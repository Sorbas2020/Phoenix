6327   2748                                    .ORG $2748
6328   2748             ;*****************************************************************************
6329   2748             ;* Add score values for enemies hit.
6330   2748             ;*****************************************************************************
6331   2748             L2748:
6332   2748 1A                                 LD      A,(DE)              ; get $4370
6333   2749 1C                                 INC     E                   ;
6334   274A FE 01                              CP      $01                 ;
6335   274C C0                                 RET     NZ                  ; if not 1
6336   274D 1A                                 LD      A,(DE)              ;
6337   274E A7                                 AND     A                   ; updates the zero flag
6338   274F C8                                 RET     Z                   ;
6339   2750 0F                                 RRCA                        ; enemy has been hit
6340   2751 0F                                 RRCA                        ;
6341   2752 0F                                 RRCA                        ;
6342   2753 0F                                 RRCA                        ;
6343   2754 47                                 LD      B,A                 ;
6344   2755 E6 F0                              AND     $F0                 ;
6345   2757 4F                                 LD      C,A                 ;
6346   2758 78                                 LD      A,B                 ;
6347   2759 E6 0F                              AND     $0F                 ;
6348   275B 47                                 LD      B,A                 ;
6349   275C CD 20 02                           CALL    AddToScore          ; 
6350   275F AF                                 XOR     A                   ; Clear A Reg.
6351   2760 12                                 LD      (DE),A              ; clear the temp. score storage and ...
6352   2761 32 97 43                           LD      (M4397),A           ; ... the first two digits of BCD score value
6353   2764 C9                                 RET                         ;
6354   2765             
6355   2768                                    .ORG $2768
6356   2768             ;*****************************************************************************
6357   2768             ;* Score-display
6358   2768             ;* Together with `$43BE` (`BonusLivesAt`), these make a contiguous 3 byte BCD value
6359   2768             ;* (`$43BD` = low, `$43BE` = middle, `$43BF` = high).
6360   2768             ;* `$43BE` is loaded from the DIP switches to `$30/$40/$50/$60`,
6361   2768             ;* the "extra ship at 3000/4000/5000/6000 points" setting,
6362   2768             ;* and `$43BD`/`$43BF` are its companion digit bytes (zeroed at init).
6363   2768             ;* This 3-byte threshold is checked against the player's score,
6364   2768             ;* using the 3 byte BCD compare `L0314`.
6365   2768             ;*****************************************************************************
6366   2768             L2768:
6367   2768 E5                                 PUSH    HL                  
6368   2769 11 61 42                           LD      DE,$4261            ; end of the screen area of player 1 score
6369   276C 06 06                              LD      B,$06               ; number of digits to print
6370   276E 3A A3 43                           LD      A,(GameAndDemoOrSplash)
6371   2771 A7                                 AND     A                   ; updates the zero flag
6372   2772 CA 78 27                           JP      Z,$2778             ; if GameAndDemoOrSplash is 'Game and demo for player 1'
6373   2775 11 21 40                           LD      DE,$4021            ; end of the screen area of player 2 score
6374   2778 CD C4 00                           CALL    PrintNumber         ; update the score on screen
6375   277B E1                                 POP     HL                  
6376   277C 11 BD 43                           LD      DE,M43BD            ; 
6377   277F EB                                 EX      DE,HL               
6378   2780 7E                                 LD      A,(HL)              
6379   2781 2C                                 INC     L                   
6380   2782 B6                                 OR      (HL)                
6381   2783 C8                                 RET     Z                   
6382   2784 2C                                 INC     L                   
6383   2785 EB                                 EX      DE,HL               
6384   2786 CD 14 03                           CALL    L0314               ; 
6385   2789 D0                                 RET     NC                  
6386   278A 3A A3 43                           LD      A,(GameAndDemoOrSplash)
6387   278D C6 90                              ADD     $90                 
6388   278F 6F                                 LD      L,A                 
6389   2790 34                                 INC     (HL)                
6390   2791 CD 67 03                           CALL    UpdateLivesScreen   ; 
6391   2794 3E FF                              LD      A,$FF               
6392   2796 32 6A 43                           LD      (M436A),A           ; 
6393   2799 2E BE                              LD      L,$BE               
6394   279B 7E                                 LD      A,(HL)              
6395   279C 36 00                              LD      (HL),$00            
6396   279E 0F                                 RRCA                        
6397   279F 0F                                 RRCA                        
6398   27A0 0F                                 RRCA                        
6399   27A1 0F                                 RRCA                        
6400   27A2 2D                                 DEC     L                   
6401   27A3 77                                 LD      (HL),A              
6402   27A4 C9                                 RET                         
6403   27A5             
6404   27A8                                    .ORG $27A8
6405   27A8             ;*****************************************************************************
6406   27A8             ;* Update the sound control hardware registers
6407   27A8             ;*****************************************************************************
