5434   22A5 2C                                 INC     L                   ; advance in page $1C (wraps $FF->$00)
5435   22A6 1B                                 DEC     DE                  ; 
5436   22A7 7E                                 LD      A,(HL)              ; 
5437   22A8 12                                 LD      (DE),A              ; 
