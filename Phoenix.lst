8434   3923             ;*****************************************************************************
8435   3923             ;* Trigger the melody chip for 'Elise',
8436   3923             ;* if flag for: 'mother ship score display' is set.
8437   3923             ;*****************************************************************************
8438   3923             L3923:
8439   3923 C8                                 RET     Z                   ; 
8440   3924 35                                 DEC     (HL)                ; decrement $436B Counter for: 'mother ship score display'
8441   3925 2E 8D                              LD      L,$8D               ; SoundControlB
8442   3927 7E                                 LD      A,(HL)              ; 
8443   3928 E6 3F                              AND     $3F                 ; 0011_1111
8444   392A F6 80                              OR      $80                 ; 1000_0000
8445   392C 77                                 LD      (HL),A              ; triggers tune2 -- 'FÜR ELISE' (Beethoven)
8446   392D C9                                 RET                         ; 
8447   392E             
8448   3930                                    .ORG $3930
8449   3930             ;*****************************************************************************
8450   3930             ;* Bird bomb-drop dispatcher:
8451   3930             ;* For the birds currently in the active scroll band (from T3DC0),
8452   3930             ;* check which sit over the player and have them drop a bomb.
8453   3930             ;* The active-object window (start index + count) comes from `T3DC0`
8454   3930             ;* indexed by the scroll phase; the player danger window `(B,C)`
8455   3930             ;* is the player's mapped X position widened by `D` (from `L3A00`).
8456   3930             ;*****************************************************************************
8457   3930             L3930:
8458   3930 3A D2 4B                           LD      A,(B4BD2)           ; A = formation vertical scroll phase (0..31)
8459   3933 E6 1E                              AND     $1E                 ; 0001_1110 even -> 2-byte stride index into T3DC0
8460   3935 C6 C0                              ADD     T3DC0 & $FF         ; + LSB of table T3DC0
8461   3937 6F                                 LD      L,A                 ; 
8462   3938 26 3D                              LD      H,T3DC0 >> 8        ; HL = T3DC0 + (phase & $1E)
8463   393A 5E                                 LD      E,(HL)              ; E = entry.byte0 = number of bird objects to scan
8464   393B 2C                                 INC     L                   ; 
8465   393C 6E                                 LD      L,(HL)              ; L = entry.byte1 = LSB of first bird object
8466   393D 26 4B                              LD      H,$4B               ; HL -> first active bird object in $4B70 array
8467   393F CD 00 3A                           CALL    L3A00               ; gate: may abort L3930; otherwise D = danger half-width
8468   3942 3A 9F 43                           LD      A,(M439F)           ; player mapped position (right edge)
8469   3945 82                                 ADD     A,D                 ; 
8470   3946 4F                                 LD      C,A                 ; C = right bound of player "danger" window
8471   3947 3A 9E 43                           LD      A,(M439E)           ; player mapped position (left edge)
8472   394A 92                                 SUB     D                   ; 
8473   394B 47                                 LD      B,A                 ; B = left bound of player "danger" window
8474   394C             L394C:
8475   394C E5                                 PUSH    HL                  ; 
8476   394D CD 5C 39                           CALL    L395C               ; test this bird; drop a bomb if it's over the player
8477   3950 E1                                 POP     HL                  ; 
8478   3951 7D                                 LD      A,L                 ; 
8479   3952 C6 08                              ADD     $08                 ; next bird object (8-byte stride)
8480   3954 6F                                 LD      L,A                 ; 
8481   3955 1D                                 DEC     E                   ; repeat for 'count' birds
8482   3956 C2 4C 39                           JP      NZ,L394C            ; 
8483   3959 C9                                 RET                         ; 
8484   395A             
8485   395C                                    .ORG $395C
8486   395C             ;*****************************************************************************
8487   395C             ;* Per-bird bomb test:
8488   395C             ;* HL -> bird object.  B/C = player danger window (left/right).
8489   395C             ;*****************************************************************************
8490   395C             L395C:
8491   395C 7E                                 LD      A,(HL)              ; +0 = bird shape / maturity index
8492   395D FE 05                              CP      $05                 ; 
8493   395F D8                                 RET     C                   ; skip birds not fully grown (index < 5)
8494   3960 7D                                 LD      A,L                 ; 
8495   3961 C6 05                              ADD     $05                 ; 
8496   3963 6F                                 LD      L,A                 ; HL -> object+5 (grid X)
8497   3964 7E                                 LD      A,(HL)              ; A = bird grid X
8498   3965 B8                                 CP      B                   ; 
8499   3966 D8                                 RET     C                   ; bird left of the window -> no bomb
8500   3967 B9                                 CP      C                   ; 
8501   3968 D0                                 RET     NC                  ; bird right of the window -> no bomb   (so B <= X < C)
8502   3969 D6 04                              SUB     $04                 ; center the drop under the bird
8503   396B 47                                 LD      B,A                 ; B = bomb X
8504   396C 2D                                 DEC     L                   ; 
8505   396D 2D                                 DEC     L                   ; 
8506   396E 2D                                 DEC     L                   ; HL -> object+2 (vertical/screen-row data)
8507   396F 3A D2 4B                           LD      A,(B4BD2)           ; scroll phase
8508   3972 86                                 ADD     A,(HL)              ; + bird's vertical data
8509   3973 E6 1F                              AND     $1F                 ; 0001_1111
8510   3975 07                                 RLCA                        ; *8 -> screen row
8511   3976 07                                 RLCA                        ; 
8512   3977 07                                 RLCA                        ; 
8513   3978 C6 08                              ADD     $08                 ; 
8514   397A 4F                                 LD      C,A                 ; C = bomb Y
8515   397B C3 B7 25                           JP      L25B7               ; spawn an enemy bullet (the bird drops a bomb)
8516   397E             
8517   3980                                    .ORG $3980
8518   3980             ;*****************************************************************************
8519   3980             ;* Player shield vs. bird collision sweep:
8520   3980             ;* Active while the formation is in a vertical band.
8521   3980             ;* Borrows the player-bullet vars to probe a column above the ship,
8522   3980             ;* destroying birds the shield touches, then ticks the shield timer.
8523   3980             ;*****************************************************************************
8524   3980             L3980:
8525   3980 3A D2 4B                           LD      A,(B4BD2)           ; scroll phase
8526   3983 D6 0C                              SUB     $0C                 ; 
8527   3985 D8                                 RET     C                   ; only when phase is in $0C..$1B
8528   3986 FE 10                              CP      $10                 ; 
8529   3988 D0                                 RET     NC                  ; 
8530   3989             ;*****************************************************************************
8531   3989             ;* --- save the real player bullet state into the $4BC0 buffer ---
8532   3989             ;*****************************************************************************
8533   3989 21 C4 43                           LD      HL,PlayerBulletState
8534   398C 11 C0 4B                           LD      DE,B4BC0            ; 
8535   398F 06 04                              LD      B,$04               ; 
8536   3991 CD E0 05                           CALL    CopyBbytesHLtoDE    ; $43C4..C7 -> $4BC0..C3
8537   3994 2E E6                              LD      L,$E6               ; AbovePlayerBulletMSB
8538   3996 06 02                              LD      B,$02               ; 
8539   3998 CD E0 05                           CALL    CopyBbytesHLtoDE    ; $43E6..E7 -> $4BC4..C5
8540   399B             ;*****************************************************************************
8541   399B             ;* --- aim the probe at the player ship and force it "active" ---
8542   399B             ;*****************************************************************************
8543   399B 2E E2                              LD      L,$E2               ; PlayerShipMSB
8544   399D 11 E6 43                           LD      DE,AbovePlayerBulletMSB
8545   39A0 06 02                              LD      B,$02               ; 
8546   39A2 CD E0 05                           CALL    CopyBbytesHLtoDE    ; probe address = ship position
8547   39A5 2E C4                              LD      L,$C4               ; PlayerBulletState
8548   39A7 36 08                              LD      (HL),$08            ; PlayerBulletState = active
8549   39A9 11 9E 43                           LD      DE,M439E            ; 
8550   39AC 3A 9B 43                           LD      A,(Counter9A+$1)    ; 
8551   39AF 0F                                 RRCA                        ; 
8552   39B0 DA BF 39                           JP      C,L39BF             ; pick left/right column by frame parity
8553   39B3 1C                                 INC     E                   ; use M439F (right) instead of M439E
8554   39B4 2E E7                              LD      L,$E7               ; AbovePlayerBulletLSB
8555   39B6 7E                                 LD      A,(HL)              ; 
8556   39B7 D6 20                              SUB     $20                 ; nudge probe up one row
8557   39B9 77                                 LD      (HL),A              ; 
8558   39BA 2D                                 DEC     L                   ; AbovePlayerBulletMSB
8559   39BB 7E                                 LD      A,(HL)              ; 
8560   39BC DE 00                              SBC     $00                 ; 
8561   39BE 77                                 LD      (HL),A              ; 
8562   39BF             L39BF:
8563   39BF 1A                                 LD      A,(DE)              ; 
8564   39C0 32 C6 43                           LD      (PlayerBulletX),A   ; probe X = player mapped position
8565   39C3             ;*****************************************************************************
8566   39C3             ;* --- Use (the sweep)
8567   39C3             ;* After saving, the routine forces `PlayerBulletState` active (`$39A7: LD (HL),$08`),
8568   39C3             ;* seeds the aim X, and repeatedly calls the bird collision routine `L3800`
8569   39C3             ;* while stepping the "above-player bullet" address down one row at a time — checking up to ~`$1D` rows for a hit.
8570   39C3             ;*****************************************************************************
8571   39C3             L39C3:
8572   39C3 CD 00 38                           CALL    L3800               ; bird collision check at this row
8573   39C6 21 C4 43                           LD      HL,PlayerBulletState
8574   39C9 7E                                 LD      A,(HL)              ; 
8575   39CA E6 08                              AND     $08                 ; 0000_1000
8576   39CC CA F0 39                           JP      Z,L39F0             ; bullet consumed (bird hit) -> shield upkeep
8577   39CF 21 E7 43                           LD      HL,AbovePlayerBulletLSB
8578   39D2 34                                 INC     (HL)                ; step down a row
8579   39D3 7E                                 LD      A,(HL)              ; 
8580   39D4 E6 1F                              AND     $1F                 ; 0001_1111
8581   39D6 FE 1D                              CP      $1D                 ; 
8582   39D8 DA C3 39                           JP      C,L39C3             ; step down a row, repeat (~29 rows)
8583   39DB             ;*****************************************************************************
8584   39DB             ;* --- Restore buffer
8585   39DB             ;* When the sweep finishes (or the shield branch at `L39F0` completes),
8586   39DB             ;* the saved bytes are copied back, returning the player bullet to exactly its previous state
8587   39DB             ;*****************************************************************************
8588   39DB             L39DB:
8589   39DB 21 C0 4B                           LD      HL,B4BC0            ; restore the saved player bullet state
8590   39DE 11 C4 43                           LD      DE,PlayerBulletState
8591   39E1 06 04                              LD      B,$04               ; 
8592   39E3 CD E0 05                           CALL    CopyBbytesHLtoDE    ; $4BC0..C3 -> $43C4..C7
8593   39E6 1E E6                              LD      E,$E6               ; 
8594   39E8 06 02                              LD      B,$02               ; 
8595   39EA C3 E0 05                           JP      CopyBbytesHLtoDE    ; $4BC4..C5 -> $43E6..E7 (and return)
8596   39ED             
8597   39F0                                    .ORG $39F0
8598   39F0             ;*****************************************************************************
8599   39F0             ;* Shield timer upkeep (entered on a hit):
8600   39F0             ;*****************************************************************************
8601   39F0             L39F0:
8602   39F0 2E A6                              LD      L,$A6               ; ShieldCount ($43A6)
8603   39F2 7E                                 LD      A,(HL)              ; 
8604   39F3 FE C0                              CP      $C0                 ; shield still has time?
8605   39F5 DA C4 0C                           JP      C,L0CC4             ; no -> hand off (shield expired handling)
8606   39F8 D6 01                              SUB     $01                 ; 
8607   39FA 77                                 LD      (HL),A              ; spend one unit of shield time
8608   39FB C3 DB 39                           JP      L39DB               ; restore player bullet state and return
8609   39FE             
8610   3A00                                    .ORG $3A00
8611   3A00             ;*****************************************************************************
8612   3A00             ;* Frame gate + danger-window width:
8613   3A00             ;* Returns D = half-width of the player "danger" window
8614   3A00             ;* (wider when fewer birds remain -> more aggressive bombing).
8615   3A00             ;* On alternate frames, pops L3930's return address so the
8616   3A00             ;* whole bomb scan is skipped this frame (throttles bombing).
8617   3A00             ;* The `POP HL` / `RET` trick at `$3A0E` is the key detail:
8618   3A00             ;* when the gate "fails", it removes `L3930`'s own continuation (`$3942`)
8619   3A00             ;* from the stack and returns one level higher, so on those frames `L3930`
8620   3A00             ;* performs no bomb-drop scan at all.
8621   3A00             ;*****************************************************************************
8622   3A00             L3A00:
8623   3A00 3A BB 43                           LD      A,(BirdsLeft)       ; 
8624   3A03 D6 0C                              SUB     $0C                 ; 
8625   3A05 2F                                 CPL                         ; 
8626   3A06 3C                                 INC     A                   ; A = $0C - BirdsLeft  (two's-complement negate)
8627   3A07 57                                 LD      D,A                 ; D = danger-window half width
8628   3A08 3A 9B 43                           LD      A,(Counter9A+$1)    ; 
8629   3A0B 0F                                 RRCA                        ; 
8630   3A0C 0F                                 RRCA                        ; test a timing bit
8631   3A0D D8                                 RET     C                   ; bit set  -> return to L3930, continue the scan
8632   3A0E E1                                 POP     HL                  ; bit clear-> discard L3930's return address...
8633   3A0F C9                                 RET                         ; ...returning to L3930's caller, skipping the scan
8634   3A10             
8635   3A10             ;*****************************************************************************
8636   3A10             ;* Update all synth sounds and melody trigger data.
8637   3A10             ;*****************************************************************************
8638   3A10             UpdateSounds:
8639   3A10 21 B8 43                           LD      HL,LevelAndRound    ; 
8640   3A13 7E                                 LD      A,(HL)              ; get it
8641   3A14 A7                                 AND     A                   ; updates the zero flag
8642   3A15 C2 43 3B                           JP      NZ,L3B43            ; if LevelAndRound is not 0, update synth sounds
8643   3A18 2E 8D                              LD      L,$8D               ; set SoundControlB for...
8644   3A1A 36 CF                              LD      (HL),$CF            ; ... 1100_1111 triggers Tune3 -- ESTUDIO (Phoenix theme song)
8645   3A1C C9                                 RET                         ; 
8646   3A1D             ;
8647   3A1D             L3A1D:
8648   3A1D 21 69 43                           LD      HL,M4369            ; 
8649   3A20 7E                                 LD      A,(HL)              ; 
8650   3A21 A7                                 AND     A                   ; updates the zero flag
8651   3A22 CA 40 3A                           JP      Z,L3A40             ; if $4369 is 0.
8652   3A25 FE 20                              CP      $20                 ; 
8653   3A27 DA 2C 3A                           JP      C,L3A2C             ; 
8654   3A2A 36 20                              LD      (HL),$20            ; 
8655   3A2C             L3A2C:
8656   3A2C 35                                 DEC     (HL)                ; 
8657   3A2D 7E                                 LD      A,(HL)              ; 
8658   3A2E 07                                 RLCA                        ; Multiply by 4 ..
8659   3A2F 07                                 RLCA                        ; ..
8660   3A30 00                                 NOP                         ; 
8661   3A31 2F                                 CPL                         ; 
8662   3A32 E6 0E                              AND     $0E                 ; 0000_1110
8663   3A34 2E 8D                              LD      L,$8D               ; SoundControlB
8664   3A36 77                                 LD      (HL),A              ; 
8665   3A37 2E 68                              LD      L,$68               ; $4368
8666   3A39 36 00                              LD      (HL),$00            ; reset 'maturity of the birds'
8667   3A3B 2E 66                              LD      L,$66               ; $4366
8668   3A3D 36 00                              LD      (HL),$00            ; reset the flag for: 'Mothership hit'
8669   3A3F C9                                 RET                         ; 
8670   3A40             
8671   3A40             ;*****************************************************************************
8672   3A40             ;* Enemy hit sound during explosion animation.
8673   3A40             ;*****************************************************************************
8674   3A40             L3A40:
8675   3A40 2E 64                              LD      L,$64               ; $4364 Flag for: 'enemy hit detected' ($FF) and counter
8676   3A42 7E                                 LD      A,(HL)              ; 
8677   3A43 A7                                 AND     A                   ; updates the zero flag
8678   3A44 CA 62 3A                           JP      Z,L3A62             ; 
8679   3A47 FE 10                              CP      $10                 ; 
8680   3A49 DA 4E 3A                           JP      C,L3A4E             ; 
8681   3A4C 36 10                              LD      (HL),$10            ; start value for animation counter
8682   3A4E             L3A4E:
8683   3A4E 35                                 DEC     (HL)                ; 
8684   3A4F 7E                                 LD      A,(HL)              ; 
8685   3A50 0F                                 RRCA                        ; 
8686   3A51 00                                 NOP                         ; 
8687   3A52 00                                 NOP                         ; 
8688   3A53 2F                                 CPL                         ; 
8689   3A54 E6 07                              AND     $07                 ; 0000_0111
8690   3A56 F6 10                              OR      $10                 ; 0001_0000 sound variation speed
8691   3A58 2E 8C                              LD      L,$8C               ; SoundControlA
8692   3A5A 77                                 LD      (HL),A              ; enemy hit sound
8693   3A5B 2E 66                              LD      L,$66               ; $4366
8694   3A5D 36 00                              LD      (HL),$00            ; reset the flag for: 'Mothership hit'
8695   3A5F C9                                 RET                         ; 
8696   3A60             
8697   3A62                                    .ORG $3A62
8698   3A62             ;*****************************************************************************
8699   3A62             ;* Bird wing hit sound.
8700   3A62             ;*****************************************************************************
8701   3A62             L3A62:
8702   3A62 2E 66                              LD      L,$66               ; $4366
8703   3A64 7E                                 LD      A,(HL)              ; get flag 'bird wing hit detected'
8704   3A65 A7                                 AND     A                   ; updates the zero flag
8705   3A66 C8                                 RET     Z                   ; if not set.
8706   3A67 FE 10                              CP      $10                 
8707   3A69 DA 78 3A                           JP      C,L3A78             ; 
8708   3A6C 36 10                              LD      (HL),$10            
8709   3A6E 3A B8 43                           LD      A,(LevelAndRound)   ; 
8710   3A71 E6 08                              AND     $08                 ; 0000_1000
8711   3A73 CA 78 3A                           JP      Z,L3A78             ; 
8712   3A76 36 05                              LD      (HL),$05            
8713   3A78             L3A78:
8714   3A78 35                                 DEC     (HL)                ; 
8715   3A79 2E 8C                              LD      L,$8C               ; SoundControlA
8716   3A7B 7E                                 LD      A,(HL)              ; 
8717   3A7C E6 08                              AND     $08                 ; 0000_1000
8718   3A7E F6 04                              OR      $04                 ; 0000_0100
8719   3A80 77                                 LD      (HL),A              ; bird wing hit sound
8720   3A81 C9                                 RET                         ; 
8721   3A82             ;
8722   3A82             L3A82:
8723   3A82 21 9A 43                           LD      HL,Counter9A        ; 
8724   3A85 7E                                 LD      A,(HL)              
8725   3A86 FE 03                              CP      $03                 
8726   3A88 D8                                 RET     C                   
8727   3A89 2E 8D                              LD      L,$8D               ; SoundControlB
8728   3A8B 7E                                 LD      A,(HL)              
8729   3A8C E6 3F                              AND     $3F                 ; 0011_1111
8730   3A8E 77                                 LD      (HL),A              ; stop melody
8731   3A8F C9                                 RET                         
8732   3A90             ;
