6314   272E 47                                 LD      B,A                 ;
6315   272F 0E 00                              LD      C,$00               ;
6316   2731 CD 20 02                           CALL    AddToScore          ; 
6317   2734 AF                                 XOR     A                   ; A=0
6318   2735 12                                 LD      (DE),A              ;
6319   2736 32 97 43                           LD      (M4397),A           ; 
6320   2739             L2739:
6321   2739 3A 97 43                           LD      A,(M4397)           ; 
6322   273C A7                                 AND     A                   ; updates the zero flag
6323   273D CC 68 27                           CALL    Z,L2768             ; if $4397 is 0.
6324   2740 CD A8 27                           CALL    UpdateSoundControlHW
6325   2743 C3 10 3A                           JP      L3A10               ; 
