6671   3000             
6672   3000             ;*****************************************************************************
6673   3000             ; h7-ic51.7a
6674   3000             ;*****************************************************************************
6675   3000             
6676   3000             ;*****************************************************************************
6677   3000             ;* AlienBehaviorUpdate.
6678   3000             ;* This is the 'core of the matter'!
6679   3000             ;* The 'core of the matter': drives every alien attack pattern and the
6680   3000             ;* randomized selection. One sub-task runs per frame, chosen round-robin by
6681   3000             ;* Counter93 (0-7) via jump table T3018. The sub-tasks cooperate through the
6682   3000             ;* behavior state machine at $4350 and the control block $4350-$435B.
6683   3000             ;* The selected patterns do always fit on the screen,
6684   3000             ;* even if the alien formation is further down. (phase 1, 2, 3)
6685   3000             ;*****************************************************************************
6686   3000             L3000:
6687   3000 21 93 43                           LD      HL,Counter93        ; 
6688   3003 7E                                 LD      A,(HL)              ; load and save ram value
6689   3004 34                                 INC     (HL)                ; increment Counter93
6690   3005 E6 07                              AND     $07                 ; masc out 0000_0111 the saved value in order to count from 0 to 7
6691   3007 21 18 30                           LD      HL,T3018            ; base of jump table
6692   300A 07                                 RLCA                        ; Multiply by 2 to get a 2 byte offset
6693   300B 85                                 ADD     A,L                 ;
6694   300C 6F                                 LD      L,A                 ;
6695   300D 7E                                 LD      A,(HL)              ; get MSB from jump table
6696   300E 23                                 INC     HL                  ;
6697   300F 6E                                 LD      L,(HL)              ; get LSB from jump table
6698   3010 67                                 LD      H,A                 ;
6699   3011 E9                                 JP      (HL)                ; jump to the corresponding function
6700   3012             ;*****************************************************************************
6701   3012             ;* Sub-task 7: Do nothing.
6702   3012             ;*****************************************************************************
6703   3012             L3012:
6704   3012 C9                                 RET                         ;
6705   3013             
6706   3018                                    .ORG $3018
6707   3018             ;
6708   3018             T3018:
6709   3018                                    .MSFIRST
6710   3018 32 64                              .DW L3264 ; 0 -> L3264  install chosen pattern / rotate start pointer
6711   301A 30 28                              .DW L3028 ; 1 -> L3028  'Angry movement A/B' (push formation down)
6712   301C 30 BA                              .DW L30BA ; 2 -> L30BA  tick attack-delay + group timers
6713   301E 31 24                              .DW L3124 ; 3 -> L3124  decide how many aliens attack
6714   3020 31 5A                              .DW L315A ; 4 -> L315A  pick a random alien to attack
6715   3022 31 B4                              .DW L31B4 ; 5 -> L31B4  choose the closed-loop swoop pattern
6716   3024 32 2C                              .DW L322C ; 6 -> L322C  confirm pattern start across the grid
6717   3026 30 12                              .DW L3012 ; 7 -> L3012  (nop)
6718   3028             
6719   3028             ;*****************************************************************************
6720   3028             ;* Sub-task 1: 'Angry movement pattern A/B' (pattern 26/28).
6721   3028             ;* Every $4358 frames, escalate $4357 and re-arm the downward-push pattern
6722   3028             ;* (T2E00/T2E40), so the formation creeps further down the screen.
6723   3028             ;*****************************************************************************
6724   3028             L3028:
6725   3028 21 57 43                           LD      HL,M4357            ; 
6726   302B 7E                                 LD      A,(HL)              
6727   302C FE 03                              CP      $03                 
6728   302E D0                                 RET     NC                  ; if >= 3
6729   302F 2E 50                              LD      L,$50               
6730   3031 7E                                 LD      A,(HL)              ; get $4350
6731   3032 FE 04                              CP      $04                 
6732   3034 D0                                 RET     NC                  ; if >= 4
6733   3035 2E 58                              LD      L,$58               
6734   3037 7E                                 LD      A,(HL)              ; get $4358
6735   3038 A7                                 AND     A                   ; updates the zero flag
6736   3039 CA 5C 30                           JP      Z,L305C             ; 
6737   303C 35                                 DEC     (HL)                ; $4358
6738   303D C0                                 RET     NZ                  
6739   303E 2D                                 DEC     L                   
6740   303F 34                                 INC     (HL)                ; $4357
6741   3040 2E 50                              LD      L,$50               
6742   3042 36 04                              LD      (HL),$04            ; set $4350
6743   3044 2E 53                              LD      L,$53               
6744   3046 36 10                              LD      (HL),$10            ; set $4353
6745   3048 2C                                 INC     L                   
6746   3049 36 50                              LD      (HL),$50            ; set $4354
6747   304B 2E 51                              LD      L,$51               
6748   304D 36 2E                              LD      (HL),$2E            ; set $4351
6749   304F 2C                                 INC     L                   
6750   3050 36 00                              LD      (HL),$00            ; clear $4352
6751   3052 3A C2 43                           LD      A,(PlayerShipX)     ; 
6752   3055 0F                                 RRCA                        
6753   3056 D8                                 RET     C                   
6754   3057 36 40                              LD      (HL),$40            ; set $4352
6755   3059 C9                                 RET                         
6756   305A             
6757   305C                                    .ORG $305C
6758   305C             ;*****************************************************************************
6759   305C             ;* End of movement pattern reached. Get the next start pointer.
6760   305C             ;*****************************************************************************
6761   305C             L305C:
6762   305C CD 74 30                           CALL    L3074               ; 
6763   305F 21 57 43                           LD      HL,M4357            ; 
6764   3062 7E                                 LD      A,(HL)              ; get $4357
6765   3063 07                                 RLCA                        ; Multiply by 4 ..
6766   3064 07                                 RLCA                        ; ..
6767   3065 00                                 NOP                         ;
6768   3066 00                                 NOP                         ;
6769   3067 81                                 ADD     A,C                 ;
6770   3068 C6 07                              ADD     $07                 ;
6771   306A 2E 58                              LD      L,$58               ;
6772   306C 77                                 LD      (HL),A              ; store to $4358
6773   306D C9                                 RET                         ;
6774   306E             
6775   3074                                    .ORG $3074
6776   3074             ;*****************************************************************************
6777   3074             ;* Build a scaled random magnitude in C from round, level, aliens-left and
6778   3074             ;* a random number. Used to size timer spans and attacker counts.
6779   3074             ;*****************************************************************************
6780   3074             L3074:
6781   3074 21 B8 43                           LD      HL,LevelAndRound    ; 
6782   3077 7E                                 LD      A,(HL)              
6783   3078 0F                                 RRCA                        
6784   3079 00                                 NOP                         
6785   307A E6 07                              AND     $07                 ; 0000_0111
6786   307C 47                                 LD      B,A                 
6787   307D 3E 07                              LD      A,$07               
6788   307F 90                                 SUB     B                   
6789   3080 4F                                 LD      C,A                 
6790   3081 7E                                 LD      A,(HL)              ; get LevelAndRound
6791   3082 FE 80                              CP      $80                 
6792   3084 DA 89 30                           JP      C,L3089             ; 
6793   3087 3E 70                              LD      A,$70               
6794   3089             L3089:
6795   3089 0F                                 RRCA                        
6796   308A 0F                                 RRCA                        
6797   308B 0F                                 RRCA                        
6798   308C 0F                                 RRCA                        
6799   308D E6 07                              AND     $07                 
6800   308F 47                                 LD      B,A                 
6801   3090 3E 07                              LD      A,$07               
6802   3092 90                                 SUB     B                   
6803   3093 81                                 ADD     A,C                 
6804   3094 4F                                 LD      C,A                 
6805   3095 3A BA 43                           LD      A,(AliensLeft)      ; 
6806   3098 D6 05                              SUB     $05                 
6807   309A D2 9F 30                           JP      NC,L309F            ; 
6808   309D 3E 10                              LD      A,$10               
6809   309F             L309F:
6810   309F 81                                 ADD     A,C                 
6811   30A0 4F                                 LD      C,A                 
6812   30A1 CD AA 30                           CALL    GetRandomNumber     ; 
6813   30A4 E6 07                              AND     $07                 
6814   30A6 81                                 ADD     A,C                 
6815   30A7 4F                                 LD      C,A                 
6816   30A8 C9                                 RET                         
6817   30A9             
6818   30AA                                    .ORG $30AA
6819   30AA             ;*****************************************************************************
6820   30AA             ;* Free running counter ($439B) and the X position of the player ship ($43C2)
6821   30AA             ;* is the base for a pseudo random number.
6822   30AA             ;* Returns A-register: $00 to $0F.
6823   30AA             ;*****************************************************************************
6824   30AA             GetRandomNumber:
6825   30AA 21 9B 43                           LD      HL,Counter9A+$1     ; 
6826   30AD 7E                                 LD      A,(HL)              ;
6827   30AE 07                                 RLCA                        ; Multiply by 8 ..
6828   30AF 07                                 RLCA                        ; ..
6829   30B0 07                                 RLCA                        ; ..
6830   30B1 E6 07                              AND     $07                 ; mask out 0000_0111 in order to count from 0 to 7
6831   30B3 2E C2                              LD      L,$C2               ; get $43C2 PlayerShipX
6832   30B5 86                                 ADD     A,(HL)              ; add to counter value
6833   30B6 E6 0F                              AND     $0F                 ; mask out 0000_1111
6834   30B8 C9                                 RET                         ;
6835   30B9             
6836   30BA                                    .ORG $30BA
6837   30BA             ;*****************************************************************************
6838   30BA             ;* Sub-task 2: tick the three staggered group timers and the attack delay.
6839   30BA             ;* When the delay $4355 expires (in state 0) begin a new attack (state 1).
6840   30BA             ;*****************************************************************************
6841   30BA             L30BA:
6842   30BA 21 58 43                           LD      HL,M4358            ; 
6843   30BD CD DA 30                           CALL    L30DA               ; for $4359
6844   30C0 CD DA 30                           CALL    L30DA               ; for $435A
6845   30C3 CD DA 30                           CALL    L30DA               ; for $435B
6846   30C6 2E 50                              LD      L,$50               
6847   30C8 7E                                 LD      A,(HL)              ; get $4350
6848   30C9 A7                                 AND     A                   ; updates the zero flag
6849   30CA C0                                 RET     NZ                  ; if <> 0
6850   30CB 2E 55                              LD      L,$55               
6851   30CD 7E                                 LD      A,(HL)              ; get $4355
6852   30CE A7                                 AND     A                   ; updates the zero flag
6853   30CF CA E4 30                           JP      Z,L30E4             ; if 0
6854   30D2 35                                 DEC     (HL)                
6855   30D3 C0                                 RET     NZ                  
6856   30D4 2E 50                              LD      L,$50               
6857   30D6 36 01                              LD      (HL),$01            
6858   30D8 C9                                 RET                         
6859   30D9             
6860   30DA                                    .ORG $30DA
6861   30DA             ;*****************************************************************************
6862   30DA             ;* Tick one timer (does not go below 0).
6863   30DA             ;*****************************************************************************
6864   30DA             L30DA:
6865   30DA 2C                                 INC     L                   
6866   30DB 7E                                 LD      A,(HL)              
6867   30DC A7                                 AND     A                   ; updates the zero flag
6868   30DD C8                                 RET     Z                   ; if 4359, 435A, 435B = 0
6869   30DE 35                                 DEC     (HL)                
6870   30DF C9                                 RET                         
6871   30E0             
6872   30E4                                    .ORG $30E4
6873   30E4             ;*****************************************************************************
6874   30E4             ;* Recompute the attack delay $4355 and reload the 3 group timers.
6875   30E4             ;*****************************************************************************
6876   30E4             L30E4:
6877   30E4 CD 74 30                           CALL    L3074               ; 
6878   30E7 21 9A 43                           LD      HL,Counter9A        ; 
6879   30EA 7E                                 LD      A,(HL)              
6880   30EB FE 10                              CP      $10                 
6881   30ED DA F2 30                           JP      C,L30F2             ; 
6882   30F0 3E 0F                              LD      A,$0F               
6883   30F2             L30F2:
6884   30F2 47                                 LD      B,A                 
6885   30F3 3E 0F                              LD      A,$0F               
6886   30F5 90                                 SUB     B                   
6887   30F6 81                                 ADD     A,C                 
6888   30F7 4F                                 LD      C,A                 
6889   30F8 06 01                              LD      B,$01               
6890   30FA 2E 58                              LD      L,$58               
6891   30FC CD 12 31                           CALL    L3112               ; for $4359
6892   30FF CD 12 31                           CALL    L3112               ; for $435A
6893   3102 CD 12 31                           CALL    L3112               ; for $435B
6894   3105 79                                 LD      A,C                 
6895   3106 0F                                 RRCA                        
6896   3107 0F                                 RRCA                        
6897   3108 E6 3F                              AND     $3F                 ; 0011_1111
6898   310A C6 01                              ADD     $01                 
6899   310C 2E 55                              LD      L,$55               
6900   310E 77                                 LD      (HL),A              ; set $4355
6901   310F C9                                 RET                         
6902   3110             
6903   3112                                    .ORG $3112
6904   3112             ;*****************************************************************************
6905   3112             ;* Reload one group timer (only if it is currently 0).
6906   3112             ;*****************************************************************************
6907   3112             L3112:
6908   3112 2C                                 INC     L                   
6909   3113 7E                                 LD      A,(HL)              
6910   3114 A7                                 AND     A                   ; updates the zero flag
6911   3115 C0                                 RET     NZ                  ; if <> 0
6912   3116 79                                 LD      A,C                 
6913   3117 0F                                 RRCA                        
6914   3118 E6 7F                              AND     $7F                 ; 0111_1111
6915   311A 4F                                 LD      C,A                 
6916   311B 78                                 LD      A,B                 
6917   311C A7                                 AND     A                   ; updates the zero flag
6918   311D C8                                 RET     Z                   
6919   311E 05                                 DEC     B                   
6920   311F 36 0C                              LD      (HL),$0C            
6921   3121 C9                                 RET                         
6922   3122             
6923   3124                                    .ORG $3124
6924   3124             ;*****************************************************************************
6925   3124             ;* Sub-task 3: in state 1, advance to state 2 and compute the number of
6926   3124             ;* aliens that will fly the swoop ($4353), from round + random, reduced as
6927   3124             ;* the escalation counter $4357 grows.
6928   3124             ;*****************************************************************************
6929   3124             L3124:
6930   3124 21 50 43                           LD      HL,M4350            ; 
6931   3127 7E                                 LD      A,(HL)              
6932   3128 FE 01                              CP      $01                 
6933   312A C0                                 RET     NZ                  ; if <> 1
6934   312B 36 02                              LD      (HL),$02            ; set $4350
6935   312D 2E B8                              LD      L,$B8               
6936   312F 7E                                 LD      A,(HL)              ; get LevelAndRound
6937   3130 0F                                 RRCA                        
6938   3131 0F                                 RRCA                        
6939   3132 E6 0F                              AND     $0F                 
6940   3134 C6 05                              ADD     $05                 
6941   3136 FE 11                              CP      $11                 
6942   3138 DA 3D 31                           JP      C,L313D             ; 
6943   313B 3E 05                              LD      A,$05               
6944   313D             L313D:
6945   313D 2E 57                              LD      L,$57               
6946   313F 96                                 SUB     (HL)                
6947   3140 47                                 LD      B,A                 
6948   3141 CD AA 30                           CALL    GetRandomNumber     ; 
6949   3144 3C                                 INC     A                   
6950   3145 B8                                 CP      B                   
6951   3146 DA 4B 31                           JP      C,L314B             ; 
6952   3149 3E 01                              LD      A,$01               
6953   314B             L314B:
6954   314B 2E 53                              LD      L,$53               
6955   314D 77                                 LD      (HL),A              
6956   314E C9                                 RET                         
6957   314F             
6958   315A                                    .ORG $315A
6959   315A             ;*****************************************************************************
6960   315A             ;* Sub-task 4: in state 2, scan the 16-alien grid from a random offset for
6961   315A             ;* an active alien whose control bytes match the current start pointer.
6962   315A             ;* The first match is recorded in $4354 and state advances to 3.
6963   315A             ;*****************************************************************************
6964   315A             L315A:
6965   315A 21 50 43                           LD      HL,M4350            ; 
6966   315D 7E                                 LD      A,(HL)              
6967   315E FE 02                              CP      $02                 
6968   3160 C0                                 RET     NZ                  ; if <> 2
6969   3161 CD AA 30                           CALL    GetRandomNumber     ; 
6970   3164 00                                 NOP                         
6971   3165 47                                 LD      B,A                 
6972   3166 07                                 RLCA                        ; Multiply by 2
6973   3167 C6 50                              ADD     $50                 
6974   3169 6F                                 LD      L,A                 
6975   316A 26 4B                              LD      H,$4B               
6976   316C 78                                 LD      A,B                 
6977   316D 07                                 RLCA                        ; Multiply by 4 ..
6978   316E 07                                 RLCA                        ;
6979   316F C6 70                              ADD     $70                 
6980   3171 5F                                 LD      E,A                 
6981   3172 16 4B                              LD      D,$4B               
6982   3174 0E 10                              LD      C,$10               
6983   3176 79                                 LD      A,C                 
6984   3177 90                                 SUB     B                   
6985   3178 47                                 LD      B,A                 
6986   3179             L3179:
6987   3179 CD 92 31                           CALL    L3192               ; 
6988   317C 13                                 INC     DE                  
6989   317D 13                                 INC     DE                  
6990   317E 13                                 INC     DE                  
6991   317F 13                                 INC     DE                  
6992   3180 23                                 INC     HL                  
6993   3181 23                                 INC     HL                  
6994   3182 05                                 DEC     B                   
6995   3183 C2 8A 31                           JP      NZ,L318A            ; 
6996   3186 1E 70                              LD      E,$70               
6997   3188 2E 50                              LD      L,$50               
6998   318A             L318A:
6999   318A 0D                                 DEC     C                   
7000   318B C2 79 31                           JP      NZ,L3179            ; 
7001   318E C9                                 RET                         
7002   318F             
7003   3192                                    .ORG $3192
7004   3192             ;*****************************************************************************
7005   3192             ;* Match test: active alien whose control bytes equal the start pointer.
7006   3192             ;*****************************************************************************
7007   3192             L3192:
7008   3192 1A                                 LD      A,(DE)              
7009   3193 E6 08                              AND     $08                 
7010   3195 C8                                 RET     Z                   
7011   3196 3A 94 43                           LD      A,(M4394)           ; 
7012   3199 BE                                 CP      (HL)                
7013   319A C0                                 RET     NZ                  
7014   319B 3A 56 43                           LD      A,(M4356)           ; 
7015   319E 2C                                 INC     L                   
7016   319F 46                                 LD      B,(HL)              
7017   31A0 2D                                 DEC     L                   
7018   31A1 B8                                 CP      B                   
7019   31A2 C0                                 RET     NZ                  
7020   31A3 7D                                 LD      A,L                 
7021   31A4 32 54 43                           LD      (M4354),A           ; 
7022   31A7 3E 03                              LD      A,$03               
7023   31A9 32 50 43                           LD      (M4350),A           ; 
7024   31AC E1                                 POP     HL                  
7025   31AD C9                                 RET                         
7026   31AE             
7027   31B4                                    .ORG $31B4
7028   31B4             ;*****************************************************************************
7029   31B4             ;* Sub-task 5: in state 3, choose the closed-loop swoop pattern for the
7030   31B4             ;* selected alien based on its position relative to the player (T3300),
7031   31B4             ;* its row/phase (L3210 + T3310) and a random pick (T3330). Pattern pointer
7032   31B4             ;* is stored at $4351/$4352 and state advances to 5.
7033   31B4             ;*****************************************************************************
7034   31B4             L31B4:
7035   31B4 3A 50 43                           LD      A,(M4350)           ; 
