3052   0D1C             ;*****************************************************************************
3053   0D1C             ;* Alien movement update.
3054   0D1C             ;*****************************************************************************
3055   0D1C             L0D1C:
3056   0D1C 01 70 4B                           LD      BC,M4B70            ; Alien control state A
3057   0D1F 21 50 4B                           LD      HL,M4B50            ; Alien movement pattern table
3058   0D22             L0D22:
3059   0D22 CD 30 0D                           CALL    L0D30               ; 
3060   0D25 0C                                 INC     C                   ; 
3061   0D26 0C                                 INC     C                   ; 
3062   0D27 2C                                 INC     L                   ; 
3063   0D28 3E B0                              LD      A,$B0               ; 
3064   0D2A B9                                 CP      C                   ; 
3065   0D2B C2 22 0D                           JP      NZ,L0D22            ; loop for 16 aliens
3066   0D2E C9                                 RET                         ; 
3067   0D2F             
3068   0D30                                    .ORG $0D30
3069   0D30             ;
3070   0D30             L0D30:
3071   0D30 56                                 LD      D,(HL)              ; get MSB of pointer for alien movement pattern
3072   0D31 23                                 INC     HL                  ; 
3073   0D32 0A                                 LD      A,(BC)              ; get alien control state A
3074   0D33 03                                 INC     BC                  ; 
3075   0D34 03                                 INC     BC                  ; 
3076   0D35 E6 08                              AND     $08                 ; 0000_1000
3077   0D37 C8                                 RET     Z                   ; if bit3 of alien control state A, not set
3078   0D38 5E                                 LD      E,(HL)              ; get LSB of pointer for alien movement pattern
3079   0D39 EB                                 EX      DE,HL               ; 
3080   0D3A 7E                                 LD      A,(HL)              ; get pointer to movement list (T1000)
3081   0D3B 07                                 RLCA                        ; multiply by 2 to get a 2 byte offset at T1700
3082   0D3C C6 00                              ADD     $00                 ; reset all flags
3083   0D3E 6F                                 LD      L,A                 ; get LSB for movement direction table (T1700)
3084   0D3F 26 17                              LD      H,T1700 >> 8        ; get MSB for movement direction table (T1700)
3085   0D41 AF                                 XOR     A                   ; A=0
3086   0D42 BE                                 CP      (HL)                ; check for end marker
3087   0D43 CA 4F 0D                           JP      Z,L0D4F             ; if end reached
3088   0D46 23                                 INC     HL                  ; value for Y movement
3089   0D47 BE                                 CP      (HL)                ; check for Y movement
3090   0D48 CA 5E 0D                           JP      Z,L0D5E             ; if no Y movement
3091   0D4B 2B                                 DEC     HL                  ; value for X movement
3092   0D4C 0A                                 LD      A,(BC)              ; get alien screen coordinate X
3093   0D4D 86                                 ADD     A,(HL)              ; add the X delta from T1700
3094   0D4E 02                                 LD      (BC),A              ; save it back
3095   0D4F             L0D4F:
3096   0D4F 03                                 INC     BC                  ; -> Y coordinate
3097   0D50 23                                 INC     HL                  ; Y from alien movement direction table (T1700)
3098   0D51 0A                                 LD      A,(BC)              ; get alien screen coordinate Y
3099   0D52 86                                 ADD     A,(HL)              ; add the Y delta
3100   0D53 02                                 LD      (BC),A              ; save it back
3101   0D54 0B                                 DEC     BC                  ; alien screen coordinate X
3102   0D55 E6 07                              AND     $07                 ; 0000_0111
3103   0D57 EB                                 EX      DE,HL               ; 
3104   0D58 C0                                 RET     NZ                  ; if grid border not reached
3105   0D59 34                                 INC     (HL)                ; next movement list pointer (T1000)
3106   0D5A C9                                 RET                         ; 
3107   0D5B             
3108   0D5E                                    .ORG $0D5E
3109   0D5E             L0D5E:
3110   0D5E 2B                                 DEC     HL                  ; value for X movement
3111   0D5F 0A                                 LD      A,(BC)              ; get Alien screen coordinate X
3112   0D60 86                                 ADD     A,(HL)              ; add both
3113   0D61 02                                 LD      (BC),A              ; save
3114   0D62 E6 07                              AND     $07                 ; 0000_0111
3115   0D64 EB                                 EX      DE,HL               ; 
3116   0D65 C0                                 RET     NZ                  ; if grid border not reached
3117   0D66 34                                 INC     (HL)                ; next movement list pointer (T1000)
3118   0D67 C9                                 RET                         ; 
3119   0D68             
3120   0D70                                    .ORG $0D70
3121   0D70             ;*****************************************************************************
3122   0D70             ;* Alien animation update.
3123   0D70             ;* 1. Uses the movement-list opcode → `T16A0` (3-byte anim record)
3124   0D70             ;* 2. From that, picks a base into `T1600` and a small X/Y sub-index (fine scroll / facing)
3125   0D70             ;* 3. Reads one byte from `T1600`...`T1690`
3126   0D70             ;* 4. Stores it in control state B = LSB for `$14xx`
3127   0D70             ;*****************************************************************************
3128   0D70             AlienAnimationUpdate:
3129   0D70             L0D70:
3130   0D70 01 70 4B                           LD      BC,M4B70            ; Alien control state A
3131   0D73 21 50 4B                           LD      HL,M4B50            ; Alien movement pattern table
3132   0D76             L0D76:
3133   0D76 CD 86 0D                           CALL    L0D86               ; 
3134   0D79 79                                 LD      A,C                 ; 
3135   0D7A C6 04                              ADD     $04                 ; 
3136   0D7C 4F                                 LD      C,A                 ; 
3137   0D7D 3E B0                              LD      A,$B0               ; 
3138   0D7F B9                                 CP      C                   ; 
3139   0D80 C2 76 0D                           JP      NZ,L0D76            ; loop for 16 aliens
3140   0D83 C9                                 RET                         ; 
3141   0D84             
3142   0D86                                    .ORG $0D86
3143   0D86             L0D86:
3144   0D86 56                                 LD      D,(HL)              ; get MSB of pointer for alien movement pattern
3145   0D87 23                                 INC     HL                  ; 
3146   0D88 5E                                 LD      E,(HL)              ; get LSB of pointer for alien movement pattern
3147   0D89 23                                 INC     HL                  ; 
3148   0D8A 0A                                 LD      A,(BC)              ; get alien control state A
3149   0D8B E6 08                              AND     $08                 ; 0000_1000
3150   0D8D C8                                 RET     Z                   ; if bit3 of alien control state A, not set
3151   0D8E EB                                 EX      DE,HL               ; 
3152   0D8F 7E                                 LD      A,(HL)              ; get pointer to movement list (T1000)
3153   0D90 A7                                 AND     A                   ; updates the zero flag
3154   0D91 CC DE 0D                           CALL    Z,L0DDE             ; if end of movement list reached
3155   0D94 6F                                 LD      L,A                 ; get pointer to movement list
3156   0D95 07                                 RLCA                        ; multiply by ..
3157   0D96 85                                 ADD     A,L                 ; .. 3, to get a 3 byte offset at T16A0
3158   0D97 C6 A0                              ADD     T16A0 & $FF         ; LSB of T16A0
3159   0D99 6F                                 LD      L,A                 ; 
3160   0D9A 26 16                              LD      H,T16A0 >> 8        ; MSB of T16A0
3161   0D9C 0A                                 LD      A,(BC)              ; get alien control state A
3162   0D9D E6 F8                              AND     $F8                 ; 1111_1000
3163   0D9F B6                                 OR      (HL)                ; 1st byte of alien animation table
3164   0DA0 02                                 LD      (BC),A              ; set alien control state A
3165   0DA1 03                                 INC     BC                  ; 
3166   0DA2 03                                 INC     BC                  ; 
3167   0DA3 03                                 INC     BC                  ; alien screen coordinate Y
3168   0DA4 23                                 INC     HL                  ; 
3169   0DA5 7E                                 LD      A,(HL)              ; get 2nd byte of alien animation table
3170   0DA6 23                                 INC     HL                  ; 3rd byte of alien animation table
3171   0DA7 0F                                 RRCA                        ; divide by 2
3172   0DA8 DA BB 0D                           JP      C,L0DBB             ; if 2nd byte is: $01
3173   0DAB 0F                                 RRCA                        ; divide by 2
3174   0DAC DA CC 0D                           JP      C,L0DCC             ; if 2nd byte is: $02
3175   0DAF             ; 2nd byte of alien animation table is: $04
3176   0DAF 0A                                 LD      A,(BC)              ; get alien screen coordinate Y
3177   0DB0 0F                                 RRCA                        ; divide by 2
3178   0DB1 E6 03                              AND     $03                 ; 0000_0011
3179   0DB3 86                                 ADD     A,(HL)              ; add with 3rd byte of alien animation table
3180   0DB4 0B                                 DEC     BC                  ; alien screen coordinate X
3181   0DB5 C3 D2 0D                           JP      L0DD2               ; 
3182   0DB8             
3183   0DBB                                    .ORG $0DBB
3184   0DBB             ; 2nd byte of alien animation table is: $01
3185   0DBB             L0DBB:
3186   0DBB 0A                                 LD      A,(BC)              ; get alien screen coordinate Y
3187   0DBC 0F                                 RRCA                        ; divide by 2
3188   0DBD E6 03                              AND     $03                 ; 0000_0011
3189   0DBF 86                                 ADD     A,(HL)              ; add with 3rd byte of alien animation table
3190   0DC0 67                                 LD      H,A                 ; save
3191   0DC1 0B                                 DEC     BC                  ; 
3192   0DC2 0A                                 LD      A,(BC)              ; get alien screen coordinate X
3193   0DC3 E6 04                              AND     $04                 ; 0000_0100
3194   0DC5 84                                 ADD     A,H                 ; add with 3rd byte of alien animation table
3195   0DC6 C3 D2 0D                           JP      L0DD2               ; 
3196   0DC9             
3197   0DCC                                    .ORG $0DCC
3198   0DCC             ; 2nd byte of alien animation table is: $02
3199   0DCC             L0DCC:
3200   0DCC 0B                                 DEC     BC                  ; 
3201   0DCD 0A                                 LD      A,(BC)              ; get alien screen coordinate X
3202   0DCE 0F                                 RRCA                        ; divide by 2
3203   0DCF E6 03                              AND     $03                 ; 0000_0011
3204   0DD1 86                                 ADD     A,(HL)              ; add with 3rd byte of alien animation table
3205   0DD2             L0DD2:
3206   0DD2 6F                                 LD      L,A                 ; LSB for T1600
3207   0DD3 26 16                              LD      H,T1600 >> 8        ; MSB for T1600
3208   0DD5 7E                                 LD      A,(HL)              ; get data from T1600
3209   0DD6 0B                                 DEC     BC                  ; 
3210   0DD7 02                                 LD      (BC),A              ; set alien control state B (LSB for T14xx)
3211   0DD8 0B                                 DEC     BC                  ; alien control state A
3212   0DD9 EB                                 EX      DE,HL               ; 
3213   0DDA C9                                 RET                         ; 
3214   0DDB             
3215   0DDE                                    .ORG $0DDE
3216   0DDE             ; End of movement list reached
3217   0DDE             L0DDE:
3218   0DDE 1B                                 DEC     DE                  ; 
3219   0DDF 1B                                 DEC     DE                  ; 
3220   0DE0 3A 94 43                           LD      A,(M4394)           ; get start value list pointer for alien movement MSB
3221   0DE3 12                                 LD      (DE),A              ; save alien movement pattern table MSB
3222   0DE4 67                                 LD      H,A                 ; 
3223   0DE5 13                                 INC     DE                  ; 
3224   0DE6 3A 95 43                           LD      A,(M4395)           ; get start value list pointer for alien movement LSB
3225   0DE9 12                                 LD      (DE),A              ; save alien movement pattern table LSB
3226   0DEA 6F                                 LD      L,A                 ; 
3227   0DEB 13                                 INC     DE                  ; 
3228   0DEC 7E                                 LD      A,(HL)              ; get value from pointer table to alien movement list
3229   0DED C9                                 RET                         ; 
3230   0DEE             
3231   0DF0                                    .ORG $0DF0
3232   0DF0             ;*****************************************************************************
3233   0DF0             ;* Player bullet to alien, collission detection.
3234   0DF0             ;*****************************************************************************
3235   0DF0             L0DF0:
3236   0DF0 01 C4 43                           LD      BC,PlayerBulletState; 
3237   0DF3 21 E6 43                           LD      HL,AbovePlayerBulletMSB; MSB screen ram: One character above player bullet
3238   0DF6 CD 10 0E                           CALL    L0E10               ; 
3239   0DF9 01 C8 43                           LD      BC,AbovePlayerBulletState; 
3240   0DFC 21 EA 43                           LD      HL,M43EA            ; current screen addr of above-bullet
3241   0DFF C3 10 0E                           JP      L0E10               ; check char there for a hit
3242   0E02             
3243   0E10                                    .ORG $0E10
3244   0E10             ;
3245   0E10             L0E10:
3246   0E10 0A                                 LD      A,(BC)              ; get player bullet state
3247   0E11 E6 08                              AND     $08                 ; mask out 0000_1000
3248   0E13 C8                                 RET     Z                   ; if no bullet triggered
3249   0E14 56                                 LD      D,(HL)              ; get MSB screen ram adress
3250   0E15 2C                                 INC     L                   ; 
3251   0E16 5E                                 LD      E,(HL)              ; get LSB screen ram adress
3252   0E17 1A                                 LD      A,(DE)              ; character under the bullet
3253   0E18 FE C0                              CP      $C0                 ; is explosion parts ($C0 - $E3) ?
3254   0E1A D0                                 RET     NC                  ; ignore them.
3255   0E1B FE 60                              CP      $60                 ; is alien in base formation ($60 - $BF) ?
3256   0E1D D8                                 RET     C                   ; below $60 -> NOT a target, ignore
3257   0E1E FE 68                              CP      $68                 ; is alien out of formation ($68 - $BF) ?
3258   0E20 D2 39 0E                           JP      NC,L0E39            ; if yes
3259   0E23 E6 07                              AND     $07                 ; mask out 0000_0111 tile type 0..7 (low 3 bits of char code)
3260   0E25 07                                 RLCA                        ; x2
3261   0E26 07                                 RLCA                        ; x4  -> 4-byte stride
3262   0E27 C6 40                              ADD     $40                 ; 
3263   0E29 6F                                 LD      L,A                 ; 
3264   0E2A 26 17                              LD      H,T1740 >> 8        ; HL = $1740 + type*4
3265   0E2C 03                                 INC     BC                  ; 
3266   0E2D 03                                 INC     BC                  ; 
3267   0E2E 0A                                 LD      A,(BC)              ; get player bullet, coordinate X
3268   0E2F E6 07                              AND     $07                 ; 0000_0111 pixel column within the tile
3269   0E31 BE                                 CP      (HL)                ; vs byte0  (max)
3270   0E32 D0                                 RET     NC                  ; outside -> no hit
3271   0E33 23                                 INC     HL                  ; 2nd byte at T1740
3272   0E34 BE                                 CP      (HL)                ; vs byte1  (min)
3273   0E35 D8                                 RET     C                   ; outside -> no hit
3274   0E36 C3 70 0E                           JP      L0E70               ; 
3275   0E39             
3276   0E39             ;*****************************************************************************
3277   0E39             ;* Player bullet vs FLYING alien (out of formation) collision.
3278   0E39             ;* Entry (from L0E10): BC -> player-bullet structure (state at +0),
3279   0E39             ;*                     bullet X at +2, bullet Y at +3.
3280   0E39             ;* Builds the bullet's target box, then scans all 16 alien slots ($4B70).
3281   0E39             ;*****************************************************************************
3282   0E39             L0E39:
3283   0E39 03                                 INC     BC                  ; +1
3284   0E3A 03                                 INC     BC                  ; +2 -> player bullet X
3285   0E3B 0A                                 LD      A,(BC)              ; get player bullet, coordinate X
3286   0E3C 57                                 LD      D,A                 ; D = bullet X
3287   0E3D 03                                 INC     BC                  ; +3 -> player bullet Y
3288   0E3E 0A                                 LD      A,(BC)              ; get player bullet, coordinate Y
3289   0E3F E6 F8                              AND     $F8                 ; 1111_1000 (snap to character row)
3290   0E41 5F                                 LD      E,A                 ; E = bullet Y (masked)
3291   0E42 21 70 4B                           LD      HL,M4B70            ; alien data structure (16 entries x 4 bytes)
3292   0E45             ;*****************************************************************************
3293   0E45             ;* Scan every alien slot; test the active ones for a hit.
3294   0E45             ;*****************************************************************************
3295   0E45             L0E45:
3296   0E45 7E                                 LD      A,(HL)              ; alien control state A (+0)
3297   0E46 23                                 INC     HL                  ; +1
3298   0E47 23                                 INC     HL                  ; +2 -> alien screen coordinate X
3299   0E48 E6 08                              AND     $08                 ; bit3: alien active / on screen ?
3300   0E4A C4 58 0E                           CALL    NZ,L0E58            ; if active, do the collision test
3301   0E4D 23                                 INC     HL                  ; +3
3302   0E4E 23                                 INC     HL                  ; +4 -> next alien entry
3303   0E4F 3E B0                              LD      A,$B0               ; 
3304   0E51 BD                                 CP      L                   ; reached end of structure ($4BB0) ?
3305   0E52 C2 45 0E                           JP      NZ,L0E45            ; no ... test all 16 aliens
3306   0E55 C9                                 RET                         ; done, no hit
3307   0E56             
3308   0E58                                    .ORG $0E58
3309   0E58             ;*****************************************************************************
3310   0E58             ;* Bounding-box test for one flying alien.
3311   0E58             ;* HL -> alien screen X (+2); D = bullet X, E = bullet Y (masked).
3312   0E58             ;* Box: alienX <= bulletX <= alienX+8  and  alienY-8 < bulletY <= alienY+4.
3313   0E58             ;* If the bullet falls inside that box, it's a hit and control jumps to `L0C00`
3314   0E58             ;* (with `HL` still pointing at the alien's `+2` field),
3315   0E58             ;* which reads the alien's movement pattern phase to choose the score/bonus
3316   0E58             ;* and then routes to `L0EA4` to blow it up.
3317   0E58             ;*****************************************************************************
3318   0E58             L0E58:
3319   0E58 7A                                 LD      A,D                 ; bullet X
3320   0E59 BE                                 CP      (HL)                ; vs alien X
3321   0E5A D8                                 RET     C                   ; bullet left of alien -> miss
3322   0E5B 7E                                 LD      A,(HL)              ; alien X
3323   0E5C C6 08                              ADD     $08                 ; + 8 (alien width)
3324   0E5E BA                                 CP      D                   ; 
3325   0E5F D8                                 RET     C                   ; bullet right of alien -> miss
3326   0E60 23                                 INC     HL                  ; +3 -> alien screen coordinate Y
3327   0E61 7E                                 LD      A,(HL)              ; alien Y
3328   0E62 2B                                 DEC     HL                  ; back to +2
3329   0E63 C6 04                              ADD     $04                 ; alienY + 4 (lower edge)
3330   0E65 BB                                 CP      E                   ; 
3331   0E66 D8                                 RET     C                   ; bullet below the box -> miss
3332   0E67 D6 0C                              SUB     $0C                 ; (alienY+4) - $0C = alienY - 8 (upper edge)
3333   0E69 BB                                 CP      E                   ; 
3334   0E6A D0                                 RET     NC                  ; bullet above the box -> miss
3335   0E6B C3 00 0C                           JP      L0C00               ; HIT -> pick score/bonus, then destroy
3336   0E6E             
3337   0E70                                    .ORG $0E70
3338   0E70             ;
3339   0E70             L0E70:
3340   0E70 23                                 INC     HL                  ; -> byte2 at T1740
3341   0E71 0A                                 LD      A,(BC)              ; get player bullet, coordinate X
3342   0E72 E6 F8                              AND     $F8                 ; 1111_1000 cell-aligned X
3343   0E74 86                                 ADD     A,(HL)              ; + byte2 (signed: $F8=-8, $FA=-6, $02=+2, ...)
3344   0E75 57                                 LD      D,A                 ; target X for the alien-table search
3345   0E76 03                                 INC     BC                  ; 
3346   0E77 0A                                 LD      A,(BC)              ; get player bullet, coordinate Y
3347   0E78 E6 F8                              AND     $F8                 ; 1111_1000
3348   0E7A 5F                                 LD      E,A                 ; save it in E
3349   0E7B 21 70 4B                           LD      HL,M4B70            ; 
3350   0E7E             L0E7E:
3351   0E7E 7E                                 LD      A,(HL)              ; get alien control state A
3352   0E7F 23                                 INC     HL                  ; 
3353   0E80 23                                 INC     HL                  ; 
3354   0E81 E6 08                              AND     $08                 ; 0000_1000
3355   0E83 C4 90 0E                           CALL    NZ,L0E90            ; if bit3 is set
3356   0E86 23                                 INC     HL                  ; 
3357   0E87 23                                 INC     HL                  ; 
3358   0E88 3E B0                              LD      A,$B0               ; 
3359   0E8A BD                                 CP      L                   ; 
3360   0E8B C2 7E 0E                           JP      NZ,L0E7E            ; loop over alien data structure.
3361   0E8E C9                                 RET                         ; 
3362   0E8F             
3363   0E90                                    .ORG $0E90
3364   0E90             ;
3365   0E90             L0E90:
3366   0E90 7E                                 LD      A,(HL)              ; get alien screen coordinate X
3367   0E91 C6 02                              ADD     $02                 ; 
3368   0E93 BA                                 CP      D                   ; with masked player bullet, coordinate X
3369   0E94 D8                                 RET     C                   ; 
3370   0E95 D6 05                              SUB     $05                 ; 
3371   0E97 BA                                 CP      D                   ; 
3372   0E98 D0                                 RET     NC                  ; 
3373   0E99 23                                 INC     HL                  ; 
3374   0E9A 7E                                 LD      A,(HL)              ; get alien screen coordinate Y
3375   0E9B 2B                                 DEC     HL                  ; move to alien screen coordinate X
3376   0E9C E6 F8                              AND     $F8                 ; 1111_1000
3377   0E9E BB                                 CP      E                   ; with masked player bullet, coordinate Y
3378   0E9F C0                                 RET     NZ                  ; if not equal
3379   0EA0 11 02 0C                           LD      DE,$0C02            ; animation index / bonus explosion score 020.
3380   0EA3 00                                 NOP                         ; 
3381   0EA4             ;*****************************************************************************
3382   0EA4             ;* Kill with the bonus values.
3383   0EA4             ;* `L0EA4` is the common "enemy destroyed" routine:
3384   0EA4             ;* It clears the bullet's and alien's active bits, finds a free bonus explosion animation slot (`$4378`/`$4370`),
3385   0EA4             ;* and uses `D` as the animation index and `E` as the score value.
3386   0EA4             ;* (Compare the sibling entry `L0EA0: LD DE,$0C02` used for in formation kills — same mechanism, different score/anim.)
3387   0EA4             ;*****************************************************************************
3388   0EA4             L0EA4:
3389   0EA4 2B                                 DEC     HL                  ; 
3390   0EA5 2B                                 DEC     HL                  ; 
3391   0EA6 0B                                 DEC     BC                  ; 
3392   0EA7 0B                                 DEC     BC                  ; 
3393   0EA8 0B                                 DEC     BC                  ; 
3394   0EA9 0A                                 LD      A,(BC)              ; get player bullet, control state
3395   0EAA E6 F7                              AND     $F7                 ; 1111_0111
3396   0EAC 02                                 LD      (BC),A              ; clear bit3
3397   0EAD             L0EAD:
3398   0EAD 7E                                 LD      A,(HL)              ; get alien control state A
3399   0EAE E6 F7                              AND     $F7                 ; 1111_0111
3400   0EB0 77                                 LD      (HL),A              ; clear bit3
3401   0EB1 7D                                 LD      A,L                 ; 
3402   0EB2 C6 42                              ADD     $42                 ; move to MSB screen ram adress alien
3403   0EB4 6F                                 LD      L,A                 ; 
3404   0EB5 46                                 LD      B,(HL)              ; get MSB screen ram adress alien
3405   0EB6 23                                 INC     HL                  ; 
3406   0EB7 4E                                 LD      C,(HL)              ; get LSB screen ram adress alien
3407   0EB8 21 78 43                           LD      HL,M4378            ; Animation counter for the bonus explosion
3408   0EBB 7A                                 LD      A,D                 ; 
3409   0EBC FE 10                              CP      $10                 ; 
3410   0EBE CA C3 0E                           JP      Z,L0EC3             ; 
3411   0EC1 2E 70                              LD      L,$70               ; 
3412   0EC3             L0EC3:
3413   0EC3 7E                                 LD      A,(HL)              ; get explosion slot0 animation index
3414   0EC4 A7                                 AND     A                   ; updates the zero flag
3415   0EC5 CA D5 0E                           JP      Z,L0ED5             ; if explosion slot0 is free.
3416   0EC8 2C                                 INC     L                   ; 
3417   0EC9 2C                                 INC     L                   ; 
3418   0ECA 2C                                 INC     L                   ; 
3419   0ECB 2C                                 INC     L                   ; 
3420   0ECC 7E                                 LD      A,(HL)              ; 
3421   0ECD A7                                 AND     A                   ; updates the zero flag
3422   0ECE CA D5 0E                           JP      Z,L0ED5             ; 
3423   0ED1 2C                                 INC     L                   ; 
3424   0ED2 2C                                 INC     L                   ; 
3425   0ED3 2C                                 INC     L                   ; 
3426   0ED4 2C                                 INC     L                   ; 
3427   0ED5             L0ED5:
3428   0ED5 72                                 LD      (HL),D              ; set explosion animation index
3429   0ED6 2C                                 INC     L                   ; 
3430   0ED7 73                                 LD      (HL),E              ; set BCD score value
3431   0ED8 2C                                 INC     L                   ; 
3432   0ED9 70                                 LD      (HL),B              ; set explosion MSB screen ram
3433   0EDA 2C                                 INC     L                   ; 
3434   0EDB 71                                 LD      (HL),C              ; set explosion LSB screen ram
3435   0EDC 2E 64                              LD      L,$64               ; 
3436   0EDE 36 FF                              LD      (HL),$FF            ; set flag for: 'Enemy hit detected'
3437   0EE0 2E BA                              LD      L,$BA               ; AliensLeft
3438   0EE2 35                                 DEC     (HL)                ; decrement it
3439   0EE3 E1                                 POP     HL                  ; discard one return address
3440   0EE4 E1                                 POP     HL                  ; pop the NEXT return address into HL
3441   0EE5 E9                                 JP      (HL)                ; jump to it -> $0DF9, $0027, $2199, $2006
3442   0EE6             
3443   0F00                                    .ORG $0F00
3444   0F00             ;*****************************************************************************
3445   0F00             ;* 'Alien with player' collision check.
3446   0F00             ;* MAME cheat code "Invisibility for aliens": Set $0F00 to $C9 (RET)
3447   0F00             ;* Uses a 2x2 box normally; a 4x4 box when the shield/explosion state is high.
3448   0F00             ;* This is the counterpart to the bullet vs alien check:
3449   0F00             ;* It asks "has a diving alien run into the player's ship?".
3450   0F00             ;* - Box size depends on the shield (`ShieldCount`, `$43A6`).
3451   0F00             ;*   If it's below `$C0`, `L0F00` uses a 2×2 collision box around the ship.
3452   0F00             ;*   If it's `$C0` or higher (shield up / ship showing explosion tiles),
3453   0F00             ;*   it branches to `L0F74`, which uses a larger 4×4 box and a wider vertical band.
3454   0F00             ;* - `L0F56` is the fast screen test.
3455   0F00             ;*   Given the ship's screen address and a `cols × rows` size,
3456   0F00             ;*   It reads each character cell the ship occupies.
3457   0F00             ;*   If any cell holds an alien glyph (`$60`–`$BF`) it immediately jumps to `L0CF4`
3458   0F00             ;*   to handle the player being hit.
3459   0F00             ;*   If it walks the whole box with no alien, it returns with `Z` set ("no collision").
3460   0F00             ;* - `L0F38` / `L0FA6` identify and kill the offending alien.
3461   0F00             ;*   After a collision is detected, the caller derives the ship's horizontal bounds (`B`,`C`)
3462   0F00             ;*   and scans all 16 alien slots at `$4B70`. For each active alien
3463   0F00             ;*   it checks that the alien's Y is in the player's bottom band
3464   0F00             ;*   (small box `($D2,$E7)`, big box `($CA,$EF)`) and its X overlaps the ship (`B ≤ X < C`).
3465   0F00             ;*   On a match it loads the animation/score values into `DE` (`$0D04` small, `$0D02` big),
3466   0F00             ;*   rewinds `HL` to the alien's control byte, and jumps to `L0EAD`
3467   0F00             ;*   (the shared "enemy destroyed" tail, same one used by the bullet kill path) to blow the alien up.
3468   0F00             ;*****************************************************************************
3469   0F00             L0F00:
3470   0F00 21 A6 43                           LD      HL,ShieldCount      ; 
3471   0F03 7E                                 LD      A,(HL)              ; 
3472   0F04 FE C0                              CP      $C0                 ; 
3473   0F06 D2 74 0F                           JP      NC,L0F74            ; ShieldCount >= $C0 -> big-box path (fg all explosion parts)
3474   0F09 2E E2                              LD      L,$E2               ; 
3475   0F0B 56                                 LD      D,(HL)              ; D = $43E2 PlayerShipMSB
3476   0F0C 2C                                 INC     L                   ; 
3477   0F0D 5E                                 LD      E,(HL)              ; E = $43E3 PlayerShipLSB  (DE = ship screen addr)
3478   0F0E 01 02 02                           LD      BC,$0202            ; 2x2 image (B=cols, C=rows)
3479   0F11 CD 56 0F                           CALL    L0F56               ; scan ship cells for an alien char
3480   0F14 C8                                 RET     Z                   ; no collision -> done
3481   0F15 00                                 NOP                         ; (patched-out code)
3482   0F16 00                                 NOP                         ; 
3483   0F17 21 9E 43                           LD      HL,M439E            ; mapped player ship position, left part ($09..$C0)
3484   0F1A 7E                                 LD      A,(HL)              ; 
3485   0F1B D6 06                              SUB     $06                 ; 
3486   0F1D 47                                 LD      B,A                 ; B = ship left X bound
3487   0F1E 2C                                 INC     L                   ; 
3488   0F1F 4E                                 LD      C,(HL)              ; C = $439F ship right X bound
3489   0F20 21 70 4B                           LD      HL,M4B70            ; alien data structure
3490   0F23             L0F23:
3491   0F23 7E                                 LD      A,(HL)              ; alien control state (+0)
3492   0F24 2C                                 INC     L                   ; +1
3493   0F25 2C                                 INC     L                   ; +2 -> alien screen X
3494   0F26 E6 08                              AND     $08                 ; 0000_1000 alien active ?
3495   0F28 C4 38 0F                           CALL    NZ,L0F38            ; if so, position-match test
3496   0F2B 2C                                 INC     L                   ; +3
3497   0F2C 2C                                 INC     L                   ; +4 -> next entry
3498   0F2D 3E B0                              LD      A,$B0               ; 
3499   0F2F BD                                 CP      L                   ; end of 16 aliens ?
3500   0F30 C2 23 0F                           JP      NZ,L0F23            ; 
3501   0F33 C9                                 RET                         ; 
3502   0F34             
3503   0F38                                    .ORG $0F38
3504   0F38             ;*****************************************************************************
3505   0F38             ;* Find the specific colliding alien (small box). HL -> alien screen X (+2).
3506   0F38             ;* B/C = ship X bounds. Alien Y must be in the bottom band ($D2,$E7).
3507   0F38             ;*****************************************************************************
3508   0F38             L0F38:
3509   0F38 2C                                 INC     L                   ; +3 -> alien screen Y
3510   0F39 7E                                 LD      A,(HL)              ; alien Y
3511   0F3A 2D                                 DEC     L                   ; back to +2
3512   0F3B FE D2                              CP      $D2                 ; 
3513   0F3D D8                                 RET     C                   ; alien above player band -> skip
3514   0F3E FE E7                              CP      $E7                 ; 
3515   0F40 D0                                 RET     NC                  ; alien below band -> skip
3516   0F41 7E                                 LD      A,(HL)              ; alien X (+2)
3517   0F42 B9                                 CP      C                   ; 
3518   0F43 D0                                 RET     NC                  ; alien right of ship -> skip
3519   0F44 B8                                 CP      B                   ; 
3520   0F45 D8                                 RET     C                   ; alien left of ship -> skip
3521   0F46 CD C4 0C                           CALL    L0CC4               ; register the player collision
3522   0F49 11 04 0D                           LD      DE,$0D04            ; D=$0D anim index, E=$04 score selector
3523   0F4C 2B                                 DEC     HL                  ; 
3524   0F4D 2B                                 DEC     HL                  ; HL -> alien entry +0
3525   0F4E C3 AD 0E                           JP      L0EAD               ; destroy this alien
3526   0F51             
3527   0F56                                    .ORG $0F56
3528   0F56             ;*****************************************************************************
3529   0F56             ;* 'Alien with player' collision check.
3530   0F56             ;* All parts of the player ship object are checked for a collision with aliens.
3531   0F56             ;*****************************************************************************
3532   0F56             L0F56:
3533   0F56 C5                                 PUSH    BC                  ;
3534   0F57 D5                                 PUSH    DE                  ;
3535   0F58             L0F58:
3536   0F58 1A                                 LD      A,(DE)              ; character at a ship cell
3537   0F59 FE 60                              CP      $60                 ; alien chars are $60..$BF
3538   0F5B DA 63 0F                           JP      C,L0F63             ; < $60 : not an alien here
3539   0F5E FE C0                              CP      $C0                 ;
3540   0F60 DA F4 0C                           JP      C,L0CF4             ; $60..$BF : collision -> handle player hit
3541   0F63             L0F63:
3542   0F63 13                                 INC     DE                  ; next cell (right)
3543   0F64 05                                 DEC     B                   ;
3544   0F65 C2 58 0F                           JP      NZ,L0F58            ; across B columns
3545   0F68 D1                                 POP     DE                  ;
3546   0F69 C1                                 POP     BC                  ;
3547   0F6A CD 17 02                           CALL    RightOneColumn      ; step down to the next ship row
3548   0F6D 0D                                 DEC     C                   ;
3549   0F6E C2 56 0F                           JP      NZ,L0F56            ; for all C rows
3550   0F71 C9                                 RET                         ; Z set = no collision
3551   0F72             
3552   0F74                                    .ORG $0F74
3553   0F74             ;*****************************************************************************
3554   0F74             ;* Big-box variant: used when ShieldCount >= $C0 (4x4 box, wider Y band).
3555   0F74             ;*****************************************************************************
3556   0F74             L0F74:
3557   0F74 2E E2                              LD      L,$E2               ; PlayerShipMSB
3558   0F76 56                                 LD      D,(HL)              ; 
3559   0F77 2C                                 INC     L                   ; PlayerShipLSB
3560   0F78 5E                                 LD      E,(HL)              ; 
3561   0F79 CD 17 02                           CALL    RightOneColumn      ; shift to top-left of the 4x4 box
3562   0F7C 1B                                 DEC     DE                  ; 
3563   0F7D 01 04 04                           LD      BC,$0404            ; 4x4 image
3564   0F80 CD 56 0F                           CALL    L0F56               ; scan the enlarged ship area
3565   0F83 C8                                 RET     Z                   ; no collision -> done
3566   0F84 00                                 NOP                         ; (patched-out code)
3567   0F85 00                                 NOP                         ; 
3568   0F86 3A C2 43                           LD      A,(PlayerShipX)     ; {ram.PlayerShipX}
3569   0F89 D6 0E                              SUB     $0E                 ; 
3570   0F8B 47                                 LD      B,A                 ; B = ship left X bound
3571   0F8C C6 2D                              ADD     $2D                 ; 
3572   0F8E 4F                                 LD      C,A                 ; C = ship right X bound
3573   0F8F 21 70 4B                           LD      HL,M4B70            ; alien data structure
3574   0F92             L0F92:
3575   0F92 7E                                 LD      A,(HL)              ; alien control state (+0)
3576   0F93 2C                                 INC     L                   ; +1
3577   0F94 2C                                 INC     L                   ; +2 -> alien screen X
3578   0F95 E6 08                              AND     $08                 ; 0000_1000 active ?
3579   0F97 C4 A6 0F                           CALL    NZ,L0FA6            ; position-match test (big box)
3580   0F9A 2C                                 INC     L                   ; +3
3581   0F9B 2C                                 INC     L                   ; +4 -> next entry
3582   0F9C 3E B0                              LD      A,$B0               ; 
3583   0F9E BD                                 CP      L                   ; end of 16 aliens ?
3584   0F9F C2 92 0F                           JP      NZ,L0F92            ; 
3585   0FA2 C9                                 RET                         ; 
3586   0FA3             
3587   0FA6                                    .ORG $0FA6
3588   0FA6             ;*****************************************************************************
3589   0FA6             ;* Find the specific colliding alien (big box). Y band ($CA,$EF).
3590   0FA6             ;*****************************************************************************
3591   0FA6             L0FA6:
3592   0FA6 2C                                 INC     L                   ; +3 -> alien screen Y
3593   0FA7 7E                                 LD      A,(HL)              ; alien Y
3594   0FA8 2D                                 DEC     L                   ; back to +2
3595   0FA9 FE CA                              CP      $CA                 ; 
3596   0FAB D8                                 RET     C                   ; above band -> skip
3597   0FAC FE EF                              CP      $EF                 ; 
3598   0FAE D0                                 RET     NC                  ; below band -> skip
3599   0FAF 7E                                 LD      A,(HL)              ; alien X (+2)
3600   0FB0 B9                                 CP      C                   ; 
3601   0FB1 D0                                 RET     NC                  ; right of ship -> skip
3602   0FB2 B8                                 CP      B                   ; 
3603   0FB3 D8                                 RET     C                   ; left of ship -> skip
3604   0FB4 11 02 0D                           LD      DE,$0D02            ; D=$0D anim index, E=$02 score selector
3605   0FB7 2B                                 DEC     HL                  ; 
3606   0FB8 2B                                 DEC     HL                  ; HL -> alien entry +0
3607   0FB9 C3 AD 0E                           JP      L0EAD               ; destroy this alien
3608   0FBC             
3609   0FC0                                    .ORG $0FC0
3610   0FC0             ;*****************************************************************************
3611   0FC0             ;* Handle animations for killed aliens.
3612   0FC0             ;* Services 4 explosion slots (4-byte records at $4370/$4374/$4378/$437C):
3613   0FC0             ;*   +0 = animation counter (0 = slot free)
3614   0FC0             ;*   +1 = unused
3615   0FC0             ;*   +2 = screen-RAM MSB
3616   0FC0             ;*   +3 = screen-RAM LSB
3617   0FC0             ;* Slots 0/1 are ordinary alien explosions (L0FD8); slots 2/3 use L3758
3618   0FC0             ;* (the bonus-explosion animator).
3619   0FC0             ;*****************************************************************************
3620   0FC0             L0FC0:
3621   0FC0 21 70 43                           LD      HL,M4370            ; explosion slot 0
3622   0FC3 CD D8 0F                           CALL    L0FD8               ; advance alien explosion
3623   0FC6 21 74 43                           LD      HL,M4374            ; explosion slot 1
3624   0FC9 CD D8 0F                           CALL    L0FD8               ; advance alien explosion
3625   0FCC 21 78 43                           LD      HL,M4378            ; slot 2 (bonus explosion counter)
3626   0FCF CD 58 37                           CALL    L3758               ; advance bonus explosion
3627   0FD2 21 7C 43                           LD      HL,M437C            ; slot 3 (bonus explosion)
3628   0FD5 C3 58 37                           JP      L3758               ; advance bonus explosion (tail-call)
3629   0FD8             
3630   0FD8             ;*****************************************************************************
3631   0FD8             ;* Advance and draw one alien-explosion slot.
3632   0FD8             ;* HL -> slot record (+0 = counter). Returns immediately if the slot is idle.
3633   0FD8             ;*****************************************************************************
3634   0FD8             L0FD8:
3635   0FD8 7E                                 LD      A,(HL)              ; animation counter (+0)
3636   0FD9 A7                                 AND     A                   ; set zero flag
3637   0FDA C8                                 RET     Z                   ; slot free -> nothing to do
3638   0FDB 46                                 LD      B,(HL)              ; B = current counter value
3639   0FDC 35                                 DEC     (HL)                ; advance the animation (count down)
3640   0FDD 2C                                 INC     L                   ; +1 (unused)
3641   0FDE 2C                                 INC     L                   ; +2
3642   0FDF 56                                 LD      D,(HL)              ; D = screen-RAM MSB
3643   0FE0 2C                                 INC     L                   ; +3
3644   0FE1 5E                                 LD      E,(HL)              ; E = screen-RAM LSB (DE = draw position)
3645   0FE2 00                                 NOP                         ; 
3646   0FE3 CD 10 02                           CALL    LeftOneColumn       ; nudge the draw origin
3647   0FE6 78                                 LD      A,B                 ; counter value
3648   0FE7 E6 0E                              AND     $0E                 ; 0000_1110 keep even bits (0,2,4,...,14)
3649   0FE9 0F                                 RRCA                        ; /2 -> frame index 0..7
3650   0FEA C6 B0                              ADD     $B0                 ; -> LSB of T17B0 sequence table
3651   0FEC 6F                                 LD      L,A                 ; 
3652   0FED 26 17                              LD      H,$17               ; HL = $17B0 + frame index
3653   0FEF 6E                                 LD      L,(HL)              ; L = LSB of the explosion frame image
3654   0FF0 EB                                 EX      DE,HL               ; HL = frame image ($17xx), DE = screen pos
3655   0FF1 01 DF FF                           LD      BC,$FFDF            ; Screen offset constant -33 right one column (-1), up one row (-32)
3656   0FF4 C3 40 35                           JP      Draw3x2             ; draw the 3x2 explosion frame
3657   0FF7             
3658   1000                                    .ORG $1000
3659   1000             ;*****************************************************************************
3660   1000             ; ic47
3661   1000             ;*****************************************************************************
3662   1000             
3663   1000             ; Pointer table to alien movement list (T1700):
3664   1000             ; Value * 2 ==> LSB of T1700
3665   1000             ; This is the default movement pattern for the alien formation:
3666   1000             ; Right, right, right, right, left, left, left, left,
3667   1000             ; left, left, left, left, right, right, right, right,
3668   1000             ; end mark. Used at phase 0, 1, 2 and 3.
3669   1000             T1000:
3670   1000 01 01 01 01                        .DB $01, $01, $01, $01, $02, $02, $02, $02
3670   1004 02 02 02 02 
3671   1008 02 02 02 02                        .DB $02, $02, $02, $02, $01, $01, $01, $01
3671   100C 01 01 01 01 
3672   1010 00                                 .DB $00
3673   1011             ; not used
3674   1011 FF FF FF FF                        .DB $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF
3674   1015 FF FF FF FF 
3675   1019 FF FF FF FF                        .DB $FF, $FF, $FF, $FF, $FF, $FF, $FF
3675   101D FF FF FF 
3676   1020             
