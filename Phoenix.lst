1570   0568 00 50 00 D0                        .DB $00, $50, $00, $D0       ; AbovePlayerBulletState, AbovePlayerBulletShape, AbovePlayerBulletX, AbovePlayerBulletY
1571   056C 00 58 00 20                        .DB $00, $58, $00, $20       ; AlienBullet0State, AlienBullet0Shape, AlienBullet0X, AlienBullet0Y
1572   0570 00 58 00 20                        .DB $00, $58, $00, $20       ; AlienBullet1State, AlienBullet1Shape, AlienBullet1X, AlienBullet1Y
1573   0574 00 58 00 20                        .DB $00, $58, $00, $20       ; AlienBullet2State, AlienBullet2Shape, AlienBullet2X, AlienBullet2Y
1574   0578 00 58 00 20                        .DB $00, $58, $00, $20       ; AlienBullet3State, AlienBullet3Shape, AlienBullet3X, AlienBullet3Y
1575   057C 00 58 00 20                        .DB $00, $58, $00, $20       ; AlienBullet4State, AlienBullet4Shape, AlienBullet4X, AlienBullet4Y
