0477   0000             B4BC2                  .EQU $4BC2       ;saved PlayerBulletX
0478   0000             B4BC3                  .EQU $4BC3       ;saved PlayerBulletY
0479   0000             B4BC4                  .EQU $4BC4       ;saved AbovePlayerBulletMSB
0480   0000             B4BC5                  .EQU $4BC5       ;saved AbovePlayerBulletLSB
0481   0000             
0482   0000             B4BD1                  .EQU $4BD1       ;Descent turnaround depth threshold (formation reverses when `$4BD2` passes it)
0483   0000             B4BD2                  .EQU $4BD2       ;Vertical scroll phase 0–31 of the bird formation (derived from `CounterB9`; master index) (0..31)
0484   0000             B4BD3                  .EQU $4BD3       ;Countdown timer between bird attack launches
0485   0000             B4BD4                  .EQU $4BD4       ;Attack sub-pattern selector (0–3, from random `$436F`) for one of four attack variants
0486   0000             B4BD5                  .EQU $4BD5       ;Descent step/speed value (feeds the `$3ED0` dither scroll rate)
0487   0000             B4BD6                  .EQU $4BD6       ;Combined scroll-phase + active-bird center index (indexes `$3EE0` curve & `T3DE0` sound)
0488   0000             B4BD7                  .EQU $4BD7       ;Active-bird vertical spread — computed but not consumed (vestigial)
0489   0000             
0490   0000             B4BED                  .EQU $4BED       ;Unused RAM (cleared at level init, never referenced)
0491   0000             B4BEE                  .EQU $4BEE       ;Unused RAM (cleared at level init, never referenced)
0492   0000             B4BEF                  .EQU $4BEF       ;Unused RAM (cleared at level init, never referenced)
0493   0000             
0494   0000             ; Stack
0495   0000             Stack                  .EQU $4BF0       ;Stack space 4BF0:4BFF
0496   0000             
0497   0000             ;HW
0498   0000             videoRegister          .EQU $5000       ;Lower bit selects the RAM bank
0499   0000             scrollRegister         .EQU $5800       ;Screen scrolling
0500   0000             SOUNDCTLA              .EQU $6000       ;Sound control A
0501   0000             SOUNDCTLB              .EQU $6800       ;Sound control B
0502   0000             IN0                    .EQU $7000       ;Player inputs
0503   0000             DSW0                   .EQU $7800       ;DIP switch settings
0504   0000             
0505   0000                                    .ORG $0000
0506   0000             ;*****************************************************************************
0507   0000             ; ic45
0508   0000             ;*****************************************************************************
0509   0000             
0510   0000             ;*****************************************************************************
0511   0000             ;* Initialization
0512   0000             ;*****************************************************************************
0513   0000             L0000:
0514   0000 00                                 NOP                         ; Start/restart and interrupts end up at 0008
0515   0001 00                                 NOP                         ;
0516   0002 00                                 NOP                         ;
0517   0003 00                                 NOP                         ;
0518   0004 00                                 NOP                         ;
0519   0005 00                                 NOP                         ;
0520   0006 00                                 NOP                         ;
0521   0007 00                                 NOP                         ;
0522   0008             ; 
0523   0008 31 FF 4B                           LD      SP,$4BFF            ; Top-ish of RAM
0524   000B 26 50                              LD      H,videoRegister >> 8
0525   000D 36 00                              LD      (HL),$00            ; Select the first bank of RAM
0526   000F CD 50 00                           CALL    InitSoundScreen     ; Turn sound off and clear both screen areas
0527   0012 21 00 18                           LD      HL,T1800            ; Screen draw info
0528   0015 0E 03                              LD      C,$03               ; 3 columns (rotated to 3 rows)
0529   0017 CD D0 01                           CALL    PrintTextLines      ; Draw the first 3 rows of the background (scores and coins)
0530   001A             
0531   001A             ;*****************************************************************************
0532   001A             ;* Main loop begin
0533   001A             ;*****************************************************************************
0534   001A             MainLoop:
0535   001A CD 80 00                           CALL    WaitVBlankCoin      ; Wait for VBlank and count any coins
0536   001D 3A A2 43                           LD      A,(GameOrAttract)   ;
0537   0020 A7                                 AND     A                   ; updates the zero flag
0538   0021 CA 2D 00                           JP      Z,L002D             ; if 'Attract mode'
0539   0024             ; Game mode
0540   0024 CD 00 04                           CALL    GameStateMachine    ; controls the flow of the game.
0541   0027 CD 00 27                           CALL    UpdateScoresAndSound
0542   002A C3 1A 00                           JP      MainLoop            ; Back to top of main loop
0543   002D             ; Attract mode (no sound, no scoreing, no manual steering)
0544   002D             L002D:
0545   002D 3E 0F                              LD      A,$0F               ; 0000_1111 mute the sound chip TMS36XX
0546   002F 26 60                              LD      H,SOUNDCTLA >> 8    ; 60xx sound A
0547   0031 77                                 LD      (HL),A              ;
0548   0032 26 68                              LD      H,SOUNDCTLB >> 8    ; 68xx sound B
0549   0034 77                                 LD      (HL),A              ;
0550   0035 CD 77 03                           CALL    UpdateSoundControlRAM
0551   0038 00                                 NOP                         ;
0552   0039 CD E0 17                           CALL    CoinChecking        ; Converts raw `CoinCount` into playable credits, applying the coinage DIP on `DSW0`
0553   003C A7                                 AND     A                   ; updates the zero flag
0554   003D CA 46 00                           JP      Z,L0046             ; No credits ... continue splash
0555   0040 CD 88 02                           CALL    PromptForStartGame  ;
0556   0043 C3 1A 00                           JP      MainLoop            ; Back to top of main loop
0557   0046             ; Continue splash 
0558   0046             L0046:
0559   0046 CD E3 00                           CALL    SplashAndDemo       ;
0560   0049 C3 1A 00                           JP      MainLoop            ; Back to top of main loop
0561   004C             ;*****************************************************************************
0562   004C             ;* Main loop end
0563   004C             ;*****************************************************************************
0564   004C             
0565   0050                                    .ORG $0050
0566   0050             ;*****************************************************************************
0567   0050             ;* Initialize the sound (off) and screen (clear)
0568   0050             ;*****************************************************************************
0569   0050             InitSoundScreen:
0570   0050 26 68                              LD      H,SOUNDCTLB >> 8    ; 68xx sound B
0571   0052 36 00                              LD      (HL),$00            ; Sound off
0572   0054 26 60                              LD      H,SOUNDCTLA >> 8    ; 60xx sound A
0573   0056 36 00                              LD      (HL),$00            ; Sound off
0574   0058 26 58                              LD      H,scrollRegister >> 8
0575   005A 36 00                              LD      (HL),$00            ; First memory bank
0576   005C CD 6B 00                           CALL    ClearRAMBank        ; Clear the bank (includes screen)
0577   005F 26 50                              LD      H,videoRegister >> 8
0578   0061 36 01                              LD      (HL),$01            ; Second memory bank
0579   0063 CD 6B 00                           CALL    ClearRAMBank        ; Clear the bank (includes screen)
0580   0066 26 50                              LD      H,videoRegister >> 8
0581   0068 36 00                              LD      (HL),$00            ; Back to first memory bank
0582   006A C9                                 RET                         ; Done
0583   006B             
0584   006B             ;*****************************************************************************
0585   006B             ;* Clear a RAM Bank (bank 0 or 1)
0586   006B             ;* Set the lower bit of the video register to pick the bank before calling.
0587   006B             ;* 4000 - 4BF8
0588   006B             ;* We call this function, which means we don't want to clear the return on the stack.
0589   006B             ;* That's why we start clearing at 4BF8 instead of 4BFF.
0590   006B             ;* Since screen memory is part of this bank, we are clearing the screen too.
0591   006B             ;*****************************************************************************
0592   006B             ClearRAMBank:
0593   006B 21 F8 4B                           LD      HL,$4BF8            ; Highest point ... skip the top of the stack
0594   006E 3E 3F                              LD      A,$3F               ; Stop when H reaches 3F
0595   0070             L0070:
0596   0070 36 00                              LD      (HL),$00            ; Clear the memory
0597   0072 2B                                 DEC     HL                  ; Point to next
0598   0073 BC                                 CP      H                   ; All done?
0599   0074 C2 70 00                           JP      NZ,L0070            ; No ... go back for all
0600   0077 C9                                 RET                         ; Done
0601   0078             
0602   0078             ;*****************************************************************************
0603   0078             ;* Slow printing the static texts and filling the scroll register
0604   0078             ;* with background tiles.
0605   0078             ;* Only used at attract mode during the intro splash.
0606   0078             ;*****************************************************************************
0607   0078             SlowPrintScrollRegisterUpdate:
0608   0078 CD 96 01                           CALL    SlowPrintScoreAverageTable
0609   007B C3 F0 06                           JP      L06F0               ; update scroll register and fill background
0610   007E             
0611   0080                                    .ORG $0080
0612   0080             ;*****************************************************************************
0613   0080             ;* Wait for the vertical blanking and then handle coin counting
0614   0080             ;*****************************************************************************
0615   0080             WaitVBlankCoin:
0616   0080 26 78                              LD      H,DSW0 >> 8         ; 78xx DSW0 Check ...
0617   0082 7E                                 LD      A,(HL)              ; ... screen blanking flag
0618   0083 E6 80                              AND     $80                 ; Wait for it ...
0619   0085 CA 80 00                           JP      Z,WaitVBlankCoin    ; ... to set
0620   0088             ; 
0621   0088             L0088:
0622   0088 7E                                 LD      A,(HL)              ; Check screen blanking flag
0623   0089 E6 80                              AND     $80                 ; Wait for it ...
0624   008B C2 88 00                           JP      NZ,L0088            ; ... to clear (0=in blanking)
0625   008E 26 70                              LD      H,IN0 >> 8          ; 70xx IN0 Current value ...
0626   0090 7E                                 LD      A,(HL)              ; ... of IN0 inputs
0627   0091 21 A0 43                           LD      HL,IN0Current       ; Value from ...
0628   0094 46                                 LD      B,(HL)              ; ... last read
0629   0095 77                                 LD      (HL),A              ; Store new value
0630   0096 2C                                 INC     L                   ; To 43A1
0631   0097 70                                 LD      (HL),B              ; Store old value
0632   0098 2E 9B                              LD      L,$9B               ; Bump the ...
0633   009A CD 00 02                           CALL    AddOneToMem         ; ... ?? counter
0634   009D 2E 8F                              LD      L,$8F               ; Get number ...
0635   009F 7E                                 LD      A,(HL)              ; ... of coins
0636   00A0             ;
0637   00A0             ; !! There are two digits for "coins" on the screen, but only the one's digit is
0638   00A0             ; !! changed. Once you get to 9, the code stops counting. It takes the coin
0639   00A0             ; !! from you, but it doesn't give you credit.
0640   00A0             ;
0641   00A0 FE 09                              CP      $09                 ; Already 9?
0642   00A2 C8                                 RET     Z                   ; Yes ... nothing more to check
0643   00A3 D2 00 00                           JP      NC,L0000            ; More than 9? OOPS -- soft reset
0644   00A6 06 01                              LD      B,$01               ; Coin bit of the input register
0645   00A8 CD BB 00                           CALL    CheckInputBits      ; Has the coin input gone from 1 to 0?
0646   00AB C8                                 RET     Z                   ; No ... no coins inserted ... done
0647   00AC 2E 8F                              LD      L,$8F               ; Add one ...
0648   00AE 34                                 INC     (HL)                ; ... to coin count
0649   00AF 7E                                 LD      A,(HL)              ; Current value ...
0650   00B0 C6 20                              ADD     $20                 ; ... to number tile
0651   00B2 32 42 41                           LD      ($4142),A           ; Change number of coins on screen
0652   00B5 C9                                 RET                         ; Done
0653   00B6             
0654   00BB                                    .ORG $00BB
0655   00BB             ;*****************************************************************************
0656   00BB             ;* Check to see if a particular bit(s) in the input register has changed
0657   00BB             ;* from 1 to 0 since last we checked. Return NZ if transitioned from 1 to 0.
0658   00BB             ;*****************************************************************************
0659   00BB             CheckInputBits:
0660   00BB 21 A0 43                           LD      HL,IN0Current       ; Get current ...
0661   00BE 7E                                 LD      A,(HL)              ; ... input value
0662   00BF 2F                                 CPL                         ; Flip the current bits
0663   00C0 A0                                 AND     B                   ; Mask off all but the ones we are checking
0664   00C1 2C                                 INC     L                   ; Point to last input value
0665   00C2 A6                                 AND     (HL)                ; Zero unles new bit is 0 and old is 1
0666   00C3 C9                                 RET                         ; Return state
0667   00C4             
0668   00C4             ;*****************************************************************************
0669   00C4             ;* Prints the number pointed to by HL (points to the end of the number) to the screen pointed
0670   00C4             ;* to by DE (points to the end of the screen area). B is the number of digits to print.
0671   00C4             ;*****************************************************************************
0672   00C4             PrintNumber:
0673   00C4 7E                                 LD      A,(HL)              ; Get the two digits
0674   00C5 E6 0F                              AND     $0F                 ; Keep the LSB
0675   00C7 F6 20                              OR      $20                 ; Offset to number tile
0676   00C9 12                                 LD      (DE),A              ; Store the number tile to screen memory
0677   00CA CD 10 02                           CALL    LeftOneColumn       ; next screen position
0678   00CD 05                                 DEC     B                   ; All done?
0679   00CE C8                                 RET     Z                   ; Yes ... out
0680   00CF 7E                                 LD      A,(HL)              ; Keep the ...
0681   00D0 0F                                 RRCA                        ; ...
0682   00D1 0F                                 RRCA                        ; ...
0683   00D2 0F                                 RRCA                        ; ...
0684   00D3 0F                                 RRCA                        ; ...
0685   00D4 E6 0F                              AND     $0F                 ; ... LSB
0686   00D6 F6 20                              OR      $20                 ; Offset to number tile
0687   00D8 12                                 LD      (DE),A              ; Store the number tile to screen memory
0688   00D9 CD 10 02                           CALL    LeftOneColumn       ; next screen position
0689   00DC 2B                                 DEC     HL                  ; Next data position
0690   00DD 05                                 DEC     B                   ; All digits done?
0691   00DE C2 C4 00                           JP      NZ,PrintNumber      ; No ... keep going
0692   00E1 C9                                 RET                         ; Yes ... out
0693   00E2             
0694   00E3                                    .ORG $00E3
0695   00E3             ;*****************************************************************************
0696   00E3             ;* Handles the intro splash and the game demo.
0697   00E3             ;*****************************************************************************
0698   00E3             SplashAndDemo:
0699   00E3 21 99 43                           LD      HL,M4399            ; starts with 0
0700   00E6 CD 00 02                           CALL    AddOneToMem         ; increases it by one
0701   00E9 01 01 00                           LD      BC,$0001            ;
0702   00EC CD 58 02                           CALL    CompareBCtoMem      ;
0703   00EF CA E1 01                           JP      Z,PrintCopyright    ; do if Counter98 is >= 00 01
0704   00F2 01 02 00                           LD      BC,$0002            ;
0705   00F5 11 1F 01                           LD      DE,$011F            ; used as delay counter
0706   00F8 CD 60 02                           CALL    SubtractIfEnough    ;
0707   00FB D2 96 01                           JP      NC,SlowPrintScoreAverageTable    ; do if Counter98 is >= 00 02
0708   00FE 01 20 01                           LD      BC,$0120            ; for a longer break
0709   0101 CD 58 02                           CALL    CompareBCtoMem      ;
0710   0104 CA CA 0B                           JP      Z,DrawScoreAverageTableTiles     ; do if Counter98 is >= 01 20
0711   0107 0E B0                              LD      C,$B0               ; for a short break
0712   0109 CD 58 02                           CALL    CompareBCtoMem      ;
0713   010C CA E1 01                           JP      Z,PrintCopyright    ; do if Counter98 is >= 01 B0
0714   010F 0E B8                              LD      C,$B8               ;
0715   0111 CD 58 02                           CALL    CompareBCtoMem      ;
0716   0114 CA 80 05                           JP      Z,InitBackgroundData            ; do if Counter98 is >= 01 B8
0717   0117 0E C0                              LD      C,$C0               ; for a short break
0718   0119 11 DF 02                           LD      DE,$02DF            ;
0719   011C CD 60 02                           CALL    SubtractIfEnough    ;
0720   011F D2 78 00                           JP      NC,SlowPrintScrollRegisterUpdate ; do if Counter98 is >= 01 C0
0721   0122 01 00 03                           LD      BC,$0300            ;
0722   0125 11 AF 03                           LD      DE,$03AF            ;
0723   0128 CD 60 02                           CALL    SubtractIfEnough    ;
0724   012B D2 DC 21                           JP      NC,DrawIntroBirdAnimationFrame   ; do if Counter98 is >= 03 00
0725   012E 01 E6 03                           LD      BC,$03E6            ;
0726   0131 11 FF FF                           LD      DE,$FFFF            ;
0727   0134 CD 60 02                           CALL    SubtractIfEnough    ;
0728   0137 D2 B0 03                           JP      NC,GameDemo         ; do if Counter98 is >= 03 E6
0729   013A C9                                 RET                         ;
0730   013B             
0731   0140                                    .ORG $0140
0732   0140             ;*****************************************************************************
0733   0140             ;* Clears foreground and background but leaves the 3 score rows.
0734   0140             ;*****************************************************************************
0735   0140             ClearForeAndBackground:
0736   0140 CD A0 03                           CALL    ClearBackground     ; Clear the background
0737   0143 CD 80 00                           CALL    WaitVBlankCoin      ; Wait for VBlank
0738   0146 CD 80 03                           CALL    ClearForeground     ; Clear the foreground (leave the 3 score rows)
0739   0149 21 A3 43                           LD      HL,GameAndDemoOrSplash
0740   014C 36 02                              LD      (HL),$02            ; set to: 'Intro splash'
0741   014E 2C                                 INC     L                   ; GameState
0742   014F 36 00                              LD      (HL),$00            ; to 0
0743   0151 00                                 NOP                         ; Old command removed or space for a future replace patch
0744   0152 00                                 NOP                         ; ..
0745   0153 00                                 NOP                         ; ..
0746   0154 2E B8                              LD      L,$B8               ; LevelAndRound, $43B9, AliensLeft, BirdsLeft, $43BC, $43BD, BonusLivesAt, $43BF to 0
0747   0156 06 08                              LD      B,$08               ; number of bytes to clear
0748   0158 CD D8 05                           CALL    ClearBbytesAtHL     ;
0749   015B 2E BA                              LD      L,$BA               ; Set AliensLeft
0750   015D 36 10                              LD      (HL),$10            ; to 16 aliens left in wave
0751   015F 2E BE                              LD      L,$BE               ;
0752   0161 3A 00 78                           LD      A,(DSW0)            ; 78xx DSW0, get DIP switch settings
0753   0164 E6 0C                              AND     $0C                 ; mask out 0000_1100 the Bonus lives
0754   0166 07                                 RLCA                        ; rotate left ..
0755   0167 07                                 RLCA                        ; .. to 0011_0000
0756   0168 C6 30                              ADD     $30                 ; -> $30,$40,$50,$60
0757   016A 77                                 LD      (HL),A              ; save to BonusLivesAt = 3000/4000/5000/6000 pts (BCD)
0758   016B 26 58                              LD      H,scrollRegister >> 8
0759   016D 36 00                              LD      (HL),$00            ; init screen scrolling
0760   016F CD 80 00                           CALL    WaitVBlankCoin      ;
0761   0172 C9                                 RET                         ;
0762   0173             
0763   0173             ;*****************************************************************************
0764   0173             ;* Used for the game demo during attract mode.
0765   0173             ;* Returning the bits for feeding the IN0Current for the simulated player inputs.
0766   0173             ;* Resulting values are depending on $4398:$4399 .
0767   0173             ;* Counter value goes from $03E6 to $1510 during the demo.
0768   0173             ;* 1010_1110...move left
0769   0173             ;* 1100_1110...move right
0770   0173             ;* 1111_1110...push fire
0771   0173             ;* 0111_1110...push shield
0772   0173             ;*****************************************************************************
0773   0173             GetPlayerInputsForDemo:
0774   0173 7E                                 LD      A,(HL)              ; get $4399 (LSB from 16 bit counter)
0775   0174 E6 7F                              AND     $7F                 ; mask out 0111_1111, (counter goes from 00 to $7F)
0776   0176 06 CE                              LD      B,$CE               ; return : 1100_1110...move right
0777   0178 FE 1F                              CP      $1F                 ; 1st trigger point of demo
0778   017A D8                                 RET     C                   ; return if greater
0779   017B 06 FE                              LD      B,$FE               ; 1111_1110...push fire
0780   017D C8                                 RET     Z                   ; return if equal
0781   017E 06 AE                              LD      B,$AE               ; 1010_1110...move left
0782   0180 FE 5F                              CP      $5F                 ; 2nd trigger point of demo
0783   0182 D8                                 RET     C                   ; return if greater
0784   0183 06 FE                              LD      B,$FE               ; 1111_1110...push fire
0785   0185 C8                                 RET     Z                   ; return if equal
0786   0186 06 CE                              LD      B,$CE               ; 1100_1110...move right
0787   0188 FE 7F                              CP      $7F                 ; 3rd trigger point of demo
0788   018A D8                                 RET     C                   ; return if greater
0789   018B 06 FE                              LD      B,$FE               ; 1111_1110...push fire
0790   018D 2D                                 DEC     L                   ;
0791   018E 7E                                 LD      A,(HL)              ; get $4398 (MSB from 16 bit counter)
0792   018F FE 09                              CP      $09                 ; 4rd trigger point of demo
0793   0191 C0                                 RET     NZ                  ; return if not equal
0794   0192 06 7E                              LD      B,$7E               ; 0111_1110...push shield
0795   0194 C9                                 RET                         ;
0796   0195             
0797   0196                                    .ORG $0196
0798   0196             ;*****************************************************************************
0799   0196             ;* Slow printing the static texts for the score average table
0800   0196             ;* and the big letters of the Phoenix title. Prints ONE character per call,
0801   0196             ;* driven by Counter98 ($4398:$4399). Attract-mode only.
0802   0196             ;* In: HL = $4399 (Counter98 LSB).
0803   0196             ;*****************************************************************************
0804   0196             SlowPrintScoreAverageTable:
0805   0196 7E                                 LD      A,(HL)              ; A = $4399 (Counter98 low byte)
0806   0197 E6 1F                              AND     $1F                 ; low 5 bits = char position within the line
0807   0199 FE 06                              CP      $06                 ; positions 0..5 are the inter-line gap
0808   019B D8                                 RET     C                   ; ...nothing to print yet
0809   019C 5F                                 LD      E,A                 ; E = char index (6..31)
0810   019D 7E                                 LD      A,(HL)              ; A = $4399 again
0811   019E E6 E0                              AND     $E0                 ; top 3 bits = which line (0..7) * $20
0812   01A0 4F                                 LD      C,A                 ; C = line offset (low byte)
0813   01A1 2D                                 DEC     L                   ; -> $4398
0814   01A2 46                                 LD      B,(HL)              ; B = Counter98 high byte = block-of-8-lines offset
0815   01A3 2E A8                              LD      L,$A8               ; scratch pointer $43A8...
0816   01A5 70                                 LD      (HL),B              ; $43A8 = B (offset MSB)
0817   01A6 2C                                 INC     L                   ; -> $43A9
0818   01A7 71                                 LD      (HL),C              ; $43A9 = C (offset LSB)
0819   01A8 01 60 18                           LD      BC,T1860            ; base of the text-block table
0820   01AB CD 06 02                           CALL    AddBCtoMem          ; ($43A8:$43A9) += $1860  -> pointer to the line record
0821   01AE 7E                                 LD      A,(HL)              ; A = pointer LSB ($43A9)
0822   01AF 2D                                 DEC     L                   ; -> $43A8
0823   01B0 66                                 LD      H,(HL)              ; H = pointer MSB
0824   01B1 6F                                 LD      L,A                 ; HL = record address ($1860 + offset)
0825   01B2 7B                                 LD      A,E                 ; A = char index
0826   01B3 56                                 LD      D,(HL)              ; D = record +0 = screen dest MSB
0827   01B4 2C                                 INC     L                   ; 
0828   01B5 5E                                 LD      E,(HL)              ; E = record +1 = screen dest LSB (DE = line start)
0829   01B6 2D                                 DEC     L                   ; back to record +0
0830   01B7 4F                                 LD      C,A                 ; C = char index
0831   01B8 85                                 ADD     A,L                 ; 
0832   01B9 6F                                 LD      L,A                 ; HL = record + char index  (the char to print)
0833   01BA 79                                 LD      A,C                 ; A = char index
0834   01BB D6 06                              SUB     $06                 ; columns to advance = index - 6
0835   01BD 4F                                 LD      C,A                 ; 
0836   01BE CA C8 01                           JP      Z,L01C8             ; index 6 -> print at the line start
0837   01C1             L01C1:
0838   01C1 CD 17 02                           CALL    RightOneColumn      ; move to next screen position
0839   01C4 0D                                 DEC     C                   ;
0840   01C5 C2 C1 01                           JP      NZ,L01C1            ; ...advance (index-6) columns
0841   01C8             L01C8:
0842   01C8 7E                                 LD      A,(HL)              ; the character at record+index
0843   01C9 12                                 LD      (DE),A              ; print one character on the screen
0844   01CA C3 E0 14                           JP      L14E0               ; coinage text fixup, then return
0845   01CD             
0846   01D0                                    .ORG $01D0
0847   01D0             ;*****************************************************************************
0848   01D0             ;* Print the top 3 lines (scores, lives, coins)
0849   01D0             ;*****************************************************************************
0850   01D0             PrintTextLines:
0851   01D0 56                                 LD      D,(HL)              ; Get ...
0852   01D1 2C                                 INC     L                   ; ... the ...
0853   01D2 5E                                 LD      E,(HL)              ; ... screen coord
0854   01D3 7D                                 LD      A,L                 ; Add 5 ...
0855   01D4 C6 05                              ADD     $05                 ; ... go get ...
0856   01D6 6F                                 LD      L,A                 ; ... data
0857   01D7 06 1A                              LD      B,$1A               ; 26 columns
0858   01D9 CD ED 01                           CALL    DrawRow             ; Draw next row
0859   01DC 0D                                 DEC     C                   ; All lines done?
0860   01DD C2 D0 01                           JP      NZ,PrintTextLines   ; No ... draw all rows
0861   01E0 C9                                 RET                         ; Done
0862   01E1             
0863   01E1             ;*****************************************************************************
0864   01E1             ;* Print the copyright lines (bottom 3 lines)
0865   01E1             ;*****************************************************************************
0866   01E1             PrintCopyright:
0867   01E1 CD 40 01                           CALL    ClearForeAndBackground
0868   01E4             L01E4:
0869   01E4 21 60 19                           LD      HL,T1960            ; "PHOENIX ... U.S.A"
0870   01E7 0E 03                              LD      C,$03               ; 3 lines at the bottom
0871   01E9 C3 D0 01                           JP      PrintTextLines      ; Print the copyright
0872   01EC             
0873   01ED                                    .ORG $01ED
0874   01ED             ;*****************************************************************************
0875   01ED             ;* Remember the screen is rotated.
0876   01ED             ;* This draws a column in screen memory (row on the screen)
0877   01ED             ;*****************************************************************************
0878   01ED             DrawRow:
0879   01ED 7E                                 LD      A,(HL)              ; Copy the data ...
0880   01EE 12                                 LD      (DE),A              ; .. to the screen
0881   01EF 23                                 INC     HL                  ; Next in data
0882   01F0 CD 17 02                           CALL    RightOneColumn      ; Move DE to next row
0883   01F3 05                                 DEC     B                   ; All drawn?
0884   01F4 C2 ED 01                           JP      NZ,DrawRow          ; Draw them all
0885   01F7 C9                                 RET                         ; Done
0886   01F8             
0887   0200                                    .ORG $0200
0888   0200             ;*****************************************************************************
0889   0200             ;* Two-byte +1 to (HL-1) : (HL).
0890   0200             ;*****************************************************************************
0891   0200             AddOneToMem:
0892   0200 34                                 INC     (HL)                ; Add one to LSB
0893   0201 C0                                 RET     NZ                  ; We didn't overflow ... done
0894   0202 2D                                 DEC     L                   ; Back up to MSB
0895   0203 34                                 INC     (HL)                ; Carry into the MSB
0896   0204 2C                                 INC     L                   ; Restore point to LSB
0897   0205 C9                                 RET                         ; Done
0898   0206             
0899   0206             ;*****************************************************************************
0900   0206             ;* Two-byte addition. BC is added to (HL-1) : (HL).
0901   0206             ;*****************************************************************************
0902   0206             AddBCtoMem:
0903   0206 7E                                 LD      A,(HL)              ; Get the lower byte
0904   0207 81                                 ADD     A,C                 ; Add C to the lower
0905   0208 77                                 LD      (HL),A              ; Store the new lower
0906   0209 2D                                 DEC     L                   ; Back up to upper byte
0907   020A 7E                                 LD      A,(HL)              ; Add B and carry ...
0908   020B 88                                 ADC     A,B                 ; ... to upper byte
0909   020C 77                                 LD      (HL),A              ; Store the new upper byte
0910   020D 2C                                 INC     L                   ; Restore pointer to LSB
0911   020E C9                                 RET                         ; Done
0912   020F             
0913   0210                                    .ORG $0210
0914   0210             ;*****************************************************************************
0915   0210             ;* Add 32 (left one column on the rotated screen) to DE (two bytes)
0916   0210             ;*****************************************************************************
0917   0210             LeftOneColumn:
0918   0210 7B                                 LD      A,E                 ; Add ...
0919   0211 C6 20                              ADD     $20                 ; ... 32 to ...
0920   0213 5F                                 LD      E,A                 ; ... E
0921   0214 D0                                 RET     NC                  ; No carry ... we are done
0922   0215 14                                 INC     D                   ; Carry into D
0923   0216 C9                                 RET                         ; Done
0924   0217             
0925   0217             ;*****************************************************************************
0926   0217             ;* Subtract 32 (right one column on the rotated screen) from DE (two bytes)
0927   0217             ;*****************************************************************************
0928   0217             RightOneColumn:
0929   0217 7B                                 LD      A,E                 ; Subtract ...
0930   0218 D6 20                              SUB     $20                 ; ... 32 from ...
0931   021A 5F                                 LD      E,A                 ; ... E
0932   021B D0                                 RET     NC                  ; No borrow ... we are done
0933   021C 15                                 DEC     D                   ; Borrow from D
0934   021D C9                                 RET                         ; Done
0935   021E             
0936   0220                                    .ORG $0220
0937   0220             ;*****************************************************************************
0938   0220             ;* 3-byte (6 digit) BCD addition. Add BC*10 to (HL-2):(HL-1):(HL).
0939   0220             ;* The games keeps the lowest digit of the scores to 0.
0940   0220             ;*****************************************************************************
0941   0220             AddToScore:
0942   0220 AF                                 XOR     A                   ; !! Pointless. We are about to change A and the flags
0943   0221 7E                                 LD      A,(HL)              ; Lowest 2 digits
0944   0222 81                                 ADD     A,C                 ; Add C to score
0945   0223 27                                 DAA                         ; Adjust for binary coded decimal
0946   0224 77                                 LD      (HL),A              ; Update lowest 2 digits
0947   0225 2D                                 DEC     L                   ; Point to middle 2 digits
0948   0226 7E                                 LD      A,(HL)              ; Add B to ...
0949   0227 88                                 ADC     A,B                 ; ... score
0950   0228 27                                 DAA                         ; Adjust for BCD
0951   0229 77                                 LD      (HL),A              ; Store the middle 2 digits
0952   022A 2D                                 DEC     L                   ; Point to the upper 2 digits
0953   022B 7E                                 LD      A,(HL)              ; Add in ...
0954   022C CE 00                              ADC     $00                 ; ... any carry
0955   022E 27                                 DAA                         ; Adjust for binary coded decimal
0956   022F 77                                 LD      (HL),A              ; Store the upper 2 digits
0957   0230 2C                                 INC     L                   ; Restore ...
0958   0231 2C                                 INC     L                   ; ... pointer
0959   0232 C9                                 RET                         ; Done
0960   0233             
0961   0258                                    .ORG $0258
0962   0258             ;*****************************************************************************
0963   0258             ;* Two byte compare of BC to memory at (HL-1):(HL)
0964   0258             ;*****************************************************************************
0965   0258             CompareBCtoMem:
0966   0258 7E                                 LD      A,(HL)              ; Value from memory
0967   0259 B9                                 CP      C                   ; Are the lower values the same?
0968   025A C0                                 RET     NZ                  ; No ... return not-zero
0969   025B 2D                                 DEC     L                   ; Point to MSB
0970   025C 7E                                 LD      A,(HL)              ; Get the MSB value
0971   025D 2C                                 INC     L                   ; Restore the pointer
0972   025E B8                                 CP      B                   ; Compare the MSBs
0973   025F C9                                 RET                         ; Return the flags
0974   0260             
0975   0260             ;*****************************************************************************
0976   0260             ;* Subtract DE from memory if memory is greater/equal to BC.
0977   0260             ;*****************************************************************************
0978   0260             SubtractIfEnough:
0979   0260 CD 70 02                           CALL    SubtractFromMemory  ; Try subtraction. Is memory larger (or equal) to BC?
0980   0263 D8                                 RET     C                   ; No ... ignore request
0981   0264 CD 77 02                           CALL    SubtractToMemory    ; Yes ... subtract DE from memory
0982   0267 C9                                 RET                         ; Done
0983   0268             
0984   0270                                    .ORG $0270
0985   0270             ;*****************************************************************************
0986   0270             ;* Two byte subtraction of memory from BC. BC = BC -  (HL-1):(HL)
0987   0270             ;*****************************************************************************
0988   0270             SubtractFromMemory:
0989   0270 7E                                 LD      A,(HL)              ; Get the low byte
0990   0271 91                                 SUB     C                   ; Subtract from C
0991   0272 2D                                 DEC     L                   ; Point to upper byte
0992   0273 7E                                 LD      A,(HL)              ; Get the upper byte
0993   0274 98                                 SBC     B                   ; Subtract from B (with borrow)
0994   0275 2C                                 INC     L                   ; Restore pointer
0995   0276 C9                                 RET                         ; Done
0996   0277             
0997   0277             ;*****************************************************************************
0998   0277             ;* Two byte subtraction of DE from memory. (HL-1):(HL) = (HL-1):(HL) - DE
0999   0277             ;*****************************************************************************
1000   0277             SubtractToMemory:
1001   0277 7B                                 LD      A,E                 ; Lower byte
1002   0278 96                                 SUB     (HL)                ; Subtract it from memory
1003   0279 2D                                 DEC     L                   ; Point to upper byte
1004   027A 7A                                 LD      A,D                 ; Value to A
1005   027B 9E                                 SBC     (HL)                ; Subtract upper byte from memory (with borrow)
1006   027C 2C                                 INC     L                   ; Restore pointer
1007   027D C9                                 RET                         ; Done
1008   027E             
1009   0280                                    .ORG $0280
1010   0280             ;*****************************************************************************
1011   0280             ;* Two byte compare of HL to BC
1012   0280             ;*****************************************************************************
1013   0280             CompareHLtoBC:
1014   0280 7D                                 LD      A,L                 ; Compare lower ...
1015   0281 B9                                 CP      C                   ; ... bytes
1016   0282 C0                                 RET     NZ                  ; Not the same ... return NZ
1017   0283 7C                                 LD      A,H                 ; Compare upper ...
1018   0284 B8                                 CP      B                   ; ... bytes
1019   0285 C9                                 RET                         ; Return the check
1020   0286             
1021   0288                                    .ORG $0288
1022   0288             ;*****************************************************************************
1023   0288             ;* Start game screen
1024   0288             ;*****************************************************************************
1025   0288             PromptForStartGame:
1026   0288 CD 40 01                           CALL    ClearForeAndBackground
1027   028B 21 C0 19                           LD      HL,T19C0            ; 
1028   028E 0E 02                              LD      C,$02               ; print two lines: 'PUSH ONLY...1PLAYER BUTTON'
1029   0290 CD D0 01                           CALL    PrintTextLines      ;
1030   0293 0E 02                              LD      C,$02               ;
1031   0295 CD E0 17                           CALL    CoinChecking        ; Converts raw `CoinCount` into playable credits, applying the coinage DIP on `DSW0`
1032   0298 FE 02                              CP      $02                 ; 2 player mode possible if credit > 1
1033   029A DA A7 02                           JP      C,L02A7             ;
1034   029D 21 A0 1B                           LD      HL,T1BA0            ;
1035   02A0 0E 01                              LD      C,$01               ; print one line: '1 OR 2PLAYERS BUTTON'
1036   02A2 CD D0 01                           CALL    PrintTextLines      ;
1037   02A5 0E 06                              LD      C,$06               ;
1038   02A7             L02A7:
1039   02A7 3A 00 70                           LD      A,(IN0)             ; 70xx IN0  Get the bits...
1040   02AA 2F                                 CPL                         ; ...for the two...
1041   02AB A1                                 AND     C                   ; ...start buttons and...
1042   02AC C8                                 RET     Z                   ; ...ret if no start button was pressed.
1043   02AD CD CB 02                           CALL    DecrementCoins      ; (GameOrAttract will be affected here as well)
1044   02B0 CD F0 02                           CALL    UpdateHiScore       ;
1045   02B3 CD 2E 03                           CALL    ClearAndPrintScores ;
1046   02B6 CD 50 03                           CALL    GetPlayerLivesFromDip
1047   02B9 CD 40 01                           CALL    ClearForeAndBackground
1048   02BC 26 50                              LD      H,videoRegister >> 8
1049   02BE 36 01                              LD      (HL),$01            ;
1050   02C0 CD 40 01                           CALL    ClearForeAndBackground
1051   02C3 26 50                              LD      H,videoRegister >> 8
1052   02C5 36 00                              LD      (HL),$00            ;
1053   02C7 C9                                 RET                         ;
1054   02C8             
1055   02CB                                    .ORG $02CB
1056   02CB             ;*****************************************************************************
1057   02CB             ;* Coin handling
1058   02CB             ;*****************************************************************************
1059   02CB             DecrementCoins:
1060   02CB 0E 01                              LD      C,$01               ; Value for 'one player game mode'
1061   02CD FE 02                              CP      $02                 ; A register holds the value of start buttons
1062   02CF CA D4 02                           JP      Z,L02D4             ; jump if 'start 1' was pressed.
1063   02D2 0E 02                              LD      C,$02               ; Value for 'two players game mode'
1064   02D4             L02D4:
1065   02D4 21 A2 43                           LD      HL,GameOrAttract    ; 
1066   02D7 71                                 LD      (HL),C              ; set it to 1 or 2 and leave the attract mode.
1067   02D8 3A 00 78                           LD      A,(DSW0)            ; 78xx DSW0
1068   02DB E6 10                              AND     $10                 ; mask for coinage 0001_0000
1069   02DD CA E3 02                           JP      Z,L02E3             ;
1070   02E0 79                                 LD      A,C                 ;
1071   02E1 07                                 RLCA                        ; Multiply by 2
1072   02E2 4F                                 LD      C,A                 ;
1073   02E3             L02E3:
1074   02E3 2E 8F                              LD      L,CoinCount & $FF   ; LSB of CoinCount
1075   02E5 7E                                 LD      A,(HL)              ; get CoinCount value
1076   02E6 91                                 SUB     C                   ; decrement coins
1077   02E7 77                                 LD      (HL),A              ; save it
1078   02E8 C6 20                              ADD     $20                 ; map value to character code
1079   02EA 32 42 41                           LD      (ForegroundScreen+$142),A ; updates the number of coins on the screen
1080   02ED C9                                 RET                         ;
1081   02EE             
1082   02F0                                    .ORG $02F0
1083   02F0             ;*****************************************************************************
1084   02F0             ;* Copy the score to hi score if greater
1085   02F0             ;*****************************************************************************
1086   02F0             UpdateHiScore:
1087   02F0 11 83 43                           LD      DE,Score1low        ; score of player 1
1088   02F3 21 8B 43                           LD      HL,HiScorelow       ; current hi score
1089   02F6 CD 14 03                           CALL    L0314               ; 3 byte BCD compare
1090   02F9 D4 20 03                           CALL    NC,L0320            ;
1091   02FC 1E 87                              LD      E,Score2low & $FF   ; LSB of Score2low
1092   02FE 2E 8B                              LD      L,HiScorelow & $FF  ; LSB of HiScorelow
1093   0300 CD 14 03                           CALL    L0314               ; 3 byte BCD compare
1094   0303 D4 20 03                           CALL    NC,L0320            ;
1095   0306 2E 8B                              LD      L,HiScorelow & $FF  ; LSB of HiScorelow
1096   0308 11 41 41                           LD      DE,$4141            ; High-score Screen coordinates (LSB)
1097   030B 06 06                              LD      B,$06               ; 6 digits
1098   030D CD C4 00                           CALL    PrintNumber         ; Print the 6-digit number
1099   0310 C9                                 RET                         ; Done
1100   0311             
1101   0314                                    .ORG $0314
1102   0314             ;*****************************************************************************
1103   0314             ;* Generic 3 byte BCD comparator
1104   0314             ;*****************************************************************************
1105   0314             L0314:
1106   0314 1A                                 LD      A,(DE)              ;
1107   0315 96                                 SUB     (HL)                ;
1108   0316 1D                                 DEC     E                   ;
1109   0317 2D                                 DEC     L                   ;
1110   0318 1A                                 LD      A,(DE)              ;
1111   0319 9E                                 SBC     (HL)                ;
1112   031A 1D                                 DEC     E                   ;
1113   031B 2D                                 DEC     L                   ;
1114   031C 1A                                 LD      A,(DE)              ;
1115   031D 9E                                 SBC     (HL)                ;
1116   031E C9                                 RET                         ;
1117   031F             
1118   0320                                    .ORG $0320
1119   0320             L0320:
1120   0320 1A                                 LD      A,(DE)              ;
1121   0321 77                                 LD      (HL),A              ;
1122   0322 13                                 INC     DE                  ;
1123   0323 23                                 INC     HL                  ;
1124   0324 1A                                 LD      A,(DE)              ;
1125   0325 77                                 LD      (HL),A              ;
1126   0326 13                                 INC     DE                  ;
1127   0327 23                                 INC     HL                  ;
1128   0328 1A                                 LD      A,(DE)              ;
1129   0329 77                                 LD      (HL),A              ;
1130   032A C9                                 RET                         ;
1131   032B             
1132   032E                                    .ORG $032E
1133   032E             ;*****************************************************************************
1134   032E             ;* Update of the score values on screen.
1135   032E             ;*****************************************************************************
1136   032E             ClearAndPrintScores:
1137   032E 21 80 43                           LD      HL,M4380            ; Clear scores..
1138   0331             L0331:
1139   0331 36 00                              LD      (HL),$00            ; ..from $4380..
1140   0333 23                                 INC     HL                  ;
1141   0334 7D                                 LD      A,L                 ;
1142   0335 FE 88                              CP      $88                 ; ..to $4387
1143   0337 C2 31 03                           JP      NZ,L0331            ;
1144   033A 2E 83                              LD      L,Score1low & $FF   ; print player 1 score
1145   033C 11 61 42                           LD      DE,$4261            ; Score1 screen coordinates (LSB)
1146   033F 06 06                              LD      B,$06               ; 6 digits
1147   0341 CD C4 00                           CALL    PrintNumber         ;
1148   0344 2E 87                              LD      L,Score2low & $FF   ; print player 2 score
1149   0346 11 21 40                           LD      DE,$4021            ; Score2 screen coordinates (LSB)
1150   0349 06 06                              LD      B,$06               ; 6 digits
1151   034B CD C4 00                           CALL    PrintNumber         ;
1152   034E C9                                 RET                         ; Done
1153   034F             
1154   0350                                    .ORG $0350
1155   0350             ;*****************************************************************************
1156   0350             ;* Gets the DIP switch settings for player lives.
1157   0350             ;*****************************************************************************
1158   0350             GetPlayerLivesFromDip:
1159   0350 3A 00 78                           LD      A,(DSW0)            ; 78xx DSW0, get DIP switch settings
1160   0353 E6 03                              AND     $03                 ; mask out 0000_0011 number of lives
1161   0355 C6 03                              ADD     $03                 ; to get : 03, 04, 05 or 06
1162   0357 47                                 LD      B,A                 ;
1163   0358 21 90 43                           LD      HL,Player1Lives     ;
1164   035B 70                                 LD      (HL),B              ; save it
1165   035C 2E A2                              LD      L,GameOrAttract & $FF
1166   035E 7E                                 LD      A,(HL)              ; load GameOrAttract and ..
1167   035F FE 01                              CP      $01                 ; check if one or two players mode
1168   0361 CA 67 03                           JP      Z,UpdateLivesScreen ;
1169   0364 2E 91                              LD      L,Player2Lives & $FF
1170   0366 70                                 LD      (HL),B              ; save it to Player2Lives
1171   0367             
1172   0367             ;*****************************************************************************
1173   0367             ;* Updates the number of lives on the screen
1174   0367             ;*****************************************************************************
1175   0367             UpdateLivesScreen:
1176   0367 2E 90                              LD      L,Player1Lives & $FF
1177   0369 7E                                 LD      A,(HL)              ; load Player1Lives
1178   036A F6 20                              OR      $20                 ; map value to character code
1179   036C 32 A2 42                           LD      (ForegroundScreen+$2A2),A ; number of lives, for player 1 at screen ram
1180   036F 2C                                 INC     L                   ;
1181   0370 7E                                 LD      A,(HL)              ; load Player2Lives
1182   0371 F6 20                              OR      $20                 ; map value to character code
1183   0373 32 62 40                           LD      (ForegroundScreen+$62),A ; number of lives, for player 2 at screen ram
1184   0376 C9                                 RET                         ;
1185   0377             
1186   0377             ;*****************************************************************************
1187   0377             ;* Update the sound control RAM registers
1188   0377             ;*****************************************************************************
1189   0377             UpdateSoundControlRAM:
1190   0377 21 8C 43                           LD      HL,SoundControlA    ;
1191   037A 77                                 LD      (HL),A              ;
1192   037B 2C                                 INC     L                   ; and update ..
1193   037C 77                                 LD      (HL),A              ; .. SoundControlB
1194   037D C9                                 RET                         ;
1195   037E             
1196   0380                                    .ORG $0380
1197   0380             ;*****************************************************************************
1198   0380             ;* Clears the foreground except for the top 3 rows (the scores)
1199   0380             ;*****************************************************************************
1200   0380             ClearForeground:
1201   0380 21 3F 43                           LD      HL,ForegroundScreen+$33F       ; End of foreground screen
1202   0383 11 1F 00                           LD      DE,$001F            ; 00 for clear and 1F for finding end of a column
1203   0386 01 3F 03                           LD      BC,$033F            ; 03 for leaving top 3 rows and 3F for find the beginning of screen memory
1204   0389             L0389:
1205   0389 72                                 LD      (HL),D              ; Clear the screen
1206   038A 2B                                 DEC     HL                  ; Next location
1207   038B 72                                 LD      (HL),D              ; Clear the screen
1208   038C 2B                                 DEC     HL                  ; Next location
1209   038D 7D                                 LD      A,L                 ; Keep lower 5 ...
1210   038E A3                                 AND     E                   ; ... bits (32 bytes in a column)
1211   038F B8                                 CP      B                   ; At the top of the column?
1212   0390 C2 89 03                           JP      NZ,L0389            ; No ... keep clearing the column
1213   0393 72                                 LD      (HL),D              ; Clear the 4th column from the top
1214   0394 2B                                 DEC     HL                  ; To ...
1215   0395 2B                                 DEC     HL                  ; ... top ...
1216   0396 2B                                 DEC     HL                  ; ... of the ...
1217   0397 2B                                 DEC     HL                  ; ... row
1218   0398 7C                                 LD      A,H                 ; Have we reached ...
1219   0399 B9                                 CP      C                   ; ... 3FFF ?
1220   039A C2 89 03                           JP      NZ,L0389            ; No ... clear all columns
1221   039D C9                                 RET                         ; Done
1222   039E             
1223   03A0                                    .ORG $03A0
1224   03A0             ;*****************************************************************************
1225   03A0             ;* Clears the background screen.
1226   03A0             ;*****************************************************************************
1227   03A0             ClearBackground:
1228   03A0 21 3F 4B                           LD      HL,BackgroundScreen+$33F       ; End of background screen memory
1229   03A3 11 47 00                           LD      DE,$0047            ; 00 for clear and 47 to find the beginning of screen memory
1230   03A6             L03A6:
1231   03A6 72                                 LD      (HL),D              ; Clear the screen
1232   03A7 2B                                 DEC     HL                  ; Next location
1233   03A8 72                                 LD      (HL),D              ; Clear the screen
1234   03A9 2B                                 DEC     HL                  ; Next location
1235   03AA 7C                                 LD      A,H                 ; Have we reached ...
1236   03AB BB                                 CP      E                   ; HL = 47FF ?
1237   03AC C2 A6 03                           JP      NZ,L03A6            ; No ... keep clearing
1238   03AF C9                                 RET                         ; Done
1239   03B0             
1240   03B0             ;*****************************************************************************
1241   03B0             ;* The game demo is using the real game code with simulated player inputs.
1242   03B0             ;* The timeline of the game demo, as part of the attract mode,
1243   03B0             ;* is covered by a 16 bit counter $4398:$4399.
1244   03B0             ;* 1st demo from value: $03E6 to $07A0.
1245   03B0             ;* 2nd demo from value: $0800 to $0B60.
1246   03B0             ;* 3rd demo from value: $0C00 to $1510.
1247   03B0             ;*****************************************************************************
1248   03B0             GameDemo:
1249   03B0 01 A0 07                           LD      BC,$07A0            ;
1250   03B3 CD 70 02                           CALL    SubtractFromMemory  ;
1251   03B6 DA CE 03                           JP      C,L03CE             ;
1252   03B9 CD 58 02                           CALL    CompareBCtoMem      ;
1253   03BC CA EB 03                           JP      Z,L03EB             ;
1254   03BF 01 60 0B                           LD      BC,$0B60            ;
1255   03C2 CD 70 02                           CALL    SubtractFromMemory  ;
1256   03C5 DA CE 03                           JP      C,L03CE             ;
1257   03C8 CD 58 02                           CALL    CompareBCtoMem      ;
1258   03CB CA E2 03                           JP      Z,L03E2             ;
1259   03CE             L03CE:
1260   03CE CD 73 01                           CALL    GetPlayerInputsForDemo
1261   03D1 21 A0 43                           LD      HL,IN0Current       ;
1262   03D4 7E                                 LD      A,(HL)              ;
1263   03D5 E6 01                              AND     $01                 ; mask out real button presses, but leave the coin event.
1264   03D7 B0                                 OR      B                   ; feed the IN0Current with movement data
1265   03D8 77                                 LD      (HL),A              ; for the game demo.
1266   03D9 C3 00 04                           JP      GameStateMachine    ;
1267   03DC             
1268   03E2                                    .ORG $03E2
1269   03E2             ;*****************************************************************************
1270   03E2             ;* Changing the game demo level at attract mode.
1271   03E2             ;*****************************************************************************
1272   03E2             L03E2:
1273   03E2 01 08 01                           LD      BC,$0108            ; Next interval game state is 1, set LevelAndRound to 1st round, level 8 (mothership wave)
1274   03E5 11 00 10                           LD      DE,$1000            ; set AliensLeft to 1 and BirdsLeft to 0
1275   03E8 C3 F1 03                           JP      L03F1               ; 
1276   03EB             
1277   03EB             ;*****************************************************************************
1278   03EB             ;* Changing the game demo level at attract mode.
1279   03EB             ;*****************************************************************************
1280   03EB             L03EB:
1281   03EB 01 04 01                           LD      BC,$0104            ;
1282   03EE 11 08 00                           LD      DE,$0008            ;
1283   03F1             L03F1:
1284   03F1 21 A4 43                           LD      HL,GameState        ; Next interval game state ...
1285   03F4 70                                 LD      (HL),B              ; ... is 1 (flashing of score)
1286   03F5 2E B8                              LD      L,$B8               ;
1287   03F7 71                                 LD      (HL),C              ; set LevelAndRound to 1st round, level 4 (blue birds wave)
1288   03F8 2E BA                              LD      L,$BA               ;
1289   03FA 72                                 LD      (HL),D              ; set AliensLeft to 0
1290   03FB 2C                                 INC     L                   ;
1291   03FC 73                                 LD      (HL),E              ; set BirdsLeft to 8
1292   03FD C9                                 RET                         ;
1293   03FE             
1294   0400                                    .ORG $0400
1295   0400             ;*****************************************************************************
1296   0400             ;* Game state machine.
1297   0400             ;* Jump to function by number in GameState.
1298   0400             ;*****************************************************************************
1299   0400             GameStateMachine:
1300   0400 21 0E 04                           LD      HL,T040E            ; Jump table
1301   0403 3A A4 43                           LD      A,(GameState)       ;
1302   0406 07                                 RLCA                        ; *2
1303   0407 85                                 ADD     A,L                 ; Offset ...
1304   0408 6F                                 LD      L,A                 ; ... into the table
1305   0409 7E                                 LD      A,(HL)              ; MSB of destination
1306   040A 2C                                 INC     L                   ; Get the
1307   040B 6E                                 LD      L,(HL)              ; ... LSB of destination
1308   040C 67                                 LD      H,A                 ; Now point to function
1309   040D E9                                 JP      (HL)                ; Jump to function
1310   040E             
1311   040E             ; Notice these addresses are MSB:LSB (backwards from the processor's endianness)
1312   040E             T040E:
1313   040E                                    .MSFIRST
1314   040E 04 30                              .DW L0430                   ; game state 0: called once at 'new game start'
1315   0410 04 AC                              .DW L04AC                   ; game state 1: called for each frame during 'flashing of score1 or 2'
1316   0412 05 15                              .DW L0515                   ; game state 2: called once for initialization of game and level data
1317   0414 08 00                              .DW L0800                   ; game state 3: called for each frame of normal game play
1318   0416 0A EA                              .DW L0AEA                   ; game state 4: called for each frame of 'player ship partikel explosion'
1319   0418 0B 60                              .DW L0B60                   ; game state 5: called for each frame during 'GAME OVER' text
1320   041A 24 00                              .DW L2400                   ; game state 6: called for each frame during 'mother ship partikel explosion'
1321   041C 24 4C                              .DW L244C                   ; game state 7: called for each frame during 'mother ship score display'
1322   041E             
1323   041E             ;*****************************************************************************
1324   041E             ;* Set lower bits of video register,
1325   041E             ;* for the color palette, memory bank, and the screen flipping at cocktail mode.
1326   041E             ;*****************************************************************************
1327   041E             SetBitsVideoRegister:
1328   041E 3A A3 43                           LD      A,(GameAndDemoOrSplash)
1329   0421 E6 01                              AND     $01                 ; mask out 0000_0001 for 'memory bank'
1330   0423 47                                 LD      B,A                 ;
1331   0424 3A B8 43                           LD      A,(LevelAndRound)   ;
1332   0427 E6 02                              AND     $02                 ; masc out 0000_0010 for 'color palette'
1333   0429 B0                                 OR      B                   ; set the bits at...
1334   042A 32 00 50                           LD      (videoRegister),A   ; 50xx video register
1335   042D C9                                 RET                         ;
1336   042E             
1337   0430                                    .ORG $0430
1338   0430             ;*****************************************************************************
1339   0430             ;* Game state 0.
1340   0430             ;* New game start.
1341   0430             ;*****************************************************************************
1342   0430             L0430:
1343   0430 21 A4 43                           LD      HL,GameState        ; Next interval game state ...
1344   0433 36 01                              LD      (HL),$01            ; ... is 1 (flashing of score)
1345   0435 2C                                 INC     L                   ;
1346   0436 36 80                              LD      (HL),$80            ; Set value for CounterA5 (score flash time)
1347   0438 2E A3                              LD      L,GameAndDemoOrSplash & $FF   ; save the value of..
1348   043A 7E                                 LD      A,(HL)              ; .. GameAndDemoOrSplash
1349   043B 36 00                              LD      (HL),$00            ; set it to game demo / game play
1350   043D FE 02                              CP      $02                 ;
1351   043F C8                                 RET     Z                   ; return if it was 'Intro splash' before.
1352   0440 77                                 LD      (HL),A              ; set GameAndDemoOrSplash to 'Game and demo for player 1'
1353   0441 2D                                 DEC     L                   ;
1354   0442 7E                                 LD      A,(HL)              ; get GameOrAttract
1355   0443 FE 01                              CP      $01                 ;
1356   0445 C8                                 RET     Z                   ; one-player mode -> no switch
1357   0446 2C                                 INC     L                   ;
1358   0447 7E                                 LD      A,(HL)              ; get GameAndDemoOrSplash
1359   0448 A7                                 AND     A                   ; updates the zero flag
1360   0449 CA A0 04                           JP      Z,L04A0             ; currently player 1 -> switch to player 2
1361   044C 2E 90                              LD      L,$90               ;
1362   044E 7E                                 LD      A,(HL)              ; else currently player 2: check Player1Lives
1363   044F A7                                 AND     A                   ; updates the zero flag
1364   0450 C8                                 RET     Z                   ; player 1 has no lives -> don't switch back
1365   0451 2E A3                              LD      L,$A3               ;
1366   0453 36 00                              LD      (HL),$00            ; set GameAndDemoOrSplash to 'Game and demo for player 1'
1367   0455 01 00 01                           LD      BC,$0100            ; from bank 1 to bank 0
1368   0458 CD 60 04                           CALL    CopyMemoryBank      ; to toggle the player
1369   045B C9                                 RET                         ;
1370   045C             
1371   0460                                    .ORG $0460
1372   0460             ;*****************************************************************************
1373   0460             ;* Copy memory bank to bank.
1374   0460             ;* B = from-bank number, C = to-bank number.  Copies three regions:
1375   0460             ;*   1) the foreground playfield (from $4320)
1376   0460             ;*      This loop walks the screen in the display's native (rotated) order:
1377   0460             ;*      It copies a 4 byte group (`E & 3` inner loop), then snaps `E` to
1378   0460             ;*      its `$x0` boundary and subtracts `$20` to jump to the group one screen line earlier,
1379   0460             ;*      when that underflows it decrements the page (`DEC D`).
1380   0460             ;*      It marches through pages `$43 -> $42 -> $41 -> $40` and stops when `D` reaches `$3F`
1381   0460             ;*      (i.e. below `$4000`). Net effect: the visible playfield is transferred between banks.
1382   0460             ;*   2) the game-state/score block  $4380-$43B7
1383   0460             ;*      A straight linear copy (`INC E` until `$B8`). This carries the two players' scores
1384   0460             ;*      (`$4380`–`$4387`) plus the level/round and assorted counters in that block.
1385   0460             ;*   3) the object buffer          $4BC0-$4BFF
1386   0460             ;*      Another linear copy that runs until `E` wraps from `$FF` to `$00`.
1387   0460             ;*      This preserves the in progress object/bird buffer.
1388   0460             ;* Role in the game:
1389   0460             ;* `CopyMemoryBank` is what makes alternating two player play possible:
1390   0460             ;* at each turn boundary the game flips the "current player" flag and calls this routine
1391   0460             ;* to move the departing player's screen and state into their bank while bringing
1392   0460             ;* the incoming player's bank live (the register ends on `C`). The three regions cover
1393   0460             ;* exactly what must persist across turns — the visible screen, the score/level/counter block,
1394   0460             ;* and the object buffer — so each player resumes precisely where they left off.
1395   0460             ;*****************************************************************************
1396   0460             CopyMemoryBank:
1397   0460 21 00 50                           LD      HL,videoRegister    ; 50xx video / RAM bank-select register
1398   0463 11 20 43                           LD      DE,ForegroundScreen+$320; $4320 = 1st row, 1st line of playfield
1399   0466             ;----- Region 1: the visible foreground screen --------------------------------
1400   0466             L0466:
1401   0466 70                                 LD      (HL),B              ; select source bank
1402   0467 1A                                 LD      A,(DE)              ; read byte from source bank
1403   0468 71                                 LD      (HL),C              ; select destination bank
1404   0469 12                                 LD      (DE),A              ; write byte into destination bank
1405   046A 1C                                 INC     E                   ; next byte
1406   046B 7B                                 LD      A,E                 ; 
1407   046C E6 03                              AND     $03                 ; still inside the 4-byte group?
1408   046E C2 66 04                           JP      NZ,L0466            ; ...yes, copy the 4 bytes of this group
1409   0471 7B                                 LD      A,E                 ; group done: move to the next screen line
1410   0472 E6 F0                              AND     $F0                 ; snap E to its $x0 boundary
1411   0474 D6 20                              SUB     $20                 ; step back one screen line (-32)
1412   0476 5F                                 LD      E,A                 ; 
1413   0477 D2 66 04                           JP      NC,L0466            ; no underflow -> keep copying this page
1414   047A 15                                 DEC     D                   ; underflow -> previous page
1415   047B 7A                                 LD      A,D                 ; 
1416   047C FE 3F                              CP      $3F                 ; dropped below $4000 ?
1417   047E C2 66 04                           JP      NZ,L0466            ; no -> continue ($43..$40 pages)
1418   0481 11 80 43                           LD      DE,M4380            ; yes -> region 1 done
1419   0484             ;----- Region 2: game-state + score block $4380-$43B7 -------------------------
1420   0484             L0484:
1421   0484 70                                 LD      (HL),B              ; source bank
1422   0485 1A                                 LD      A,(DE)              ; 
1423   0486 71                                 LD      (HL),C              ; dest bank
1424   0487 12                                 LD      (DE),A              ; 
1425   0488 1C                                 INC     E                   ; 
1426   0489 7B                                 LD      A,E                 ; 
1427   048A FE B8                              CP      $B8                 ; until $43B8
1428   048C C2 84 04                           JP      NZ,L0484            ; 
1429   048F 11 C0 4B                           LD      DE,B4BC0            ; then the object buffer...
1430   0492             ;----- Region 3: object buffer $4BC0-$4BFF ------------------------------------
1431   0492             L0492:
1432   0492 70                                 LD      (HL),B              ; source bank
1433   0493 1A                                 LD      A,(DE)              ; 
1434   0494 71                                 LD      (HL),C              ; dest bank
1435   0495 12                                 LD      (DE),A              ; 
1436   0496 1C                                 INC     E                   ; 
1437   0497 7B                                 LD      A,E                 ; 
1438   0498 FE 00                              CP      $00                 ; until E wraps ($4C00)
1439   049A C2 92 04                           JP      NZ,L0492            ; 
1440   049D C9                                 RET                         ; 
1441   049E             
1442   04A0                                    .ORG $04A0
1443   04A0             ;*****************************************************************************
1444   04A0             ;* Changing the player at attract mode.
1445   04A0             ;*****************************************************************************
1446   04A0             L04A0:
1447   04A0 2E A3                              LD      L,$A3               ; set GameAndDemoOrSplash
1448   04A2 36 01                              LD      (HL),$01            ; to 'Game for player 2'
1449   04A4 01 01 00                           LD      BC,$0001            ; from bank 0 to bank 1
1450   04A7 CD 60 04                           CALL    CopyMemoryBank      ; to toggle the player
1451   04AA C9                                 RET                         ;
1452   04AB             
1453   04AC                                    .ORG $04AC
1454   04AC             ;*****************************************************************************
1455   04AC             ;* Game state 1.
1456   04AC             ;* Flashing of score1 or 2.
1457   04AC             ;*****************************************************************************
1458   04AC             L04AC:
1459   04AC 21 A5 43                           LD      HL,CounterA5        ;
1460   04AF 35                                 DEC     (HL)                ; decrement counter
1461   04B0 7E                                 LD      A,(HL)              ; save value
1462   04B1 2D                                 DEC     L                   ; HL=A3A4 next game state ..
1463   04B2 36 02                              LD      (HL),$02            ; .. is 2
1464   04B4 A7                                 AND     A                   ; ret if ..
1465   04B5 C8                                 RET     Z                   ; counter 0
1466   04B6 36 01                              LD      (HL),$01            ; set game state to 1
1467   04B8 FE 7F                              CP      $7F                 ; 0111_1111
1468   04BA CA F0 07                           JP      Z,L07F0             ;
1469   04BD 2E 9A                              LD      L,$9A               ;
1470   04BF 36 00                              LD      (HL),$00            ; reset Counter9A MSB
1471   04C1 2C                                 INC     L                   ; and ..
1472   04C2 36 00                              LD      (HL),$00            ; LSB
1473   04C4 E6 08                              AND     $08                 ; 0000_1000
1474   04C6 C2 E6 04                           JP      NZ,L04E6            ;
1475   04C9 CD E8 06                           CALL    L06E8               ;
1476   04CC 00                                 NOP                         ;
1477   04CD 21 A3 43                           LD      HL,GameAndDemoOrSplash
1478   04D0 7E                                 LD      A,(HL)              ;
1479   04D1 A7                                 AND     A                   ; updates the zero flag
1480   04D2 2E 83                              LD      L,$83               ; LSB of Score1low adress
1481   04D4 11 61 42                           LD      DE,$4261            ; screen ram addr. of lowest score digit player 1
1482   04D7 CA DF 04                           JP      Z,L04DF             ; 
1483   04DA 2E 87                              LD      L,$87               ; LSB of Score2low adress
1484   04DC 11 21 40                           LD      DE,$4021            ; screen ram addr. of lowest score digit player 2
1485   04DF             L04DF:
1486   04DF 06 06                              LD      B,$06               ; number of digits to print
1487   04E1 CD C4 00                           CALL    PrintNumber         ;
1488   04E4 C9                                 RET                         ;
1489   04E5             
1490   04E6                                    .ORG $04E6
1491   04E6             L04E6:
1492   04E6 21 A3 43                           LD      HL,GameAndDemoOrSplash
1493   04E9 7E                                 LD      A,(HL)              ;
1494   04EA A7                                 AND     A                   ; updates the zero flag
1495   04EB 11 61 42                           LD      DE,$4261            ; screen ram addr. of lowest score digit player 1
1496   04EE CA F4 04                           JP      Z,L04F4             ;
1497   04F1 11 21 40                           LD      DE,$4021            ; screen ram addr. of lowest score digit player 2
1498   04F4             L04F4:
1499   04F4 06 06                              LD      B,$06               ; number of digits to delete
1500   04F6 CD FB 04                           CALL    L04FB               ;
1501   04F9 C9                                 RET                         ;
1502   04FA             
1503   04FB                                    .ORG $04FB
1504   04FB             L04FB:
1505   04FB 3E 00                              LD      A,$00               ; delete ..
1506   04FD 12                                 LD      (DE),A              ; ..one digit
1507   04FE CD 10 02                           CALL    LeftOneColumn       ;
1508   0501 05                                 DEC     B                   ; decrement number of digits
1509   0502 C2 FB 04                           JP      NZ,L04FB            ; ..until
1510   0505 C9                                 RET                         ; ..done
1511   0506             
1512   0506             ;*****************************************************************************
1513   0506             ;* Clear $4392 to $4397 and
1514   0506             ;* init start value list pointer for alien movement MSB $4394
1515   0506             ;*****************************************************************************
1516   0506             L0506:
1517   0506 21 92 43                           LD      HL,M4392            ;
1518   0509 06 06                              LD      B,$06               ; number of bytes to clear
1519   050B CD D8 05                           CALL    ClearBbytesAtHL     ;
1520   050E 3A 50 4B                           LD      A,(M4B50)           ; get alien movement pattern table MSB
1521   0511 32 94 43                           LD      (M4394),A           ; save start value list pointer for alien movement MSB
1522   0514 C9                                 RET                         ;
1523   0515             
1524   0515             ;*****************************************************************************
1525   0515             ;* Game state 2.
1526   0515             ;* Initialization of game and level data.
1527   0515             ;*****************************************************************************
1528   0515             L0515:
1529   0515 CD 1E 04                           CALL    SetBitsVideoRegister; set color palette according to LevelAndRound
1530   0518 21 A4 43                           LD      HL,GameState        ; Next interval game state ...
1531   051B 36 03                              LD      (HL),$03            ; ... is 3 (normal game play)
1532   051D CD 80 05                           CALL    InitBackgroundData ;
1533   0520 CD 47 05                           CALL    InitPlayerDataStructure
1534   0523 CD A0 09                           CALL    L09A0               ; get screen ram adress for player ship position
1535   0526             L0526:
1536   0526 CD 32 05                           CALL    L0532               ; init alien data for a new level and round
1537   0529 CD 6C 0A                           CALL    L0A6C               ; get screen ram adress for all aliens
1538   052C CD 06 05                           CALL    L0506               ; clear 4392 to 4397, init 4394
1539   052F C3 B0 32                           JP      L32B0               ; Bird-level init
1540   0532             
1541   0532             ;*****************************************************************************
1542   0532             ;* Init alien data for a new level and round
1543   0532             ;*****************************************************************************
1544   0532             L0532:
1545   0532 21 50 4B                           LD      HL,M4B50            ;
1546   0535 06 A0                              LD      B,$A0               ; clear $4B50 to $4BEF
1547   0537 CD D8 05                           CALL    ClearBbytesAtHL     ;
1548   053A CD EC 05                           CALL    InitAlienControlStates
1549   053D CD 50 06                           CALL    L0650               ; copy init values for 16 aliens to $4B50-$4B6F
1550   0540 CD 10 06                           CALL    InitAlienPositions  ; load alien screen coordinates (X,Y grid), for a new level and round
1551   0543 C9                                 RET                         ;
1552   0544             
1553   0547                                    .ORG $0547
1554   0547             ;*****************************************************************************
1555   0547             ;* Copy 32 byte from $0560 to $43C0 Player and bullets data structure (grid)
1556   0547             ;* and clear 32 bytes of player and bullets data structure (screen ram).
1557   0547             ;*****************************************************************************
1558   0547             InitPlayerDataStructure:
1559   0547 21 60 05                           LD      HL,T0560            ;
1560   054A 11 C0 43                           LD      DE,PlayerState      ; base of data structure (grid)
1561   054D 06 20                              LD      B,$20               ;
1562   054F CD E0 05                           CALL    CopyBbytesHLtoDE    ;
1563   0552 21 E0 43                           LD      HL,OldPlayerShipMSB ;
1564   0555 06 20                              LD      B,$20               ;
1565   0557 CD D8 05                           CALL    ClearBbytesAtHL     ;
1566   055A C9                                 RET                         ;
1567   055B             
1568   0560                                    .ORG $0560
1569   0560             ; Data copied to $43C0-$43DF
1570   0560             ; Default values for player and bullets data structure (grid).
1571   0560             T0560:
1572   0560 0C 10 64 D8                        .DB $0C, $10, $64, $D8       ; PlayerState, PlayerShape, PlayerShipX, PlayerShipY
1573   0564 00 50 00 D0                        .DB $00, $50, $00, $D0       ; PlayerBulletState, PlayerBulletShape, PlayerBulletX, PlayerBulletY
1574   0568 00 50 00 D0                        .DB $00, $50, $00, $D0       ; AbovePlayerBulletState, AbovePlayerBulletShape, AbovePlayerBulletX, AbovePlayerBulletY
1575   056C 00 58 00 20                        .DB $00, $58, $00, $20       ; AlienBullet0State, AlienBullet0Shape, AlienBullet0X, AlienBullet0Y
1576   0570 00 58 00 20                        .DB $00, $58, $00, $20       ; AlienBullet1State, AlienBullet1Shape, AlienBullet1X, AlienBullet1Y
1577   0574 00 58 00 20                        .DB $00, $58, $00, $20       ; AlienBullet2State, AlienBullet2Shape, AlienBullet2X, AlienBullet2Y
1578   0578 00 58 00 20                        .DB $00, $58, $00, $20       ; AlienBullet3State, AlienBullet3Shape, AlienBullet3X, AlienBullet3Y
1579   057C 00 58 00 20                        .DB $00, $58, $00, $20       ; AlienBullet4State, AlienBullet4Shape, AlienBullet4X, AlienBullet4Y
1580   0580             
1581   0580             ;*****************************************************************************
1582   0580             ;* Init background graphic's data, dependent on level and round.
1583   0580             ;*****************************************************************************
1584   0580             InitBackgroundData:
1585   0580 21 98 05                           LD      HL,T0598            ;
1586   0583 3A B8 43                           LD      A,(LevelAndRound)   ;
1587   0586 E6 0F                              AND     $0F                 ; 0000_1111
1588   0588 85                                 ADD     A,L                 ;
1589   0589 6F                                 LD      L,A                 ;
1590   058A 6E                                 LD      L,(HL)              ;
1591   058B 26 05                              LD      H,T05A8 >> 8        ;
1592   058D 11 AB 43                           LD      DE,M43AB            ; Start of background graphic's data
1593   0590 06 0C                              LD      B,$0C               ; number of bytes to copy
1594   0592 CD E0 05                           CALL    CopyBbytesHLtoDE    ;
1595   0595 C9                                 RET                         ;
1596   0596             
1597   0598                                    .ORG $0598
1598   0598             ; Mapping table for the background graphic's data, over game levels.
1599   0598             ; Bit0 - bit3 of $43B8 is the table index.
1600   0598             ; Data will be fetched two times. Once before and once after the 'spiral fill' animation.
1601   0598             ; The double call is really a side effect of always going through
1602   0598             ; `GameState = 2` on every level entry, including "levels" that are only the spiral transition.
1603   0598             ; So the first fetch is needless.
1604   0598             ; They did not special-case "skip global init until after spiral."
1605   0598             ; $05A0 should be $CC but it was never fixed and has no side effect.
1606   0598             T0598:
1607   0598 A8 A8                              .DB T05A8 & $FF, T05A8 & $FF    ;init values for 1st alien wave (pointer to $05A8, $05A8)
1608   059A C0 C0                              .DB T05C0 & $FF, T05C0 & $FF    ;init values for 2st alien wave (pointer to $05C0, $05C0)
1609   059C A8 A8                              .DB T05A8 & $FF, T05A8 & $FF    ;init values for blue birds wave (pointer to $05A8, $05A8)
1610   059E A8 A8                              .DB T05A8 & $FF, T05A8 & $FF    ;init values for pink birds wave (pointer to $05A8, $05A8)
1611   05A0 B4 CC                              .DB T05B4 & $FF, T05CC & $FF    ;init values for mothership wave (pointer to $05B4, $05CC)
1612   05A2 B4 B4                              .DB T05B4 & $FF, T05B4 & $FF    ;init values for mothership wave (pointer to $05B4, $05B4)
1613   05A4 A8 A8                              .DB T05A8 & $FF, T05A8 & $FF    ;not used? pointer to $05A8, $05A8
1614   05A6 A8 A8                              .DB T05A8 & $FF, T05A8 & $FF    ;not used? pointer to $05A8, $05A8
1615   05A8             
1616   05A8             ; Data for Background graphic's (stars, planets, galaxies) and scroll control
1617   05A8             ; e.g.:counter values, timer values, T1C00, T1D00, T1F00, ..
1618   05A8             ; Data copied to $43AB-$43B6
1619   05A8             T05A8:
1620   05A8 80 7F 00 00                        .DB $80, $7F, $00, $00, $40, $3F, $00, T1C00 >> 8, T1C00 & $FF, $FF, $FF, $FF    ; alien waves
1620   05AC 40 3F 00 1C 
1620   05B0 00 FF FF FF 
1621   05B4             T05B4:
1622   05B4 60 5F 01 02                        .DB $60, $5F, $01, $02, $30, $2F, $00, T1C00 >> 8, T1C00 & $FF, $C0, $FF, $FF    ; mothership
1622   05B8 30 2F 00 1C 
1622   05BC 00 C0 FF FF 
1623   05C0             T05C0:
1624   05C0 80 7F 03 04                        .DB $80, $7F, $03, $04, $40, $3F, $00, T1F00 >> 8, T1F00 & $FF, $A0, $FF, $FF    ; alien wave 2
1624   05C4 40 3F 00 1F 
1624   05C8 00 A0 FF FF 
1625   05CC             T05CC:
1626   05CC 60 60 05 06                        .DB $60, $60, $05, $06, $50, $30, $00, T1D00 >> 8, T1D00 & $FF, $48, $FF, $FF    ; mothership
1626   05D0 50 30 00 1D 
1626   05D4 00 48 FF FF 
1627   05D8             
1628   05D8             ;*****************************************************************************
1629   05D8             ;* Clears B memories starting at HL.
1630   05D8             ;*****************************************************************************
1631   05D8             ClearBbytesAtHL:
1632   05D8 AF                                 XOR     A                   ; A=0
1633   05D9             L05D9:
1634   05D9 77                                 LD      (HL),A              ; store
1635   05DA 23                                 INC     HL                  ; next
1636   05DB 05                                 DEC     B                   ; decrease counter.
1637   05DC C2 D9 05                           JP      NZ,L05D9            ;
1638   05DF C9                                 RET                         ;
1639   05E0             
1640   05E0             ;*****************************************************************************
1641   05E0             ;* Copy number of bytes (B register) from DE to HL.
1642   05E0             ;*****************************************************************************
1643   05E0             CopyBbytesHLtoDE:
1644   05E0 7E                                 LD      A,(HL)              ; Copy to HL ...
1645   05E1 12                                 LD      (DE),A              ; ... from DE
1646   05E2 23                                 INC     HL                  ; Next destination
1647   05E3 13                                 INC     DE                  ; Next source
1648   05E4 05                                 DEC     B                   ; All done?
1649   05E5 C2 E0 05                           JP      NZ,CopyBbytesHLtoDE ; no ... keep going
1650   05E8 C9                                 RET                         ; Out
1651   05E9             
1652   05EC                                    .ORG $05EC
1653   05EC             ;*****************************************************************************
1654   05EC             ;* Init all alien control states for a given level and round.
1655   05EC             ;*****************************************************************************
1656   05EC             InitAlienControlStates:
1657   05EC 21 00 15                           LD      HL,T1500            ;
1658   05EF 3A B8 43                           LD      A,(LevelAndRound)   ;
1659   05F2 E6 0F                              AND     $0F                 ;
1660   05F4 07                                 RLCA                        ; Multiply by 2
1661   05F5 85                                 ADD     A,L                 ;
1662   05F6 6F                                 LD      L,A                 ;
1663   05F7 56                                 LD      D,(HL)              ;
1664   05F8 23                                 INC     HL                  ;
1665   05F9 5E                                 LD      E,(HL)              ;
1666   05FA             ;
1667   05FA             L05FA:
1668   05FA 21 70 4B                           LD      HL,M4B70            ;
1669   05FD 3A BA 43                           LD      A,(AliensLeft)      ;
1670   0600 47                                 LD      B,A                 ;
1671   0601 A7                                 AND     A                   ; updates the zero flag
1672   0602 C8                                 RET     Z                   ; if no AliensLeft
1673   0603             ;
1674   0603             L0603:
1675   0603 72                                 LD      (HL),D              ; set control state A
1676   0604 2C                                 INC     L                   ;
1677   0605 73                                 LD      (HL),E              ; set control state B
1678   0606 2C                                 INC     L                   ;
1679   0607 2C                                 INC     L                   ;
1680   0608 2C                                 INC     L                   ;
1681   0609 05                                 DEC     B                   ; number of aliens left
1682   060A C2 03 06                           JP      NZ,L0603            ;
1683   060D C9                                 RET                         ;
1684   060E             
1685   0610                                    .ORG $0610
1686   0610             ;*****************************************************************************
1687   0610             ;* Load alien screen coordinates for a given level and round to $4B70 - $4BAF.
1688   0610             ;*****************************************************************************
1689   0610             InitAlienPositions:
1690   0610 21 3A 06                           LD      HL,T063A            ;
1691   0613 3A B8 43                           LD      A,(LevelAndRound)   ;
1692   0616 0F                                 RRCA                        ;
1693   0617 E6 0F                              AND     $0F                 ; mask out 0000_1111
1694   0619 85                                 ADD     A,L                 ;
1695   061A 6F                                 LD      L,A                 ;
1696   061B 00                                 NOP                         ; Old command removed or space for a future replace patch
1697   061C 00                                 NOP                         ; ..
1698   061D 00                                 NOP                         ; ..
1699   061E 6E                                 LD      L,(HL)              ;
1700   061F 26 15                              LD      H,T1540 >> 8        ; MSB for T1540-T15E0
1701   0621 11 72 4B                           LD      DE,M4B72            ;
1702   0624 3A BA 43                           LD      A,(AliensLeft)      ;
1703   0627 47                                 LD      B,A                 ;
1704   0628 A7                                 AND     A                   ; updates the zero flag
1705   0629 C8                                 RET     Z                   ; if no AliensLeft
1706   062A             ;
1707   062A             L062A:
1708   062A 7E                                 LD      A,(HL)              ; get value from table
1709   062B 12                                 LD      (DE),A              ; save to alien screen coordinate
1710   062C 23                                 INC     HL                  ;
1711   062D 13                                 INC     DE                  ;
1712   062E 7E                                 LD      A,(HL)              ;
1713   062F 12                                 LD      (DE),A              ;
1714   0630 23                                 INC     HL                  ;
1715   0631 13                                 INC     DE                  ;
1716   0632 13                                 INC     DE                  ;
1717   0633 13                                 INC     DE                  ;
1718   0634 05                                 DEC     B                   ;
1719   0635 C2 2A 06                           JP      NZ,L062A            ; loop for all AliensLeft
1720   0638 C9                                 RET                         ;
1721   0639             
1722   063A                                    .ORG $063A
1723   063A             ; Init data for 1st game round.
1724   063A             ; LSB's for T1560, T1540, T15E0.
1725   063A             T063A:
1726   063A 60 40 E0 E0                        .DB T1560 & $FF, T1540 & $FF, T15E0 & $FF, T15E0 & $FF, T15E0 & $FF, T15E0 & $FF, $FF, $FF
1726   063E E0 E0 FF FF 
1727   0642             ; Init data for 2nd game round.
1728   0642             ; LSB's for T15C0, T15A0, T1580.
1729   0642 C0 A0 80 80                        .DB T15C0 & $FF, T15A0 & $FF, T1580 & $FF, T1580 & $FF, T1580 & $FF, T1580 & $FF, $FF, $FF
1729   0646 80 80 FF FF 
1730   064A             
1731   0650                                    .ORG $0650
1732   0650             ;*****************************************************************************
1733   0650             ;* Copy init values for 16 aliens to $4B50-$4B6F (Pointer to alien movement pattern)
1734   0650             ;*****************************************************************************
1735   0650             L0650:
1736   0650 21 20 15                           LD      HL,T1520            ;
1737   0653 3A B8 43                           LD      A,(LevelAndRound)   ;
1738   0656 E6 0F                              AND     $0F                 ; mask out 0000_1111
1739   0658 07                                 RLCA                        ; Multiply by 2
1740   0659 85                                 ADD     A,L                 ;
1741   065A 6F                                 LD      L,A                 ;
1742   065B 56                                 LD      D,(HL)              ;
1743   065C 23                                 INC     HL                  ;
1744   065D 5E                                 LD      E,(HL)              ;
1745   065E 21 50 4B                           LD      HL,M4B50            ;
1746   0661 3A BA 43                           LD      A,(AliensLeft)      ;
1747   0664 47                                 LD      B,A                 ;
1748   0665 A7                                 AND     A                   ; updates the zero flag
1749   0666 C8                                 RET     Z                   ; if no AliensLeft
1750   0667             L0667:
1751   0667 72                                 LD      (HL),D              ;
1752   0668 2C                                 INC     L                   ;
1753   0669 73                                 LD      (HL),E              ;
1754   066A 2C                                 INC     L                   ;
1755   066B 05                                 DEC     B                   ;
1756   066C C2 67 06                           JP      NZ,L0667            ; loop for all AliensLeft
1757   066F C9                                 RET                         ;
1758   0670             
1759   067A                                    .ORG $067A
1760   067A             ;*****************************************************************************
1761   067A             ;* Scroll down the background screen one pixel.
1762   067A             ;*****************************************************************************
1763   067A             StarsScrollDown:
1764   067A 21 B9 43                           LD      HL,CounterB9        ;
1765   067D 7E                                 LD      A,(HL)              ;
1766   067E 35                                 DEC     (HL)                ; decrement the backwards counter
1767   067F 32 00 58                           LD      (scrollRegister),A  ; 58xx scroll register
1768   0682 E6 07                              AND     $07                 ; mask out 0000_0111
1769   0684 C0                                 RET     NZ                  ; continue after 8 pixels...
1770   0685             ; Fill the background with stars or mothership.
1771   0685 01 47 20                           LD      BC,$2047            ;
1772   0688 11 21 4B                           LD      DE,$4B21            ; get character from the background screen (1st row, 2nd line)
1773   068B 7E                                 LD      A,(HL)              ; get $43B9 free running 8 bit backwards counter value
1774   068C 0F                                 RRCA                        ;
1775   068D 0F                                 RRCA                        ;
1776   068E 0F                                 RRCA                        ;
1777   068F E6 1F                              AND     $1F                 ; mask out 0001_1111
1778   0691 83                                 ADD     A,E                 ;
1779   0692 5F                                 LD      E,A                 ;
1780   0693 2E B2                              LD      L,$B2               ;
1781   0695 7E                                 LD      A,(HL)              ; get $43B2 (MSB of T1C00 or T1D00 or T1F00)
1782   0696 2C                                 INC     L                   ;
1783   0697 6E                                 LD      L,(HL)              ; get $43B3 (LSB of T1C00 or T1D00 or T1F00)
1784   0698 67                                 LD      H,A                 ;
1785   0699             L0699:
1786   0699 7E                                 LD      A,(HL)              ;
1787   069A 12                                 LD      (DE),A              ; to background screen
1788   069B 2C                                 INC     L                   ;
1789   069C 7B                                 LD      A,E                 ;
1790   069D 90                                 SUB     B                   ;
1791   069E 5F                                 LD      E,A                 ;
1792   069F D2 99 06                           JP      NC,L0699            ;
1793   06A2 15                                 DEC     D                   ;
1794   06A3 7A                                 LD      A,D                 ;
1795   06A4 B9                                 CP      C                   ;
1796   06A5 C2 99 06                           JP      NZ,L0699            ;
1797   06A8 7D                                 LD      A,L                 ;
1798   06A9 32 B3 43                           LD      (M43B3),A           ;
1799   06AC C9                                 RET                         ;
1800   06AD             
1801   06B0                                    .ORG $06B0
1802   06B0             ;*****************************************************************************
1803   06B0             ;* Fill the background with (2x2) planets.
1804   06B0             ;* Reads the MSB from `T1E20`, then reaches `T1E40` simply by adding `$20`
1805   06B0             ;* to the same pointer (`$1E20 + $20 = $1E40`) — which is the clearest proof that `T1E40` is the LSB companion of `T1E20`.
1806   06B0             ;* So `DE = (T1E20[i] << 8) | T1E40[i]`, then the LSB gets a scroll dependent offset added (derived from `CounterB9 >> 3`)
1807   06B0             ;* so the planet drifts down as the star background scrolls. `DE` ends up somewhere in `$4800`–`$4BFF` (the background screen).
1808   06B0             ;* The graphic itself is then chosen via `T1E60 -> T1E00` and drawn by `L07DC`.
1809   06B0             ;* The routine only fires when `CounterB9` matches the planet counter (`$43AB`),
1810   06B0             ;* so as the background scrolls a new planet is dropped in at successive slots,
1811   06B0             ;* the slot index (masked to `$1F`) cycles through all 32 `T1E20`/`T1E40` positions.
1812   06B0             ;*****************************************************************************
1813   06B0             AddPlanetsToBackground:
1814   06B0 21 AB 43                           LD      HL,M43AB            ; counter value for (2x2) planets
1815   06B3 3A B9 43                           LD      A,(CounterB9)       ;
1816   06B6 4F                                 LD      C,A                 ;
1817   06B7 BE                                 CP      (HL)                ;
1818   06B8 C0                                 RET     NZ                  ; only when CounterB9 == $43AB
1819   06B9 7E                                 LD      A,(HL)              ; 
1820   06BA 2C                                 INC     L                   ; -> $43AC
1821   06BB 86                                 ADD     A,(HL)              ; + $43AC
1822   06BC 2D                                 DEC     L                   ; 
1823   06BD 77                                 LD      (HL),A              ; $43AB += $43AC  (schedule next planet row)
1824   06BE 2C                                 INC     L                   ; 
1825   06BF 2C                                 INC     L                   ; -> $43AD
1826   06C0 34                                 INC     (HL)                ; $43AD++
1827   06C1 46                                 LD      B,(HL)              ; B = $43AD  (planet X, LSB table)
1828   06C2 2C                                 INC     L                   ; -> $43AE
1829   06C3 34                                 INC     (HL)                ; $43AE++
1830   06C4 7E                                 LD      A,(HL)              ; A = $43AE  (planet X, MSB table)
1831   06C5 21 20 1E                           LD      HL,T1E20            ; MSB's of screen ram for planets
1832   06C8 E6 1F                              AND     $1F                 ; slot index 0..31
1833   06CA 85                                 ADD     A,L                 ; 
1834   06CB 6F                                 LD      L,A                 ; HL = T1E20 + index
1835   06CC 56                                 LD      D,(HL)              ; D = MSB of screen address
1836   06CD C6 20                              ADD     $20                 ; 
1837   06CF 6F                                 LD      L,A                 ; HL = T1E40 + index
1838   06D0 5E                                 LD      E,(HL)              ; E = LSB of screen address  <-- T1E40
1839   06D1 79                                 LD      A,C                 ; C = CounterB9 (scroll phase)
1840   06D2 0F                                 RRCA                        ; 
1841   06D3 0F                                 RRCA                        ; 
1842   06D4 0F                                 RRCA                        ; 
1843   06D5 E6 1E                              AND     $1E                 ; 0001_1111
1844   06D7 83                                 ADD     A,E                 ; add scroll-based vertical offset...
1845   06D8 C6 02                              ADD     $02                 ; ...to the T1E40 LSB
1846   06DA 5F                                 LD      E,A                 ; final DE = planet destination in $48xx-$4Bxx
1847   06DB 21 60 1E                           LD      HL,T1E60            ; graphic-select offsets into T1E00
1848   06DE 78                                 LD      A,B                 ; 
1849   06DF E6 1F                              AND     $1F                 ; 0001_1111
1850   06E1 85                                 ADD     A,L                 ; 
1851   06E2 6F                                 LD      L,A                 ; 
1852   06E3 6E                                 LD      L,(HL)              ; HL = $1E00 + T1E60[j]  -> 2x2 tile data
1853   06E4 CD DC 07                           CALL    L07DC               ; draw the 2x2 planet at DE
1854   06E7 C9                                 RET                         ; 
1855   06E8             
1856   06E8             ;*****************************************************************************
1857   06E8             ;* Print score column
1858   06E8             ;*****************************************************************************
1859   06E8             L06E8:
1860   06E8 21 00 18                           LD      HL,T1800            ; base addr. table for 'screen ram adresses and static texts'
1861   06EB 0E 01                              LD      C,$01               ; 1 column (rotated to 1 row)
1862   06ED C3 D0 01                           JP      PrintTextLines      ;
