8357   38BC             L38BC:
8358   38BC C6 B0                              ADD     $B0                 ; LSB of the wing-mask table
8359   38BE 6F                                 LD      L,A                 ; HL = $3BB0 + B
8360   38BF 26 3B                              LD      H,$3B               ; 
8361   38C1 7E                                 LD      A,(HL)              ; wing pixel-column mask
8362   38C2 A1                                 AND     C                   ; overlap with bullet column?
8363   38C3 C8                                 RET     Z                   ; no -> no wing hit
8364   38C4 CD A1 38                           CALL    L38A1               ; 
8365   38C7 1A                                 LD      A,(DE)              ; 
8366   38C8 D6 0B                              SUB     $0B                 ; 
8367   38CA DA E9 38                           JP      C,L38E9             ; 
8368   38CD FE 03                              CP      $03                 ; 
8369   38CF D2 E9 38                           JP      NC,L38E9            ; if >= $03
8370   38D2 47                                 LD      B,A                 ; 
8371   38D3 62                                 LD      H,D                 ; 
8372   38D4 7B                                 LD      A,E                 ; 
8373   38D5 C6 05                              ADD     $05                 ; 
8374   38D7 6F                                 LD      L,A                 ; 
8375   38D8 3A C6 43                           LD      A,(PlayerBulletX)   ; 
8376   38DB BE                                 CP      (HL)                ; 
8377   38DC 17                                 RLA                         ; 
8378   38DD 07                                 RLCA                        ; Multiply by 4 ..
8379   38DE 07                                 RLCA                        ; ..
8380   38DF E6 04                              AND     $04                 ; 0000_0100
8381   38E1 B0                                 OR      B                   ; 
8382   38E2 C6 B8                              ADD     $B8                 ; 
8383   38E4 6F                                 LD      L,A                 ; 
8384   38E5 26 3D                              LD      H,$3D               ; 
8385   38E7 7E                                 LD      A,(HL)              ; replacement (wing shot off) character
8386   38E8 12                                 LD      (DE),A              ; overwrite the bird tile
8387   38E9             ;*****************************************************************************
8388   38E9             ;* A bird's wing was hit
8389   38E9             ;*****************************************************************************
8390   38E9             L38E9:
8391   38E9 3E FF                              LD      A,$FF               ; set the flag for
8392   38EB 32 66 43                           LD      (M4366),A           ; bird wing hit detected
8393   38EE 01 02 07                           LD      BC,$0702            ; 
8394   38F1 C3 F8 38                           JP      L38F8               ; 
8395   38F4             
8396   38F8                                    .ORG $38F8
8397   38F8             ;
8398   38F8             L38F8:
8399   38F8 21 70 43                           LD      HL,M4370            ; 
8400   38FB             L38FB:
8401   38FB AF                                 XOR     A                   ; A=0
8402   38FC BE                                 CP      (HL)                
8403   38FD CA 06 39                           JP      Z,L3906             ; 
8404   3900 2C                                 INC     L                   
8405   3901 2C                                 INC     L                   
8406   3902 2C                                 INC     L                   
8407   3903 2C                                 INC     L                   
8408   3904 BE                                 CP      (HL)                
8409   3905 C0                                 RET     NZ                  
8410   3906             L3906:
8411   3906 70                                 LD      (HL),B              
8412   3907 2C                                 INC     L                   
8413   3908 71                                 LD      (HL),C              
8414   3909 2C                                 INC     L                   
8415   390A 3A E6 43                           LD      A,(AbovePlayerBulletMSB)
8416   390D 77                                 LD      (HL),A              
8417   390E 2C                                 INC     L                   
8418   390F 3A E7 43                           LD      A,(AbovePlayerBulletLSB)
8419   3912 77                                 LD      (HL),A              
8420   3913 3A C4 43                           LD      A,(PlayerBulletState)
8421   3916 E6 F7                              AND     $F7                 
8422   3918 32 C4 43                           LD      (PlayerBulletState),A
8423   391B C9                                 RET                         
