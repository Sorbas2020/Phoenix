7595   352A 13                                 INC     DE                  ;
7596   352B 23                                 INC     HL                  ;
7597   352C 1A                                 LD      A,(DE)              ;
7598   352D 77                                 LD      (HL),A              ;
7599   352E 13                                 INC     DE                  ;
7600   352F 09                                 ADD     HL,BC               ;
7601   3530             Draw5x2:
7602   3530 1A                                 LD      A,(DE)              ;
7603   3531 77                                 LD      (HL),A              ;
7604   3532 13                                 INC     DE                  ;
7605   3533 23                                 INC     HL                  ;
7606   3534 1A                                 LD      A,(DE)              ;
7607   3535 77                                 LD      (HL),A              ;
7608   3536 13                                 INC     DE                  ;
7609   3537 09                                 ADD     HL,BC               ;
7610   3538             Draw4x2:
7611   3538 1A                                 LD      A,(DE)              ;
7612   3539 77                                 LD      (HL),A              ;
7613   353A 13                                 INC     DE                  ;
7614   353B 23                                 INC     HL                  ;
7615   353C 1A                                 LD      A,(DE)              ;
7616   353D 77                                 LD      (HL),A              ;
7617   353E 13                                 INC     DE                  ;
7618   353F 09                                 ADD     HL,BC               ;
7619   3540             Draw3x2:
7620   3540 1A                                 LD      A,(DE)              ;
7621   3541 77                                 LD      (HL),A              ;
7622   3542 13                                 INC     DE                  ;
7623   3543 23                                 INC     HL                  ;
7624   3544 1A                                 LD      A,(DE)              ;
7625   3545 77                                 LD      (HL),A              ;
7626   3546 13                                 INC     DE                  ;
7627   3547 09                                 ADD     HL,BC               ;
7628   3548             Draw2x2:
7629   3548 1A                                 LD      A,(DE)              ;
7630   3549 77                                 LD      (HL),A              ;
7631   354A 13                                 INC     DE                  ;
7632   354B 23                                 INC     HL                  ;
7633   354C 1A                                 LD      A,(DE)              ;
7634   354D 77                                 LD      (HL),A              ;
7635   354E 13                                 INC     DE                  ;
7636   354F 09                                 ADD     HL,BC               ;
7637   3550             Draw1x2:
7638   3550 1A                                 LD      A,(DE)              ;
7639   3551 77                                 LD      (HL),A              ;
7640   3552 13                                 INC     DE                  ;
7641   3553 23                                 INC     HL                  ;
7642   3554 1A                                 LD      A,(DE)              ;
7643   3555 77                                 LD      (HL),A              ;
7644   3556 13                                 INC     DE                  ;
7645   3557 09                                 ADD     HL,BC               ;
7646   3558             ;
7647   3558             L3558:
7648   3558 36 00                              LD      (HL),$00            ;
7649   355A 23                                 INC     HL                  ;
7650   355B 36 00                              LD      (HL),$00            ;
7651   355D C9                                 RET                         ;
7652   355E             
7653   3560                                    .ORG $3560
7654   3560             ;*****************************************************************************
7655   3560             ;* Bird-launch setup:
7656   3560             ;* Decides the parameters of the next incoming bird group.
7657   3560             ;* Builds a random horizontal jitter, then composes an index from the current game state.
7658   3560             ;* The index is `bit5(timing) | round(bits 3 4) | (BirdsLeft 1)(bits 1 2)`,
7659   3560             ;* which spans `$00`–`$3E` in steps of 2 -> addresses `$3E80`–`$3EBE`.
7660   3560             ;* So the table is 32 two byte entries, selected by:
7661   3560             ;* - Game round (`LevelAndRound`, clamped at round 4) -> one of 4 difficulty groups
7662   3560             ;* - Birds remaining (`BirdsLeft 1`, clamped to 0–3) -> entry within the group
7663   3560             ;* - A timing bit from `Counter9A` -> alternates between the two halves of the table
7664   3560             ;* They're then consumed by the bird movement/attack code.
7665   3560             ;*****************************************************************************
7666   3560             L3560:
7667   3560 CD AA 30                           CALL    GetRandomNumber     ; A = random 0..15
7668   3563 47                                 LD      B,A                 ; 
7669   3564 07                                 RLCA                        ; *2
7670   3565 07                                 RLCA                        ; *4
7671   3566 4F                                 LD      C,A                 ; C = random*4  (used for $436D jitter)
7672   3567 07                                 RLCA                        ; *8
7673   3568 07                                 RLCA                        ; *16
7674   3569 B0                                 OR      B                   ; 
7675   356A 32 6F 43                           LD      (M436F),A           ; $436F = (random<<4)|random
7676   356D 3A B8 43                           LD      A,(LevelAndRound)   ; 
7677   3570 FE 40                              CP      $40                 ; 
7678   3572 DA 77 35                           JP      C,L3577             ; round < 4 -> use as is
7679   3575 3E 30                              LD      A,$30               ; round >= 4 -> clamp
7680   3577             L3577:
7681   3577 E6 30                              AND     $30                 ; 0011_0000 round selector
7682   3579 0F                                 RRCA                        ; -> bits 3-4 : 0,8,$10,$18
7683   357A 47                                 LD      B,A                 ; 
7684   357B 3A BB 43                           LD      A,(BirdsLeft)       ; 
7685   357E 3D                                 DEC     A                   ; 
7686   357F FE 04                              CP      $04                 ; 
7687   3581 DA 86 35                           JP      C,L3586             ; 
7688   3584 3E 03                              LD      A,$03               ; clamp BirdsLeft-1 to 3
7689   3586             L3586:
7690   3586 07                                 RLCA                        ; *2 -> bits 1-2
7691   3587 B0                                 OR      B                   ; 
7692   3588 47                                 LD      B,A                 ; 
7693   3589 3A 9A 43                           LD      A,(Counter9A)       ; 
7694   358C 07                                 RLCA                        ; Multiply by 4 ..
7695   358D 07                                 RLCA                        ; ..
7696   358E E6 20                              AND     $20                 ; timing bit -> bit 5
7697   3590 B0                                 OR      B                   ; 
7698   3591 C6 80                              ADD     $80                 ; LSB of $3E80
7699   3593 6F                                 LD      L,A                 ; 
7700   3594 26 3E                              LD      H,$3E               ; HL = $3E80 + index
7701   3596 7E                                 LD      A,(HL)              ; byte0
7702   3597 32 6E 43                           LD      (M436E),A           ; $436E = T3E80 byte0  (bird count/size)
7703   359A 2C                                 INC     L                   ; 
7704   359B 7E                                 LD      A,(HL)              ; byte1
7705   359C 81                                 ADD     A,C                 ; + random jitter (random<<2)
7706   359D E6 F8                              AND     $F8                 ; 1111_1000 align to 8-pixel grid
7707   359F 32 6D 43                           LD      (M436D),A           ; $436D = T3E80 byte1 + jitter (start X)
7708   35A2 C9                                 RET                         ; 
7709   35A3             
7710   35B0                                    .ORG $35B0
7711   35B0             ;*****************************************************************************
7712   35B0             ;* The dispatch trick:
7713   35B0             ;* `L35B0` is called with `HL` -> the bird's record.
7714   35B0             ;* It reads the state index at record offset +0, then (crucially) advances `HL`
7715   35B0             ;* to offset +4 and passes that pointer along.
7716   35B0             ;* It then looks up `T3F00 + index*8` and pushes four 16 bit values, then does `RET`.
7717   35B0             ;*****************************************************************************
7718   35B0             L35B0:
7719   35B0 7E                                 LD      A,(HL)              ; get index character block shape
7720   35B1 A7                                 AND     A                   ; updates the zero flag
7721   35B2 C8                                 RET     Z                   ; if index is 0
7722   35B3 47                                 LD      B,A                 ; save index to B
7723   35B4 2C                                 INC     L                   ; +1
7724   35B5 2C                                 INC     L                   ; +2
7725   35B6 2C                                 INC     L                   ; +3
7726   35B7 2C                                 INC     L                   ; +4
7727   35B8 7E                                 LD      A,(HL)              ; $4B74 timer
7728   35B9 A7                                 AND     A                   ; updates the zero flag
7729   35BA CA BE 35                           JP      Z,L35BE             ; 
7730   35BD 35                                 DEC     (HL)                ; count down
7731   35BE             L35BE:
7732   35BE EB                                 EX      DE,HL               ; DE = bird record + 4
7733   35BF D5                                 PUSH    DE                  ; (1) push bird pointer(+4)
7734   35C0 78                                 LD      A,B                 ; state index
7735   35C1 07                                 RLCA                        ; Multiply by 8 ..
7736   35C2 07                                 RLCA                        ; ..
7737   35C3 07                                 RLCA                        ; ..
7738   35C4 6F                                 LD      L,A                 ; 
7739   35C5 26 3F                              LD      H,$3F               ; HL = T3F00 + index*8
7740   35C7 46                                 LD      B,(HL)              ; +0,+1
7741   35C8 23                                 INC     HL                  ; 
7742   35C9 4E                                 LD      C,(HL)              ; get 2nd byte
7743   35CA C5                                 PUSH    BC                  ; (2) push "BC constant"
7744   35CB 23                                 INC     HL                  ; +2,+3
7745   35CC 46                                 LD      B,(HL)              ; get 3rd byte
7746   35CD 23                                 INC     HL                  ; 
7747   35CE 4E                                 LD      C,(HL)              ; get 4rd byte
7748   35CF C5                                 PUSH    BC                  ; (3) push "DE constant"
7749   35D0 23                                 INC     HL                  ; +4,+5
7750   35D1 46                                 LD      B,(HL)              ; get MSB of 1st address
7751   35D2 23                                 INC     HL                  ; 
7752   35D3 4E                                 LD      C,(HL)              ; get LSB of 1st address
7753   35D4 C5                                 PUSH    BC                  ; (4) push 1st address
7754   35D5 23                                 INC     HL                  ; +6,+7
7755   35D6 46                                 LD      B,(HL)              ; get MSB of 2nd address
7756   35D7 23                                 INC     HL                  ; 
7757   35D8 4E                                 LD      C,(HL)              ; get LSB of 2nd address
7758   35D9 C5                                 PUSH    BC                  ; (5) push 2nd address
7759   35DA EB                                 EX      DE,HL               ; HL = bird record + 4 again
7760   35DB C9                                 RET                         ; calls the 2nd address
7761   35DC             ;*****************************************************************************
7762   35DC             ;* Because the 2nd address was pushed last, `RET` jumps there first. So the sequence is:
7763   35DC             ;* 1. `RET` -> 2nd address (`$35E0` or `$36C0`) runs first, with `HL` = bird record +4.
7764   35DC             ;*    These are the movement / animation routines. They do their work and finish with their own `RET`.
7765   35DC             ;* 2. That `RET` pops the next stack item — the 1st address (`$36CC`, `$36D2`, `$36EA`, or `$370A`)
7766   35DC             ;*     — and jumps there. These are the state transition routines.
7767   35DC             ;*     They begin by popping the two constants and the bird pointer back off the stack.
7768   35DC             ;*****************************************************************************
7769   35DC             
7770   35E0                                    .ORG $35E0
7771   35E0             ; called by $35B0
7772   35E0             L35E0:
7773   35E0 2C                                 INC     L                   ; -> +5
7774   35E1 2C                                 INC     L                   ; -> +6
7775   35E2 7E                                 LD      A,(HL)              ; A = $4B76 (step)
7776   35E3 FE 10                              CP      $10                 ; 
7777   35E5 D2 28 36                           JP      NC,L3628            ; step >= $10 -> special handling
7778   35E8 47                                 LD      B,A                 ; 
7779   35E9 2D                                 DEC     L                   ; -> +5 (grid X)
7780   35EA 86                                 ADD     A,(HL)              ; 
7781   35EB 77                                 LD      (HL),A              ; grid X += step
7782   35EC 2D                                 DEC     L                   ; -> +4
7783   35ED 2D                                 DEC     L                   ; -> +3 (animation phase)
7784   35EE 78                                 LD      A,B                 ; 
7785   35EF 86                                 ADD     A,(HL)              ; 
7786   35F0 77                                 LD      (HL),A              ; animation phase += step
7787   35F1 FE 08                              CP      $08                 ; 
7788   35F3 DA 6A 36                           JP      C,L366A             ; 
7789   35F6 E6 07                              AND     $07                 ; 0000_0111
7790   35F8 77                                 LD      (HL),A              ; phase wraps mod 8
7791   35F9 2D                                 DEC     L                   ; 
7792   35FA 7E                                 LD      A,(HL)              ; 
7793   35FB D6 20                              SUB     $20                 ; 
7794   35FD 77                                 LD      (HL),A              ; 
7795   35FE D2 04 36                           JP      NC,L3604            ; 
7796   3601 2D                                 DEC     L                   ; 
7797   3602 35                                 DEC     (HL)                ; 
7798   3603 2C                                 INC     L                   ; 
7799   3604             L3604:
7800   3604 2C                                 INC     L                   ; 
7801   3605 2C                                 INC     L                   ; 
7802   3606 2C                                 INC     L                   ; 
7803   3607 4E                                 LD      C,(HL)              ; 
7804   3608 2C                                 INC     L                   ; 
7805   3609 2C                                 INC     L                   ; 
7806   360A 7E                                 LD      A,(HL)              ; 
7807   360B 2D                                 DEC     L                   ; 
7808   360C 36 10                              LD      (HL),$10            ; 
7809   360E 91                                 SUB     C                   ; 
7810   360F CA 72 36                           JP      Z,L3672             ; 
7811   3612 3D                                 DEC     A                   ; 
7812   3613 0F                                 RRCA                        ; 
7813   3614 0F                                 RRCA                        ; 
7814   3615 0F                                 RRCA                        ; 
7815   3616 E6 1F                              AND     $1F                 ; 0001_1111
7816   3618 B8                                 CP      B                   ; 
7817   3619 3C                                 INC     A                   ; 
7818   361A 77                                 LD      (HL),A              ; 
7819   361B D8                                 RET     C                   ; 
7820   361C 3A 6E 43                           LD      A,(M436E)           ; target count
7821   361F 77                                 LD      (HL),A              ; 
7822   3620 B8                                 CP      B                   ; 
7823   3621 C8                                 RET     Z                   ; 
7824   3622 04                                 INC     B                   ; 
7825   3623 70                                 LD      (HL),B              ; 
7826   3624 C9                                 RET                         ; 
7827   3625             
7828   3628                                    .ORG $3628
7829   3628             L3628:
7830   3628 E6 0F                              AND     $0F                 ; 0000_1111
7831   362A CA 44 37                           JP      Z,L3744             ; 
7832   362D 47                                 LD      B,A                 ; 
7833   362E 2D                                 DEC     L                   ; 
7834   362F 7E                                 LD      A,(HL)              ; 
7835   3630 90                                 SUB     B                   ; 
7836   3631 77                                 LD      (HL),A              ; 
7837   3632 2D                                 DEC     L                   ; 
7838   3633 2D                                 DEC     L                   ; 
7839   3634 7E                                 LD      A,(HL)              ; 
7840   3635 90                                 SUB     B                   ; 
7841   3636 77                                 LD      (HL),A              ; 
7842   3637 D2 95 36                           JP      NC,L3695            ; 
7843   363A E6 07                              AND     $07                 ; 0000_0111
7844   363C 77                                 LD      (HL),A              ; 
7845   363D 2D                                 DEC     L                   ; 
7846   363E 7E                                 LD      A,(HL)              ; 
7847   363F C6 20                              ADD     $20                 ; 
7848   3641 77                                 LD      (HL),A              ; 
7849   3642 D2 48 36                           JP      NC,L3648            ; 
7850   3645 2D                                 DEC     L                   ; 
7851   3646 34                                 INC     (HL)                ; 
7852   3647 2C                                 INC     L                   ; 
7853   3648             L3648:
7854   3648 2C                                 INC     L                   
7855   3649 2C                                 INC     L                   
7856   364A 2C                                 INC     L                   
7857   364B 7E                                 LD      A,(HL)              
7858   364C 2C                                 INC     L                   
7859   364D 2C                                 INC     L                   
7860   364E 96                                 SUB     (HL)                
7861   364F 0F                                 RRCA                        
7862   3650 0F                                 RRCA                        
7863   3651 0F                                 RRCA                        
7864   3652 E6 1F                              AND     $1F                 
7865   3654 B8                                 CP      B                   
7866   3655 3C                                 INC     A                   
7867   3656 2D                                 DEC     L                   
7868   3657 DA 63 36                           JP      C,L3663             ; 
7869   365A 3A 6E 43                           LD      A,(M436E)           ; 
7870   365D B8                                 CP      B                   
7871   365E CA 63 36                           JP      Z,L3663             ; 
7872   3661 78                                 LD      A,B                 
7873   3662 3C                                 INC     A                   
7874   3663             L3663:
7875   3663 F6 10                              OR      $10                 
7876   3665 77                                 LD      (HL),A              
7877   3666 C9                                 RET                         
