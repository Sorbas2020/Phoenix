3028   0CE7 C6 20                              ADD     $20                 
3029   0CE9 5F                                 LD      E,A                 
3030   0CEA 50                                 LD      D,B                 
3031   0CEB A7                                 AND     A                   ; updates the zero flag
3032   0CEC C2 DE 0C                           JP      NZ,L0CDE            ; loop for all bullet slots
3033   0CEF C9                                 RET                         
3034   0CF0             
