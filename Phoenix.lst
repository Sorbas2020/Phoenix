1892   0718                                    .ORG $0718
1893   0718             ;*****************************************************************************
1894   0718             ;* Draw or delete screen objects dep. on control state of player, alien and bullet.
1895   0718             ;*****************************************************************************
1896   0718             UpdateScreenObjects:
1897   0718 CD 20 07                           CALL    Bit4Controller      ; for deleting screen objects
1898   071B C3 40 07                           JP      Bit3Controller      ; for drawing screen objects
1899   071E             
1900   0720                                    .ORG $0720
1901   0720             ;*****************************************************************************
1902   0720             ;* Handles the bit4 actions for deleting screen objects.
1903   0720             ;*****************************************************************************
1904   0720             Bit4Controller:
1905   0720 0A                                 LD      A,(BC)              ; get value from data structure (grid)
1906   0721 67                                 LD      H,A                 ; save the bits
1907   0722 E6 10                              AND     $10                 ; mask out 0001_0000 (bit4 of control state A)
1908   0724 C8                                 RET     Z                   ; ret if bit not set.
1909   0725 7C                                 LD      A,H                 ; restore the bits
1910   0726 E6 EF                              AND     $EF                 ; mask out 1110_1111
1911   0728 02                                 LD      (BC),A              ; save to control state A
1912   0729 07                                 RLCA                        ; Multiply by 8 ..
1913   072A 07                                 RLCA                        ; ..
1914   072B 07                                 RLCA                        ; ..
1915   072C E6 07                              AND     $07                 ; mask out 0000_0111
1916   072E C6 38                              ADD     $38                 ; add to base for jump table
1917   0730 6F                                 LD      L,A                 ;
1918   0731 26 07                              LD      H,T0735 >> 8        ; MSB for jump table
1919   0733 6E                                 LD      L,(HL)              ;
1920   0734 E9                                 JP      (HL)                ; jump to control function
1921   0735             
1922   0735             ; LSB jump table:
1923   0735             ;.....not used
1924   0735             ;........not used
1925   0735             ;...........not used
1926   0735             ;..............0763..................control state A: 0001_xxxx...Delete 1x1 screen objects.
1927   0735             ;.................0779...............control state A: 0011_xxxx...Delete 2x1 screen objects.
1928   0735             ;....................not used
1929   0735             ;.......................079E.........control state A: 0111_xxxx...Delete 1x2 screen objects.
1930   0735             ;..........................07BE......control state A: 1001_xxxx...Delete 2x2 screen objects.
1931   0735             T0735:
1932   0735 00 00 00 63                        .DB $00, $00, $00, L0763 & $FF, L0779 & $FF, $00, L079E & $FF, L07BE & $FF
1932   0739 79 00 9E BE 
1933   073D             
1934   0740                                    .ORG $0740
1935   0740             ;*****************************************************************************
1936   0740             ;* Handles the bit3 actions for drawing screen objects.
1937   0740             ;*****************************************************************************
1938   0740             Bit3Controller:
1939   0740 0A                                 LD      A,(BC)              ; get value from data structure (grid)
1940   0741 67                                 LD      H,A                 ; save it
1941   0742 E6 08                              AND     $08                 ; mask out 0000_1000 (bit3 of control state A)
1942   0744 C8                                 RET     Z                   ; ret if bit not set.
1943   0745 7C                                 LD      A,H                 ; restore the bits
1944   0746 E6 07                              AND     $07                 ; mask out 0000_0111
1945   0748 67                                 LD      H,A                 ; save it
1946   0749 0F                                 RRCA                        ; Divide by 8 ..
1947   074A 0F                                 RRCA                        ; ..
1948   074B 0F                                 RRCA                        ; ..
1949   074C B4                                 OR      H                   ; add original bits
1950   074D F6 18                              OR      $18                 ; set 0001_1000 flag
1951   074F 02                                 LD      (BC),A              ; set the bits at control state A
1952   0750 03                                 INC     BC                  ; go to control state B
1953   0751 7C                                 LD      A,H                 ;
1954   0752 C6 5B                              ADD     $5B                 ; add to base for jump table
1955   0754 6F                                 LD      L,A                 ;
1956   0755 26 07                              LD      H,T0759 >> 8        ; MSB for jump table
1957   0757 6E                                 LD      L,(HL)              ;
1958   0758 E9                                 JP      (HL)                ; jump to control function
1959   0759             
1960   0759             ; LSB jump table:
1961   0759             ;.....not used
1962   0759             ;........not used
1963   0759             ;...........076D.....................control state A: xxxx_1000...Draw 1x1 screen objects.
1964   0759             ;..............0788..................control state A: xxxx_1001...Draw 2x1 screen objects.
1965   0759             ;.................not used
1966   0759             ;....................07AA............control state A: xxxx_1011...Draw 1x2 screen objects.
1967   0759             ;.......................07D2.........control state A: xxxx_1100...Draw 2x2 screen objects.
1968   0759             ;..........................not used
1969   0759             T0759:
1970   0759 00 00 6D 88                        .DB $00, $00, L076D & $FF, L0788 & $FF, $00, L07AA & $FF, L07D2 & $FF
1970   075D 00 AA D2 
