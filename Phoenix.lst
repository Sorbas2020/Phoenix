7049   31CD B8                                 CP      B                   
7050   31CE D2 D6 31                           JP      NC,L31D6            ; 
7051   31D1 4F                                 LD      C,A                 
7052   31D2 78                                 LD      A,B                 
7053   31D3 41                                 LD      B,C                 
7054   31D4 0E 00                              LD      C,$00               
7055   31D6             L31D6:
7056   31D6 90                                 SUB     B                   
7057   31D7 07                                 RLCA                        ; Multiply by 8 ..
7058   31D8 07                                 RLCA                        ; ..
7059   31D9 07                                 RLCA                        ; ..
7060   31DA E6 07                              AND     $07                 
7061   31DC C6 00                              ADD     $00                 ; LSB for table T3300
7062   31DE 6F                                 LD      L,A                 
7063   31DF 26 33                              LD      H,$33               ; get MSB for table T3300
7064   31E1 7E                                 LD      A,(HL)              
7065   31E2 81                                 ADD     A,C                 
7066   31E3 07                                 RLCA                        ; Multiply by 4 ..
7067   31E4 07                                 RLCA                        ; ..
7068   31E5 4F                                 LD      C,A                 
7069   31E6 00                                 NOP                         
7070   31E7 00                                 NOP                         
7071   31E8 00                                 NOP                         
7072   31E9 3A 57 43                           LD      A,(M4357)           ; 
7073   31EC 47                                 LD      B,A                 
7074   31ED CD 10 32                           CALL    L3210               ; 
7075   31F0 79                                 LD      A,C                 
7076   31F1 80                                 ADD     A,B                 
7077   31F2 C6 10                              ADD     $10                 ; LSB for table T3310
7078   31F4 6F                                 LD      L,A                 
7079   31F5 26 33                              LD      H,$33               ; get MSB for table T3310
7080   31F7 4E                                 LD      C,(HL)              
7081   31F8 CD AA 30                           CALL    GetRandomNumber     ; 
7082   31FB E6 06                              AND     $06                 
7083   31FD 81                                 ADD     A,C                 
7084   31FE 6F                                 LD      L,A                 
7085   31FF 26 33                              LD      H,$33               ; get MSB for table T3330 (base adresses of closed loops pattern tables for aliens)
7086   3201 7E                                 LD      A,(HL)              
7087   3202 2C                                 INC     L                   
