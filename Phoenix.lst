7422   34C0             ;*****************************************************************************
7423   34C0             ;* Draw a given bird object.
7424   34C0             ;* Input HL is the data structur of one bird object.
7425   34C0             ;* (For the 8 birds: $4B70, $4B78, $4B80, $4B88, $4B90, $4B98, $4BA0, $4BA8)
7426   34C0             ;*****************************************************************************
7427   34C0             DrawBirdObject:
7428   34C0 7E                                 LD      A,(HL)              ; HL=$4B70 (or $4B78,...)
7429   34C1 A7                                 AND     A                   ; updates the zero flag
7430   34C2 C8                                 RET     Z                   ; if 0
7431   34C3 47                                 LD      B,A                 ; save it
7432   34C4 C6 C0                              ADD     $C0                 ; add to base for table T3EC0
7433   34C6 5F                                 LD      E,A                 ; save it
7434   34C7 16 3E                              LD      D,$3E               ; MSB for T3EC0
7435   34C9 1A                                 LD      A,(DE)              ; get data starting from $3EC1
7436   34CA 4F                                 LD      C,A                 ;
7437   34CB 2C                                 INC     L                   ;
7438   34CC 56                                 LD      D,(HL)              ; get $4B71 MSB of screen ram
7439   34CD 2C                                 INC     L                   ;
7440   34CE 5E                                 LD      E,(HL)              ; get $4B72 LSB of screen ram
7441   34CF 2C                                 INC     L                   ;
7442   34D0 78                                 LD      A,B                 ; restore it
7443   34D1 07                                 RLCA                        ; Multiply by 8 ..
7444   34D2 07                                 RLCA                        ; ..
7445   34D3 07                                 RLCA                        ; ..
7446   34D4 86                                 ADD     A,(HL)              ; and add to $4B73 alien0 screen coordinate Y
7447   34D5 E6 7E                              AND     $7E                 ; mask out 0111_1110
7448   34D7 6F                                 LD      L,A                 ;
7449   34D8 26 3E                              LD      H,$3E               ;
7450   34DA 7E                                 LD      A,(HL)              ; get MSB from address table for bird character block shapes (T3E08)
7451   34DB 2C                                 INC     L                   ;
7452   34DC 6E                                 LD      L,(HL)              ; get LSB
7453   34DD 67                                 LD      H,A                 ;
7454   34DE             L34DE:
7455   34DE 7A                                 LD      A,D                 ;
7456   34DF FE 4B                              CP      $4B                 ; MSB of screen ram
7457   34E1 C2 0C 35                           JP      NZ,L350C            ; if value is not equal $4B
7458   34E4 7B                                 LD      A,E                 ;
7459   34E5 FE 50                              CP      $50                 ;
7460   34E7 DA 0C 35                           JP      C,L350C             ; 
7461   34EA 06 08                              LD      B,$08               ;
7462   34EC 2C                                 INC     L                   ;
7463   34ED 2C                                 INC     L                   ;
7464   34EE D6 20                              SUB     $20                 ;
7465   34F0 5F                                 LD      E,A                 ;
7466   34F1 FE 50                              CP      $50                 ;
7467   34F3 DA 09 35                           JP      C,L3509             ; 
7468   34F6 06 10                              LD      B,$10               ;
7469   34F8 2C                                 INC     L                   ;
7470   34F9 2C                                 INC     L                   ;
7471   34FA D6 20                              SUB     $20                 ;
7472   34FC 5F                                 LD      E,A                 ;
7473   34FD FE 50                              CP      $50                 ;
7474   34FF DA 09 35                           JP      C,L3509             ; 
7475   3502 06 18                              LD      B,$18               ;
7476   3504 2C                                 INC     L                   ;
7477   3505 2C                                 INC     L                   ;
7478   3506 D6 20                              SUB     $20                 ;
7479   3508 5F                                 LD      E,A                 ;
7480   3509             ;
7481   3509             L3509:
7482   3509 79                                 LD      A,C                 ;
7483   350A 80                                 ADD     A,B                 ;
7484   350B 4F                                 LD      C,A                 ;
7485   350C             ;
7486   350C             L350C:
