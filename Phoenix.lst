5037   20B5 36 00                              LD      (HL),$00            
5038   20B7 0F                                 RRCA                        
5039   20B8 D2 BF 20                           JP      NC,L20BF            ; 
5040   20BB EB                                 EX      DE,HL               
5041   20BC 4E                                 LD      C,(HL)              
5042   20BD EB                                 EX      DE,HL               ; get data from $2800
5043   20BE 71                                 LD      (HL),C              
5044   20BF             L20BF:
5045   20BF 23                                 INC     HL                  
5046   20C0 13                                 INC     DE                  
5047   20C1 05                                 DEC     B                   
5048   20C2 C2 B5 20                           JP      NZ,L20B5            ; 
5049   20C5 E3                                 EX      (SP),HL             
5050   20C6 23                                 INC     HL                  
5051   20C7 7D                                 LD      A,L                 
5052   20C8 0F                                 RRCA                        
5053   20C9 DA B1 20                           JP      C,L20B1             ; 
5054   20CC 7D                                 LD      A,L                 
5055   20CD E6 1F                              AND     $1F                 
5056   20CF CA E1 20                           JP      Z,L20E1             ; 
5057   20D2 E3                                 EX      (SP),HL             
5058   20D3 7D                                 LD      A,L                 
5059   20D4 D6 30                              SUB     $30                 
5060   20D6 6F                                 LD      L,A                 
5061   20D7 7C                                 LD      A,H                 
5062   20D8 DE 00                              SBC     $00                 
5063   20DA 67                                 LD      H,A                 
5064   20DB E3                                 EX      (SP),HL             
5065   20DC FE 3F                              CP      $3F                 
5066   20DE C2 B1 20                           JP      NZ,L20B1            ; 
5067   20E1             L20E1:
5068   20E1 C1                                 POP     BC                  
5069   20E2 C9                                 RET                         
5070   20E3             
5071   20E8                                    .ORG $20E8
5072   20E8             ;*****************************************************************************
5073   20E8             ;* Draw one 4x4 ship-fragment sprite during the player-ship explosion.
5074   20E8             ;* Entry (from L0BC4): A = CounterA5 phase, DE = ship screen address.
5075   20E8             ;* Fragment image pointer comes from T1B90; position is scattered using
5076   20E8             ;* CounterB9 (via L211C) and the phase.
5077   20E8             ;* Purpose:
5078   20E8             ;* `L20E8` draws the flying debris sprites of the exploding player ship
5079   20E8             ;* (fragment image chosen from `T1B90`, scattered by `CounterB9`/phase,
5080   20E8             ;* `L211C` freezing the scroll).
5081   20E8             ;*****************************************************************************
5082   20E8             L20E8:
5083   20E8 47                                 LD      B,A                 ; B = phase (CounterA5)
5084   20E9 7A                                 LD      A,D                 ; 
5085   20EA C6 08                              ADD     $08                 ; nudge the row
5086   20EC 57                                 LD      D,A                 ; 
5087   20ED CD 1C 21                           CALL    L211C               ; {code.L211C} clamp scroll during explosion
5088   20F0 0F                                 RRCA                        ; 
5089   20F1 0F                                 RRCA                        ; scatter offset from CounterB9
5090   20F2 0F                                 RRCA                        ; 
5091   20F3 83                                 ADD     A,E                 ; 
5092   20F4 E6 1F                              AND     $1F                 ; 0001_1111 keep within a column
5093   20F6 4F                                 LD      C,A                 ; 
5094   20F7 7B                                 LD      A,E                 ; 
5095   20F8 E6 E0                              AND     $E0                 ; 1110_0000 column bits
5096   20FA B1                                 OR      C                   ; 
5097   20FB 5F                                 LD      E,A                 ; E = scattered LSB
5098   20FC 78                                 LD      A,B                 ; phase
5099   20FD 0F                                 RRCA                        ; 
5100   20FE 0F                                 RRCA                        ; 
5101   20FF E6 0E                              AND     $0E                 ; 0000_1110 -> even index 0..14
5102   2101 C6 90                              ADD     $90                 ; -> T1B90 entry
5103   2103 6F                                 LD      L,A                 ; 
5104   2104 26 1B                              LD      H,$1B               ; HL = T1B90 + index
5105   2106 7E                                 LD      A,(HL)              ; fragment image MSB
5106   2107 2C                                 INC     L                   ; 
5107   2108 6E                                 LD      L,(HL)              ; fragment image LSB
5108   2109 67                                 LD      H,A                 ; HL = fragment image
5109   210A 01 04 04                           LD      BC,$0404            ; images are 4x4images are 4x4
5110   210D C3 D6 0A                           JP      DrawImageCbyB       ; draw it
5111   2110             
5112   211C                                    .ORG $211C
5113   211C             ;*****************************************************************************
5114   211C             ;* Clamp the scroll register to $10 while CounterB9 is in ($10,$30).
5115   211C             ;*****************************************************************************
5116   211C             L211C:
5117   211C 21 B9 43                           LD      HL,CounterB9        ; 
5118   211F 7E                                 LD      A,(HL)              
5119   2120 FE 10                              CP      $10                 
5120   2122 D8                                 RET     C                   
5121   2123 FE 30                              CP      $30                 
5122   2125 D0                                 RET     NC                  
5123   2126 3E 10                              LD      A,$10               
5124   2128 77                                 LD      (HL),A              
5125   2129 32 00 58                           LD      (scrollRegister),A  ; 58xx scroll register
5126   212C C9                                 RET                         
5127   212D             
5128   2130                                    .ORG $2130
5129   2130             ;*****************************************************************************
5130   2130             ;* Per-frame update dispatchers for the alien-wave levels.
5131   2130             ;* B = frame phase (rotating counter). Each phase runs a different subset of
5132   2130             ;* the heavy per-frame work, spreading it across frames.
5133   2130             ;* `L2130`/`L2146`/`L21BA` are the game's per frame level dispatchers:
5134   2130             ;* A rotating frame phase counter (`B`) selects one of several groups of update calls
5135   2130             ;* (`AlienDataController`, `AlienBehaviorUpdate`, `AlienMovementUpdate`,
5136   2130             ;* `AlienAnimationUpdate`, `EnemyBulletUpdate`, collision `L0F00`, killed alien anim `L0FC0`,
5137   2130             ;* bomb drop `L2560`, mothership housekeeping `L24C4`),
5138   2130             ;* so the heavy work is spread over multiple frames.
5139   2130             ;*****************************************************************************
5140   2130             L2130:
5141   2130 78                                 LD      A,B                 ; frame phase
5142   2131 A7                                 AND     A                   ; updates the zero flag
5143   2132 CA 50 21                           JP      Z,L2150             ; phase 0
5144   2135 FE 01                              CP      $01                 ;
5145   2137 CA 60 21                           JP      Z,L2160             ; phase 1
5146   213A FE 02                              CP      $02                 ;
5147   213C CA 70 21                           JP      Z,L2170             ; phase 2
5148   213F C3 80 21                           JP      L2180               ; phase 3
5149   2142             
5150   2146                                    .ORG $2146
5151   2146             ;*****************************************************************************
5152   2146             ;* Game's per frame level dispatcher (even/odd phase)
5153   2146             ;*****************************************************************************
5154   2146             L2146:
5155   2146 78                                 LD      A,B                 ; 
5156   2147 0F                                 RRCA                        ; test phase bit 0
5157   2148 D2 90 21                           JP      NC,L2190            ; even phase
5158   214B C3 A5 21                           JP      L21A5               ; odd phase
5159   214E             
5160   2150                                    .ORG $2150
5161   2150             ;*****************************************************************************
5162   2150             ;* Phase 0
5163   2150             ;*****************************************************************************
5164   2150             L2150:
5165   2150 CD 50 0A                           CALL    AlienDataController ; draw or delete alien
5166   2153 CD 00 30                           CALL    L3000               ; AlienBehaviorUpdate
5167   2156 C3 00 0F                           JP      L0F00               ; 'alien with player' collision check
5168   2159             
5169   2160                                    .ORG $2160
5170   2160             ;*****************************************************************************
5171   2160             ;* Phase 1
5172   2160             ;*****************************************************************************
5173   2160             L2160:
5174   2160 CD C4 24                           CALL    L24C4               ; background / mothership housekeeping
5175   2163 CD 40 0C                           CALL    L0C40               ; EnemyBulletUpdate
5176   2166 CD 1C 0D                           CALL    L0D1C               ; AlienMovementUpdate
5177   2169 C3 C0 0F                           JP      L0FC0               ; Handle animations for killed aliens
5178   216C             
5179   2170                                    .ORG $2170
5180   2170             ;*****************************************************************************
5181   2170             ;* Phase 2
5182   2170             ;*****************************************************************************
5183   2170             L2170:
5184   2170 CD 70 0D                           CALL    L0D70               ; AlienAnimationUpdate
5185   2173 C3 60 25                           JP      L2560               ; try to drop a bomb on the player
5186   2176             
5187   2180                                    .ORG $2180
5188   2180             ;*****************************************************************************
5189   2180             ;* Phase 3
5190   2180             ;*****************************************************************************
5191   2180             L2180:
5192   2180 CD C4 24                           CALL    L24C4               ; background / mothership housekeeping
5193   2183 CD 40 0C                           CALL    L0C40               ; EnemyBulletUpdate
5194   2186 CD 6C 0A                           CALL    L0A6C               ; get screen ram adress for all aliens
5195   2189 C3 C0 0F                           JP      L0FC0               ; Handle animations for killed aliens
5196   218C             
5197   2190                                    .ORG $2190
5198   2190             ;
5199   2190             L2190:
5200   2190 CD 50 0A                           CALL    AlienDataController ; draw or delete alien
5201   2193 CD 00 30                           CALL    L3000               ; AlienBehaviorUpdate
5202   2196 CD 00 0F                           CALL    L0F00               ; 'alien with player' collision check
5203   2199 CD 60 25                           CALL    L2560               ; try to drop a bomb
5204   219C C3 40 0C                           JP      L0C40               ; EnemyBulletUpdate
5205   219F             
5206   21A5                                    .ORG $21A5
5207   21A5             ;
5208   21A5             L21A5:
5209   21A5 CD 1C 0D                           CALL    L0D1C               ; AlienMovementUpdate
5210   21A8 CD 70 0D                           CALL    L0D70               ; AlienAnimationUpdate
5211   21AB CD 6C 0A                           CALL    L0A6C               ; get screen ram adress for all aliens
5212   21AE CD C0 0F                           CALL    L0FC0               ; Handle animations for killed aliens
5213   21B1 C3 C4 24                           JP      L24C4               ; background / mothership housekeeping
5214   21B4             
5215   21BA                                    .ORG $21BA
5216   21BA             ;*****************************************************************************
5217   21BA             ;* Mothership-wave dispatcher (and end-of-wave handling).
5218   21BA             ;*****************************************************************************
5219   21BA             L21BA:
5220   21BA 78                                 LD      A,B                 ;
5221   21BB 0F                                 RRCA                        ; test phase bit 0
5222   21BC D2 04 22                           JP      NC,L2204            ; even phase: end-of-wave countdown (L2204)
5223   21BF CD 40 0C                           CALL    L0C40               ; EnemyBulletUpdate
5224   21C2 CD C0 0F                           CALL    L0FC0               ; Handle animations for killed aliens
5225   21C5 CD C4 24                           CALL    L24C4               ; mothership housekeeping
5226   21C8 3A B8 43                           LD      A,(LevelAndRound)   ; 
5227   21CB E6 0F                              AND     $0F                 ; mask out 0000_1111
5228   21CD FE 0B                              CP      $0B                 ;
5229   21CF DA 04 22                           JP      C,L2204             ; if < game level B
5230   21D2 3E 10                              LD      A,$10               ; 16 aliens for a new wave
5231   21D4 32 BA 43                           LD      (AliensLeft),A      ; 
5232   21D7 C3 26 05                           JP      L0526               ; init alien data
5233   21DA             
5234   21DC                                    .ORG $21DC
5235   21DC             ;*****************************************************************************
5236   21DC             ;* Handles the bird animation at intro.
5237   21DC             ;* The driver is a single counter, `M4399` 
5238   21DC             ;* (the "slow-print" timer that advances during the intro splash).
5239   21DC             ;* Its bits are split into two roles:
5240   21DC             ;* - `M4399 & 7` -> the bird's animation sub-phase 
5241   21DC             ;*   (written to bird-object byte +3, `$4B73`).
5242   21DC             ;*   This cycles the wing position 0–7 within the current shape.
5243   21DC             ;* - `M4399 >> 3` -> the index into `T233A`, which yields the shape index 
5244   21DC             ;*   (written to bird-object byte +0, `$4B70`).
5245   21DC             ;* In other words, each entry in `T233A` is held for 8 timer ticks
5246   21DC             ;* (one full pass of the low-3-bit phase) before the script advances to the next shape.
5247   21DC             ;* `T233A` is therefore "the shape every 8 frames", and the low bits provide the in-between wing flapping.
5248   21DC             ;*****************************************************************************
5249   21DC             DrawIntroBirdAnimationFrame:
5250   21DC 7E                                 LD      A,(HL)              ; {ram.M4399} Actual index for slow print at intro splash (starts with $300)
5251   21DD 00                                 NOP                         ;
5252   21DE 47                                 LD      B,A                 ; save it
5253   21DF 21 73 4B                           LD      HL,B4B73            ; used as temp memory
5254   21E2 E6 07                              AND     $07                 ; mask out 0000_0111 in order to count from 0 to 7
5255   21E4 77                                 LD      (HL),A              ; save it
5256   21E5 2D                                 DEC     L                   ;
5257   21E6 36 EF                              LD      (HL),$EF            ; use $4B72 for LSB of screen ram
5258   21E8 2D                                 DEC     L                   ;
5259   21E9 36 49                              LD      (HL),$49            ; use $4B71 for MSB of screen ram
5260   21EB 2D                                 DEC     L                   ; $4B70 (bird0 index character block shape)
5261   21EC 78                                 LD      A,B                 ; restore $4399
5262   21ED E6 F8                              AND     $F8                 ; mask out 1111_1000
5263   21EF 0F                                 RRCA                        ; Divide by 8 ..
5264   21F0 0F                                 RRCA                        ; ..
5265   21F1 0F                                 RRCA                        ; ..
5266   21F2 C6 3A                              ADD     T233A & $FF         ; LSB of T233A
5267   21F4 5F                                 LD      E,A                 ;
5268   21F5 16 23                              LD      D,T233A >> 8        ; MSB of T233A
5269   21F7 1A                                 LD      A,(DE)              ; get data starting at T233A for animation frame index
5270   21F8 77                                 LD      (HL),A              ; write to $4B70
5271   21F9 CD C0 34                           CALL    DrawBirdObject      ; draw the bird at intro
5272   21FC C3 E0 1E                           JP      L1EE0               ; Copyright-notice integrity check
5273   21FF             
5274   2204                                    .ORG $2204
5275   2204             ;
5276   2204             L2204:
5277   2204 21 B6 43                           LD      HL,M43B6            ; End-of-wave countdown timer
5278   2207 35                                 DEC     (HL)                ;
5279   2208 7E                                 LD      A,(HL)              ;
5280   2209 FE A0                              CP      $A0                 ;
5281   220B D0                                 RET     NC                  ;
5282   220C 2E A4                              LD      L,$A4               ;
5283   220E 36 02                              LD      (HL),$02            ; set GameState to: 'initialization of game and level data'
5284   2210 2E A6                              LD      L,$A6               ;
5285   2212 36 00                              LD      (HL),$00            ; clear ShieldCount
5286   2214 2E B8                              LD      L,$B8               ;
5287   2216 34                                 INC     (HL)                ; increment LevelAndRound
5288   2217 7E                                 LD      A,(HL)              ;
5289   2218 E6 0E                              AND     $0E                 ; mask out 0000_1110
5290   221A 0F                                 RRCA                        ; divide by 2
5291   221B C6 60                              ADD     T1760 & $FF         ; add to base of table T1760
5292   221D 5F                                 LD      E,A                 ;
5293   221E 16 17                              LD      D,T1760 >> 8        ;
5294   2220 2C                                 INC     L                   ;
5295   2221 2C                                 INC     L                   ;
5296   2222 1A                                 LD      A,(DE)              ; get value from table T1760
5297   2223 A7                                 AND     A                   ; updates the flags
5298   2224 F2 2A 22                           JP      P,L222A             ; if not positive.
5299   2227 2C                                 INC     L                   ; use BirdsLeft
5300   2228 E6 7F                              AND     $7F                 ; mask out 0111_1111
5301   222A             L222A:
5302   222A 77                                 LD      (HL),A              ; save to $43BA (AliensLeft) or $43BB (BirdsLeft)
5303   222B C3 80 03                           JP      ClearForeground     ; 
5304   222E             
5305   2230                                    .ORG $2230
5306   2230             ;*****************************************************************************
5307   2230             ;* Game level 4, 6 and 8:
5308   2230             ;* Drives the spiral fade-in animation between waves.
5309   2230             ;* The animation step counter is incremented every frame,
5310   2230             ;* its value indexes the spiral drawing progress,
5311   2230             ;* and when the spiral is complete it advances to the next level.
5312   2230             ;*****************************************************************************
5313   2230             L2230:
5314   2230 21 9C 43                           LD      HL,M439C            ; 
5315   2233 7E                                 LD      A,(HL)              ;
5316   2234 34                                 INC     (HL)                ; advance animation
5317   2235 00                                 NOP                         ;
5318   2236 0F                                 RRCA                        ;
5319   2237 E6 3F                              AND     $3F                 ; mask out 0011_1111
5320   2239 FE 0D                              CP      $0D                 ;
5321   223B CA 92 22                           JP      Z,L2292             ; 
5322   223E 06 1F                              LD      B,$1F               ; The asterisk character
5323   2240 DA 60 22                           JP      C,L2260             ; 
5324   2243 06 00                              LD      B,$00               ; The space character
5325   2245 D6 0E                              SUB     $0E                 ;
5326   2247 FE 0D                              CP      $0D                 ;
5327   2249 C2 60 22                           JP      NZ,L2260            ; 
5328   224C 21 B8 43                           LD      HL,LevelAndRound    ; 
5329   224F 34                                 INC     (HL)                ; increment game level $43B8
5330   2250 2E A4                              LD      L,$A4               ; HL=43A4 -- game state
5331   2252 36 02                              LD      (HL),$02            ; Next interval game state is 2: 'init game and level data'
5332   2254 C9                                 RET                         ;
5333   2255             
5334   2260                                    .ORG $2260
5335   2260             ;
5336   2260             L2260:
5337   2260 4F                                 LD      C,A                 ;
5338   2261 0F                                 RRCA                        ;
5339   2262 0F                                 RRCA                        ;
5340   2263 0F                                 RRCA                        ;
5341   2264 57                                 LD      D,A                 ;
5342   2265 E6 1F                              AND     $1F                 ;
5343   2267 5F                                 LD      E,A                 ;
5344   2268 7A                                 LD      A,D                 ;
5345   2269 E6 E0                              AND     $E0                 ;
5346   226B C6 B0                              ADD     $B0                 ;
5347   226D 6F                                 LD      L,A                 ;
5348   226E 7B                                 LD      A,E                 ;
5349   226F CE 41                              ADC     $41                 ;
5350   2271 67                                 LD      H,A                 ;
5351   2272 7D                                 LD      A,L                 ;
5352   2273 91                                 SUB     C                   ;
5353   2274 6F                                 LD      L,A                 ;
5354   2275 79                                 LD      A,C                 ;
5355   2276 3C                                 INC     A                   ;
5356   2277 4F                                 LD      C,A                 ;
5357   2278 07                                 RLCA                        ; Multiply by 2
5358   2279 5F                                 LD      E,A                 ;
5359   227A             ;
5360   227A             L227A:
5361   227A 51                                 LD      D,C                 ; D is the height counter for each pass
5362   227B             ;
5363   227B             L227B:
5364   227B 70                                 LD      (HL),B              ; draw the asterisk or space
5365   227C 23                                 INC     HL                  ; one row down
5366   227D 70                                 LD      (HL),B              ; another asterisk or space
5367   227E 23                                 INC     HL                  ; one row down
5368   227F 15                                 DEC     D                   ; all of this column done?
5369   2280 C2 7B 22                           JP      NZ,L227B            ; No ... do all rows
5370   2283 7D                                 LD      A,L                 ; LSB of screen pointer
5371   2284 91                                 SUB     C                   ; move up ...
5372   2285 91                                 SUB     C                   ; ... height * 2
5373   2286 D6 20                              SUB     $20                 ; Move right one column
5374   2288 6F                                 LD      L,A                 ; New LSB
5375   2289 7C                                 LD      A,H                 ; Borrow into ...
5376   228A DE 00                              SBC     $00                 ; ... the ...
5377   228C 67                                 LD      H,A                 ; ... MSB
5378   228D 1D                                 DEC     E                   ; All columns done?
5379   228E C2 7A 22                           JP      NZ,L227A            ; no ... do all columns
5380   2291 C9                                 RET                         ; Done
5381   2292             ;*****************************************************************************
5382   2292             ;* Spiral step
5383   2292             ;*****************************************************************************
5384   2292             L2292:
5385   2292 21 B8 43                           LD      HL,LevelAndRound    ; 
5386   2295 7E                                 LD      A,(HL)              ;
5387   2296 E6 08                              AND     $08                 ; mask out 0000_1000
5388   2298 CA F0 22                           JP      Z,L22F0             ; 
5389   229B             ;*****************************************************************************
5390   229B             ;* Fill the entire background with stars (uses the whole `$1C00`–`$1CFF` page, including `$1CB4`–`$1CFF`).
5391   229B             ;* `L2292` copies the star page into background VRAM from `$4B3F` downward, reading `T1C00` with `INC L`
5392   229B             ;* (which wraps inside page `$1C`), until it has filled `$4800`–`$4B3F`.
5393   229B             ;*****************************************************************************
5394   229B 21 00 1C                           LD      HL,T1C00            ; Background stars to erase mother ship
5395   229E 11 3F 4B                           LD      DE,$4B3F            ; End of background screen memory
5396   22A1 06 47                              LD      B,$47               ;
5397   22A3             L22A3:
5398   22A3 7E                                 LD      A,(HL)              ;
5399   22A4 12                                 LD      (DE),A              ;
5400   22A5 2C                                 INC     L                   ;
5401   22A6 1B                                 DEC     DE                  ;
5402   22A7 7E                                 LD      A,(HL)              ;
5403   22A8 12                                 LD      (DE),A              ;
5404   22A9 2C                                 INC     L                   ;
5405   22AA 1B                                 DEC     DE                  ;
5406   22AB 78                                 LD      A,B                 ;
5407   22AC BA                                 CP      D                   ;
5408   22AD C2 A3 22                           JP      NZ,L22A3            ; 
5409   22B0 C3 E0 22                           JP      L22E0               ; 
5410   22B3             
5411   22B4                                    .ORG $22B4
5412   22B4             ;*****************************************************************************
5413   22B4             ;* Game level 9:
5414   22B4             ;* Mothership 'fade in' animation.
