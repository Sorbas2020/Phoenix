4894   2000             ;*****************************************************************************
4895   2000             ; h5-ic49.5a
4896   2000             ;*****************************************************************************
4897   2000             ;*****************************************************************************
4898   2000             ;* Game level 1, 3 and B:
4899   2000             ;* 'player alife' with aliens, after 'fade in'
4900   2000             ;*****************************************************************************
4901   2000             L2000:
4902   2000 CD 76 08                           CALL    PlayerUpdate        ; Updates the player ship, player bullet and the shield.
4903   2003 CD F0 0D                           CALL    L0DF0               ; alien bullet to player, collission detection ?
4904   2006 CD A0 24                           CALL    L24A0               ; 
4905   2009 21 5F 43                           LD      HL,M435F            ; 8 bit counter for alien movement
4906   200C 7E                                 LD      A,(HL)              ; get value
4907   200D E6 03                              AND     $03                 ; mask out 0000_0011 for count 0 to 3
4908   200F 47                                 LD      B,A                 ; save the masked counter
4909   2010 34                                 INC     (HL)                ; increment alien movement counter
4910   2011 3A BA 43                           LD      A,(AliensLeft)      ; 
4911   2014 A7                                 AND     A                   ; updates the zero flag
4912   2015 CA BA 21                           JP      Z,L21BA             ; if no AliensLeft
4913   2018 FE 05                              CP      $05                 ;
4914   201A D2 30 21                           JP      NC,L2130            ; if <= 5 left
4915   201D 2D                                 DEC     L                   ; $435E
4916   201E 78                                 LD      A,B                 ; get masked counter
4917   201F A7                                 AND     A                   ; updates the zero flag
4918   2020 C2 25 20                           JP      NZ,L2025            ; if masked counter <> 0
4919   2023 36 FF                              LD      (HL),$FF            ; set all bits at $435E
4920   2025             L2025:
4921   2025 7E                                 LD      A,(HL)              ; get $435E
4922   2026 A7                                 AND     A                   ; updates the zero flag
4923   2027 CA 30 21                           JP      Z,L2130             ; if $435E = 0
4924   202A C3 46 21                           JP      L2146               ; 
4925   202D             
4926   2030                                    .ORG $2030
4927   2030             ;
4928   2030             L2030:
4929   2030 E6 03                              AND     $03                 
4930   2032 FE 01                              CP      $01                 
4931   2034 11 50 1B                           LD      DE,$1B50            
4932   2037 C3 AC 23                           JP      L23AC               ; 
4933   203A             
