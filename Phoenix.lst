8580   3A31 2F                                 CPL                         
8581   3A32 E6 0E                              AND     $0E                 
8582   3A34 2E 8D                              LD      L,$8D               
8583   3A36 77                                 LD      (HL),A              
8584   3A37 2E 68                              LD      L,$68               
8585   3A39 36 00                              LD      (HL),$00            
8586   3A3B 2E 66                              LD      L,$66               
8587   3A3D 36 00                              LD      (HL),$00            
8588   3A3F C9                                 RET                         
