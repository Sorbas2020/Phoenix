8016   370A             ;*****************************************************************************
8017   370A             ; called by $35B0
8018   370A             ;* `L370A` is one of the four 1st address (state transition) handlers,
8019   370A             ;* selected by table entries `6`, `7`, `A`, and `F`.
8020   370A             ;* It runs after the frame's movement handler and decides whether the bird
8021   370A             ;* has finished its current growth phase; if so, it advances the bird to
8022   370A             ;* its next state and records progress in the global bird maturity flags `$4368`.
8023   370A             ;* Bird record fields it touches (relative to the +4 pointer it receives):
8024   370A             ;* offset +0 (via `-4`) = state index (the `T3F00` selector / character block shape),
8025   370A             ;* offset +4 = phase timer, offset +6 = sub counter.
8026   370A             ;* Step by step:
8027   370A             ;* 1. Recover parameters (`$370A`–`$370C`): pops the two `T3F00` constants for this state
8028   370A             ;*    into `DE`/`BC` and the bird pointer into `HL`.
8029   370A             ;* 2. Gate on completion (`$370D`–`$3715`): if the phase timer (offset +4) is still non zero,
8030   370A             ;*    or the low nibble of the sub counter (offset +6) is non zero,
8031   370A             ;*    the bird hasn't finished this growth phase yet, so it returns and leaves the state unchanged.
8032   370A             ;* 3. Default transition (`$3716`–`$371D`): once idle, it programs the *next* state
8033   370A             ;*    — new phase timer = `B` (table byte +0), new state index = `D` (table byte +2).
8034   370A             ;* 4. Record maturity (`$371E`–`$3723`): sets bit 2 (`$04`) of the global bird maturity flags at `$4368`.
8035   370A             ;* 5. Optional randomized branch (`$3726`–`$373E`): it samples the per wave random seed `$436F`,
8036   370A             ;*    masks it with table byte +3 (`E`) and tests the high nibble. If that misses (`RET NZ` not taken),
8037   370A             ;*    it *overrides* the transition — state index becomes `E & $0F`, phase timer becomes `C` (table byte +1)
8038   370A             ;*    — and sets an additional maturity bit 3 (`$08`).
8039   370A             ;* In other words, `L370A` is the "this bird has finished growing one stage" handler:
8040   370A             ;* it either promotes the bird to a fixed next shape or, with a seed driven probability,
8041   370A             ;* diverts it to an alternate shape, and it ticks up the flock's maturity progress in `$4368`
8042   370A             ;* so the wave logic knows how far the birds have developed. The sibling handlers work the same way
8043   370A             ;* but set different maturity bits: `L36D2` sets bit 0 (`$01`), `L36EA` sets bit 1 (`$02`),
8044   370A             ;* and `L36CC` is the plain "pop and return" terminator with no transition.
8045   370A             ;*****************************************************************************
8046   370A             L370A:
8047   370A D1                                 POP     DE                  ; DE = table +2/+3 (alt next-state + mask)
8048   370B C1                                 POP     BC                  ; BC = table +0/+1 (alt timer + params)
8049   370C E1                                 POP     HL                  ; HL = bird record + 4
8050   370D 7E                                 LD      A,(HL)              ; phase timer (offset +4)
8051   370E A7                                 AND     A                   ; updates the zero flag
8052   370F C0                                 RET     NZ                  ; still counting down -> not ready, leave
8053   3710 2C                                 INC     L                   ; -> offset +6 (sub-counter)
8054   3711 2C                                 INC     L                   ; 
8055   3712 7E                                 LD      A,(HL)              ; 
8056   3713 E6 0F                              AND     $0F                 ; 0000_1111
8057   3715 C0                                 RET     NZ                  ; sub-counter low nibble busy -> not ready
8058   3716 2D                                 DEC     L                   ; back to offset +4
8059   3717 2D                                 DEC     L                   ; 
8060   3718 70                                 LD      (HL),B              ; load new phase timer (from table +0)
8061   3719 2D                                 DEC     L                   ; -> offset +0 (state index)
8062   371A 2D                                 DEC     L                   ; 
8063   371B 2D                                 DEC     L                   ; 
8064   371C 2D                                 DEC     L                   ; 
8065   371D 72                                 LD      (HL),D              ; set default NEXT state index (from table +2)
8066   371E 3A 68 43                           LD      A,(M4368)           ; bird maturity flags
8067   3721 F6 04                              OR      $04                 ; 0000_0100 set maturity stage bit 2
8068   3723 32 68 43                           LD      (M4368),A           ; 
8069   3726 3A 6F 43                           LD      A,(M436F)           ; per-wave random seed
8070   3729 A3                                 AND     E                   ; mask with table +3
8071   372A E6 F0                              AND     $F0                 ; 1111_0000
8072   372C C0                                 RET     NZ                  ; keep the default transition if high nibble hits
8073   372D 7B                                 LD      A,E                 ; else take the RANDOMIZED branch:
8074   372E E6 0F                              AND     $0F                 ; 0000_1111
8075   3730 77                                 LD      (HL),A              ; override state index = (table+3 low nibble)
8076   3731 2C                                 INC     L                   ; -> offset +4
8077   3732 2C                                 INC     L                   ; 
8078   3733 2C                                 INC     L                   ; 
8079   3734 2C                                 INC     L                   ; 
8080   3735 71                                 LD      (HL),C              ; override phase timer = table +1
8081   3736 3A 68 43                           LD      A,(M4368)           ; maturity of the birds
8082   3739 F6 08                              OR      $08                 ; 0000_1000 set maturity stage bit 3
8083   373B 32 68 43                           LD      (M4368),A           ; 
8084   373E C9                                 RET                         ; 
