3114   0D70             ;*****************************************************************************
3115   0D70             ;* Alien animation update.
3116   0D70             ;* 1. Uses the movement-list opcode → `T16A0` (3-byte anim record)
3117   0D70             ;* 2. From that, picks a base into `T1600` and a small X/Y sub-index (fine scroll / facing)
3118   0D70             ;* 3. Reads one byte from `T1600`...`T1690`
3119   0D70             ;* 4. Stores it in control state B = LSB for `$14xx`
3120   0D70             ;*****************************************************************************
3121   0D70             AlienAnimationUpdate:
3122   0D70             L0D70:
3123   0D70 01 70 4B                           LD      BC,M4B70            ; Alien control state A
3124   0D73 21 50 4B                           LD      HL,M4B50            ; Alien movement pattern table
3125   0D76             L0D76:
3126   0D76 CD 86 0D                           CALL    L0D86               ; 
3127   0D79 79                                 LD      A,C                 ; 
3128   0D7A C6 04                              ADD     $04                 ; 
3129   0D7C 4F                                 LD      C,A                 ; 
3130   0D7D 3E B0                              LD      A,$B0               ; 
3131   0D7F B9                                 CP      C                   ; 
3132   0D80 C2 76 0D                           JP      NZ,L0D76            ; loop for 16 aliens
3133   0D83 C9                                 RET                         ; 
3134   0D84             
3135   0D86                                    .ORG $0D86
3136   0D86             L0D86:
3137   0D86 56                                 LD      D,(HL)              ; get MSB of pointer for alien movement pattern
3138   0D87 23                                 INC     HL                  ; 
3139   0D88 5E                                 LD      E,(HL)              ; get LSB of pointer for alien movement pattern
3140   0D89 23                                 INC     HL                  ; 
3141   0D8A 0A                                 LD      A,(BC)              ; get alien control state A
3142   0D8B E6 08                              AND     $08                 ; 0000_1000
3143   0D8D C8                                 RET     Z                   ; if bit3 of alien control state A, not set
3144   0D8E EB                                 EX      DE,HL               ; 
3145   0D8F 7E                                 LD      A,(HL)              ; get pointer to movement list (T1000)
3146   0D90 A7                                 AND     A                   ; updates the zero flag
3147   0D91 CC DE 0D                           CALL    Z,L0DDE             ; if end of movement list reached
3148   0D94 6F                                 LD      L,A                 ; get pointer to movement list
3149   0D95 07                                 RLCA                        ; multiply by ..
3150   0D96 85                                 ADD     A,L                 ; .. 3, to get a 3 byte offset at T16A0
3151   0D97 C6 A0                              ADD     T16A0 & $FF         ; LSB of T16A0
3152   0D99 6F                                 LD      L,A                 ; 
3153   0D9A 26 16                              LD      H,T16A0 >> 8        ; MSB of T16A0
3154   0D9C 0A                                 LD      A,(BC)              ; get alien control state A
3155   0D9D E6 F8                              AND     $F8                 ; 1111_1000
3156   0D9F B6                                 OR      (HL)                ; 1st byte of alien animation table
3157   0DA0 02                                 LD      (BC),A              ; set alien control state A
3158   0DA1 03                                 INC     BC                  ; 
3159   0DA2 03                                 INC     BC                  ; 
3160   0DA3 03                                 INC     BC                  ; alien screen coordinate Y
3161   0DA4 23                                 INC     HL                  ; 
3162   0DA5 7E                                 LD      A,(HL)              ; get 2nd byte of alien animation table
3163   0DA6 23                                 INC     HL                  ; 3rd byte of alien animation table
3164   0DA7 0F                                 RRCA                        ; divide by 2
3165   0DA8 DA BB 0D                           JP      C,L0DBB             ; if 2nd byte is: $01
3166   0DAB 0F                                 RRCA                        ; divide by 2
3167   0DAC DA CC 0D                           JP      C,L0DCC             ; if 2nd byte is: $02
3168   0DAF             ; 2nd byte of alien animation table is: $04
3169   0DAF 0A                                 LD      A,(BC)              ; get alien screen coordinate Y
3170   0DB0 0F                                 RRCA                        ; divide by 2
3171   0DB1 E6 03                              AND     $03                 ; 0000_0011
3172   0DB3 86                                 ADD     A,(HL)              ; add with 3rd byte of alien animation table
3173   0DB4 0B                                 DEC     BC                  ; alien screen coordinate X
3174   0DB5 C3 D2 0D                           JP      L0DD2               ; 
3175   0DB8             
3176   0DBB                                    .ORG $0DBB
3177   0DBB             ; 2nd byte of alien animation table is: $01
3178   0DBB             L0DBB:
3179   0DBB 0A                                 LD      A,(BC)              ; get alien screen coordinate Y
3180   0DBC 0F                                 RRCA                        ; divide by 2
3181   0DBD E6 03                              AND     $03                 ; 0000_0011
3182   0DBF 86                                 ADD     A,(HL)              ; add with 3rd byte of alien animation table
3183   0DC0 67                                 LD      H,A                 ; save
3184   0DC1 0B                                 DEC     BC                  ; 
3185   0DC2 0A                                 LD      A,(BC)              ; get alien screen coordinate X
3186   0DC3 E6 04                              AND     $04                 ; 0000_0100
3187   0DC5 84                                 ADD     A,H                 ; add with 3rd byte of alien animation table
3188   0DC6 C3 D2 0D                           JP      L0DD2               ; 
3189   0DC9             
3190   0DCC                                    .ORG $0DCC
3191   0DCC             ; 2nd byte of alien animation table is: $02
3192   0DCC             L0DCC:
3193   0DCC 0B                                 DEC     BC                  ; 
3194   0DCD 0A                                 LD      A,(BC)              ; get alien screen coordinate X
3195   0DCE 0F                                 RRCA                        ; divide by 2
3196   0DCF E6 03                              AND     $03                 ; 0000_0011
3197   0DD1 86                                 ADD     A,(HL)              ; add with 3rd byte of alien animation table
3198   0DD2             L0DD2:
3199   0DD2 6F                                 LD      L,A                 ; LSB for T1600
3200   0DD3 26 16                              LD      H,T1600 >> 8        ; MSB for T1600
3201   0DD5 7E                                 LD      A,(HL)              ; get data from T1600
3202   0DD6 0B                                 DEC     BC                  ; 
3203   0DD7 02                                 LD      (BC),A              ; set alien control state B (LSB for T14xx)
3204   0DD8 0B                                 DEC     BC                  ; alien control state A
3205   0DD9 EB                                 EX      DE,HL               ; 
3206   0DDA C9                                 RET                         ; 
3207   0DDB             
3208   0DDE                                    .ORG $0DDE
3209   0DDE             ; End of movement list reached
3210   0DDE             L0DDE:
3211   0DDE 1B                                 DEC     DE                  ; 
3212   0DDF 1B                                 DEC     DE                  ; 
3213   0DE0 3A 94 43                           LD      A,(M4394)           ; get start value list pointer for alien movement MSB
3214   0DE3 12                                 LD      (DE),A              ; save alien movement pattern table MSB
3215   0DE4 67                                 LD      H,A                 ; 
3216   0DE5 13                                 INC     DE                  ; 
3217   0DE6 3A 95 43                           LD      A,(M4395)           ; get start value list pointer for alien movement LSB
3218   0DE9 12                                 LD      (DE),A              ; save alien movement pattern table LSB
3219   0DEA 6F                                 LD      L,A                 ; 
3220   0DEB 13                                 INC     DE                  ; 
3221   0DEC 7E                                 LD      A,(HL)              ; get value from pointer table to alien movement list
3222   0DED C9                                 RET                         ; 
