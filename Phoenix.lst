1994   076D             ;* Draw 1x1 screen objects (used at 'fade in' animation).
1995   076D             ;*****************************************************************************
1996   076D             L076D:
1997   076D EB                                 EX      DE,HL               ;
1998   076E 23                                 INC     HL                  ;
1999   076F 23                                 INC     HL                  ;
2000   0770 56                                 LD      D,(HL)              ; get MSB screen ram adress of alien
2001   0771 23                                 INC     HL                  ;
2002   0772 5E                                 LD      E,(HL)              ; get LSB screen ram adress of alien
2003   0773 0A                                 LD      A,(BC)              ; get alien control state B
2004   0774 12                                 LD      (DE),A              ; set at screen ram
2005   0775 0B                                 DEC     BC                  ; move to alien control state A
2006   0776 C9                                 RET                         ;
