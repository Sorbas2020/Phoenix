6506   27BD 21 63 43                           LD      HL,ParticleExplosion
6507   27C0 7E                                 LD      A,(HL)              ;
6508   27C1 A7                                 AND     A                   ; updates the zero flag
6509   27C2 C2 E2 27                           JP      NZ,L27E2            ; if player ship was hit.
6510   27C5 2E 61                              LD      L,$61               ; BulletTriggered
6511   27C7 7E                                 LD      A,(HL)              ; 
6512   27C8 A7                                 AND     A                   ; updates the zero flag
6513   27C9 C8                                 RET     Z                   ; 
6514   27CA FE 19                              CP      $19                 ; 
6515   27CC D2 D8 27                           JP      NC,L27D8            ; if >= $19
6516   27CF 35                                 DEC     (HL)                ; 
6517   27D0 2E 8C                              LD      L,$8C               ; SoundControlA
6518   27D2 7E                                 LD      A,(HL)              ; 
