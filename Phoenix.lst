8911   3B78 3F F8 0F FF 
8911   3B7C FF FC 1F FF 
8912   3B80 FC 1F FC 1F                        .DB $FC, $1F, $FC, $1F, $F0, $7F, $F0, $7F, $C0, $FF, $01, $C0, $FF, $01, $00, $FF   ; for bird background tiles B0 - BF
