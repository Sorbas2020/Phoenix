2084   07AE 23                                 INC     HL                  ;
2085   07AF 5E                                 LD      E,(HL)              ;
2086   07B0 0A                                 LD      A,(BC)              ;
2087   07B1 6F                                 LD      L,A                 ;
2088   07B2 26 14                              LD      H,T1420 >> 8        ; get alien character block shapes table
2089   07B4 7E                                 LD      A,(HL)              ;
