1533   0529 CD 6C 0A                           CALL    L0A6C               ; get screen ram adress for all aliens
1534   052C CD 06 05                           CALL    L0506               ; clear 4392 to 4397, init 4394
1535   052F C3 B0 32                           JP      L32B0               ;
