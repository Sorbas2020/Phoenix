2205   0834             ;*****************************************************************************
2206   0834             ;* Game level 0 and 2:
2207   0834             ;* Stars scrolling down and 'aliens fade in'
2208   0834             ;*****************************************************************************
2209   0834             L0834:
2210   0834 CD F0 06                           CALL    L06F0               ; update scroll register and fill background
2211   0837 21 B4 43                           LD      HL,CounterB4        ; 
2212   083A 35                                 DEC     (HL)                ; decrement the counter
2213   083B 7E                                 LD      A,(HL)              ;
2214   083C FE 15                              CP      $15                 ;
2215   083E D0                                 RET     NC                  ;
2216   083F CD 5A 08                           CALL    GetAnimationChrs    ; for 'aliens fade in'
2217   0842 CD FA 05                           CALL    L05FA               ; init all alien control states
2218   0845 CD 50 0A                           CALL    AlienDataController ;
2219   0848             L0848:
2220   0848 21 B4 43                           LD      HL,CounterB4        ;
2221   084B 7E                                 LD      A,(HL)              ;
2222   084C A7                                 AND     A                   ; updates the zero flag
2223   084D C0                                 RET     NZ                  ; if CounterB4 is 0.
2224   084E 2E B8                              LD      L,$B8               ;
2225   0850 34                                 INC     (HL)                ; increment game level $43B8
2226   0851 2E A4                              LD      L,$A4               ; Next interval game state ...
2227   0853 36 02                              LD      (HL),$02            ; .. is 2
2228   0855 C9                                 RET                         ;
2229   0856             
2230   085A                                    .ORG $085A
2231   085A             ;*****************************************************************************
2232   085A             ;* The 'aliens fade in' animation sequence is:
2233   085A             ;* 6C, 6D, 6E, 6F, 68, from foreground tiles.
2234   085A             ;*****************************************************************************
2235   085A             GetAnimationChrs:
2236   085A 11 6C 08                           LD      DE,$086C            ;
2237   085D FE 11                              CP      $11                 ;
2238   085F D0                                 RET     NC                  ;
2239   0860 1E 6D                              LD      E,$6D               ;
2240   0862 FE 0D                              CP      $0D                 ;
2241   0864 D0                                 RET     NC                  ;
2242   0865 1E 6E                              LD      E,$6E               ;
2243   0867 FE 09                              CP      $09                 ;
2244   0869 D0                                 RET     NC                  ;
2245   086A 1E 6F                              LD      E,$6F               ;
2246   086C FE 05                              CP      $05                 ;
2247   086E D0                                 RET     NC                  ;
2248   086F 1E 68                              LD      E,$68               ;
2249   0871 C9                                 RET                         ;
2250   0872             
2251   0876                                    .ORG $0876
2252   0876             ;*****************************************************************************
2253   0876             ; Updates the player ship, player bullet and the shield.
2254   0876             ;*****************************************************************************
2255   0876             PlayerUpdate:
2256   0876 CD 00 07                           CALL    PlayerDataController     ; draw new / delete old objects
2257   0879 CD 86 08                           CALL    L0886               ; copy current player data to old player data ?
2258   087C CD A0 08                           CALL    L08A0               ; update player position, bullet and shield
2259   087F CD A0 09                           CALL    L09A0               ; get screen ram adress for player ship position
2260   0882 CD 7A 09                           CALL    L097A               ; map player ship position to $439E $439F
2261   0885 C9                                 RET                         ;
2262   0886             
2263   0886             ;*****************************************************************************
2264   0886             ; Copy current player data to old player data.
2265   0886             ;*****************************************************************************
2266   0886             L0886:
2267   0886 21 EB 43                           LD      HL,M43EB            ; start at current-LSB of object 2
2268   0889 06 03                              LD      B,$03               ; 3 objects
2269   088B             L088B:
2270   088B 56                                 LD      D,(HL)              ; D = current LSB ($43EB)
2271   088C 2B                                 DEC     HL                  ; 
2272   088D 5E                                 LD      E,(HL)              ; E = current MSB ($43EA)
2273   088E 2B                                 DEC     HL                  ; 
2274   088F 72                                 LD      (HL),D              ; old LSB ($43E9) = current LSB
2275   0890 2B                                 DEC     HL                  ; 
2276   0891 73                                 LD      (HL),E              ; old MSB ($43E8) = current MSB
2277   0892 2B                                 DEC     HL                  ; 
2278   0893 05                                 DEC     B                   ; 
2279   0894 C2 8B 08                           JP      NZ,L088B            ; 
2280   0897 C9                                 RET                         ; 
2281   0898             
2282   08A0                                    .ORG $08A0
2283   08A0             ;*****************************************************************************
2284   08A0             ;* Update player position, bullet and shield
2285   08A0             ;*****************************************************************************
2286   08A0             L08A0:
2287   08A0 CD C4 08                           CALL    MovePlayer          ;
2288   08A3 21 C4 43                           LD      HL,PlayerBulletState
2289   08A6 CD 30 09                           CALL    L0930               ; get the assigned player bullet tile if fire button was pressed
2290   08A9 3A B8 43                           LD      A,(LevelAndRound)   ;
2291   08AC E6 0F                              AND     $0F                 ; 0000_1111
2292   08AE FE 03                              CP      $03                 ;
2293   08B0 C0                                 RET     NZ                  ; return if not game level 3 (2nd alien wave)
2294   08B1 21 C8 43                           LD      HL,AbovePlayerBulletState
2295   08B4 CD 30 09                           CALL    L0930               ; get the assigned player bullet tile if fire button was pressed
2296   08B7 C9                                 RET                         ;
2297   08B8             
2298   08C4                                    .ORG $08C4
2299   08C4             ;*****************************************************************************
2300   08C4             ;* Player ship, shield and bullets handler.
2301   08C4             ;*****************************************************************************
2302   08C4             MovePlayer:
2303   08C4 21 C0 43                           LD      HL,PlayerState      ;
2304   08C7 7E                                 LD      A,(HL)              ;
2305   08C8 E6 08                              AND     $08                 ; mask out 0000_1000
2306   08CA CA A0 0A                           JP      Z,DrawShields       ; Draw shields
2307   08CD 2E A6                              LD      L,$A6               ;
2308   08CF 7E                                 LD      A,(HL)              ; get ShieldCount
2309   08D0 A7                                 AND     A                   ; updates the zero flag
2310   08D1 C2 EA 08                           JP      NZ,L08EA            ; if ShieldCount not 0.
2311   08D4 06 80                              LD      B,$80               ; 1000_0000 (bit7='shield')
2312   08D6 CD BB 00                           CALL    CheckInputBits      ;
2313   08D9 CA EB 08                           JP      Z,L08EB             ;
2314   08DC 2E 62                              LD      L,$62               ;
2315   08DE 36 40                              LD      (HL),$40            ; set bit6 at $4362
2316   08E0 2E C0                              LD      L,$C0               ;
2317   08E2 7E                                 LD      A,(HL)              ; get $43C0 PlayerState
2318   08E3 E6 F7                              AND     $F7                 ; mask out 1111_0111
2319   08E5 77                                 LD      (HL),A              ;
2320   08E6 2E A6                              LD      L,$A6               ; ShieldCount
2321   08E8 36 FF                              LD      (HL),$FF            ;
2322   08EA             L08EA:
2323   08EA 35                                 DEC     (HL)                ; decrement ShieldCount
2324   08EB             L08EB:
2325   08EB 2E C2                              LD      L,PlayerShipX & $FF ; LSB of $43C2 PlayerShipX
2326   08ED CD 00 09                           CALL    L0900               ; Update the player ship x coordinate.
2327   08F0 01 00 16                           LD      BC,T1600            ;
2328   08F3 C3 26 09                           JP      L0926               ; get player ship animation frame values, mapped with T1600/T1620
2329   08F6             
2330   0900                                    .ORG $0900
2331   0900             ;*****************************************************************************
2332   0900             ;* Update the player ship x coordinate.
2333   0900             ;*****************************************************************************
2334   0900             L0900:
2335   0900 3A A0 43                           LD      A,(IN0Current)      ;
2336   0903 2F                                 CPL                         ; flip the current bits
2337   0904 E6 60                              AND     $60                 ; mask out 0110_0000
2338   0906 C8                                 RET     Z                   ; if no button pressed
2339   0907 E6 40                              AND     $40                 ; mask out 0100_0000
2340   0909 CA 17 09                           JP      Z,L0917             ;
2341   090C 7E                                 LD      A,(HL)              ; get $43C2 PlayerShipX
2342   090D FE 0D                              CP      $0D                 ;
2343   090F D8                                 RET     C                   ; if left boundary reached
2344   0910 35                                 DEC     (HL)                ; 'left' button: dec $43C2 PlayerShipX
2345   0911 3E FF                              LD      A,$FF               ;
2346   0913 32 60 43                           LD      (PlayerMoved),A     ; set 'player moved' flag
2347   0916 C9                                 RET                         ;
2348   0917             L0917:
2349   0917 7E                                 LD      A,(HL)              ; get $43C2 PlayerShipX
2350   0918 FE C0                              CP      $C0                 ;
2351   091A D0                                 RET     NC                  ; if right boundary reached
2352   091B 34                                 INC     (HL)                ; 'right' button: inc $43C2 PlayerShipX
2353   091C 3E FF                              LD      A,$FF               ;
2354   091E 32 60 43                           LD      (PlayerMoved),A     ; set 'player moved' flag
2355   0921 C9                                 RET                         ;
2356   0922             
2357   0926                                    .ORG $0926
2358   0926             ;*****************************************************************************
2359   0926             ;* Get player ship animation frame values, mapped with T1600/T1620.
2360   0926             ;*****************************************************************************
2361   0926             L0926:
2362   0926 7E                                 LD      A,(HL)              ;
2363   0927 E6 07                              AND     $07                 ; mask out 0000_0111
2364   0929 81                                 ADD     A,C                 ;
2365   092A 4F                                 LD      C,A                 ;
2366   092B 0A                                 LD      A,(BC)              ; get data from table
2367   092C 2D                                 DEC     L                   ;
2368   092D 77                                 LD      (HL),A              ;
2369   092E C9                                 RET                         ;
2370   092F             
2371   0930                                    .ORG $0930
2372   0930             ;*****************************************************************************
2373   0930             ;* Get the assigned player bullet tile if fire button was pressed.
2374   0930             ;*****************************************************************************
2375   0930             L0930:
2376   0930 7E                                 LD      A,(HL)              ;
2377   0931 E6 08                              AND     $08                 ; mask out 0000_1000
2378   0933 C2 64 09                           JP      NZ,L0964            ; update PlayerBulletY (grid) and PlayerBulletState
2379   0936 EB                                 EX      DE,HL               ;
2380   0937 06 10                              LD      B,$10               ; 0001_0000 (bit4='fire')
2381   0939 CD BB 00                           CALL    CheckInputBits      ;
2382   093C C8                                 RET     Z                   ; return if button not pressed
2383   093D 7E                                 LD      A,(HL)              ;
2384   093E E6 EF                              AND     $EF                 ; mask out 1110_1111
2385   0940 77                                 LD      (HL),A              ;
2386   0941 1A                                 LD      A,(DE)              ;
2387   0942 F6 08                              OR      $08                 ; set bit3 at..
2388   0944 12                                 LD      (DE),A              ; $43C4 PlayerBulletState
2389   0945 13                                 INC     DE                  ;
2390   0946 13                                 INC     DE                  ;
2391   0947 3A C2 43                           LD      A,(PlayerShipX)     ;
2392   094A C6 04                              ADD     $04                 ; mask out 0000_0100
2393   094C 12                                 LD      (DE),A              ;
2394   094D 13                                 INC     DE                  ;
2395   094E 3A C3 43                           LD      A,(PlayerShipY)     ; $D8
2396   0951 D6 08                              SUB     $08                 ;
2397   0953 12                                 LD      (DE),A              ;
2398   0954 1B                                 DEC     DE                  ;
2399   0955 EB                                 EX      DE,HL               ;
2400   0956 01 20 16                           LD      BC,T1620            ; get character for player bullets
2401   0959 CD 26 09                           CALL    L0926               ; get player ship animation frame values, mapped with T1600/T1620
2402   095C 3E 30                              LD      A,$30               ; 0011_0000
2403   095E 32 61 43                           LD      (BulletTriggered),A ; set 'bullet triggered' flag
2404   0961 C9                                 RET                         ;
2405   0962             
2406   0964                                    .ORG $0964
2407   0964             ;*****************************************************************************
2408   0964             ;* Update PlayerBulletY (grid) and PlayerBulletState.
2409   0964             ;*****************************************************************************
2410   0964             L0964:
2411   0964 2C                                 INC     L                   ;
2412   0965 2C                                 INC     L                   ;
2413   0966 2C                                 INC     L                   ;
2414   0967 7E                                 LD      A,(HL)              ; get $43C7 PlayerBulletY (grid)
2415   0968 D6 08                              SUB     $08                 ; move bullet ($08 represents the bullet speed)
2416   096A 77                                 LD      (HL),A              ;
2417   096B FE 1F                              CP      $1F                 ; top of the screen reached?
2418   096D D0                                 RET     NC                  ; if not reached
2419   096E             L096E:
2420   096E 2D                                 DEC     L                   ;
2421   096F 2D                                 DEC     L                   ;
2422   0970 2D                                 DEC     L                   ;
2423   0971 7E                                 LD      A,(HL)              ; get $43C4 PlayerBulletState
2424   0972 E6 F7                              AND     $F7                 ; 1111_0111
2425   0974 77                                 LD      (HL),A              ; del bit3 at PlayerBulletState
2426   0975 C9                                 RET                         ;
2427   0976             
2428   097A                                    .ORG $097A
2429   097A             ;*****************************************************************************
2430   097A             ;* Player ship X position mapping.
2431   097A             ;*****************************************************************************
2432   097A             L097A:
2433   097A 3A C2 43                           LD      A,(PlayerShipX)     ;
2434   097D 47                                 LD      B,A                 ; save it
2435   097E E6 07                              AND     $07                 ; mask out 0000_0111
2436   0980 07                                 RLCA                        ;
2437   0981 21 38 0B                           LD      HL,T0B38            ; mapping table
2438   0984 85                                 ADD     A,L                 ;
2439   0985 6F                                 LD      L,A                 ;
2440   0986 78                                 LD      A,B                 ; restore it
2441   0987 96                                 SUB     (HL)                ;
2442   0988 32 9E 43                           LD      (M439E),A           ; Mapped player ship position, left part
2443   098B 23                                 INC     HL                  ;
2444   098C 78                                 LD      A,B                 ;
2445   098D 86                                 ADD     A,(HL)              ;
2446   098E 32 9F 43                           LD      (M439F),A           ; Mapped player ship position, right part
2447   0991 C9                                 RET                         ;
2448   0992             
2449   09A0                                    .ORG $09A0
2450   09A0             ;*****************************************************************************
2451   09A0             ;* Get screen ram adress for player and bullet positions.
2452   09A0             ;* from: 43C2:43C3, 43C6:43C7, 43CA:43CB
2453   09A0             ;* ......PlayerShipX
2454   09A0             ;* ...........PlayerShipY
2455   09A0             ;* .................PlayerBulletX
2456   09A0             ;* ......................PlayerBulletY
2457   09A0             ;* ............................AbovePlayerBulletX
2458   09A0             ;* .................................AbovePlayerBulletY
2459   09A0             ;* to:   43E2:43E3, 43E6:43E7, 43EA:43EB
2460   09A0             ;*****************************************************************************
2461   09A0             L09A0:
2462   09A0 01 C2 43                           LD      BC,PlayerShipX      ;
2463   09A3 11 E2 43                           LD      DE,PlayerShipMSB    ;
2464   09A6             L09A6:
2465   09A6 CD BA 09                           CALL    GetScreenRamAddress ;
2466   09A9 03                                 INC     BC                  ;
2467   09AA 03                                 INC     BC                  ;
2468   09AB 03                                 INC     BC                  ;
2469   09AC 13                                 INC     DE                  ;
2470   09AD 13                                 INC     DE                  ;
2471   09AE 13                                 INC     DE                  ;
2472   09AF 79                                 LD      A,C                 ;
2473   09B0 FE CE                              CP      $CE                 ; end of data structure
2474   09B2 C2 A6 09                           JP      NZ,L09A6            ;
2475   09B5 C9                                 RET                         ;
2476   09B6             
2477   09BA                                    .ORG $09BA
2478   09BA             ;*****************************************************************************
2479   09BA             ;* Mapping of 'grid values' to screen ram address.
2480   09BA             ;*****************************************************************************
2481   09BA             GetScreenRamAddress:
2482   09BA 21 00 0A                           LD      HL,T0A00            ; Screen ram addresses for the top row (left to right)
2483   09BD 0A                                 LD      A,(BC)              ; get the X coordinate
2484   09BE E6 F8                              AND     $F8                 ; drop the low 3 (sub-cell) bits
2485   09C0 0F                                 RRCA                        ; 
2486   09C1 0F                                 RRCA                        ; A = column * 2  (2-byte entries)
2487   09C2 85                                 ADD     A,L                 ; 
2488   09C3 6F                                 LD      L,A                 ; HL = T0A00 + column*2
2489   09C4 7E                                 LD      A,(HL)              ; MSB of that column's screen address
2490   09C5 12                                 LD      (DE),A              ; save it
2491   09C6 03                                 INC     BC                  ; 
2492   09C7 13                                 INC     DE                  ; 
2493   09C8 23                                 INC     HL                  ; move to LSB for T0A00
2494   09C9 0A                                 LD      A,(BC)              ; get the coordinate
2495   09CA E6 F8                              AND     $F8                 ; 1111_1000
2496   09CC 0F                                 RRCA                        ; 0111_1100
2497   09CD 0F                                 RRCA                        ; 0011_1110
2498   09CE 0F                                 RRCA                        ; 0001_1111
2499   09CF 86                                 ADD     A,(HL)              ; LSB += (Y >> 3)  -> row within the column
2500   09D0 12                                 LD      (DE),A              ; save it
2501   09D1 C9                                 RET                         ; 
2502   09D2             
2503   0A00                                    .ORG $0A00
2504   0A00             ; Screen ram addresses for the top row (left to right)
2505   0A00             ; Notice these addresses are MSB:LSB (backwards from the processors endianness)
2506   0A00             ; The offset is `(X & $F8) >> 2`, which ranges `$00`…`$3E`.
2507   0A00             ; The 26 valid columns use offsets `$00`–`$32` (`$0A00`–`$0A33`).
2508   0A00             ; Any X coordinate large enough to produce offset `$34`–`$3E` lands in your range and reads `$0000`.
2509   0A00             ; Because the entry is `$0000` for both MSB and the row base LSB,
2510   0A00             ; the computed destination collapses to address `$0000` (plus a tiny Y offset),
2511   0A00             ; i.e. low ROM, where writes are simply ignored.
2512   0A00             ; The result is that an object pushed past the right edge is "drawn" to a harmless null address
2513   0A00             ; instead of corrupting screen RAM or wrapping onto a visible tile.
2514   0A00             T0A00:
2515   0A00                                    .MSFIRST
2516   0A00 43 20                              .DW ForegroundScreen+$320  ; Upper left corner of rotated screen
2517   0A02 43 00                              .DW ForegroundScreen+$300
2518   0A04 42 E0                              .DW ForegroundScreen+$2E0
2519   0A06 42 C0                              .DW ForegroundScreen+$2C0
2520   0A08 42 A0                              .DW ForegroundScreen+$2A0
2521   0A0A 42 80                              .DW ForegroundScreen+$280
2522   0A0C 42 60                              .DW ForegroundScreen+$260
2523   0A0E 42 40                              .DW ForegroundScreen+$240
2524   0A10 42 20                              .DW ForegroundScreen+$220
2525   0A12 42 00                              .DW ForegroundScreen+$200
2526   0A14 41 E0                              .DW ForegroundScreen+$1E0
2527   0A16 41 C0                              .DW ForegroundScreen+$1C0
2528   0A18 41 A0                              .DW ForegroundScreen+$1A0
2529   0A1A 41 80                              .DW ForegroundScreen+$180
2530   0A1C 41 60                              .DW ForegroundScreen+$160
2531   0A1E 41 40                              .DW ForegroundScreen+$140
2532   0A20 41 20                              .DW ForegroundScreen+$120
2533   0A22 41 00                              .DW ForegroundScreen+$100
2534   0A24 40 E0                              .DW ForegroundScreen+$E0
2535   0A26 40 C0                              .DW ForegroundScreen+$C0
2536   0A28 40 A0                              .DW ForegroundScreen+$A0
2537   0A2A 40 80                              .DW ForegroundScreen+$80
2538   0A2C 40 60                              .DW ForegroundScreen+$60
2539   0A2E 40 40                              .DW ForegroundScreen+$40
2540   0A30 40 20                              .DW ForegroundScreen+$20
2541   0A32 40 00                              .DW ForegroundScreen       ; Upper right corner of rotated screen
2542   0A34             
2543   0A34             ; Mapping the 'out of screen' objects,
2544   0A34             ; that catch coordinates mapping beyond the 26 columns, returning a null (`$0000`) address
2545   0A34             ; so off screen objects are written to a safe, ignored location rather than drawn as garbage.
2546   0A34 00 00                              .DB $00, $00
2547   0A36 00 00                              .DB $00, $00
2548   0A38 00 00                              .DB $00, $00
2549   0A3A 00 00                              .DB $00, $00
2550   0A3C 00 00                              .DB $00, $00
2551   0A3E 00 00                              .DB $00, $00
2552   0A40             ;
2553   0A40             T0A40:
2554   0A40 AA BA AB BB                        .DB $AA, $BA, $AB, $BB     ;alien shape #37 (set A)
2555   0A44 80 90 81 91                        .DB $80, $90, $81, $91     ;alien shape #34 (set A)
2556   0A48             T0A48:
2557   0A48 74 7C 75 7D                        .DB $74, $7C, $75, $7D     ;alien pilot shape (set B)
2558   0A4C             
2559   0A50                                    .ORG $0A50
2560   0A50             ;*****************************************************************************
2561   0A50             ;* Handle alien control states for all aliens.
2562   0A50             ;* This routine has a bug!
2563   0A50             ;* Loop goes 20 times for 16 aliens. But bit 3 or 4 is not set at
2564   0A50             ;* UpdateScreenObjects. So luckily no effect.
2565   0A50             ;* Possible fix would be: 'CP $F0' at $0A63.
2566   0A50             ;*****************************************************************************
2567   0A50             AlienDataController:
2568   0A50 01 70 4B                           LD      BC,M4B70            ; alien data structure (grid)
2569   0A53 11 B0 4B                           LD      DE,M4BB0            ; alien data structure (screen ram)
2570   0A56             L0A56:
2571   0A56 C5                                 PUSH    BC                  ;
2572   0A57 CD 18 07                           CALL    UpdateScreenObjects ;
2573   0A5A C1                                 POP     BC                  ;
2574   0A5B 79                                 LD      A,C                 ;
2575   0A5C C6 04                              ADD     $04                 ;
2576   0A5E 4F                                 LD      C,A                 ;
2577   0A5F C6 40                              ADD     $40                 ;
2578   0A61 5F                                 LD      E,A                 ;
2579   0A62 50                                 LD      D,B                 ;
2580   0A63 A7                                 AND     A                   ; updates the zero flag (bug)
2581   0A64 C2 56 0A                           JP      NZ,L0A56            ;
2582   0A67 C9                                 RET                         ;
2583   0A68             
2584   0A6C                                    .ORG $0A6C
2585   0A6C             ;*****************************************************************************
2586   0A6C             ;* Get screen ram adress for all aliens.
2587   0A6C             ;*****************************************************************************
2588   0A6C             L0A6C:
2589   0A6C 01 70 4B                           LD      BC,M4B70            ; data structure for alien control and screen coordinate
2590   0A6F 11 B3 4B                           LD      DE,M4BB3            ; data structure for alien screen ram address
2591   0A72             L0A72:
2592   0A72 C5                                 PUSH    BC                  ;
2593   0A73 D5                                 PUSH    DE                  ;
2594   0A74 0A                                 LD      A,(BC)              ;
2595   0A75 E6 18                              AND     $18                 ; mask out 0001_1000
2596   0A77 CA 8A 0A                           JP      Z,L0A8A             ; if 0 then skip the mapping
2597   0A7A EB                                 EX      DE,HL               ;
2598   0A7B 56                                 LD      D,(HL)              ;
2599   0A7C 2B                                 DEC     HL                  ;
2600   0A7D 5E                                 LD      E,(HL)              ;
2601   0A7E 2B                                 DEC     HL                  ;
2602   0A7F 72                                 LD      (HL),D              ;
2603   0A80 2B                                 DEC     HL                  ;
2604   0A81 73                                 LD      (HL),E              ;
2605   0A82 EB                                 EX      DE,HL               ;
2606   0A83 13                                 INC     DE                  ;
2607   0A84 13                                 INC     DE                  ;
2608   0A85 03                                 INC     BC                  ;
2609   0A86 03                                 INC     BC                  ;
2610   0A87 CD BA 09                           CALL    GetScreenRamAddress ;
2611   0A8A             L0A8A:
2612   0A8A D1                                 POP     DE                  ;
2613   0A8B C1                                 POP     BC                  ;
2614   0A8C 79                                 LD      A,C                 ;
2615   0A8D C6 04                              ADD     $04                 ;
2616   0A8F 4F                                 LD      C,A                 ;
2617   0A90 7B                                 LD      A,E                 ;
2618   0A91 C6 04                              ADD     $04                 ;
2619   0A93 5F                                 LD      E,A                 ;
2620   0A94 FE 03                              CP      $03                 ;
2621   0A96 C2 72 0A                           JP      NZ,L0A72            ; loop for all aliens
2622   0A99 C9                                 RET                         ;
2623   0A9A             
2624   0AA0                                    .ORG $0AA0
2625   0AA0             ;*****************************************************************************
2626   0AA0             ;* Handler for the player shield.
2627   0AA0             ;*****************************************************************************
2628   0AA0             DrawShields:
2629   0AA0 2E E2                              LD      L,PlayerShipMSB & $FF     ; HL=43E2 Player's screen memory location
2630   0AA2 56                                 LD      D,(HL)              ; Get the PlayerScreenRamMSB
2631   0AA3 23                                 INC     HL                  ; Get the ... PlayerScreenRamLSB
2632   0AA4 5E                                 LD      E,(HL)              ; ... LSB (ignore any fine bit shifting of the player)
2633   0AA5 CD 10 02                           CALL    LeftOneColumn       ; Shield pictures begin one column to the left of the ship
2634   0AA8 1B                                 DEC     DE                  ; Shield pictures begin one row above the ship
2635   0AA9 01 04 04                           LD      BC,$0404            ; Shiled images are 4x4
2636   0AAC 2E A6                              LD      L,ShieldCount & $FF ; Decrement the ...
2637   0AAE 35                                 DEC     (HL)                ; ... shield counter
2638   0AAF 7E                                 LD      A,(HL)              ; Current shield counter value
2639   0AB0 21 F0 17                           LD      HL,FourByFourEmpty  ; Blank 4x4
2640   0AB3 FE C0                              CP      $C0                 ; Shield time done?
2641   0AB5 CA 48 0B                           JP      Z,ShieldsExpired    ; Yes ... turn shields off
2642   0AB8 21 70 17                           LD      HL,T1770            ; Four shield-active pictures
2643   0ABB E6 0C                              AND     $0C                 ; Drop lower 2 bits (0000_1100). Images change every 4 ticks.
2644   0ABD 07                                 RLCA                        ; Multiply by 4 ...
2645   0ABE 07                                 RLCA                        ; ... to get a 16-byte offest (4x4 pictures)
2646   0ABF 85                                 ADD     A,L                 ; Point to the ...
2647   0AC0 6F                                 LD      L,A                 ; ... correct image
2648   0AC1 C3 D6 0A                           JP      DrawImageCbyB       ; Draw the new shield image
2649   0AC4             
2650   0AD6                                    .ORG $0AD6
2651   0AD6             ;*****************************************************************************
2652   0AD6             ; B is number of rows
2653   0AD6             ; C is number of columns
2654   0AD6             ; HL is the data
2655   0AD6             ; DE is the pointer to the screen
2656   0AD6             ;*****************************************************************************
2657   0AD6             DrawImageCbyB:
2658   0AD6 D5                                 PUSH    DE                  ; Hold screen pointer
2659   0AD7 C5                                 PUSH    BC                  ; Hold width/Height
2660   0AD8             L0AD8:
2661   0AD8 7E                                 LD      A,(HL)              ; Character to ...
2662   0AD9 12                                 LD      (DE),A              ; ... the screen
2663   0ADA 23                                 INC     HL                  ; Next in data
2664   0ADB 13                                 INC     DE                  ; Next column on screen
2665   0ADC 05                                 DEC     B                   ; All rows done in this column?
2666   0ADD C2 D8 0A                           JP      NZ,L0AD8            ; No ... finish the rows
2667   0AE0 C1                                 POP     BC                  ; Restore the counters
2668   0AE1 D1                                 POP     DE                  ; Restore the screen pointer
2669   0AE2 CD 17 02                           CALL    RightOneColumn      ; Move over one column
2670   0AE5 0D                                 DEC     C                   ; All columns done?
2671   0AE6 C2 D6 0A                           JP      NZ,DrawImageCbyB    ; No ... do all columns
2672   0AE9 C9                                 RET                         ; Done
2673   0AEA             
2674   0AEA             ;*****************************************************************************
2675   0AEA             ;* Game state 4.
2676   0AEA             ;* Player ship partikel explosion. (ship blows apart)
2677   0AEA             ;* - It freezes scrolling (`CounterB9 &= $F8` -> scroll register) so the blast stays put.
2678   0AEA             ;* - It anchors the effect at the ship's screen address (`$43E2/$43E3`).
2679   0AEA             ;* - `CounterA5` (`$43A5`) is the animation phase, decremented each frame and dispatched.
2680   0AEA             ;*****************************************************************************
2681   0AEA             L0AEA:
2682   0AEA 21 B9 43                           LD      HL,CounterB9        ; 
2683   0AED 7E                                 LD      A,(HL)              ; 
2684   0AEE E6 F8                              AND     $F8                 ; 1111_1000 coarsen the scroll phase...
2685   0AF0 77                                 LD      (HL),A              ; 
2686   0AF1 32 00 58                           LD      (scrollRegister),A  ; ...and freeze the 58xx scroll
2687   0AF4 2E E2                              LD      L,$E2               ; PlayerShipMSB ($43E2)
2688   0AF6 56                                 LD      D,(HL)              ; 
2689   0AF7 2C                                 INC     L                   ; PlayerShipLSB ($43E3)
2690   0AF8 5E                                 LD      E,(HL)              ; 
2691   0AF9 CD 10 02                           CALL    LeftOneColumn       ; anchor the blast at the ship
2692   0AFC 1B                                 DEC     DE                  ; 
2693   0AFD 00                                 NOP                         ; 
2694   0AFE 2E A5                              LD      L,$A5               ; CounterA5 = explosion phase/timer
2695   0B00 35                                 DEC     (HL)                ; 
2696   0B01 7E                                 LD      A,(HL)              ; 
2697   0B02 CA 15 0B                           JP      Z,L0B15             ; phase 0  -> finish (lose a life)
2698   0B05 FE 20                              CP      $20                 ; 
2699   0B07 DA A0 0B                           JP      C,L0BA0             ; late phase -> clear background/scroll
2700   0B0A CA 80 03                           JP      Z,ClearForeground   ; 
2701   0B0D C3 BA 0B                           JP      L0BBA               ; main phase -> render particles
2702   0B10             
2703   0B15                                    .ORG $0B15
2704   0B15             ;*****************************************************************************
2705   0B15             ;* The explosion is over — it reloads `CounterA5=5`, decrements that player's life count,
2706   0B15             ;* refreshes the lives display, and sets `GameState = 0` (new turn / next player start).
2707   0B15             ;*****************************************************************************
2708   0B15             L0B15:
2709   0B15 2D                                 DEC     L                   ;
2710   0B16 36 05                              LD      (HL),$05            ;
2711   0B18 2D                                 DEC     L                   ;
2712   0B19 7E                                 LD      A,(HL)              ;
2713   0B1A C6 90                              ADD     $90                 ; -> Player1Lives / Player2Lives slot
2714   0B1C 6F                                 LD      L,A                 ;
2715   0B1D 7E                                 LD      A,(HL)              ;
2716   0B1E A7                                 AND     A                   ; updates the zero flag
2717   0B1F C8                                 RET     Z                   ;
2718   0B20 35                                 DEC     (HL)                ; lose a life
2719   0B21 E5                                 PUSH    HL                  ;
2720   0B22 CD 67 03                           CALL    UpdateLivesScreen   ;
2721   0B25 E1                                 POP     HL                  ;
2722   0B26 7E                                 LD      A,(HL)              ;
2723   0B27 A7                                 AND     A                   ; updates the zero flag
2724   0B28 C8                                 RET     Z                   ;
2725   0B29 2E A4                              LD      L,$A4               ; GameState
2726   0B2B 36 00                              LD      (HL),$00            ; set to: 'new game start'
2727   0B2D C9                                 RET                         ;
2728   0B2E             
2729   0B38                                    .ORG $0B38
2730   0B38             ; Player ship X position mapping table
2731   0B38             T0B38:
2732   0B38 00 08                              .DB $00, $08
2733   0B3A 01 09                              .DB $01, $09
2734   0B3C 02 0A                              .DB $02, $0A
2735   0B3E 03 0B                              .DB $03, $0B
2736   0B40 03 0B                              .DB $03, $0B
2737   0B42 02 0A                              .DB $02, $0A
2738   0B44 01 09                              .DB $01, $09
2739   0B46 00 08                              .DB $00, $08
2740   0B48             
2741   0B48             ;*****************************************************************************
2742   0B48             ;* The player shield is expired.
2743   0B48             ;* Shield and player gets removed from screen.
2744   0B48             ;* PlayerShipX position is reset.
2745   0B48             ;*****************************************************************************
2746   0B48             ShieldsExpired:
2747   0B48 CD D6 0A                           CALL    DrawImageCbyB       ; 
2748   0B4B 21 C0 43                           LD      HL,PlayerState      ; 
2749   0B4E 36 0C                              LD      (HL),$0C            ; 0000_1100
2750   0B50 2C                                 INC     L                   ; PlayerShape
2751   0B51 36 0C                              LD      (HL),$0C            ; 0000_1100
2752   0B53 2C                                 INC     L                   ; PlayerShipX
2753   0B54 7E                                 LD      A,(HL)              ; get
2754   0B55 E6 F8                              AND     $F8                 ; 1111_1000
2755   0B57 F6 03                              OR      $03                 ; 0000_0011
2756   0B59 77                                 LD      (HL),A              ; reset PlayerShipX
2757   0B5A C9                                 RET                         ; 
2758   0B5B             
2759   0B60                                    .ORG $0B60
2760   0B60             ;*****************************************************************************
2761   0B60             ;* Game state 5.
2762   0B60             ;* 'GAME OVER'.
2763   0B60             ;*****************************************************************************
2764   0B60             L0B60:
2765   0B60 21 A5 43                           LD      HL,CounterA5        ; 
2766   0B63 34                                 INC     (HL)                ; 
2767   0B64 7E                                 LD      A,(HL)              ; 
2768   0B65 FE 40                              CP      $40                 ; 
2769   0B67 CA A0 03                           JP      Z,ClearBackground   ; 
2770   0B6A 21 00 1A                           LD      HL,T1A00            ; "        GAME  OVER        "
2771   0B6D 0E 01                              LD      C,$01               ; 
2772   0B6F FE 80                              CP      $80                 ; 
2773   0B71 C2 95 0B                           JP      NZ,L0B95            ; 
2774   0B74 21 A4 43                           LD      HL,GameState        ; Next interval game state ...
2775   0B77 36 00                              LD      (HL),$00            ; ... is 0 (new game start)
2776   0B79 2E 90                              LD      L,$90               ; Player1Lives
2777   0B7B 7E                                 LD      A,(HL)              ; 
2778   0B7C 2C                                 INC     L                   ; Player2Lives
2779   0B7D B6                                 OR      (HL)                ; 
2780   0B7E C0                                 RET     NZ                  ; 
2781   0B7F AF                                 XOR     A                   ; A=0
2782   0B80 2E 98                              LD      L,$98               ; Counter98
2783   0B82 77                                 LD      (HL),A              ; 
2784   0B83 2C                                 INC     L                   ; Counter98+1
2785   0B84 77                                 LD      (HL),A              ; 
2786   0B85 2E A2                              LD      L,$A2               ; GameOrAttract
2787   0B87 77                                 LD      (HL),A              ; 
2788   0B88 2C                                 INC     L                   ; GameAndDemoOrSplash
2789   0B89 7E                                 LD      A,(HL)              ; 
2790   0B8A A7                                 AND     A                   ; updates the zero flag
2791   0B8B C8                                 RET     Z                   ; 
2792   0B8C 36 00                              LD      (HL),$00            ; 
2793   0B8E 01 00 01                           LD      BC,$0100            ; from bank 1 to bank 0
2794   0B91 CD 60 04                           CALL    CopyMemoryBank      ; 
2795   0B94 C9                                 RET                         ; 
2796   0B95             ;
2797   0B95             L0B95:
2798   0B95 CD D0 01                           CALL    PrintTextLines      ; "        GAME  OVER        "
2799   0B98 CD E4 01                           CALL    L01E4               ; print the copyright lines
2800   0B9B C3 F0 1D                           JP      L1DF0               ; protection against piracy
2801   0B9E             
2802   0BA0                                    .ORG $0BA0
2803   0BA0             ;*****************************************************************************
2804   0BA0             ;* Late cleanup: clear background, reset scroll on non‑mothership levels.
2805   0BA0             ;*****************************************************************************
2806   0BA0             L0BA0:
2807   0BA0 21 B8 43                           LD      HL,LevelAndRound    ;
2808   0BA3 7E                                 LD      A,(HL)              ;
2809   0BA4 E6 0F                              AND     $0F                 ; mask out 0000_1111
2810   0BA6 FE 04                              CP      $04                 ;
2811   0BA8 D8                                 RET     C                   ; return if < game level 4 (alien waves)
2812   0BA9 FE 09                              CP      $09                 ;
2813   0BAB D0                                 RET     NC                  ; return if > game level 9 (mothership)
2814   0BAC 2C                                 INC     L                   ; CounterB9
2815   0BAD AF                                 XOR     A                   ; A=0
2816   0BAE 77                                 LD      (HL),A              ; CounterB9 to 0
2817   0BAF 32 00 58                           LD      (scrollRegister),A  ; reset the 58xx scroll register
2818   0BB2 C3 A0 03                           JP      ClearBackground     ;
2819   0BB5             
2820   0BBA                                    .ORG $0BBA
2821   0BBA             ;*****************************************************************************
2822   0BBA             ;* Player-ship explosion:
2823   0BBA             ;* Per-frame visual dispatcher.
2824   0BBA             ;* Entered from L0AEA (game state 4) with A = CounterA5 (explosion phase),
2825   0BBA             ;* when CounterA5 >= $20. Selects one task per frame from the low 2 bits,
2826   0BBA             ;* so the three effects are interleaved as the counter runs down:
2827   0BBA             ;*   CounterA5 & 1 == 0   -> L0FC0  killed-alien animation upkeep
2828   0BBA             ;*   CounterA5 & 3 == 01  -> L20E8  draw a 4x4 ship-fragment sprite
2829   0BBA             ;*   CounterA5 & 3 == 11  -> L2070  render the particle field (T2800/T2900)
2830   0BBA             ;* So across consecutive frames the three low bit patterns rotate through the three tasks,
2831   0BBA             ;* letting the game advance the debris field, the fragment sprites,
2832   0BBA             ;* and any in progress killed alien effects without doing all of them in a single frame.
2833   0BBA             ;*****************************************************************************
2834   0BBA             L0BBA:
2835   0BBA 47                                 LD      B,A                 ; save the CounterA5 phase value
2836   0BBB 0F                                 RRCA                        ; bit0 -> carry
2837   0BBC D2 C0 0F                           JP      NC,L0FC0            ; bit0=0: handle animations for killed aliens
2838   0BBF 0F                                 RRCA                        ; bit0 was 1; now original bit1 -> carry
2839   0BC0 78                                 LD      A,B                 ; restore CounterA5
2840   0BC1 DA 70 20                           JP      C,L2070             ; bits1:0=11: render ship particle field (T2800/T2900)
2841   0BC4 C3 E8 20                           JP      L20E8               ; bits1:0=01: draw 4x4 ship-fragment sprite
2842   0BC7             
2843   0BCA                                    .ORG $0BCA
2844   0BCA             ;*****************************************************************************
2845   0BCA             ;* Draws the character tiles for the score average table.
2846   0BCA             ;*****************************************************************************
2847   0BCA             DrawScoreAverageTableTiles:
2848   0BCA 21 D0 42                           LD      HL,$42D0            ; upper left corner screen ram position
2849   0BCD 01 DF FF                           LD      BC,$FFDF            ; Screen offset constant -33 right one column (-1), up one row (-32)
2850   0BD0 36 64                              LD      (HL),$64            ; left part of alien shape #3
2851   0BD2 09                                 ADD     HL,BC               ;
2852   0BD3 23                                 INC     HL                  ;
2853   0BD4 36 65                              LD      (HL),$65            ; right part of alien shape #3
2854   0BD6 21 F2 42                           LD      HL,$42F2            ; screen ram position for
2855   0BD9 11 40 0A                           LD      DE,T0A40            ; T0A40 alien shape #37 and alien shape #34
2856   0BDC CD 38 35                           CALL    Draw4x2             ;
2857   0BDF 21 15 4B                           LD      HL,$4B15            ; screen ram position for
2858   0BE2 11 00 3C                           LD      DE,T3C00            ; bird shape #24 (Object 3C00)
2859   0BE5 CD 28 35                           CALL    Draw6x2             ;
2860   0BE8 21 D8 4A                           LD      HL,$4AD8            ; screen ram position for
2861   0BEB 11 48 0A                           LD      DE,T0A48            ; T0A48 alien pilot shape
2862   0BEE CD 48 35                           CALL    Draw2x2             ;
2863   0BF1 C9                                 RET                         ;
2864   0BF2             
2865   0C00                                    .ORG $0C00
2866   0C00             ;*****************************************************************************
2867   0C00             ;* Score/bonus selector for a shot flying alien:
2868   0C00             ;* A flying alien was hit. Choose its explosion / score from its current
2869   0C00             ;* movement-pattern phase.
2870   0C00             ;* Entry: HL -> struck alien's screen-X field ($4B72 + 4*index).
2871   0C00             ;* Per-alien movement-pattern pointers live at $4B50 (2 bytes: MSB,LSB each).
2872   0C00             ;* Pattern value 7 or 8 (attack/dive apex) -> 200-pt bonus + bonus explosion;
2873   0C00             ;* any other value -> normal kill.  All paths finish in L0EA4.
2874   0C00             ;* This routine is the mechanic that rewards shooting an alien at the peak of its swoop/dive,
2875   0C00             ;* only when the enemy's movement pattern is in phase 7–8 do you get the 200 point bonus
2876   0C00             ;* and the special bonus explosion, hitting it at any other point in its flight
2877   0C00             ;* gives the ordinary kill value.
2878   0C00             ;*****************************************************************************
2879   0C00             L0C00:
2880   0C00 E5                                 PUSH    HL                  ; save the alien entry pointer
2881   0C01 7D                                 LD      A,L                 ; L = $72,$76,$7A,... (screen-X field of this alien)
2882   0C02 D6 72                              SUB     $72                 ; -> 0,4,8,... = 4 * alien index
2883   0C04 0F                                 RRCA                        ; /2 -> 0,2,4,... = 2 * alien index
2884   0C05 C6 50                              ADD     $50                 ; -> $50 + 2*index
2885   0C07 6F                                 LD      L,A                 ; HL = $4B50 + 2*index (this alien's pattern pointer)
2886   0C08 7E                                 LD      A,(HL)              ; get MSB pointer of alien movement pattern
2887   0C09 2C                                 INC     L                   ; 
2888   0C0A 6E                                 LD      L,(HL)              ; get LSB pointer of alien movement pattern
2889   0C0B 67                                 LD      H,A                 ; HL = alien's current position in its pattern list
2890   0C0C 11 04 0C                           LD      DE,$0C04            ; default: D=$0C anim index, E=$04 normal-kill score
2891   0C0F 7E                                 LD      A,(HL)              ; get movement pattern value (current phase)
2892   0C10 E1                                 POP     HL                  ; restore the alien entry pointer
2893   0C11 FE 07                              CP      $07                 ; 
2894   0C13 DA A4 0E                           JP      C,L0EA4             ; phase < $07: normal kill
2895   0C16 FE 09                              CP      $09                 ; 
2896   0C18 D2 A4 0E                           JP      NC,L0EA4            ; phase >= $09: normal kill
2897   0C1B             ; Else phase is $07 or $08 -> BONUS
2898   0C1B 11 20 10                           LD      DE,$1020            ; D=$10 anim index, E=$20 bonus explosion score 200
2899   0C1E 3E FF                              LD      A,$FF               ; set bonus explosion flag
2900   0C20 32 69 43                           LD      (M4369),A           ; $4369 = 'bonus explosion'
2901   0C23 C3 A4 0E                           JP      L0EA4               ; kill with the bonus values
2902   0C26             
2903   0C40                                    .ORG $0C40
2904   0C40             ;*****************************************************************************
2905   0C40             ; Updates the enemy bullets.
2906   0C40             ;*****************************************************************************
2907   0C40             L0C40:
2908   0C40 21 FF 43                           LD      HL,AlienBullet4LSB  ; 
2909   0C43 06 05                              LD      B,$05               ; 5 bullet slots
2910   0C45 CD 8B 08                           CALL    L088B               ; Copy current enemy bullet data to old enemy bullet data
2911   0C48 CD 56 0C                           CALL    L0C56               ; Enemy bullets movement and animation
2912   0C4B CD 6B 0C                           CALL    L0C6B               ; Get the screen ram address for all enemy bullets
2913   0C4E CD D8 0C                           CALL    L0CD8               ; Draw or delete the screen objects
2914   0C51 C9                                 RET                         ; 
2915   0C52             
2916   0C56                                    .ORG $0C56
2917   0C56             ;*****************************************************************************
2918   0C56             ;* Enemy bullets movement and animation.
2919   0C56             ;* Handles all 5 bullet slots.
2920   0C56             ;*****************************************************************************
2921   0C56             L0C56:
2922   0C56 21 CC 43                           LD      HL,AlienBullet0State; 
2923   0C59             L0C59:
2924   0C59 E5                                 PUSH    HL                  ; 
2925   0C5A CD 84 0C                           CALL    L0C84               ; movement and animation of enemy bullet
2926   0C5D E1                                 POP     HL                  ; 
2927   0C5E 7D                                 LD      A,L                 ; 
2928   0C5F C6 04                              ADD     $04                 ; 
2929   0C61 6F                                 LD      L,A                 ; 
2930   0C62 FE E0                              CP      $E0                 ; 
2931   0C64 C2 59 0C                           JP      NZ,L0C59            ; loop for 5 enemy bullet slots
2932   0C67 C9                                 RET                         ; 
2933   0C68             
2934   0C6B                                    .ORG $0C6B
2935   0C6B             ;*****************************************************************************
2936   0C6B             ;* Get the screen ram address for all enemy bullets.
2937   0C6B             ;*****************************************************************************
2938   0C6B             L0C6B:
2939   0C6B 01 CE 43                           LD      BC,AlienBullet0X    ; 
2940   0C6E 11 EE 43                           LD      DE,AlienBullet0MSB  ; 
2941   0C71             L0C71:
2942   0C71 CD BA 09                           CALL    GetScreenRamAddress ; 
2943   0C74 03                                 INC     BC                  ; 
2944   0C75 03                                 INC     BC                  ; 
2945   0C76 03                                 INC     BC                  ; 
2946   0C77 13                                 INC     DE                  ; 
2947   0C78 13                                 INC     DE                  ; 
2948   0C79 13                                 INC     DE                  ; 
2949   0C7A 79                                 LD      A,C                 ; 
2950   0C7B FE E2                              CP      $E2                 ; 
2951   0C7D C2 71 0C                           JP      NZ,L0C71            ; loop for 5 enemy bullet slots
2952   0C80 C9                                 RET                         ; 
2953   0C81             
2954   0C84                                    .ORG $0C84
2955   0C84             ;*****************************************************************************
2956   0C84             ;* Movement and animation of enemy bullet.
2957   0C84             ;* They have half the speed of player bullets and a simple animation.
2958   0C84             ;*****************************************************************************
2959   0C84             L0C84:
2960   0C84 7E                                 LD      A,(HL)              ; get enemy bullet control state
2961   0C85 E6 08                              AND     $08                 ; 0000_1000
2962   0C87 C8                                 RET     Z                   ; if bit 3 not set
2963   0C88 00                                 NOP                         ; 
2964   0C89 00                                 NOP                         ; 
2965   0C8A 2C                                 INC     L                   ; 
2966   0C8B 7E                                 LD      A,(HL)              ; get enemy bullet character code
2967   0C8C EE 04                              XOR     $04                 ; toggle 0000_0100 for animation: $58/$5C, $59/$5D, ...
2968   0C8E 77                                 LD      (HL),A              ; set new character code
2969   0C8F 2C                                 INC     L                   ; 
2970   0C90 2C                                 INC     L                   ; 
2971   0C91 7E                                 LD      A,(HL)              ; get enemy bullet coordinate Y
2972   0C92 C6 04                              ADD     $04                 ; move bullet down
2973   0C94 77                                 LD      (HL),A              ; 
2974   0C95 FE F9                              CP      $F9                 ; bottom of screen
2975   0C97 D2 6E 09                           JP      NC,L096E            ; if bottom of screen reached
2976   0C9A 2D                                 DEC     L                   ; enemy bullet coordinate X
2977   0C9B CD B4 0C                           CALL    L0CB4               ; 
2978   0C9E 54                                 LD      D,H                 ; 
2979   0C9F 7D                                 LD      A,L                 ; 
2980   0CA0 C6 20                              ADD     $20                 ; move to EnemyBullet(x)MSB
2981   0CA2 5F                                 LD      E,A                 ; 
2982   0CA3 EB                                 EX      DE,HL               ; 
2983   0CA4 46                                 LD      B,(HL)              ; get EnemyBullet(x)MSB
2984   0CA5 23                                 INC     HL                  ; 
2985   0CA6 4E                                 LD      C,(HL)              ; get EnemyBullet(x)LSB
2986   0CA7 0A                                 LD      A,(BC)              ; 
2987   0CA8 EB                                 EX      DE,HL               ; 
2988   0CA9 2C                                 INC     L                   ; 
2989   0CAA FE E8                              CP      $E8                 ; 
2990   0CAC D2 6E 09                           JP      NC,L096E            ; if >= $E8 (fgtiles upper part of player shield)
2991   0CAF C9                                 RET                         ; 
2992   0CB0             
2993   0CB4                                    .ORG $0CB4
2994   0CB4             ;
2995   0CB4             L0CB4:
2996   0CB4 FE DC                              CP      $DC                 ; lower part of screen
2997   0CB6 D8                                 RET     C                   ; if not reached
2998   0CB7 FE E9                              CP      $E9                 
2999   0CB9 D0                                 RET     NC                  
3000   0CBA 3A 9F 43                           LD      A,(M439F)           ; Mapped player ship position, right part: ($17 to $C8)
3001   0CBD BE                                 CP      (HL)                
3002   0CBE D8                                 RET     C                   
3003   0CBF 3A 9E 43                           LD      A,(M439E)           ; Mapped player ship position, left part: ($09 to $C0)
3004   0CC2 BE                                 CP      (HL)                
