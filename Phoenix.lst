8484   39C3             ;*****************************************************************************
8485   39C3             ;* --- Use (the sweep)
8486   39C3             ;* After saving, the routine forces `PlayerBulletState` active (`$39A7: LD (HL),$08`),
8487   39C3             ;* seeds the aim X, and repeatedly calls the bird collision routine `L3800`
8488   39C3             ;* while stepping the "above-player bullet" address down one row at a time — checking up to ~`$1D` rows for a hit.
8489   39C3             ;*****************************************************************************
8490   39C3             L39C3:
8491   39C3 CD 00 38                           CALL    L3800               ; Collision detection for birds
8492   39C6 21 C4 43                           LD      HL,PlayerBulletState
8493   39C9 7E                                 LD      A,(HL)              
8494   39CA E6 08                              AND     $08                 
8495   39CC CA F0 39                           JP      Z,L39F0             ; 
8496   39CF 21 E7 43                           LD      HL,AbovePlayerBulletLSB
8497   39D2 34                                 INC     (HL)                
8498   39D3 7E                                 LD      A,(HL)              
8499   39D4 E6 1F                              AND     $1F                 
8500   39D6 FE 1D                              CP      $1D                 
8501   39D8 DA C3 39                           JP      C,L39C3             ; 
8502   39DB             ;*****************************************************************************
8503   39DB             ;* --- Restore buffer
8504   39DB             ;* When the sweep finishes (or the shield branch at `L39F0` completes),
8505   39DB             ;* the saved bytes are copied back, returning the player bullet to exactly its previous state
8506   39DB             ;*****************************************************************************
8507   39DB             L39DB:
