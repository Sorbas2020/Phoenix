3408   0EC5 CA D5 0E                           JP      Z,L0ED5             ; 
3409   0EC8 2C                                 INC     L                   
3410   0EC9 2C                                 INC     L                   
3411   0ECA 2C                                 INC     L                   
3412   0ECB 2C                                 INC     L                   
3413   0ECC 7E                                 LD      A,(HL)              
3414   0ECD A7                                 AND     A                   ; updates the zero flag
3415   0ECE CA D5 0E                           JP      Z,L0ED5             ; 
3416   0ED1 2C                                 INC     L                   
3417   0ED2 2C                                 INC     L                   
3418   0ED3 2C                                 INC     L                   
