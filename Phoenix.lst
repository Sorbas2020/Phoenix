2029   0788             ;*****************************************************************************
2030   0788             ;* Bit3 control function 88:
2031   0788             ;* If control state A: xxxx_1001
2032   0788             ;* Map alien control state B to shape and draw it.
2033   0788             ;* Draw 2x1 screen objects (alien).
2034   0788             ;*****************************************************************************
2035   0788             L0788:
2036   0788 EB                                 EX      DE,HL               ;
2037   0789 23                                 INC     HL                  ;
2038   078A 23                                 INC     HL                  ;
2039   078B 56                                 LD      D,(HL)              ;
2040   078C 23                                 INC     HL                  ;
2041   078D 5E                                 LD      E,(HL)              ;
2042   078E 0A                                 LD      A,(BC)              ; get alien control state B
2043   078F 6F                                 LD      L,A                 ; as offset for...
2044   0790 26 14                              LD      H,T1420 >> 8        ; get alien character block shapes table
2045   0792 7E                                 LD      A,(HL)              ;
2046   0793 12                                 LD      (DE),A              ; draw alien character left part
2047   0794 23                                 INC     HL                  ; next character
2048   0795 CD 17 02                           CALL    RightOneColumn      ;
2049   0798 7E                                 LD      A,(HL)              ;
2050   0799 12                                 LD      (DE),A              ; draw alien character right part
2051   079A 0B                                 DEC     BC                  ;
2052   079B C9                                 RET                         ;
