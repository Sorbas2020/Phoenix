5339   2230             ;*****************************************************************************
5340   2230             ;* Game level 4, 6 and 8:
5341   2230             ;* Drives the spiral fade-in animation between waves.
5342   2230             ;* The animation step counter is incremented every frame,
5343   2230             ;* its value indexes the spiral drawing progress,
5344   2230             ;* and when the spiral is complete it advances to the next level.
5345   2230             ;*****************************************************************************
5346   2230             L2230:
5347   2230 21 9C 43                           LD      HL,M439C            ; 
5348   2233 7E                                 LD      A,(HL)              ;
5349   2234 34                                 INC     (HL)                ; advance animation
5350   2235 00                                 NOP                         ;
5351   2236 0F                                 RRCA                        ;
5352   2237 E6 3F                              AND     $3F                 ; mask out 0011_1111
5353   2239 FE 0D                              CP      $0D                 ; 
5354   223B CA 92 22                           JP      Z,L2292             ; spiral step
5355   223E 06 1F                              LD      B,$1F               ; The asterisk character
5356   2240 DA 60 22                           JP      C,L2260             ; 
5357   2243 06 00                              LD      B,$00               ; The space character
5358   2245 D6 0E                              SUB     $0E                 ;
5359   2247 FE 0D                              CP      $0D                 ;
5360   2249 C2 60 22                           JP      NZ,L2260            ; 
5361   224C 21 B8 43                           LD      HL,LevelAndRound    ; 
5362   224F 34                                 INC     (HL)                ; increment game level $43B8
5363   2250 2E A4                              LD      L,$A4               ; HL=43A4 -- game state
5364   2252 36 02                              LD      (HL),$02            ; Next interval game state is 2: 'init game and level data'
5365   2254 C9                                 RET                         ;
5366   2255             
5367   2260                                    .ORG $2260
5368   2260             ;
5369   2260             L2260:
5370   2260 4F                                 LD      C,A                 ;
5371   2261 0F                                 RRCA                        ;
5372   2262 0F                                 RRCA                        ;
5373   2263 0F                                 RRCA                        ;
5374   2264 57                                 LD      D,A                 ;
5375   2265 E6 1F                              AND     $1F                 ; 0001_1111
5376   2267 5F                                 LD      E,A                 ;
5377   2268 7A                                 LD      A,D                 ;
5378   2269 E6 E0                              AND     $E0                 ; 1110_0000
5379   226B C6 B0                              ADD     $B0                 ;
5380   226D 6F                                 LD      L,A                 ;
5381   226E 7B                                 LD      A,E                 ;
5382   226F CE 41                              ADC     $41                 ;
5383   2271 67                                 LD      H,A                 ;
5384   2272 7D                                 LD      A,L                 ;
5385   2273 91                                 SUB     C                   ;
5386   2274 6F                                 LD      L,A                 ;
5387   2275 79                                 LD      A,C                 ;
5388   2276 3C                                 INC     A                   ;
5389   2277 4F                                 LD      C,A                 ;
5390   2278 07                                 RLCA                        ; Multiply by 2
5391   2279 5F                                 LD      E,A                 ;
5392   227A             ;
5393   227A             L227A:
5394   227A 51                                 LD      D,C                 ; D is the height counter for each pass
5395   227B             ;
5396   227B             L227B:
5397   227B 70                                 LD      (HL),B              ; draw the asterisk or space
5398   227C 23                                 INC     HL                  ; one row down
5399   227D 70                                 LD      (HL),B              ; another asterisk or space
5400   227E 23                                 INC     HL                  ; one row down
5401   227F 15                                 DEC     D                   ; all of this column done?
5402   2280 C2 7B 22                           JP      NZ,L227B            ; No ... do all rows
5403   2283 7D                                 LD      A,L                 ; LSB of screen pointer
5404   2284 91                                 SUB     C                   ; move up ...
5405   2285 91                                 SUB     C                   ; ... height * 2
5406   2286 D6 20                              SUB     $20                 ; Move right one column
5407   2288 6F                                 LD      L,A                 ; New LSB
5408   2289 7C                                 LD      A,H                 ; Borrow into ...
5409   228A DE 00                              SBC     $00                 ; ... the ...
5410   228C 67                                 LD      H,A                 ; ... MSB
5411   228D 1D                                 DEC     E                   ; All columns done?
5412   228E C2 7A 22                           JP      NZ,L227A            ; no ... do all columns
5413   2291 C9                                 RET                         ; Done
