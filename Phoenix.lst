2133   07D6 23                                 INC     HL                  ;
2134   07D7 5E                                 LD      E,(HL)              ; get LSB from player data structure (screen ram)
2135   07D8 0A                                 LD      A,(BC)              ; get value from player data structure (grid)
2136   07D9 6F                                 LD      L,A                 ;
2137   07DA 26 14                              LD      H,T1400 >> 8        ; get player ship character block shapes table
2138   07DC             L07DC:
2139   07DC 7E                                 LD      A,(HL)              ; Entry point for general draw
2140   07DD 12                                 LD      (DE),A              ; draw upper left part
2141   07DE 23                                 INC     HL                  ;
2142   07DF 13                                 INC     DE                  ;
2143   07E0 7E                                 LD      A,(HL)              ;
2144   07E1 12                                 LD      (DE),A              ; draw upper right part
2145   07E2 23                                 INC     HL                  ;
2146   07E3 1B                                 DEC     DE                  ;
2147   07E4 CD 17 02                           CALL    RightOneColumn      ;
2148   07E7 7E                                 LD      A,(HL)              ;
2149   07E8 12                                 LD      (DE),A              ; draw lower left part
2150   07E9 23                                 INC     HL                  ;
2151   07EA 13                                 INC     DE                  ;
2152   07EB 7E                                 LD      A,(HL)              ;
2153   07EC 12                                 LD      (DE),A              ; draw lower right part
2154   07ED 0B                                 DEC     BC                  ;
2155   07EE C9                                 RET                         ;
