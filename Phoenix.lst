2098   07BE                                    .ORG $07BE
2099   07BE             ;*****************************************************************************
2100   07BE             ;* Bit4 control function BE:
2101   07BE             ;* If control state A: 1001_xxxx
2102   07BE             ;* Delete 2x2 screen objects (player ship, alien).
2103   07BE             ;*****************************************************************************
2104   07BE             L07BE:
2105   07BE EB                                 EX      DE,HL               ;
2106   07BF 56                                 LD      D,(HL)              ;
2107   07C0 23                                 INC     HL                  ;
2108   07C1 5E                                 LD      E,(HL)              ;
2109   07C2 2B                                 DEC     HL                  ;
2110   07C3 AF                                 XOR     A                   ; A=0
2111   07C4 12                                 LD      (DE),A              ; delete upper left part
2112   07C5 13                                 INC     DE                  ;
2113   07C6 12                                 LD      (DE),A              ; delete upper right part
2114   07C7 CD 17 02                           CALL    RightOneColumn      ;
2115   07CA AF                                 XOR     A                   ; A=0
2116   07CB 12                                 LD      (DE),A              ; delete lower left part
2117   07CC 1B                                 DEC     DE                  ;
2118   07CD 12                                 LD      (DE),A              ; delete lower right part
2119   07CE EB                                 EX      DE,HL               ;
2120   07CF C9                                 RET                         ;
