3328   0E6B C3 00 0C                           JP      L0C00               ; 
3329   0E6E             
3330   0E70                                    .ORG $0E70
3331   0E70             ;
3332   0E70             L0E70:
3333   0E70 23                                 INC     HL                  
3334   0E71 0A                                 LD      A,(BC)              
3335   0E72 E6 F8                              AND     $F8                 
3336   0E74 86                                 ADD     A,(HL)              
3337   0E75 57                                 LD      D,A                 
3338   0E76 03                                 INC     BC                  
3339   0E77 0A                                 LD      A,(BC)              
3340   0E78 E6 F8                              AND     $F8                 
3341   0E7A 5F                                 LD      E,A                 
3342   0E7B 21 70 4B                           LD      HL,M4B70            ; 
3343   0E7E             L0E7E:
3344   0E7E 7E                                 LD      A,(HL)              
3345   0E7F 23                                 INC     HL                  
3346   0E80 23                                 INC     HL                  
3347   0E81 E6 08                              AND     $08                 
3348   0E83 C4 90 0E                           CALL    NZ,L0E90            ; 
3349   0E86 23                                 INC     HL                  
3350   0E87 23                                 INC     HL                  
3351   0E88 3E B0                              LD      A,$B0               
