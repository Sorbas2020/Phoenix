4942   2047 BE                                 CP      (HL)                ;
4943   2048 C0                                 RET     NZ                  ;
4944   2049 7E                                 LD      A,(HL)              ;
4945   204A 2C                                 INC     L                   ;
4946   204B 96                                 SUB     (HL)                ;
4947   204C 2D                                 DEC     L                   ;
4948   204D 77                                 LD      (HL),A              ;
4949   204E 2C                                 INC     L                   ;
4950   204F 2C                                 INC     L                   ;
