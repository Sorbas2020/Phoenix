5419   2292 21 B8 43                           LD      HL,LevelAndRound    ; 
5420   2295 7E                                 LD      A,(HL)              ;
5421   2296 E6 08                              AND     $08                 ; mask out 0000_1000
5422   2298 CA F0 22                           JP      Z,L22F0             ; 
5423   229B             ;*****************************************************************************
5424   229B             ;* Fill the entire background with stars (uses the whole `$1C00`–`$1CFF` page, including `$1CB4`–`$1CFF`).
5425   229B             ;* `L2292` copies the star page into background VRAM from `$4B3F` downward, reading `T1C00` with `INC L`
5426   229B             ;* (which wraps inside page `$1C`), until it has filled `$4800`–`$4B3F`.
