4927   2000             ;*****************************************************************************
4928   2000             ; h5-ic49.5a
4929   2000             ;*****************************************************************************
4930   2000             ;*****************************************************************************
4931   2000             ;* Game level 1, 3 and B:
4932   2000             ;* 'player alife' with aliens, after 'fade in'
4933   2000             ;*****************************************************************************
4934   2000             L2000:
4935   2000 CD 76 08                           CALL    PlayerUpdate        ; Updates the player ship, player bullet and the shield.
4936   2003 CD F0 0D                           CALL    L0DF0               ; Player bullet to alien, collission detection.
4937   2006 CD A0 24                           CALL    L24A0               ; Mother-ship hook
4938   2009 21 5F 43                           LD      HL,M435F            ; 8 bit counter for alien movement
4939   200C 7E                                 LD      A,(HL)              ; get value
4940   200D E6 03                              AND     $03                 ; mask out 0000_0011 for count 0 to 3
4941   200F 47                                 LD      B,A                 ; save the masked counter
4942   2010 34                                 INC     (HL)                ; increment alien movement counter
4943   2011 3A BA 43                           LD      A,(AliensLeft)      ; 
4944   2014 A7                                 AND     A                   ; updates the zero flag
4945   2015 CA BA 21                           JP      Z,L21BA             ; if no AliensLeft -> Mothership-wave dispatcher (and end-of-wave handling)
4946   2018 FE 05                              CP      $05                 ; 
4947   201A D2 30 21                           JP      NC,L2130            ; if >= 5 left
4948   201D 2D                                 DEC     L                   ; $435E
4949   201E 78                                 LD      A,B                 ; get masked counter
4950   201F A7                                 AND     A                   ; updates the zero flag
4951   2020 C2 25 20                           JP      NZ,L2025            ; if masked counter <> 0
4952   2023 36 FF                              LD      (HL),$FF            ; set $435E Flag for: 'AliensLeft < 5'
4953   2025             L2025:
4954   2025 7E                                 LD      A,(HL)              ; get $435E
4955   2026 A7                                 AND     A                   ; updates the zero flag
4956   2027 CA 30 21                           JP      Z,L2130             ; if $435E = 0
4957   202A C3 46 21                           JP      L2146               ; Game's per frame level dispatcher (even/odd phase)
4958   202D             
4959   2030                                    .ORG $2030
4960   2030             ;
4961   2030             L2030:
4962   2030 E6 03                              AND     $03                 ; 0000_0011
4963   2032 FE 01                              CP      $01                 ; 
4964   2034 11 50 1B                           LD      DE,$1B50            ; right-half belt-parts table
4965   2037 C3 AC 23                           JP      L23AC               ; 
4966   203A             
4967   2040                                    .ORG $2040
4968   2040             ;*****************************************************************************
4969   2040             ;* Add 1x1 small galaxies to background.
4970   2040             ;*****************************************************************************
4971   2040             AddGalaxiesToBackground:
4972   2040 21 AF 43                           LD      HL,M43AF            ; $43AF = next-galaxy trigger (CounterB9 value)
4973   2043 3A B9 43                           LD      A,(CounterB9)       ; 
4974   2046 4F                                 LD      C,A                 ; 
4975   2047 BE                                 CP      (HL)                ; 
4976   2048 C0                                 RET     NZ                  ; 
4977   2049 7E                                 LD      A,(HL)              ; 
4978   204A 2C                                 INC     L                   ; -> $43B0
4979   204B 96                                 SUB     (HL)                ; - $43B0
4980   204C 2D                                 DEC     L                   ; 
4981   204D 77                                 LD      (HL),A              ; $43AF -= $43B0  (schedule next galaxy)
4982   204E 2C                                 INC     L                   ; 
4983   204F 2C                                 INC     L                   ; -> $43B1
4984   2050 34                                 INC     (HL)                ; $43B1++
4985   2051 7E                                 LD      A,(HL)              ; A = $43B1  (galaxy position index)
4986   2052 21 80 1E                           LD      HL,T1E80            ; data for the 16 (1x1) small galaxies from setB
4987   2055 E6 1F                              AND     $1F                 ; 0001_1111
4988   2057 85                                 ADD     A,L                 ; 
4989   2058 6F                                 LD      L,A                 ; 
4990   2059 46                                 LD      B,(HL)              ; 
4991   205A C6 20                              ADD     $20                 ; 
4992   205C 6F                                 LD      L,A                 ; 
4993   205D 56                                 LD      D,(HL)              ; 
4994   205E C6 20                              ADD     $20                 ; 
4995   2060 6F                                 LD      L,A                 ; 
4996   2061 5E                                 LD      E,(HL)              ; 
4997   2062 79                                 LD      A,C                 ; 
4998   2063 0F                                 RRCA                        ; 
4999   2064 0F                                 RRCA                        ; 
5000   2065 0F                                 RRCA                        ; 
5001   2066 E6 1F                              AND     $1F                 ; 0001_1111
5002   2068 83                                 ADD     A,E                 ; 
5003   2069 3C                                 INC     A                   ; 
5004   206A 5F                                 LD      E,A                 ; 
5005   206B 78                                 LD      A,B                 ; 
5006   206C 12                                 LD      (DE),A              ; 
5007   206D C9                                 RET                         ; 
5008   206E             
5009   2070                                    .ORG $2070
5010   2070             ;*****************************************************************************
5011   2070             ;* `L2070`/`L2085` compute the entry offset from the ship position and current phase,
5012   2070             ;* so as `CounterA5` counts down the "lit" cells sweep through the field.
5013   2070             ;* The ship visibly bursts into scattering particles that then thin out and vanish.
5014   2070             ;*****************************************************************************
5015   2070             L2070:
5016   2070 7B                                 LD      A,E                 ; 
5017   2071 D6 0A                              SUB     $0A                 ; 
5018   2073 C6 C0                              ADD     $C0                 ; 
5019   2075 4F                                 LD      C,A                 ; 
5020   2076 7A                                 LD      A,D                 ; 
5021   2077 CE 00                              ADC     $00                 ; 
5022   2079 47                                 LD      B,A                 ; 
5023   207A 7E                                 LD      A,(HL)              ; 
5024   207B 11 00 28                           LD      DE,T2800            ; get the foreground tiles of the player ship particles explosion
5025   207E 21 00 29                           LD      HL,T2900            ; and get the control data for it
5026   2081 C3 85 20                           JP      L2085               ; 
5027   2084             
5028   2085                                    .ORG $2085
5029   2085             ;
5030   2085             L2085:
5031   2085 D6 20                              SUB     $20                 ; 
5032   2087 07                                 RLCA                        ; Multiply by 4 ..
5033   2088 07                                 RLCA                        ; ..
5034   2089 00                                 NOP                         ; 
5035   208A E6 E0                              AND     $E0                 ; 1110_0000
5036   208C 6F                                 LD      L,A                 ; 
5037   208D 3E E0                              LD      A,$E0               ; 
5038   208F 95                                 SUB     L                   ; 
5039   2090 6F                                 LD      L,A                 ; 
5040   2091             L2091:
5041   2091 3E 3F                              LD      A,$3F               ; 
5042   2093 91                                 SUB     C                   ; 
5043   2094 3E 43                              LD      A,$43               ; 
5044   2096 98                                 SBC     B                   ; 
5045   2097 D2 B0 20                           JP      NC,L20B0            ; 
5046   209A 23                                 INC     HL                  ; 
5047   209B 23                                 INC     HL                  ; 
5048   209C 7B                                 LD      A,E                 ; 
5049   209D C6 10                              ADD     $10                 ; 
5050   209F 5F                                 LD      E,A                 ; 
5051   20A0 79                                 LD      A,C                 ; 
5052   20A1 D6 20                              SUB     $20                 ; 
5053   20A3 4F                                 LD      C,A                 ; 
5054   20A4 78                                 LD      A,B                 ; 
5055   20A5 DE 00                              SBC     $00                 ; 
5056   20A7 47                                 LD      B,A                 ; 
5057   20A8 C3 91 20                           JP      L2091               ; 
5058   20AB             
5059   20B0                                    .ORG $20B0
5060   20B0             ;*****************************************************************************
5061   20B0             ;* Player ship particles explosion.
5062   20B0             ;*****************************************************************************
5063   20B0             L20B0:
5064   20B0 C5                                 PUSH    BC                  ; 
5065   20B1             L20B1:
5066   20B1 7E                                 LD      A,(HL)              ; T2900 control byte (8 flags)
5067   20B2 E3                                 EX      (SP),HL             ; HL = screen pointer
5068   20B3 06 08                              LD      B,$08               ; 
5069   20B5             L20B5:
5070   20B5 36 00                              LD      (HL),$00            ; erase this cell
5071   20B7 0F                                 RRCA                        ; next control bit -> carry
5072   20B8 D2 BF 20                           JP      NC,L20BF            ; bit clear -> leave erased
5073   20BB EB                                 EX      DE,HL               ; 
5074   20BC 4E                                 LD      C,(HL)              ; C = tile from T2800
5075   20BD EB                                 EX      DE,HL               ; get data from $2800
5076   20BE 71                                 LD      (HL),C              ; draw the particle
5077   20BF             L20BF:
5078   20BF 23                                 INC     HL                  ; next screen cell
5079   20C0 13                                 INC     DE                  ; next T2800 entry
5080   20C1 05                                 DEC     B                   ; 
5081   20C2 C2 B5 20                           JP      NZ,L20B5            ; 8 cells per byte
5082   20C5 E3                                 EX      (SP),HL             ; 
5083   20C6 23                                 INC     HL                  ; 
5084   20C7 7D                                 LD      A,L                 ; 
5085   20C8 0F                                 RRCA                        ; 
5086   20C9 DA B1 20                           JP      C,L20B1             ; 
5087   20CC 7D                                 LD      A,L                 ; 
5088   20CD E6 1F                              AND     $1F                 ; 0001_1111
5089   20CF CA E1 20                           JP      Z,L20E1             ; 
5090   20D2 E3                                 EX      (SP),HL             ; 
5091   20D3 7D                                 LD      A,L                 ; 
5092   20D4 D6 30                              SUB     $30                 ; 
5093   20D6 6F                                 LD      L,A                 ; 
5094   20D7 7C                                 LD      A,H                 ; 
5095   20D8 DE 00                              SBC     $00                 ; 
5096   20DA 67                                 LD      H,A                 ; 
5097   20DB E3                                 EX      (SP),HL             ; 
5098   20DC FE 3F                              CP      $3F                 ; 
5099   20DE C2 B1 20                           JP      NZ,L20B1            ; 
5100   20E1             L20E1:
5101   20E1 C1                                 POP     BC                  ; 
5102   20E2 C9                                 RET                         ; 
5103   20E3             
5104   20E8                                    .ORG $20E8
5105   20E8             ;*****************************************************************************
5106   20E8             ;* Draw one 4x4 ship-fragment sprite during the player-ship explosion.
5107   20E8             ;* Entry (from L0BC4): A = CounterA5 phase, DE = ship screen address.
5108   20E8             ;* Fragment image pointer comes from T1B90; position is scattered using
5109   20E8             ;* CounterB9 (via L211C) and the phase.
5110   20E8             ;* Purpose:
5111   20E8             ;* `L20E8` draws the flying debris sprites of the exploding player ship
5112   20E8             ;* (fragment image chosen from `T1B90`, scattered by `CounterB9`/phase,
5113   20E8             ;* `L211C` freezing the scroll).
5114   20E8             ;*****************************************************************************
5115   20E8             L20E8:
5116   20E8 47                                 LD      B,A                 ; B = phase (CounterA5)
5117   20E9 7A                                 LD      A,D                 ; 
5118   20EA C6 08                              ADD     $08                 ; nudge the row
5119   20EC 57                                 LD      D,A                 ; 
5120   20ED CD 1C 21                           CALL    L211C               ; {code.L211C} clamp scroll during explosion
5121   20F0 0F                                 RRCA                        ; 
5122   20F1 0F                                 RRCA                        ; scatter offset from CounterB9
5123   20F2 0F                                 RRCA                        ; 
5124   20F3 83                                 ADD     A,E                 ; 
5125   20F4 E6 1F                              AND     $1F                 ; 0001_1111 keep within a column
5126   20F6 4F                                 LD      C,A                 ; 
5127   20F7 7B                                 LD      A,E                 ; 
5128   20F8 E6 E0                              AND     $E0                 ; 1110_0000 column bits
5129   20FA B1                                 OR      C                   ; 
5130   20FB 5F                                 LD      E,A                 ; E = scattered LSB
5131   20FC 78                                 LD      A,B                 ; phase
5132   20FD 0F                                 RRCA                        ; 
5133   20FE 0F                                 RRCA                        ; 
5134   20FF E6 0E                              AND     $0E                 ; 0000_1110 -> even index 0..14
5135   2101 C6 90                              ADD     $90                 ; -> T1B90 entry
5136   2103 6F                                 LD      L,A                 ; 
5137   2104 26 1B                              LD      H,$1B               ; HL = T1B90 + index
5138   2106 7E                                 LD      A,(HL)              ; fragment image MSB
5139   2107 2C                                 INC     L                   ; 
5140   2108 6E                                 LD      L,(HL)              ; fragment image LSB
5141   2109 67                                 LD      H,A                 ; HL = fragment image
5142   210A 01 04 04                           LD      BC,$0404            ; images are 4x4images are 4x4
5143   210D C3 D6 0A                           JP      DrawImageCbyB       ; draw it
5144   2110             
5145   211C                                    .ORG $211C
5146   211C             ;*****************************************************************************
5147   211C             ;* Clamp the scroll register to $10 while CounterB9 is in ($10,$30).
5148   211C             ;*****************************************************************************
5149   211C             L211C:
5150   211C 21 B9 43                           LD      HL,CounterB9        ; 
5151   211F 7E                                 LD      A,(HL)              ; 
5152   2120 FE 10                              CP      $10                 ; 
5153   2122 D8                                 RET     C                   ; < $10: leave alone
5154   2123 FE 30                              CP      $30                 ; 
5155   2125 D0                                 RET     NC                  ; >= $30: leave alone
5156   2126 3E 10                              LD      A,$10               ; 
5157   2128 77                                 LD      (HL),A              ; pin CounterB9 = $10
5158   2129 32 00 58                           LD      (scrollRegister),A  ; 58xx scroll register
5159   212C C9                                 RET                         ; 
5160   212D             
5161   2130                                    .ORG $2130
5162   2130             ;*****************************************************************************
5163   2130             ;* Per-frame update dispatchers for the alien-wave levels.
5164   2130             ;* B = frame phase (rotating counter). Each phase runs a different subset of
5165   2130             ;* the heavy per-frame work, spreading it across frames.
5166   2130             ;* `L2130`/`L2146`/`L21BA` are the game's per frame level dispatchers:
5167   2130             ;* A rotating frame phase counter (`B`) selects one of several groups of update calls
5168   2130             ;* (`AlienDataController`, `AlienBehaviorUpdate`, `AlienMovementUpdate`,
5169   2130             ;* `AlienAnimationUpdate`, `EnemyBulletUpdate`, collision `L0F00`, killed alien anim `L0FC0`,
5170   2130             ;* bomb drop `L2560`, mothership housekeeping `L24C4`),
5171   2130             ;* so the heavy work is spread over multiple frames.
5172   2130             ;*****************************************************************************
5173   2130             L2130:
5174   2130 78                                 LD      A,B                 ; frame phase
5175   2131 A7                                 AND     A                   ; updates the zero flag
5176   2132 CA 50 21                           JP      Z,L2150             ; phase 0
5177   2135 FE 01                              CP      $01                 ;
5178   2137 CA 60 21                           JP      Z,L2160             ; phase 1
5179   213A FE 02                              CP      $02                 ;
5180   213C CA 70 21                           JP      Z,L2170             ; phase 2
5181   213F C3 80 21                           JP      L2180               ; phase 3
5182   2142             
5183   2146                                    .ORG $2146
5184   2146             ;*****************************************************************************
5185   2146             ;* Game's per frame level dispatcher (even/odd phase)
5186   2146             ;*****************************************************************************
5187   2146             L2146:
5188   2146 78                                 LD      A,B                 ; 
5189   2147 0F                                 RRCA                        ; test phase bit 0
5190   2148 D2 90 21                           JP      NC,L2190            ; even phase
5191   214B C3 A5 21                           JP      L21A5               ; odd phase
5192   214E             
5193   2150                                    .ORG $2150
5194   2150             ;*****************************************************************************
5195   2150             ;* Phase 0
5196   2150             ;*****************************************************************************
5197   2150             L2150:
5198   2150 CD 50 0A                           CALL    AlienDataController ; draw or delete alien
5199   2153 CD 00 30                           CALL    L3000               ; AlienBehaviorUpdate
5200   2156 C3 00 0F                           JP      L0F00               ; 'alien with player' collision check
5201   2159             
5202   2160                                    .ORG $2160
5203   2160             ;*****************************************************************************
5204   2160             ;* Phase 1
5205   2160             ;*****************************************************************************
5206   2160             L2160:
5207   2160 CD C4 24                           CALL    L24C4               ; background / mothership housekeeping
5208   2163 CD 40 0C                           CALL    L0C40               ; EnemyBulletUpdate
5209   2166 CD 1C 0D                           CALL    L0D1C               ; AlienMovementUpdate
5210   2169 C3 C0 0F                           JP      L0FC0               ; Handle animations for killed aliens
5211   216C             
5212   2170                                    .ORG $2170
5213   2170             ;*****************************************************************************
5214   2170             ;* Phase 2
5215   2170             ;*****************************************************************************
5216   2170             L2170:
5217   2170 CD 70 0D                           CALL    L0D70               ; AlienAnimationUpdate
5218   2173 C3 60 25                           JP      L2560               ; try to drop a bomb on the player
5219   2176             
5220   2180                                    .ORG $2180
5221   2180             ;*****************************************************************************
5222   2180             ;* Phase 3
5223   2180             ;*****************************************************************************
5224   2180             L2180:
5225   2180 CD C4 24                           CALL    L24C4               ; background / mothership housekeeping
5226   2183 CD 40 0C                           CALL    L0C40               ; EnemyBulletUpdate
5227   2186 CD 6C 0A                           CALL    L0A6C               ; get screen ram adress for all aliens
5228   2189 C3 C0 0F                           JP      L0FC0               ; Handle animations for killed aliens
5229   218C             
5230   2190                                    .ORG $2190
5231   2190             ;
5232   2190             L2190:
5233   2190 CD 50 0A                           CALL    AlienDataController ; draw or delete alien
5234   2193 CD 00 30                           CALL    L3000               ; AlienBehaviorUpdate
5235   2196 CD 00 0F                           CALL    L0F00               ; 'alien with player' collision check
5236   2199 CD 60 25                           CALL    L2560               ; try to drop a bomb
5237   219C C3 40 0C                           JP      L0C40               ; EnemyBulletUpdate
5238   219F             
5239   21A5                                    .ORG $21A5
5240   21A5             ;
5241   21A5             L21A5:
5242   21A5 CD 1C 0D                           CALL    L0D1C               ; AlienMovementUpdate
5243   21A8 CD 70 0D                           CALL    L0D70               ; AlienAnimationUpdate
5244   21AB CD 6C 0A                           CALL    L0A6C               ; get screen ram adress for all aliens
5245   21AE CD C0 0F                           CALL    L0FC0               ; Handle animations for killed aliens
5246   21B1 C3 C4 24                           JP      L24C4               ; background / mothership housekeeping
5247   21B4             
5248   21BA                                    .ORG $21BA
5249   21BA             ;*****************************************************************************
5250   21BA             ;* Mothership-wave dispatcher (and end-of-wave handling).
5251   21BA             ;*****************************************************************************
5252   21BA             L21BA:
5253   21BA 78                                 LD      A,B                 ; 
5254   21BB 0F                                 RRCA                        ; test phase bit 0
5255   21BC D2 04 22                           JP      NC,L2204            ; even phase: end-of-wave countdown (L2204)
5256   21BF CD 40 0C                           CALL    L0C40               ; EnemyBulletUpdate
5257   21C2 CD C0 0F                           CALL    L0FC0               ; Handle animations for killed aliens
5258   21C5 CD C4 24                           CALL    L24C4               ; mothership housekeeping
5259   21C8 3A B8 43                           LD      A,(LevelAndRound)   ; 
5260   21CB E6 0F                              AND     $0F                 ; mask out 0000_1111
5261   21CD FE 0B                              CP      $0B                 ; 
5262   21CF DA 04 22                           JP      C,L2204             ; if < level $B: fall through to wave end
5263   21D2 3E 10                              LD      A,$10               ; else 16 aliens ...
5264   21D4 32 BA 43                           LD      (AliensLeft),A      ; ... for a new wave
5265   21D7 C3 26 05                           JP      L0526               ; init alien data
5266   21DA             
5267   21DC                                    .ORG $21DC
5268   21DC             ;*****************************************************************************
5269   21DC             ;* Handles the bird animation at intro.
5270   21DC             ;* The driver is a single counter, `M4399` 
5271   21DC             ;* (the "slow-print" timer that advances during the intro splash).
5272   21DC             ;* Its bits are split into two roles:
5273   21DC             ;* - `M4399 & 7` -> the bird's animation sub-phase 
5274   21DC             ;*   (written to bird-object byte +3, `$4B73`).
5275   21DC             ;*   This cycles the wing position 0–7 within the current shape.
5276   21DC             ;* - `M4399 >> 3` -> the index into `T233A`, which yields the shape index 
5277   21DC             ;*   (written to bird-object byte +0, `$4B70`).
5278   21DC             ;* In other words, each entry in `T233A` is held for 8 timer ticks
5279   21DC             ;* (one full pass of the low-3-bit phase) before the script advances to the next shape.
5280   21DC             ;* `T233A` is therefore "the shape every 8 frames", and the low bits provide the in-between wing flapping.
5281   21DC             ;*****************************************************************************
5282   21DC             DrawIntroBirdAnimationFrame:
5283   21DC 7E                                 LD      A,(HL)              ; Actual index for slow print at intro splash (starts with $300)
5284   21DD 00                                 NOP                         ; 
5285   21DE 47                                 LD      B,A                 ; keep a copy
5286   21DF 21 73 4B                           LD      HL,B4B73            ; used as temp memory for animation phase
5287   21E2 E6 07                              AND     $07                 ; mask out 0000_0111 in order to count from 0 to 7
5288   21E4 77                                 LD      (HL),A              ; animation sub-phase
5289   21E5 2D                                 DEC     L                   ; 
5290   21E6 36 EF                              LD      (HL),$EF            ; use $4B72 for LSB of screen ram
5291   21E8 2D                                 DEC     L                   ; 
5292   21E9 36 49                              LD      (HL),$49            ; use $4B71 for MSB of screen ram
5293   21EB 2D                                 DEC     L                   ; $4B70 (bird0 index character block shape)
5294   21EC 78                                 LD      A,B                 ; restore $4399 timer
5295   21ED E6 F8                              AND     $F8                 ; drop low 3 bits ...
5296   21EF 0F                                 RRCA                        ; ... and >> 3
5297   21F0 0F                                 RRCA                        ; 
5298   21F1 0F                                 RRCA                        ; A = M4399 >> 3   (the T233A index)
5299   21F2 C6 3A                              ADD     T233A & $FF         ; + LSB of T233A
5300   21F4 5F                                 LD      E,A                 ; 
5301   21F5 16 23                              LD      D,T233A >> 8        ; DE = T233A + (M4399 >> 3)
5302   21F7 1A                                 LD      A,(DE)              ; A = shape index from the script
5303   21F8 77                                 LD      (HL),A              ; -> $4B70 (bird object shape index)
5304   21F9 CD C0 34                           CALL    DrawBirdObject      ; draw the bird at intro
5305   21FC C3 E0 1E                           JP      L1EE0               ; Copyright-notice integrity check
5306   21FF             
5307   2204                                    .ORG $2204
5308   2204             ;
5309   2204             L2204:
5310   2204 21 B6 43                           LD      HL,M43B6            ; End-of-wave countdown timer
5311   2207 35                                 DEC     (HL)                ; 
5312   2208 7E                                 LD      A,(HL)              ; 
5313   2209 FE A0                              CP      $A0                 ; (~96 frames later)
5314   220B D0                                 RET     NC                  ; keep waiting
5315   220C 2E A4                              LD      L,$A4               ; GameState
5316   220E 36 02                              LD      (HL),$02            ; set GameState to: 'initialization of game and level data'
5317   2210 2E A6                              LD      L,$A6               ; ShieldCount
5318   2212 36 00                              LD      (HL),$00            ; clear ShieldCount
5319   2214 2E B8                              LD      L,$B8               ; LevelAndRound
5320   2216 34                                 INC     (HL)                ; increment LevelAndRound
5321   2217 7E                                 LD      A,(HL)              ; 
5322   2218 E6 0E                              AND     $0E                 ; mask out 0000_1110
5323   221A 0F                                 RRCA                        ; divide by 2
5324   221B C6 60                              ADD     T1760 & $FF         ; add to base of table T1760
5325   221D 5F                                 LD      E,A                 ; 
5326   221E 16 17                              LD      D,T1760 >> 8        ; 
5327   2220 2C                                 INC     L                   ; 
5328   2221 2C                                 INC     L                   ; AliensLeft
