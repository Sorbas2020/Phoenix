0477   0000             B4BC2                  .EQU $4BC2       ;saved PlayerBulletX
0478   0000             B4BC3                  .EQU $4BC3       ;saved PlayerBulletY
0479   0000             B4BC4                  .EQU $4BC4       ;saved AbovePlayerBulletMSB
0480   0000             B4BC5                  .EQU $4BC5       ;saved AbovePlayerBulletLSB
0481   0000             
0482   0000             B4BD1                  .EQU $4BD1       ;Descent turnaround depth threshold (formation reverses when `$4BD2` passes it)
0483   0000             B4BD2                  .EQU $4BD2       ;Vertical scroll phase 0–31 of the bird formation (derived from `CounterB9`; master index) (0..31)
0484   0000             B4BD3                  .EQU $4BD3       ;Countdown timer between bird attack launches
0485   0000             B4BD4                  .EQU $4BD4       ;Attack sub-pattern selector (0–3, from random `$436F`) for one of four attack variants
0486   0000             B4BD5                  .EQU $4BD5       ;Descent step/speed value (feeds the `$3ED0` dither scroll rate)
0487   0000             B4BD6                  .EQU $4BD6       ;Combined scroll-phase + active-bird center index (indexes `$3EE0` curve & `T3DE0` sound)
0488   0000             B4BD7                  .EQU $4BD7       ;Active-bird vertical spread — computed but not consumed (vestigial)
0489   0000             
0490   0000             B4BED                  .EQU $4BED       ;Unused RAM (cleared at level init, never referenced)
0491   0000             B4BEE                  .EQU $4BEE       ;Unused RAM (cleared at level init, never referenced)
0492   0000             B4BEF                  .EQU $4BEF       ;Unused RAM (cleared at level init, never referenced)
0493   0000             
0494   0000             ; Stack
0495   0000             Stack                  .EQU $4BF0       ;Stack space 4BF0:4BFF
0496   0000             
0497   0000             ;HW
0498   0000             videoRegister          .EQU $5000       ;Lower bit selects the RAM bank
0499   0000             scrollRegister         .EQU $5800       ;Screen scrolling
0500   0000             SOUNDCTLA              .EQU $6000       ;Sound control A
0501   0000             SOUNDCTLB              .EQU $6800       ;Sound control B
0502   0000             IN0                    .EQU $7000       ;Player inputs
0503   0000             DSW0                   .EQU $7800       ;DIP switch settings
0504   0000             
0505   0000             ;*****************************************************************************
0506   0000             ; ic45
0507   0000             ;*****************************************************************************
0508   0000                                    .ORG $0000
0509   0000             L0000:
0510   0000 00                                 NOP                         ; Start/restart and interrupts end up at 0008
0511   0001 00                                 NOP                         ;
0512   0002 00                                 NOP                         ;
0513   0003 00                                 NOP                         ;
0514   0004 00                                 NOP                         ;
0515   0005 00                                 NOP                         ;
0516   0006 00                                 NOP                         ;
0517   0007 00                                 NOP                         ;
0518   0008             ; 
0519   0008 31 FF 4B                           LD      SP,$4BFF            ; Top-ish of RAM
0520   000B 26 50                              LD      H,videoRegister >> 8
0521   000D 36 00                              LD      (HL),$00            ; Select the first bank of RAM
0522   000F CD 50 00                           CALL    InitSoundScreen     ; Turn sound off and clear both screen areas
0523   0012 21 00 18                           LD      HL,T1800            ; Screen draw info
0524   0015 0E 03                              LD      C,$03               ; 3 columns (rotated to 3 rows)
0525   0017 CD D0 01                           CALL    PrintTextLines      ; Draw the first 3 rows of the background (scores and coins)
0526   001A             
0527   001A             ;*****************************************************************************
0528   001A             ;* Main loop begin
0529   001A             ;*****************************************************************************
0530   001A             MainLoop:
0531   001A CD 80 00                           CALL    WaitVBlankCoin      ; Wait for VBlank and count any coins
0532   001D 3A A2 43                           LD      A,(GameOrAttract)   ;
0533   0020 A7                                 AND     A                   ; updates the zero flag
0534   0021 CA 2D 00                           JP      Z,L002D             ; if 'Attract mode'
0535   0024             ; Game mode
0536   0024 CD 00 04                           CALL    GameStateMachine    ; controls the flow of the game.
0537   0027 CD 00 27                           CALL    UpdateScoresAndSound
0538   002A C3 1A 00                           JP      MainLoop            ; Back to top of main loop
0539   002D             ; Attract mode (no sound, no scoreing, no manual steering)
0540   002D             L002D:
0541   002D 3E 0F                              LD      A,$0F               ; 0000_1111 mute the sound chip TMS36XX
0542   002F 26 60                              LD      H,SOUNDCTLA >> 8    ; 60xx sound A
0543   0031 77                                 LD      (HL),A              ;
0544   0032 26 68                              LD      H,SOUNDCTLB >> 8    ; 68xx sound B
0545   0034 77                                 LD      (HL),A              ;
0546   0035 CD 77 03                           CALL    UpdateSoundControlRAM
0547   0038 00                                 NOP                         ;
0548   0039 CD E0 17                           CALL    CoinChecking        ; Converts raw `CoinCount` into playable credits, applying the coinage DIP on `DSW0`
0549   003C A7                                 AND     A                   ; updates the zero flag
0550   003D CA 46 00                           JP      Z,L0046             ; No credits ... continue splash
0551   0040 CD 88 02                           CALL    PromptForStartGame  ;
0552   0043 C3 1A 00                           JP      MainLoop            ; Back to top of main loop
0553   0046             ; Continue splash 
0554   0046             L0046:
0555   0046 CD E3 00                           CALL    SplashAndDemo       ;
0556   0049 C3 1A 00                           JP      MainLoop            ; Back to top of main loop
0557   004C             ;*****************************************************************************
0558   004C             ;* Main loop end
0559   004C             ;*****************************************************************************
0560   004C             
0561   0050                                    .ORG $0050
0562   0050             ;*****************************************************************************
0563   0050             ;* Initialize the sound (off) and screen (clear)
0564   0050             ;*****************************************************************************
0565   0050             InitSoundScreen:
0566   0050 26 68                              LD      H,SOUNDCTLB >> 8    ; 68xx sound B
0567   0052 36 00                              LD      (HL),$00            ; Sound off
0568   0054 26 60                              LD      H,SOUNDCTLA >> 8    ; 60xx sound A
0569   0056 36 00                              LD      (HL),$00            ; Sound off
0570   0058 26 58                              LD      H,scrollRegister >> 8
0571   005A 36 00                              LD      (HL),$00            ; First memory bank
0572   005C CD 6B 00                           CALL    ClearRAMBank        ; Clear the bank (includes screen)
0573   005F 26 50                              LD      H,videoRegister >> 8
0574   0061 36 01                              LD      (HL),$01            ; Second memory bank
0575   0063 CD 6B 00                           CALL    ClearRAMBank        ; Clear the bank (includes screen)
0576   0066 26 50                              LD      H,videoRegister >> 8
0577   0068 36 00                              LD      (HL),$00            ; Back to first memory bank
0578   006A C9                                 RET                         ; Done
0579   006B             
0580   006B             ;*****************************************************************************
0581   006B             ;* Clear a RAM Bank (bank 0 or 1)
0582   006B             ;* Set the lower bit of the video register to pick the bank before calling.
0583   006B             ;* 4000 - 4BF8
0584   006B             ;* We call this function, which means we don't want to clear the return on the stack.
0585   006B             ;* That's why we start clearing at 4BF8 instead of 4BFF.
0586   006B             ;* Since screen memory is part of this bank, we are clearing the screen too.
0587   006B             ;*****************************************************************************
0588   006B             ClearRAMBank:
0589   006B 21 F8 4B                           LD      HL,$4BF8            ; Highest point ... skip the top of the stack
0590   006E 3E 3F                              LD      A,$3F               ; Stop when H reaches 3F
0591   0070             L0070:
0592   0070 36 00                              LD      (HL),$00            ; Clear the memory
0593   0072 2B                                 DEC     HL                  ; Point to next
0594   0073 BC                                 CP      H                   ; All done?
0595   0074 C2 70 00                           JP      NZ,L0070            ; No ... go back for all
0596   0077 C9                                 RET                         ; Done
0597   0078             
0598   0078             ;*****************************************************************************
0599   0078             ;* Slow printing the static texts and filling the scroll register
0600   0078             ;* with background tiles.
0601   0078             ;* Only used at attract mode during the intro splash.
0602   0078             ;*****************************************************************************
0603   0078             SlowPrintScrollRegisterUpdate:
0604   0078 CD 96 01                           CALL    SlowPrintScoreAverageTable
0605   007B C3 F0 06                           JP      L06F0               ; update scroll register and fill background
0606   007E             
0607   0080                                    .ORG $0080
0608   0080             ;*****************************************************************************
0609   0080             ;* Wait for the vertical blanking and then handle coin counting
0610   0080             ;*****************************************************************************
0611   0080             WaitVBlankCoin:
0612   0080 26 78                              LD      H,DSW0 >> 8         ; 78xx DSW0 Check ...
0613   0082 7E                                 LD      A,(HL)              ; ... screen blanking flag
0614   0083 E6 80                              AND     $80                 ; Wait for it ...
0615   0085 CA 80 00                           JP      Z,WaitVBlankCoin    ; ... to set
0616   0088             ; 
0617   0088             L0088:
0618   0088 7E                                 LD      A,(HL)              ; Check screen blanking flag
0619   0089 E6 80                              AND     $80                 ; Wait for it ...
0620   008B C2 88 00                           JP      NZ,L0088            ; ... to clear (0=in blanking)
0621   008E 26 70                              LD      H,IN0 >> 8          ; 70xx IN0 Current value ...
0622   0090 7E                                 LD      A,(HL)              ; ... of IN0 inputs
0623   0091 21 A0 43                           LD      HL,IN0Current       ; Value from ...
0624   0094 46                                 LD      B,(HL)              ; ... last read
0625   0095 77                                 LD      (HL),A              ; Store new value
0626   0096 2C                                 INC     L                   ; To 43A1
0627   0097 70                                 LD      (HL),B              ; Store old value
0628   0098 2E 9B                              LD      L,$9B               ; Bump the ...
0629   009A CD 00 02                           CALL    AddOneToMem         ; ... ?? counter
0630   009D 2E 8F                              LD      L,$8F               ; Get number ...
0631   009F 7E                                 LD      A,(HL)              ; ... of coins
0632   00A0             ;
0633   00A0             ; !! There are two digits for "coins" on the screen, but only the one's digit is
0634   00A0             ; !! changed. Once you get to 9, the code stops counting. It takes the coin
0635   00A0             ; !! from you, but it doesn't give you credit.
0636   00A0             ;
0637   00A0 FE 09                              CP      $09                 ; Already 9?
0638   00A2 C8                                 RET     Z                   ; Yes ... nothing more to check
0639   00A3 D2 00 00                           JP      NC,L0000            ; More than 9? OOPS -- soft reset
0640   00A6 06 01                              LD      B,$01               ; Coin bit of the input register
0641   00A8 CD BB 00                           CALL    CheckInputBits      ; Has the coin input gone from 1 to 0?
0642   00AB C8                                 RET     Z                   ; No ... no coins inserted ... done
0643   00AC 2E 8F                              LD      L,$8F               ; Add one ...
0644   00AE 34                                 INC     (HL)                ; ... to coin count
0645   00AF 7E                                 LD      A,(HL)              ; Current value ...
0646   00B0 C6 20                              ADD     $20                 ; ... to number tile
0647   00B2 32 42 41                           LD      ($4142),A           ; Change number of coins on screen
0648   00B5 C9                                 RET                         ; Done
0649   00B6             
0650   00BB                                    .ORG $00BB
0651   00BB             ;*****************************************************************************
0652   00BB             ;* Check to see if a particular bit(s) in the input register has changed
0653   00BB             ;* from 1 to 0 since last we checked. Return NZ if transitioned from 1 to 0.
0654   00BB             ;*****************************************************************************
0655   00BB             CheckInputBits:
0656   00BB 21 A0 43                           LD      HL,IN0Current       ; Get current ...
0657   00BE 7E                                 LD      A,(HL)              ; ... input value
0658   00BF 2F                                 CPL                         ; Flip the current bits
0659   00C0 A0                                 AND     B                   ; Mask off all but the ones we are checking
0660   00C1 2C                                 INC     L                   ; Point to last input value
0661   00C2 A6                                 AND     (HL)                ; Zero unles new bit is 0 and old is 1
0662   00C3 C9                                 RET                         ; Return state
0663   00C4             
0664   00C4             ;*****************************************************************************
0665   00C4             ;* Prints the number pointed to by HL (points to the end of the number) to the screen pointed
0666   00C4             ;* to by DE (points to the end of the screen area). B is the number of digits to print.
0667   00C4             ;*****************************************************************************
0668   00C4             PrintNumber:
0669   00C4 7E                                 LD      A,(HL)              ; Get the two digits
0670   00C5 E6 0F                              AND     $0F                 ; Keep the LSB
0671   00C7 F6 20                              OR      $20                 ; Offset to number tile
0672   00C9 12                                 LD      (DE),A              ; Store the number tile to screen memory
0673   00CA CD 10 02                           CALL    LeftOneColumn       ; next screen position
0674   00CD 05                                 DEC     B                   ; All done?
0675   00CE C8                                 RET     Z                   ; Yes ... out
0676   00CF 7E                                 LD      A,(HL)              ; Keep the ...
0677   00D0 0F                                 RRCA                        ; ...
0678   00D1 0F                                 RRCA                        ; ...
0679   00D2 0F                                 RRCA                        ; ...
0680   00D3 0F                                 RRCA                        ; ...
0681   00D4 E6 0F                              AND     $0F                 ; ... LSB
0682   00D6 F6 20                              OR      $20                 ; Offset to number tile
0683   00D8 12                                 LD      (DE),A              ; Store the number tile to screen memory
0684   00D9 CD 10 02                           CALL    LeftOneColumn       ; next screen position
0685   00DC 2B                                 DEC     HL                  ; Next data position
0686   00DD 05                                 DEC     B                   ; All digits done?
0687   00DE C2 C4 00                           JP      NZ,PrintNumber      ; No ... keep going
0688   00E1 C9                                 RET                         ; Yes ... out
0689   00E2             
0690   00E3                                    .ORG $00E3
0691   00E3             ;*****************************************************************************
0692   00E3             ;* Handles the intro splash and the game demo.
0693   00E3             ;*****************************************************************************
0694   00E3             SplashAndDemo:
0695   00E3 21 99 43                           LD      HL,M4399            ; starts with 0
0696   00E6 CD 00 02                           CALL    AddOneToMem         ; increases it by one
0697   00E9 01 01 00                           LD      BC,$0001            ;
0698   00EC CD 58 02                           CALL    CompareBCtoMem      ;
0699   00EF CA E1 01                           JP      Z,PrintCopyright    ; do if Counter98 is >= 00 01
0700   00F2 01 02 00                           LD      BC,$0002            ;
0701   00F5 11 1F 01                           LD      DE,$011F            ; used as delay counter
0702   00F8 CD 60 02                           CALL    SubtractIfEnough    ;
0703   00FB D2 96 01                           JP      NC,SlowPrintScoreAverageTable    ; do if Counter98 is >= 00 02
0704   00FE 01 20 01                           LD      BC,$0120            ; for a longer break
0705   0101 CD 58 02                           CALL    CompareBCtoMem      ;
0706   0104 CA CA 0B                           JP      Z,DrawScoreAverageTableTiles     ; do if Counter98 is >= 01 20
0707   0107 0E B0                              LD      C,$B0               ; for a short break
0708   0109 CD 58 02                           CALL    CompareBCtoMem      ;
0709   010C CA E1 01                           JP      Z,PrintCopyright    ; do if Counter98 is >= 01 B0
0710   010F 0E B8                              LD      C,$B8               ;
0711   0111 CD 58 02                           CALL    CompareBCtoMem      ;
0712   0114 CA 80 05                           JP      Z,InitBackgroundData            ; do if Counter98 is >= 01 B8
0713   0117 0E C0                              LD      C,$C0               ; for a short break
0714   0119 11 DF 02                           LD      DE,$02DF            ;
0715   011C CD 60 02                           CALL    SubtractIfEnough    ;
0716   011F D2 78 00                           JP      NC,SlowPrintScrollRegisterUpdate ; do if Counter98 is >= 01 C0
0717   0122 01 00 03                           LD      BC,$0300            ;
0718   0125 11 AF 03                           LD      DE,$03AF            ;
0719   0128 CD 60 02                           CALL    SubtractIfEnough    ;
0720   012B D2 DC 21                           JP      NC,DrawIntroBirdAnimationFrame   ; do if Counter98 is >= 03 00
0721   012E 01 E6 03                           LD      BC,$03E6            ;
0722   0131 11 FF FF                           LD      DE,$FFFF            ;
0723   0134 CD 60 02                           CALL    SubtractIfEnough    ;
0724   0137 D2 B0 03                           JP      NC,GameDemo         ; do if Counter98 is >= 03 E6
0725   013A C9                                 RET                         ;
0726   013B             
0727   0140                                    .ORG $0140
0728   0140             ;*****************************************************************************
0729   0140             ;* Clears foreground and background but leaves the 3 score rows.
0730   0140             ;*****************************************************************************
0731   0140             ClearForeAndBackground:
0732   0140 CD A0 03                           CALL    ClearBackground     ; Clear the background
0733   0143 CD 80 00                           CALL    WaitVBlankCoin      ; Wait for VBlank
0734   0146 CD 80 03                           CALL    ClearForeground     ; Clear the foreground (leave the 3 score rows)
0735   0149 21 A3 43                           LD      HL,GameAndDemoOrSplash
0736   014C 36 02                              LD      (HL),$02            ; set to: 'Intro splash'
0737   014E 2C                                 INC     L                   ; GameState
0738   014F 36 00                              LD      (HL),$00            ; to 0
0739   0151 00                                 NOP                         ; Old command removed or space for a future replace patch
0740   0152 00                                 NOP                         ; ..
0741   0153 00                                 NOP                         ; ..
0742   0154 2E B8                              LD      L,$B8               ; LevelAndRound, $43B9, AliensLeft, BirdsLeft, $43BC, $43BD, BonusLivesAt, $43BF to 0
0743   0156 06 08                              LD      B,$08               ; number of bytes to clear
0744   0158 CD D8 05                           CALL    ClearBbytesAtHL     ;
0745   015B 2E BA                              LD      L,$BA               ; Set AliensLeft
0746   015D 36 10                              LD      (HL),$10            ; to 16 aliens left in wave
0747   015F 2E BE                              LD      L,$BE               ;
0748   0161 3A 00 78                           LD      A,(DSW0)            ; 78xx DSW0, get DIP switch settings
0749   0164 E6 0C                              AND     $0C                 ; mask out 0000_1100 the Bonus lives
0750   0166 07                                 RLCA                        ; rotate left ..
0751   0167 07                                 RLCA                        ; .. to 0011_0000
0752   0168 C6 30                              ADD     $30                 ; -> $30,$40,$50,$60
0753   016A 77                                 LD      (HL),A              ; save to BonusLivesAt = 3000/4000/5000/6000 pts (BCD)
0754   016B 26 58                              LD      H,scrollRegister >> 8
0755   016D 36 00                              LD      (HL),$00            ; init screen scrolling
0756   016F CD 80 00                           CALL    WaitVBlankCoin      ;
0757   0172 C9                                 RET                         ;
0758   0173             
0759   0173             ;*****************************************************************************
0760   0173             ;* Used for the game demo during attract mode.
0761   0173             ;* Returning the bits for feeding the IN0Current for the simulated player inputs.
0762   0173             ;* Resulting values are depending on $4398:$4399 .
0763   0173             ;* Counter value goes from $03E6 to $1510 during the demo.
0764   0173             ;* 1010_1110...move left
0765   0173             ;* 1100_1110...move right
0766   0173             ;* 1111_1110...push fire
0767   0173             ;* 0111_1110...push shield
0768   0173             ;*****************************************************************************
0769   0173             GetPlayerInputsForDemo:
0770   0173 7E                                 LD      A,(HL)              ; get $4399 (LSB from 16 bit counter)
0771   0174 E6 7F                              AND     $7F                 ; mask out 0111_1111, (counter goes from 00 to $7F)
0772   0176 06 CE                              LD      B,$CE               ; return : 1100_1110...move right
0773   0178 FE 1F                              CP      $1F                 ; 1st trigger point of demo
0774   017A D8                                 RET     C                   ; return if greater
0775   017B 06 FE                              LD      B,$FE               ; 1111_1110...push fire
0776   017D C8                                 RET     Z                   ; return if equal
0777   017E 06 AE                              LD      B,$AE               ; 1010_1110...move left
0778   0180 FE 5F                              CP      $5F                 ; 2nd trigger point of demo
0779   0182 D8                                 RET     C                   ; return if greater
0780   0183 06 FE                              LD      B,$FE               ; 1111_1110...push fire
0781   0185 C8                                 RET     Z                   ; return if equal
0782   0186 06 CE                              LD      B,$CE               ; 1100_1110...move right
0783   0188 FE 7F                              CP      $7F                 ; 3rd trigger point of demo
0784   018A D8                                 RET     C                   ; return if greater
0785   018B 06 FE                              LD      B,$FE               ; 1111_1110...push fire
0786   018D 2D                                 DEC     L                   ;
0787   018E 7E                                 LD      A,(HL)              ; get $4398 (MSB from 16 bit counter)
0788   018F FE 09                              CP      $09                 ; 4rd trigger point of demo
0789   0191 C0                                 RET     NZ                  ; return if not equal
0790   0192 06 7E                              LD      B,$7E               ; 0111_1110...push shield
0791   0194 C9                                 RET                         ;
0792   0195             
0793   0196                                    .ORG $0196
0794   0196             ;*****************************************************************************
0795   0196             ;* Slow printing the static texts for the score average table
0796   0196             ;* and the big letters of the Phoenix title. Prints ONE character per call,
0797   0196             ;* driven by Counter98 ($4398:$4399). Attract-mode only.
0798   0196             ;* In: HL = $4399 (Counter98 LSB).
0799   0196             ;*****************************************************************************
0800   0196             SlowPrintScoreAverageTable:
0801   0196 7E                                 LD      A,(HL)              ; get actual index for slow print ($4399)
0802   0197 E6 1F                              AND     $1F                 ; mask out 0001_1111
0803   0199 FE 06                              CP      $06                 ; reached state 6 ?
0804   019B D8                                 RET     C                   ; no..return
0805   019C 5F                                 LD      E,A                 ; save the state
0806   019D 7E                                 LD      A,(HL)              ; get actual index for slow print ($4399)
0807   019E E6 E0                              AND     $E0                 ; mask out 1110_0000
0808   01A0 4F                                 LD      C,A                 ; save bits 5,6,7
0809   01A1 2D                                 DEC     L                   ;
0810   01A2 46                                 LD      B,(HL)              ; get zero reference from $4398
0811   01A3 2E A8                              LD      L,$A8               ; ..and..
0812   01A5 70                                 LD      (HL),B              ; save it to $43A8
0813   01A6 2C                                 INC     L                   ;
0814   01A7 71                                 LD      (HL),C              ; save bits 5,6,7 to $43A9
0815   01A8 01 60 18                           LD      BC,T1860            ; data block starting with 'INSERT  COIN' text
0816   01AB CD 06 02                           CALL    AddBCtoMem          ; stores MSB LSB
0817   01AE 7E                                 LD      A,(HL)              ;
0818   01AF 2D                                 DEC     L                   ;
0819   01B0 66                                 LD      H,(HL)              ;
0820   01B1 6F                                 LD      L,A                 ;
0821   01B2 7B                                 LD      A,E                 ;
0822   01B3 56                                 LD      D,(HL)              ; get the data
0823   01B4 2C                                 INC     L                   ;
0824   01B5 5E                                 LD      E,(HL)              ;
0825   01B6 2D                                 DEC     L                   ;
0826   01B7 4F                                 LD      C,A                 ;
0827   01B8 85                                 ADD     A,L                 ;
0828   01B9 6F                                 LD      L,A                 ;
0829   01BA 79                                 LD      A,C                 ;
0830   01BB D6 06                              SUB     $06                 ;
0831   01BD 4F                                 LD      C,A                 ;
0832   01BE CA C8 01                           JP      Z,L01C8             ;
0833   01C1             L01C1:
0834   01C1 CD 17 02                           CALL    RightOneColumn      ; move to next screen position
0835   01C4 0D                                 DEC     C                   ;
0836   01C5 C2 C1 01                           JP      NZ,L01C1            ;
0837   01C8             L01C8:
0838   01C8 7E                                 LD      A,(HL)              ;
0839   01C9 12                                 LD      (DE),A              ; print one character on the screen
0840   01CA C3 E0 14                           JP      L14E0               ; check for coin event
0841   01CD             
0842   01D0                                    .ORG $01D0
0843   01D0             ;*****************************************************************************
0844   01D0             ;* Print the top 3 lines (scores, lives, coins)
0845   01D0             ;*****************************************************************************
0846   01D0             PrintTextLines:
0847   01D0 56                                 LD      D,(HL)              ; Get ...
0848   01D1 2C                                 INC     L                   ; ... the ...
0849   01D2 5E                                 LD      E,(HL)              ; ... screen coord
0850   01D3 7D                                 LD      A,L                 ; Add 5 ...
0851   01D4 C6 05                              ADD     $05                 ; ... go get ...
0852   01D6 6F                                 LD      L,A                 ; ... data
0853   01D7 06 1A                              LD      B,$1A               ; 26 columns
0854   01D9 CD ED 01                           CALL    DrawRow             ; Draw next row
0855   01DC 0D                                 DEC     C                   ; All lines done?
0856   01DD C2 D0 01                           JP      NZ,PrintTextLines   ; No ... draw all rows
0857   01E0 C9                                 RET                         ; Done
0858   01E1             
0859   01E1             ;*****************************************************************************
0860   01E1             ;* Print the copyright lines (bottom 3 lines)
0861   01E1             ;*****************************************************************************
0862   01E1             PrintCopyright:
0863   01E1 CD 40 01                           CALL    ClearForeAndBackground
0864   01E4             L01E4:
0865   01E4 21 60 19                           LD      HL,T1960            ; "PHOENIX ... U.S.A"
0866   01E7 0E 03                              LD      C,$03               ; 3 lines at the bottom
0867   01E9 C3 D0 01                           JP      PrintTextLines      ; Print the copyright
0868   01EC             
0869   01ED                                    .ORG $01ED
0870   01ED             ;*****************************************************************************
0871   01ED             ;* Remember the screen is rotated.
0872   01ED             ;* This draws a column in screen memory (row on the screen)
0873   01ED             ;*****************************************************************************
0874   01ED             DrawRow:
0875   01ED 7E                                 LD      A,(HL)              ; Copy the data ...
0876   01EE 12                                 LD      (DE),A              ; .. to the screen
0877   01EF 23                                 INC     HL                  ; Next in data
0878   01F0 CD 17 02                           CALL    RightOneColumn      ; Move DE to next row
0879   01F3 05                                 DEC     B                   ; All drawn?
0880   01F4 C2 ED 01                           JP      NZ,DrawRow          ; Draw them all
0881   01F7 C9                                 RET                         ; Done
0882   01F8             
0883   0200                                    .ORG $0200
0884   0200             ;*****************************************************************************
0885   0200             ;* Two-byte +1 to (HL-1) : (HL).
0886   0200             ;*****************************************************************************
0887   0200             AddOneToMem:
0888   0200 34                                 INC     (HL)                ; Add one to LSB
0889   0201 C0                                 RET     NZ                  ; We didn't overflow ... done
0890   0202 2D                                 DEC     L                   ; Back up to MSB
0891   0203 34                                 INC     (HL)                ; Carry into the MSB
0892   0204 2C                                 INC     L                   ; Restore point to LSB
0893   0205 C9                                 RET                         ; Done
0894   0206             
0895   0206             ;*****************************************************************************
0896   0206             ;* Two-byte addition. BC is added to (HL-1) : (HL).
0897   0206             ;*****************************************************************************
0898   0206             AddBCtoMem:
0899   0206 7E                                 LD      A,(HL)              ; Get the lower byte
0900   0207 81                                 ADD     A,C                 ; Add C to the lower
0901   0208 77                                 LD      (HL),A              ; Store the new lower
0902   0209 2D                                 DEC     L                   ; Back up to upper byte
0903   020A 7E                                 LD      A,(HL)              ; Add B and carry ...
0904   020B 88                                 ADC     A,B                 ; ... to upper byte
0905   020C 77                                 LD      (HL),A              ; Store the new upper byte
0906   020D 2C                                 INC     L                   ; Restore pointer to LSB
0907   020E C9                                 RET                         ; Done
0908   020F             
0909   0210                                    .ORG $0210
0910   0210             ;*****************************************************************************
0911   0210             ;* Add 32 (left one column on the rotated screen) to DE (two bytes)
0912   0210             ;*****************************************************************************
0913   0210             LeftOneColumn:
0914   0210 7B                                 LD      A,E                 ; Add ...
0915   0211 C6 20                              ADD     $20                 ; ... 32 to ...
0916   0213 5F                                 LD      E,A                 ; ... E
0917   0214 D0                                 RET     NC                  ; No carry ... we are done
0918   0215 14                                 INC     D                   ; Carry into D
0919   0216 C9                                 RET                         ; Done
0920   0217             
0921   0217             ;*****************************************************************************
0922   0217             ;* Subtract 32 (right one column on the rotated screen) from DE (two bytes)
0923   0217             ;*****************************************************************************
0924   0217             RightOneColumn:
0925   0217 7B                                 LD      A,E                 ; Subtract ...
0926   0218 D6 20                              SUB     $20                 ; ... 32 from ...
0927   021A 5F                                 LD      E,A                 ; ... E
0928   021B D0                                 RET     NC                  ; No borrow ... we are done
0929   021C 15                                 DEC     D                   ; Borrow from D
0930   021D C9                                 RET                         ; Done
0931   021E             
0932   0220                                    .ORG $0220
0933   0220             ;*****************************************************************************
0934   0220             ;* 3-byte (6 digit) BCD addition. Add BC*10 to (HL-2):(HL-1):(HL).
0935   0220             ;* The games keeps the lowest digit of the scores to 0.
0936   0220             ;*****************************************************************************
0937   0220             AddToScore:
0938   0220 AF                                 XOR     A                   ; !! Pointless. We are about to change A and the flags
0939   0221 7E                                 LD      A,(HL)              ; Lowest 2 digits
0940   0222 81                                 ADD     A,C                 ; Add C to score
0941   0223 27                                 DAA                         ; Adjust for binary coded decimal
0942   0224 77                                 LD      (HL),A              ; Update lowest 2 digits
0943   0225 2D                                 DEC     L                   ; Point to middle 2 digits
0944   0226 7E                                 LD      A,(HL)              ; Add B to ...
0945   0227 88                                 ADC     A,B                 ; ... score
0946   0228 27                                 DAA                         ; Adjust for BCD
0947   0229 77                                 LD      (HL),A              ; Store the middle 2 digits
0948   022A 2D                                 DEC     L                   ; Point to the upper 2 digits
0949   022B 7E                                 LD      A,(HL)              ; Add in ...
0950   022C CE 00                              ADC     $00                 ; ... any carry
0951   022E 27                                 DAA                         ; Adjust for binary coded decimal
0952   022F 77                                 LD      (HL),A              ; Store the upper 2 digits
0953   0230 2C                                 INC     L                   ; Restore ...
0954   0231 2C                                 INC     L                   ; ... pointer
0955   0232 C9                                 RET                         ; Done
0956   0233             
0957   0258                                    .ORG $0258
0958   0258             ;*****************************************************************************
0959   0258             ;* Two byte compare of BC to memory at (HL-1):(HL)
0960   0258             ;*****************************************************************************
0961   0258             CompareBCtoMem:
0962   0258 7E                                 LD      A,(HL)              ; Value from memory
0963   0259 B9                                 CP      C                   ; Are the lower values the same?
0964   025A C0                                 RET     NZ                  ; No ... return not-zero
0965   025B 2D                                 DEC     L                   ; Point to MSB
0966   025C 7E                                 LD      A,(HL)              ; Get the MSB value
0967   025D 2C                                 INC     L                   ; Restore the pointer
0968   025E B8                                 CP      B                   ; Compare the MSBs
0969   025F C9                                 RET                         ; Return the flags
0970   0260             
0971   0260             ;*****************************************************************************
0972   0260             ;* Subtract DE from memory if memory is greater/equal to BC.
0973   0260             ;*****************************************************************************
0974   0260             SubtractIfEnough:
0975   0260 CD 70 02                           CALL    SubtractFromMemory  ; Try subtraction. Is memory larger (or equal) to BC?
0976   0263 D8                                 RET     C                   ; No ... ignore request
0977   0264 CD 77 02                           CALL    SubtractToMemory    ; Yes ... subtract DE from memory
0978   0267 C9                                 RET                         ; Done
0979   0268             
0980   0270                                    .ORG $0270
0981   0270             ;*****************************************************************************
0982   0270             ;* Two byte subtraction of memory from BC. BC = BC -  (HL-1):(HL)
0983   0270             ;*****************************************************************************
0984   0270             SubtractFromMemory:
0985   0270 7E                                 LD      A,(HL)              ; Get the low byte
0986   0271 91                                 SUB     C                   ; Subtract from C
0987   0272 2D                                 DEC     L                   ; Point to upper byte
0988   0273 7E                                 LD      A,(HL)              ; Get the upper byte
0989   0274 98                                 SBC     B                   ; Subtract from B (with borrow)
0990   0275 2C                                 INC     L                   ; Restore pointer
0991   0276 C9                                 RET                         ; Done
0992   0277             
0993   0277             ;*****************************************************************************
0994   0277             ;* Two byte subtraction of DE from memory. (HL-1):(HL) = (HL-1):(HL) - DE
0995   0277             ;*****************************************************************************
0996   0277             SubtractToMemory:
0997   0277 7B                                 LD      A,E                 ; Lower byte
0998   0278 96                                 SUB     (HL)                ; Subtract it from memory
0999   0279 2D                                 DEC     L                   ; Point to upper byte
1000   027A 7A                                 LD      A,D                 ; Value to A
1001   027B 9E                                 SBC     (HL)                ; Subtract upper byte from memory (with borrow)
1002   027C 2C                                 INC     L                   ; Restore pointer
1003   027D C9                                 RET                         ; Done
1004   027E             
1005   0280                                    .ORG $0280
1006   0280             ;*****************************************************************************
1007   0280             ;* Two byte compare of HL to BC
1008   0280             ;*****************************************************************************
1009   0280             CompareHLtoBC:
1010   0280 7D                                 LD      A,L                 ; Compare lower ...
1011   0281 B9                                 CP      C                   ; ... bytes
1012   0282 C0                                 RET     NZ                  ; Not the same ... return NZ
1013   0283 7C                                 LD      A,H                 ; Compare upper ...
1014   0284 B8                                 CP      B                   ; ... bytes
1015   0285 C9                                 RET                         ; Return the check
1016   0286             
1017   0288                                    .ORG $0288
1018   0288             ;*****************************************************************************
1019   0288             ;* Start game screen
1020   0288             ;*****************************************************************************
1021   0288             PromptForStartGame:
1022   0288 CD 40 01                           CALL    ClearForeAndBackground
1023   028B 21 C0 19                           LD      HL,T19C0            ; 
1024   028E 0E 02                              LD      C,$02               ; print two lines: 'PUSH ONLY...1PLAYER BUTTON'
1025   0290 CD D0 01                           CALL    PrintTextLines      ;
1026   0293 0E 02                              LD      C,$02               ;
1027   0295 CD E0 17                           CALL    CoinChecking        ; Converts raw `CoinCount` into playable credits, applying the coinage DIP on `DSW0`
1028   0298 FE 02                              CP      $02                 ; 2 player mode possible if credit > 1
1029   029A DA A7 02                           JP      C,L02A7             ;
1030   029D 21 A0 1B                           LD      HL,T1BA0            ;
1031   02A0 0E 01                              LD      C,$01               ; print one line: '1 OR 2PLAYERS BUTTON'
1032   02A2 CD D0 01                           CALL    PrintTextLines      ;
1033   02A5 0E 06                              LD      C,$06               ;
1034   02A7             L02A7:
1035   02A7 3A 00 70                           LD      A,(IN0)             ; 70xx IN0  Get the bits...
1036   02AA 2F                                 CPL                         ; ...for the two...
1037   02AB A1                                 AND     C                   ; ...start buttons and...
1038   02AC C8                                 RET     Z                   ; ...ret if no start button was pressed.
1039   02AD CD CB 02                           CALL    DecrementCoins      ; (GameOrAttract will be affected here as well)
1040   02B0 CD F0 02                           CALL    UpdateHiScore       ;
1041   02B3 CD 2E 03                           CALL    ClearAndPrintScores ;
1042   02B6 CD 50 03                           CALL    GetPlayerLivesFromDip
1043   02B9 CD 40 01                           CALL    ClearForeAndBackground
1044   02BC 26 50                              LD      H,videoRegister >> 8
1045   02BE 36 01                              LD      (HL),$01            ;
1046   02C0 CD 40 01                           CALL    ClearForeAndBackground
1047   02C3 26 50                              LD      H,videoRegister >> 8
1048   02C5 36 00                              LD      (HL),$00            ;
1049   02C7 C9                                 RET                         ;
1050   02C8             
1051   02CB                                    .ORG $02CB
1052   02CB             ;*****************************************************************************
1053   02CB             ;* Coin handling
1054   02CB             ;*****************************************************************************
1055   02CB             DecrementCoins:
1056   02CB 0E 01                              LD      C,$01               ; Value for 'one player game mode'
1057   02CD FE 02                              CP      $02                 ; A register holds the value of start buttons
1058   02CF CA D4 02                           JP      Z,L02D4             ; jump if 'start 1' was pressed.
1059   02D2 0E 02                              LD      C,$02               ; Value for 'two players game mode'
1060   02D4             L02D4:
1061   02D4 21 A2 43                           LD      HL,GameOrAttract    ; 
1062   02D7 71                                 LD      (HL),C              ; set it to 1 or 2 and leave the attract mode.
1063   02D8 3A 00 78                           LD      A,(DSW0)            ; 78xx DSW0
1064   02DB E6 10                              AND     $10                 ; mask for coinage 0001_0000
1065   02DD CA E3 02                           JP      Z,L02E3             ;
1066   02E0 79                                 LD      A,C                 ;
1067   02E1 07                                 RLCA                        ; Multiply by 2
1068   02E2 4F                                 LD      C,A                 ;
1069   02E3             L02E3:
1070   02E3 2E 8F                              LD      L,CoinCount & $FF   ; LSB of CoinCount
1071   02E5 7E                                 LD      A,(HL)              ; get CoinCount value
1072   02E6 91                                 SUB     C                   ; decrement coins
1073   02E7 77                                 LD      (HL),A              ; save it
1074   02E8 C6 20                              ADD     $20                 ; map value to character code
1075   02EA 32 42 41                           LD      (ForegroundScreen+$142),A ; updates the number of coins on the screen
1076   02ED C9                                 RET                         ;
1077   02EE             
1078   02F0                                    .ORG $02F0
1079   02F0             ;*****************************************************************************
1080   02F0             ;* Copy the score to hi score if greater
1081   02F0             ;*****************************************************************************
1082   02F0             UpdateHiScore:
1083   02F0 11 83 43                           LD      DE,Score1low        ; score of player 1
1084   02F3 21 8B 43                           LD      HL,HiScorelow       ; current hi score
1085   02F6 CD 14 03                           CALL    L0314               ;
1086   02F9 D4 20 03                           CALL    NC,L0320            ;
1087   02FC 1E 87                              LD      E,Score2low & $FF   ; LSB of Score2low
1088   02FE 2E 8B                              LD      L,HiScorelow & $FF  ; LSB of HiScorelow
1089   0300 CD 14 03                           CALL    L0314               ;
1090   0303 D4 20 03                           CALL    NC,L0320            ;
1091   0306 2E 8B                              LD      L,HiScorelow & $FF  ; LSB of HiScorelow
1092   0308 11 41 41                           LD      DE,$4141            ; High-score Screen coordinates (LSB)
1093   030B 06 06                              LD      B,$06               ; 6 digits
1094   030D CD C4 00                           CALL    PrintNumber         ; Print the 6-digit number
1095   0310 C9                                 RET                         ; Done
1096   0311             
1097   0314                                    .ORG $0314
1098   0314             ;*****************************************************************************
1099   0314             ;* Generic 3 byte BCD comparator
1100   0314             ;*****************************************************************************
1101   0314             L0314:
1102   0314 1A                                 LD      A,(DE)              ;
1103   0315 96                                 SUB     (HL)                ;
1104   0316 1D                                 DEC     E                   ;
1105   0317 2D                                 DEC     L                   ;
1106   0318 1A                                 LD      A,(DE)              ;
1107   0319 9E                                 SBC     (HL)                ;
1108   031A 1D                                 DEC     E                   ;
1109   031B 2D                                 DEC     L                   ;
1110   031C 1A                                 LD      A,(DE)              ;
1111   031D 9E                                 SBC     (HL)                ;
1112   031E C9                                 RET                         ;
1113   031F             
1114   0320                                    .ORG $0320
1115   0320             L0320:
1116   0320 1A                                 LD      A,(DE)              ;
1117   0321 77                                 LD      (HL),A              ;
1118   0322 13                                 INC     DE                  ;
1119   0323 23                                 INC     HL                  ;
1120   0324 1A                                 LD      A,(DE)              ;
1121   0325 77                                 LD      (HL),A              ;
1122   0326 13                                 INC     DE                  ;
1123   0327 23                                 INC     HL                  ;
1124   0328 1A                                 LD      A,(DE)              ;
1125   0329 77                                 LD      (HL),A              ;
1126   032A C9                                 RET                         ;
1127   032B             
1128   032E                                    .ORG $032E
1129   032E             ;*****************************************************************************
1130   032E             ;* Update of the score values on screen.
1131   032E             ;*****************************************************************************
1132   032E             ClearAndPrintScores:
1133   032E 21 80 43                           LD      HL,M4380            ; Clear scores..
1134   0331             L0331:
1135   0331 36 00                              LD      (HL),$00            ; ..from $4380..
1136   0333 23                                 INC     HL                  ;
1137   0334 7D                                 LD      A,L                 ;
1138   0335 FE 88                              CP      $88                 ; ..to $4387
1139   0337 C2 31 03                           JP      NZ,L0331            ;
1140   033A 2E 83                              LD      L,Score1low & $FF   ; print player 1 score
1141   033C 11 61 42                           LD      DE,$4261            ; Score1 screen coordinates (LSB)
1142   033F 06 06                              LD      B,$06               ; 6 digits
1143   0341 CD C4 00                           CALL    PrintNumber         ;
1144   0344 2E 87                              LD      L,Score2low & $FF   ; print player 2 score
1145   0346 11 21 40                           LD      DE,$4021            ; Score2 screen coordinates (LSB)
1146   0349 06 06                              LD      B,$06               ; 6 digits
1147   034B CD C4 00                           CALL    PrintNumber         ;
1148   034E C9                                 RET                         ; Done
1149   034F             
1150   0350                                    .ORG $0350
1151   0350             ;*****************************************************************************
1152   0350             ;* Gets the DIP switch settings for player lives.
1153   0350             ;*****************************************************************************
1154   0350             GetPlayerLivesFromDip:
1155   0350 3A 00 78                           LD      A,(DSW0)            ; 78xx DSW0, get DIP switch settings
1156   0353 E6 03                              AND     $03                 ; mask out 0000_0011 number of lives
1157   0355 C6 03                              ADD     $03                 ; to get : 03, 04, 05 or 06
1158   0357 47                                 LD      B,A                 ;
1159   0358 21 90 43                           LD      HL,Player1Lives     ;
1160   035B 70                                 LD      (HL),B              ; save it
1161   035C 2E A2                              LD      L,GameOrAttract & $FF
1162   035E 7E                                 LD      A,(HL)              ; load GameOrAttract and ..
1163   035F FE 01                              CP      $01                 ; check if one or two players mode
1164   0361 CA 67 03                           JP      Z,UpdateLivesScreen ;
1165   0364 2E 91                              LD      L,Player2Lives & $FF
1166   0366 70                                 LD      (HL),B              ; save it to Player2Lives
1167   0367             
1168   0367             ;*****************************************************************************
1169   0367             ;* Updates the number of lives on the screen
1170   0367             ;*****************************************************************************
1171   0367             UpdateLivesScreen:
1172   0367 2E 90                              LD      L,Player1Lives & $FF
1173   0369 7E                                 LD      A,(HL)              ; load Player1Lives
1174   036A F6 20                              OR      $20                 ; map value to character code
1175   036C 32 A2 42                           LD      (ForegroundScreen+$2A2),A ; number of lives, for player 1 at screen ram
1176   036F 2C                                 INC     L                   ;
1177   0370 7E                                 LD      A,(HL)              ; load Player2Lives
1178   0371 F6 20                              OR      $20                 ; map value to character code
1179   0373 32 62 40                           LD      (ForegroundScreen+$62),A ; number of lives, for player 2 at screen ram
1180   0376 C9                                 RET                         ;
1181   0377             
1182   0377             ;*****************************************************************************
1183   0377             ;* Update the sound control RAM registers
1184   0377             ;*****************************************************************************
1185   0377             UpdateSoundControlRAM:
1186   0377 21 8C 43                           LD      HL,SoundControlA    ;
1187   037A 77                                 LD      (HL),A              ;
1188   037B 2C                                 INC     L                   ; and update ..
1189   037C 77                                 LD      (HL),A              ; .. SoundControlB
1190   037D C9                                 RET                         ;
1191   037E             
1192   0380                                    .ORG $0380
1193   0380             ;*****************************************************************************
1194   0380             ;* Clears the foreground except for the top 3 rows (the scores)
1195   0380             ;*****************************************************************************
1196   0380             ClearForeground:
1197   0380 21 3F 43                           LD      HL,ForegroundScreen+$33F       ; End of foreground screen
1198   0383 11 1F 00                           LD      DE,$001F            ; 00 for clear and 1F for finding end of a column
1199   0386 01 3F 03                           LD      BC,$033F            ; 03 for leaving top 3 rows and 3F for find the beginning of screen memory
1200   0389             L0389:
1201   0389 72                                 LD      (HL),D              ; Clear the screen
1202   038A 2B                                 DEC     HL                  ; Next location
1203   038B 72                                 LD      (HL),D              ; Clear the screen
1204   038C 2B                                 DEC     HL                  ; Next location
1205   038D 7D                                 LD      A,L                 ; Keep lower 5 ...
1206   038E A3                                 AND     E                   ; ... bits (32 bytes in a column)
1207   038F B8                                 CP      B                   ; At the top of the column?
1208   0390 C2 89 03                           JP      NZ,L0389            ; No ... keep clearing the column
1209   0393 72                                 LD      (HL),D              ; Clear the 4th column from the top
1210   0394 2B                                 DEC     HL                  ; To ...
1211   0395 2B                                 DEC     HL                  ; ... top ...
1212   0396 2B                                 DEC     HL                  ; ... of the ...
1213   0397 2B                                 DEC     HL                  ; ... row
1214   0398 7C                                 LD      A,H                 ; Have we reached ...
1215   0399 B9                                 CP      C                   ; ... 3FFF ?
1216   039A C2 89 03                           JP      NZ,L0389            ; No ... clear all columns
1217   039D C9                                 RET                         ; Done
1218   039E             
1219   03A0                                    .ORG $03A0
1220   03A0             ;*****************************************************************************
1221   03A0             ;* Clears the background screen.
1222   03A0             ;*****************************************************************************
1223   03A0             ClearBackground:
1224   03A0 21 3F 4B                           LD      HL,BackgroundScreen+$33F       ; End of background screen memory
1225   03A3 11 47 00                           LD      DE,$0047            ; 00 for clear and 47 to find the beginning of screen memory
1226   03A6             L03A6:
1227   03A6 72                                 LD      (HL),D              ; Clear the screen
1228   03A7 2B                                 DEC     HL                  ; Next location
1229   03A8 72                                 LD      (HL),D              ; Clear the screen
1230   03A9 2B                                 DEC     HL                  ; Next location
1231   03AA 7C                                 LD      A,H                 ; Have we reached ...
1232   03AB BB                                 CP      E                   ; HL = 47FF ?
1233   03AC C2 A6 03                           JP      NZ,L03A6            ; No ... keep clearing
1234   03AF C9                                 RET                         ; Done
1235   03B0             
1236   03B0             ;*****************************************************************************
1237   03B0             ;* The game demo is using the real game code with simulated player inputs.
1238   03B0             ;* The timeline of the game demo, as part of the attract mode,
1239   03B0             ;* is covered by a 16 bit counter $4398:$4399.
1240   03B0             ;* 1st demo from value: $03E6 to $07A0.
1241   03B0             ;* 2nd demo from value: $0800 to $0B60.
1242   03B0             ;* 3rd demo from value: $0C00 to $1510.
1243   03B0             ;*****************************************************************************
1244   03B0             GameDemo:
1245   03B0 01 A0 07                           LD      BC,$07A0            ;
1246   03B3 CD 70 02                           CALL    SubtractFromMemory  ;
1247   03B6 DA CE 03                           JP      C,L03CE             ;
1248   03B9 CD 58 02                           CALL    CompareBCtoMem      ;
1249   03BC CA EB 03                           JP      Z,L03EB             ;
1250   03BF 01 60 0B                           LD      BC,$0B60            ;
1251   03C2 CD 70 02                           CALL    SubtractFromMemory  ;
1252   03C5 DA CE 03                           JP      C,L03CE             ;
1253   03C8 CD 58 02                           CALL    CompareBCtoMem      ;
1254   03CB CA E2 03                           JP      Z,L03E2             ;
1255   03CE             L03CE:
1256   03CE CD 73 01                           CALL    GetPlayerInputsForDemo
1257   03D1 21 A0 43                           LD      HL,IN0Current       ;
1258   03D4 7E                                 LD      A,(HL)              ;
1259   03D5 E6 01                              AND     $01                 ; mask out real button presses, but leave the coin event.
1260   03D7 B0                                 OR      B                   ; feed the IN0Current with movement data
1261   03D8 77                                 LD      (HL),A              ; for the game demo.
1262   03D9 C3 00 04                           JP      GameStateMachine    ;
1263   03DC             
1264   03E2                                    .ORG $03E2
1265   03E2             ;*****************************************************************************
1266   03E2             ;* Changing the game demo level at attract mode.
1267   03E2             ;*****************************************************************************
1268   03E2             L03E2:
1269   03E2 01 08 01                           LD      BC,$0108            ; Next interval game state is 1, set LevelAndRound to 1st round, level 8 (mothership wave)
1270   03E5 11 00 10                           LD      DE,$1000            ; set AliensLeft to 1 and BirdsLeft to 0 ?
1271   03E8 C3 F1 03                           JP      L03F1               ; 
1272   03EB             
1273   03EB             ;*****************************************************************************
1274   03EB             ;* Changing the game demo level at attract mode.
1275   03EB             ;*****************************************************************************
1276   03EB             L03EB:
1277   03EB 01 04 01                           LD      BC,$0104            ;
1278   03EE 11 08 00                           LD      DE,$0008            ;
1279   03F1             L03F1:
1280   03F1 21 A4 43                           LD      HL,GameState        ; Next interval game state ...
1281   03F4 70                                 LD      (HL),B              ; ... is 1 (flashing of score)
1282   03F5 2E B8                              LD      L,$B8               ;
1283   03F7 71                                 LD      (HL),C              ; set LevelAndRound to 1st round, level 4 (blue birds wave)
1284   03F8 2E BA                              LD      L,$BA               ;
1285   03FA 72                                 LD      (HL),D              ; set AliensLeft to 0
1286   03FB 2C                                 INC     L                   ;
1287   03FC 73                                 LD      (HL),E              ; set BirdsLeft to 8
1288   03FD C9                                 RET                         ;
1289   03FE             
1290   0400                                    .ORG $0400
1291   0400             ;*****************************************************************************
1292   0400             ;* Game state machine.
1293   0400             ;* Jump to function by number in GameState.
1294   0400             ;*****************************************************************************
1295   0400             GameStateMachine:
1296   0400 21 0E 04                           LD      HL,T040E            ; Jump table
1297   0403 3A A4 43                           LD      A,(GameState)       ;
1298   0406 07                                 RLCA                        ; *2
1299   0407 85                                 ADD     A,L                 ; Offset ...
1300   0408 6F                                 LD      L,A                 ; ... into the table
1301   0409 7E                                 LD      A,(HL)              ; MSB of destination
1302   040A 2C                                 INC     L                   ; Get the
1303   040B 6E                                 LD      L,(HL)              ; ... LSB of destination
1304   040C 67                                 LD      H,A                 ; Now point to function
1305   040D E9                                 JP      (HL)                ; Jump to function
1306   040E             
1307   040E             ; Notice these addresses are MSB:LSB (backwards from the processor's endianness)
1308   040E             T040E:
1309   040E                                    .MSFIRST
1310   040E 04 30                              .DW L0430                   ; game state 0: called once at 'new game start'
1311   0410 04 AC                              .DW L04AC                   ; game state 1: called for each frame during 'flashing of score1 or 2'
1312   0412 05 15                              .DW L0515                   ; game state 2: called once for initialization of game and level data
1313   0414 08 00                              .DW L0800                   ; game state 3: called for each frame of normal game play
1314   0416 0A EA                              .DW L0AEA                   ; game state 4: called for each frame of 'player ship partikel explosion'
1315   0418 0B 60                              .DW L0B60                   ; game state 5: called for each frame during 'GAME OVER' text
1316   041A 24 00                              .DW L2400                   ; game state 6: called for each frame during 'mother ship partikel explosion'
1317   041C 24 4C                              .DW L244C                   ; game state 7: called for each frame during 'mother ship score display'
1318   041E             
1319   041E             ;*****************************************************************************
1320   041E             ;* Set lower bits of video register,
1321   041E             ;* for the color palette, memory bank, and the screen flipping at cocktail mode.
1322   041E             ;*****************************************************************************
1323   041E             SetBitsVideoRegister:
1324   041E 3A A3 43                           LD      A,(GameAndDemoOrSplash)
1325   0421 E6 01                              AND     $01                 ; mask out 0000_0001 for 'memory bank'
1326   0423 47                                 LD      B,A                 ;
1327   0424 3A B8 43                           LD      A,(LevelAndRound)   ;
1328   0427 E6 02                              AND     $02                 ; masc out 0000_0010 for 'color palette'
1329   0429 B0                                 OR      B                   ; set the bits at...
1330   042A 32 00 50                           LD      (videoRegister),A   ; 50xx video register
1331   042D C9                                 RET                         ;
1332   042E             
1333   0430                                    .ORG $0430
1334   0430             ;*****************************************************************************
1335   0430             ;* Game state 0.
1336   0430             ;* New game start.
1337   0430             ;*****************************************************************************
1338   0430             L0430:
1339   0430 21 A4 43                           LD      HL,GameState        ; Next interval game state ...
1340   0433 36 01                              LD      (HL),$01            ; ... is 1 (flashing of score)
1341   0435 2C                                 INC     L                   ;
1342   0436 36 80                              LD      (HL),$80            ; Set value for CounterA5 (score flash time)
1343   0438 2E A3                              LD      L,GameAndDemoOrSplash & $FF   ; save the value of..
1344   043A 7E                                 LD      A,(HL)              ; .. GameAndDemoOrSplash
1345   043B 36 00                              LD      (HL),$00            ; set it to game demo / game play
1346   043D FE 02                              CP      $02                 ;
1347   043F C8                                 RET     Z                   ; return if it was 'Intro splash' before.
1348   0440 77                                 LD      (HL),A              ; set GameAndDemoOrSplash to 'Game and demo for player 1'
1349   0441 2D                                 DEC     L                   ;
1350   0442 7E                                 LD      A,(HL)              ; get GameOrAttract
1351   0443 FE 01                              CP      $01                 ;
1352   0445 C8                                 RET     Z                   ; return if 'One player game mode'
1353   0446 2C                                 INC     L                   ;
1354   0447 7E                                 LD      A,(HL)              ; get GameAndDemoOrSplash
1355   0448 A7                                 AND     A                   ; updates the zero flag
1356   0449 CA A0 04                           JP      Z,L04A0             ; if 'Game and demo'
1357   044C 2E 90                              LD      L,$90               ;
1358   044E 7E                                 LD      A,(HL)              ; get Player1Lives
1359   044F A7                                 AND     A                   ; updates the zero flag
1360   0450 C8                                 RET     Z                   ; return if no lives left.
1361   0451 2E A3                              LD      L,$A3               ;
1362   0453 36 00                              LD      (HL),$00            ; set GameAndDemoOrSplash to 'Game and demo for player 1'
1363   0455 01 00 01                           LD      BC,$0100            ; from bank 1 to bank 0
1364   0458 CD 60 04                           CALL    CopyMemoryBank      ; to toggle the player
1365   045B C9                                 RET                         ;
1366   045C             
1367   0460                                    .ORG $0460
1368   0460             ;*****************************************************************************
1369   0460             ;* Copy memory bank to bank.
1370   0460             ;* B = from-bank number, C = to-bank number.  Copies three regions:
1371   0460             ;*   1) the foreground playfield (from $4320)
1372   0460             ;*      This loop walks the screen in the display's native (rotated) order:
1373   0460             ;*      It copies a 4 byte group (`E & 3` inner loop), then snaps `E` to
1374   0460             ;*      its `$x0` boundary and subtracts `$20` to jump to the group one screen line earlier,
1375   0460             ;*      when that underflows it decrements the page (`DEC D`).
1376   0460             ;*      It marches through pages `$43 -> $42 -> $41 -> $40` and stops when `D` reaches `$3F`
1377   0460             ;*      (i.e. below `$4000`). Net effect: the visible playfield is transferred between banks.
1378   0460             ;*   2) the game-state/score block  $4380-$43B7
1379   0460             ;*      A straight linear copy (`INC E` until `$B8`). This carries the two players' scores
1380   0460             ;*      (`$4380`–`$4387`) plus the level/round and assorted counters in that block.
1381   0460             ;*   3) the object buffer          $4BC0-$4BFF
1382   0460             ;*      Another linear copy that runs until `E` wraps from `$FF` to `$00`.
1383   0460             ;*      This preserves the in progress object/bird buffer.
1384   0460             ;* Role in the game:
1385   0460             ;* `CopyMemoryBank` is what makes alternating two player play possible:
1386   0460             ;* at each turn boundary the game flips the "current player" flag and calls this routine
1387   0460             ;* to move the departing player's screen and state into their bank while bringing
1388   0460             ;* the incoming player's bank live (the register ends on `C`). The three regions cover
1389   0460             ;* exactly what must persist across turns — the visible screen, the score/level/counter block,
1390   0460             ;* and the object buffer — so each player resumes precisely where they left off.
1391   0460             ;*****************************************************************************
1392   0460             CopyMemoryBank:
1393   0460 21 00 50                           LD      HL,videoRegister    ; 50xx video register
1394   0463 11 20 43                           LD      DE,ForegroundScreen+$320; 1st row 1st line
1395   0466             ;----- Region 1: the visible foreground screen --------------------------------
1396   0466             L0466:
1397   0466 70                                 LD      (HL),B              ;
1398   0467 1A                                 LD      A,(DE)              ;
1399   0468 71                                 LD      (HL),C              ;
1400   0469 12                                 LD      (DE),A              ;
1401   046A 1C                                 INC     E                   ;
1402   046B 7B                                 LD      A,E                 ;
1403   046C E6 03                              AND     $03                 ;
1404   046E C2 66 04                           JP      NZ,L0466            ;
1405   0471 7B                                 LD      A,E                 ;
1406   0472 E6 F0                              AND     $F0                 ;
1407   0474 D6 20                              SUB     $20                 ;
1408   0476 5F                                 LD      E,A                 ;
1409   0477 D2 66 04                           JP      NC,L0466            ;
1410   047A 15                                 DEC     D                   ;
1411   047B 7A                                 LD      A,D                 ;
1412   047C FE 3F                              CP      $3F                 ;
1413   047E C2 66 04                           JP      NZ,L0466            ;
1414   0481 11 80 43                           LD      DE,M4380            ;
1415   0484             ;----- Region 2: game-state + score block $4380-$43B7 -------------------------
1416   0484             L0484:
1417   0484 70                                 LD      (HL),B              ;
1418   0485 1A                                 LD      A,(DE)              ;
1419   0486 71                                 LD      (HL),C              ;
1420   0487 12                                 LD      (DE),A              ;
1421   0488 1C                                 INC     E                   ;
1422   0489 7B                                 LD      A,E                 ;
1423   048A FE B8                              CP      $B8                 ;
1424   048C C2 84 04                           JP      NZ,L0484            ;
1425   048F 11 C0 4B                           LD      DE,M4BC0            ;
1426   0492             ;----- Region 3: object buffer $4BC0-$4BFF ------------------------------------
1427   0492             L0492:
1428   0492 70                                 LD      (HL),B              ;
1429   0493 1A                                 LD      A,(DE)              ;
1430   0494 71                                 LD      (HL),C              ;
1431   0495 12                                 LD      (DE),A              ;
1432   0496 1C                                 INC     E                   ;
1433   0497 7B                                 LD      A,E                 ;
1434   0498 FE 00                              CP      $00                 ;
