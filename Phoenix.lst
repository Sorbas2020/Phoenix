8368   3930             ;*****************************************************************************
8369   3930             ;* Bird bomb-drop dispatcher:
8370   3930             ;* For the birds currently in the active scroll band (from T3DC0),
8371   3930             ;* check which sit over the player and have them drop a bomb.
8372   3930             ;* The active-object window (start index + count) comes from `T3DC0`
8373   3930             ;* indexed by the scroll phase; the player danger window `(B,C)`
8374   3930             ;* is the player's mapped X position widened by `D` (from `L3A00`).
8375   3930             ;*****************************************************************************
8376   3930             L3930:
8377   3930 3A D2 4B                           LD      A,(M4BD2)           ; 
8378   3933 E6 1E                              AND     $1E                 
8379   3935 C6 C0                              ADD     T3DC0 & $FF         ; LSB of table T3DC0
8380   3937 6F                                 LD      L,A                 
8381   3938 26 3D                              LD      H,T3DC0 >> 8        ; MSB of table T3DC0
8382   393A 5E                                 LD      E,(HL)              
8383   393B 2C                                 INC     L                   
8384   393C 6E                                 LD      L,(HL)              
8385   393D 26 4B                              LD      H,$4B               
