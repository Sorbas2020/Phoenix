2091   07B6 23                                 INC     HL                  ;
2092   07B7 13                                 INC     DE                  ;
2093   07B8 7E                                 LD      A,(HL)              ;
2094   07B9 12                                 LD      (DE),A              ; draw lower part on screen
2095   07BA 0B                                 DEC     BC                  ;
2096   07BB C9                                 RET                         ;
