8913   3B9C C0 FF 01 C0 
8914   3BA0 FF 01 00 FF                        .DB $FF, $01, $00, $FF, $07, $FF, $07, $FC, $1F, $F8, $0F, $F0, $C0, $03, $FF, $FF   ; for bird background tiles D0 - DF
8914   3BA4 07 FF 07 FC 
