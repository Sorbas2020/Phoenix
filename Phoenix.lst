6409   27A8 21 8C 43                           LD      HL,SoundControlA    ; ..
6410   27AB 7E                                 LD      A,(HL)              ; .. to
6411   27AC 32 00 60                           LD      (SOUNDCTLA),A       ; 60xx sound A
6412   27AF 2C                                 INC     L                   ; SoundControlB ..
6413   27B0 7E                                 LD      A,(HL)              ; .. to
6414   27B1 32 00 68                           LD      (SOUNDCTLB),A       ; 68xx sound B
6415   27B4 F6 0F                              OR      $0F                 ; 0000_1111
6416   27B6 77                                 LD      (HL),A              ;
6417   27B7 2D                                 DEC     L                   ;
6418   27B8 36 0F                              LD      (HL),$0F            ;
6419   27BA C9                                 RET                         ;
