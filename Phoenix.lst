2168   0800             ;*****************************************************************************
2169   0800             ; ic46
2170   0800             ;*****************************************************************************
2171   0800             ;*****************************************************************************
2172   0800             ;* Game state 3.
2173   0800             ;* Normal game play.
2174   0800             ;*****************************************************************************
2175   0800             L0800:
2176   0800 21 14 08                           LD      HL,T0814            ;
2177   0803 3A B8 43                           LD      A,(LevelAndRound)   ; bit0 - 3: game level, bit4 - 7: game round
2178   0806 07                                 RLCA                        ; Multiply by 2 to get a 2 byte offset
2179   0807 E6 1E                              AND     $1E                 ; mask out 0001_1110 game level
2180   0809 85                                 ADD     A,L                 ; add offset ...
2181   080A 6F                                 LD      L,A                 ; ... to base of table
2182   080B 7E                                 LD      A,(HL)              ; MSB of destination
2183   080C 2C                                 INC     L                   ; Get the
2184   080D 6E                                 LD      L,(HL)              ; ... LSB of destination
2185   080E 67                                 LD      H,A                 ; Now point to function
2186   080F E9                                 JP      (HL)                ; jump to corresponding function according to LevelAndRound.
2187   0810             
2188   0814                                    .ORG $0814
2189   0814             T0814:
2190   0814                                    .MSFIRST
2191   0814 08 34                              .DW L0834       ;Game level 0: called for each frame during stars scrolling down and 'aliens fade in'
2192   0816 20 00                              .DW L2000       ;Game level 1: called for each frame during 'player alife' with aliens, after 'fade in'
2193   0818 08 34                              .DW L0834       ;Game level 2: called for each frame during stars scrolling down and 'aliens fade in'
2194   081A 20 00                              .DW L2000       ;Game level 3: called for each frame during 'player alife' with aliens, after 'fade in'
2195   081C 22 30                              .DW L2230       ;Game level 4: called for each frame during 'spiral fill'
2196   081E 34 00                              .DW L3400       ;Game level 5: called for each frame during birds level including 'fade in'
2197   0820 22 30                              .DW L2230       ;Game level 6: called for each frame during 'spiral fill'
2198   0822 34 00                              .DW L3400       ;Game level 7: called for each frame during birds level including 'fade in'
2199   0824 22 30                              .DW L2230       ;Game level 8: called for each frame during 'spiral fill'
2200   0826 22 B4                              .DW L22B4       ;Game level 9: called for each frame during mothership 'fade in'
2201   0828 22 CA                              .DW L22CA       ;Game level A: called for each frame during mothership and aliens 'fade in'
2202   082A 20 00                              .DW L2000       ;Game level B: called for each frame during 'player alife' with aliens and mothership, after 'fade in'
2203   082C             
