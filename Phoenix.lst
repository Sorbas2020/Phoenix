3603   0FC0             ;*****************************************************************************
3604   0FC0             ;* Handle animations for killed aliens.
3605   0FC0             ;* Services 4 explosion slots (4-byte records at $4370/$4374/$4378/$437C):
3606   0FC0             ;*   +0 = animation counter (0 = slot free)
3607   0FC0             ;*   +1 = unused
3608   0FC0             ;*   +2 = screen-RAM MSB
3609   0FC0             ;*   +3 = screen-RAM LSB
3610   0FC0             ;* Slots 0/1 are ordinary alien explosions (L0FD8); slots 2/3 use L3758
3611   0FC0             ;* (the bonus-explosion animator).
3612   0FC0             ;*****************************************************************************
3613   0FC0             L0FC0:
3614   0FC0 21 70 43                           LD      HL,M4370            ; explosion slot 0
3615   0FC3 CD D8 0F                           CALL    L0FD8               ; advance alien explosion
3616   0FC6 21 74 43                           LD      HL,M4374            ; explosion slot 1
3617   0FC9 CD D8 0F                           CALL    L0FD8               ; advance alien explosion
3618   0FCC 21 78 43                           LD      HL,M4378            ; slot 2 (bonus explosion counter)
3619   0FCF CD 58 37                           CALL    L3758               ; advance bonus explosion
3620   0FD2 21 7C 43                           LD      HL,M437C            ; slot 3 (bonus explosion)
3621   0FD5 C3 58 37                           JP      L3758               ; advance bonus explosion (tail-call)
3622   0FD8             ;*****************************************************************************
3623   0FD8             ;* Advance and draw one alien-explosion slot.
3624   0FD8             ;* HL -> slot record (+0 = counter). Returns immediately if the slot is idle.
3625   0FD8             ;*****************************************************************************
3626   0FD8             L0FD8:
3627   0FD8 7E                                 LD      A,(HL)              
3628   0FD9 A7                                 AND     A                   ; updates the zero flag
3629   0FDA C8                                 RET     Z                   
3630   0FDB 46                                 LD      B,(HL)              
3631   0FDC 35                                 DEC     (HL)                
3632   0FDD 2C                                 INC     L                   
3633   0FDE 2C                                 INC     L                   
3634   0FDF 56                                 LD      D,(HL)              
3635   0FE0 2C                                 INC     L                   
3636   0FE1 5E                                 LD      E,(HL)              
3637   0FE2 00                                 NOP                         
3638   0FE3 CD 10 02                           CALL    LeftOneColumn       ; 
3639   0FE6 78                                 LD      A,B                 
3640   0FE7 E6 0E                              AND     $0E                 
3641   0FE9 0F                                 RRCA                        
3642   0FEA C6 B0                              ADD     $B0                 
3643   0FEC 6F                                 LD      L,A                 
3644   0FED 26 17                              LD      H,$17               
3645   0FEF 6E                                 LD      L,(HL)              
3646   0FF0 EB                                 EX      DE,HL               
3647   0FF1 01 DF FF                           LD      BC,$FFDF            ; Screen offset constant -33 right one column (-1), up one row (-32)
3648   0FF4 C3 40 35                           JP      Draw3x2             ; 
