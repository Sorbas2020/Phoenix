8739   3A98             ;*****************************************************************************
8740   3A98             ;* Background sound for the alien waves.
8741   3A98             ;* At least one of the aliens is doing a closed loop pattern.
8742   3A98             ;* Sound data is derived from alien control state B.
8743   3A98             ;*****************************************************************************
8744   3A98             L3A98:
8745   3A98 21 70 4B                           LD      HL,M4B70            ; Alien control state A
8746   3A9B 01 00 08                           LD      BC,$0800            ; bit3 mask, loop index
8747   3A9E 11 B0 03                           LD      DE,$03B0            ; offset to next alien control state A, LSB for end of alien data structure (grid)
8748   3AA1             L3AA1:
8749   3AA1 7E                                 LD      A,(HL)              ; 
8750   3AA2 2C                                 INC     L                   ; 
8751   3AA3 A0                                 AND     B                   ; 0000_1000
8752   3AA4 CA AE 3A                           JP      Z,L3AAE             ; 
8753   3AA7 7E                                 LD      A,(HL)              ; get Alien control state B
8754   3AA8 FE 28                              CP      $28                 ; 
8755   3AAA DA AE 3A                           JP      C,L3AAE             ; 
8756   3AAD 0C                                 INC     C                   ; 
8757   3AAE             L3AAE:
8758   3AAE 7D                                 LD      A,L                 ; 
8759   3AAF 82                                 ADD     A,D                 ; 
8760   3AB0 6F                                 LD      L,A                 ; 
8761   3AB1 BB                                 CP      E                   ; 
8762   3AB2 C2 A1 3A                           JP      NZ,L3AA1            ; loop over alien data structure (grid)
8763   3AB5 79                                 LD      A,C                 ; 
8764   3AB6 A7                                 AND     A                   ; updates the zero flag
8765   3AB7 C8                                 RET     Z                   ; 
8766   3AB8 FE 08                              CP      $08                 ; 
8767   3ABA DA BF 3A                           JP      C,L3ABF             ; 
8768   3ABD 3E 08                              LD      A,$08               ; 0000_1000
8769   3ABF             L3ABF:
8770   3ABF C6 25                              ADD     $25                 ; 0010_0101
8771   3AC1 4F                                 LD      C,A                 ; 
8772   3AC2 21 8C 43                           LD      HL,SoundControlA    ; 
8773   3AC5 7E                                 LD      A,(HL)              ; get
8774   3AC6 E6 C0                              AND     $C0                 ; mask out 1100_0000
8775   3AC8 B1                                 OR      C                   ; set e.g. 0010_1101 the terrible sound of an alien attack
8776   3AC9 77                                 LD      (HL),A              ; at SoundControlA
8777   3ACA C9                                 RET                         ; 
8778   3ACB             
8779   3AD0                                    .ORG $3AD0
8780   3AD0             ;*****************************************************************************
8781   3AD0             ;* Background sound for the bird waves:
8782   3AD0             ;* Counts frames for the current tone;
8783   3AD0             ;* it's compared against a per-phase duration taken from `T3DE0`
8784   3AD0             ;* (indexed by the formation scroll phase `B4BD6`),
8785   3AD0             ;* and when the duration is reached it resets to 0, which advances `$438E` to the next note.
8786   3AD0             ;*****************************************************************************
8787   3AD0             L3AD0:
8788   3AD0 21 8E 43                           LD      HL,M438E            ; Bird-wave background-sound phase
8789   3AD3 7E                                 LD      A,(HL)              ; 
8790   3AD4 E6 01                              AND     $01                 ; 0000_0001 phase bit
8791   3AD6 07                                 RLCA                        ; Multiply by 4 ..
8792   3AD7 07                                 RLCA                        ; ..
8793   3AD8 F6 20                              OR      $20                 ; 0010_0000
8794   3ADA 47                                 LD      B,A                 ; 
8795   3ADB 2D                                 DEC     L                   ; 
8796   3ADC 7E                                 LD      A,(HL)              ; $438D SoundControlB
8797   3ADD E6 C0                              AND     $C0                 ; 1100_0000
8798   3ADF B0                                 OR      B                   ; set bits
8799   3AE0 77                                 LD      (HL),A              ; at SoundControlB
8800   3AE1 2E 96                              LD      L,$96               ; $4396 bird-wave background-sound step timer
8801   3AE3 7E                                 LD      A,(HL)              ; 
8802   3AE4 34                                 INC     (HL)                ; tick
8803   3AE5 A7                                 AND     A                   ; updates the zero flag
8804   3AE6 CA F8 3A                           JP      Z,L3AF8             ; 
8805   3AE9 3A D6 4B                           LD      A,(B4BD6)           ; combined scroll-phase + active-bird center index (0–31)
8806   3AEC C6 E0                              ADD     $E0                 ; LSB of table T3DE0 Background sound data for the bird waves.
8807   3AEE 5F                                 LD      E,A                 ; 
8808   3AEF 16 3D                              LD      D,$3D               ; MSB of table T3DE0 Background sound data for the bird waves.
8809   3AF1 1A                                 LD      A,(DE)              ; 
8810   3AF2 BE                                 CP      (HL)                ; reached this note's duration?
8811   3AF3 D0                                 RET     NC                  ; 
8812   3AF4 36 00                              LD      (HL),$00            ; reset -> advance tone phase
8813   3AF6 C9                                 RET                         ; 
8814   3AF7             
8815   3AF8                                    .ORG $3AF8
8816   3AF8             ;
8817   3AF8             L3AF8:
8818   3AF8 2E 8E                              LD      L,$8E               ; $438E Bird-wave background-sound phase/state
8819   3AFA 34                                 INC     (HL)                ; advance the tone phase
8820   3AFB 2D                                 DEC     L                   ; SoundControlB
8821   3AFC 7E                                 LD      A,(HL)              ; 
8822   3AFD F6 10                              OR      $10                 ; set 0001_0000
8823   3AFF 77                                 LD      (HL),A              ; at SoundControlB
8824   3B00 C9                                 RET                         ; 
8825   3B01             
8826   3B02                                    .ORG $3B02
8827   3B02             ;*****************************************************************************
8828   3B02             ;* Background sound for level B (mothership).
8829   3B02             ;* Sound data is derived from Counter9A+1.
8830   3B02             ;*****************************************************************************
8831   3B02             L3B02:
8832   3B02 21 9A 43                           LD      HL,Counter9A        ; 
8833   3B05 7E                                 LD      A,(HL)              ; 
8834   3B06 FE 02                              CP      $02                 ; 
8835   3B08 D0                                 RET     NC                  ; 
8836   3B09 2C                                 INC     L                   ; 
8837   3B0A 7E                                 LD      A,(HL)              ; get Counter9A+1
8838   3B0B 47                                 LD      B,A                 ; 
8839   3B0C E6 60                              AND     $60                 ; 0110_0000
8840   3B0E 2E 8D                              LD      L,$8D               ; SoundControlB
8841   3B10 36 0A                              LD      (HL),$0A            ; set  0000_1010
8842   3B12 C0                                 RET     NZ                  ; 
8843   3B13 78                                 LD      A,B                 ; 
8844   3B14 E6 02                              AND     $02                 ; mask 0000_0010
8845   3B16 C6 1C                              ADD     $1C                 ; set  0001_1100
8846   3B18 77                                 LD      (HL),A              ; at SoundControlB
8847   3B19 C9                                 RET                         ; 
8848   3B1A             
8849   3B1B                                    .ORG $3B1B
8850   3B1B             ;*****************************************************************************
8851   3B1B             ;* Ringtone sound for the player shield.
8852   3B1B             ;* Sound data is derived from player shield animation counter.
8853   3B1B             ;*****************************************************************************
8854   3B1B             L3B1B:
8855   3B1B 21 62 43                           LD      HL,M4362            ; Player shield animation counter
8856   3B1E 7E                                 LD      A,(HL)              ; 
8857   3B1F A7                                 AND     A                   ; updates the zero flag
8858   3B20 C8                                 RET     Z                   ; if $4362 is 0.
8859   3B21 FE 40                              CP      $40                 ; 
8860   3B23 DA 28 3B                           JP      C,L3B28             ; 
8861   3B26 36 40                              LD      (HL),$40            ; 
8862   3B28             L3B28:                                             
8863   3B28 35                                 DEC     (HL)                ; 
8864   3B29 7E                                 LD      A,(HL)              ; 
8865   3B2A E6 06                              AND     $06                 ; 0000_0110
8866   3B2C 07                                 RLCA                        ; Multiply by 2
8867   3B2D 00                                 NOP                         ; 
8868   3B2E 2E 8D                              LD      L,$8D               ; SoundControlB
8869   3B30 77                                 LD      (HL),A              ; set
8870   3B31 C9                                 RET                         ; 
8871   3B32             
8872   3B33                                    .ORG $3B33
8873   3B33             ;*****************************************************************************
8874   3B33             ;* Play the sound for 'Bonus live added'.
8875   3B33             ;*****************************************************************************
8876   3B33             L3B33:
8877   3B33 21 6A 43                           LD      HL,M436A            ; get flag for: 'Bonus live added'
8878   3B36 7E                                 LD      A,(HL)              ; 
8879   3B37 A7                                 AND     A                   ; updates the zero flag
8880   3B38 C8                                 RET     Z                   ; if flag not set.
8881   3B39 35                                 DEC     (HL)                ; 
8882   3B3A E6 08                              AND     $08                 ; 0000_1000
8883   3B3C F6 07                              OR      $07                 ; 0000_0111
8884   3B3E 2E 8D                              LD      L,$8D               ; SoundControlB
8885   3B40 77                                 LD      (HL),A              ; set
8886   3B41 C9                                 RET                         ; 
8887   3B42             
8888   3B43                                    .ORG $3B43
8889   3B43             ;*****************************************************************************
8890   3B43             ;* Update all synth sounds and melody triggers.
8891   3B43             ;*****************************************************************************
8892   3B43             L3B43:
8893   3B43 21 A4 43                           LD      HL,GameState        ; 
8894   3B46 7E                                 LD      A,(HL)              ;
8895   3B47 FE 03                              CP      $03                 ; is 'normal game play' ?
8896   3B49 CC D6 23                           CALL    Z,L23D6             ; if yes, do the background sound.
8897   3B4C CD 33 3B                           CALL    L3B33               ; Sound for 'Bonus live added'.
8898   3B4F CD 1B 3B                           CALL    L3B1B               ; Ringtone sound for the player shield.
8899   3B52 CD 1D 3A                           CALL    L3A1D               ; 
8900   3B55 CD BD 27                           CALL    L27BD               ; Sound for player bullet or ship explosion.
8901   3B58 CD 82 3A                           CALL    L3A82               ; 
8902   3B5B C3 90 3A                           JP      L3A90               ; Trigger melody
8903   3B5E             
