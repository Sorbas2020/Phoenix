8734   3A90 21 6B 43                           LD      HL,M436B            ; Flag for: 'mother ship score display' ($FF) and counter
8735   3A93 7E                                 LD      A,(HL)              ; 
8736   3A94 A7                                 AND     A                   ; updates the zero flag
8737   3A95 C3 23 39                           JP      L3923               ; 
