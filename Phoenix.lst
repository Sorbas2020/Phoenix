8891   3DC0             ; Scroll-phase -> active-object-window table for the bird wave.
8892   3DC0             ; Used by `L3930`, which runs every frame during the bird attack waves (it's called from the wave loop at `$3431` and `$3448`).
8893   3DC0             ; It defines a sliding, resizing window over the column of bird objects as a function of how far the wave has scrolled down.
8894   3DC0             ; - Phases 0–8: the window starts at the top object (`$4B70`) and grows `6 -> 7 -> 8` as more rows enter the play field.
8895   3DC0             ; - Phases 10–22: the start pointer slides down one object at a time (`$4B78 -> $4B80 -> ... -> $4BA8`),
8896   3DC0             ;                 while the count shrinks `7 -> 6 -> ... -> 1`, modeling the top rows scrolling out / fewer rows remaining active.
8897   3DC0             ; - Phases 24–30: it wraps back to the top (`$4B70`) and grows again `2 -> 3 -> 4 -> 5`.
8898   3DC0             T3DC0:
8899   3DC0 06 70                              .DB $06, $70         ; phase  0 : count=6, ptr=$4B70
8900   3DC2 07 70                              .DB $07, $70         ; phase  2 : count=7, ptr=$4B70
8901   3DC4 08 70                              .DB $08, $70         ; phase  4 : count=8, ptr=$4B70
8902   3DC6 08 70                              .DB $08, $70         ; phase  6 : count=8, ptr=$4B70
8903   3DC8 08 70                              .DB $08, $70         ; phase  8 : count=8, ptr=$4B70
8904   3DCA 07 78                              .DB $07, $78         ; phase 10 : count=7, ptr=$4B78
8905   3DCC 06 80                              .DB $06, $80         ; phase 12 : count=6, ptr=$4B80
8906   3DCE 05 88                              .DB $05, $88         ; phase 14 : count=5, ptr=$4B88
8907   3DD0 04 90                              .DB $04, $90         ; phase 16 : count=4, ptr=$4B90
8908   3DD2 03 98                              .DB $03, $98         ; phase 18 : count=3, ptr=$4B98
8909   3DD4 02 A0                              .DB $02, $A0         ; phase 20 : count=2, ptr=$4BA0
8910   3DD6 01 A8                              .DB $01, $A8         ; phase 22 : count=1, ptr=$4BA8
8911   3DD8 02 70                              .DB $02, $70         ; phase 24 : count=2, ptr=$4B70
8912   3DDA 03 70                              .DB $03, $70         ; phase 26 : count=3, ptr=$4B70
8913   3DDC 04 70                              .DB $04, $70         ; phase 28 : count=4, ptr=$4B70
8914   3DDE 05 70                              .DB $05, $70         ; phase 30 : count=5, ptr=$4B70
8915   3DE0             
