2015   0779 EB                                 EX      DE,HL               ;
2016   077A 56                                 LD      D,(HL)              ;
2017   077B 23                                 INC     HL                  ;
2018   077C 5E                                 LD      E,(HL)              ;
2019   077D 2B                                 DEC     HL                  ; restore pointer
2020   077E AF                                 XOR     A                   ; A=0
2021   077F 12                                 LD      (DE),A              ; delete at screen, left part
2022   0780 CD 17 02                           CALL    RightOneColumn      ; 
2023   0783 AF                                 XOR     A                   ; A=0
