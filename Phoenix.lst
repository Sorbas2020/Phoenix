1727   0650                                    .ORG $0650
1728   0650             ;*****************************************************************************
1729   0650             ;* Copy init values for 16 aliens to $4B50-$4B6F (Pointer to alien movement pattern)
1730   0650             ;*****************************************************************************
1731   0650             L0650:
1732   0650 21 20 15                           LD      HL,T1520            ;
1733   0653 3A B8 43                           LD      A,(LevelAndRound)   ;
1734   0656 E6 0F                              AND     $0F                 ; mask out 0000_1111
1735   0658 07                                 RLCA                        ; Multiply by 2
1736   0659 85                                 ADD     A,L                 ;
1737   065A 6F                                 LD      L,A                 ;
1738   065B 56                                 LD      D,(HL)              ;
1739   065C 23                                 INC     HL                  ;
1740   065D 5E                                 LD      E,(HL)              ;
1741   065E 21 50 4B                           LD      HL,M4B50            ;
1742   0661 3A BA 43                           LD      A,(AliensLeft)      ;
1743   0664 47                                 LD      B,A                 ;
1744   0665 A7                                 AND     A                   ; updates the zero flag
1745   0666 C8                                 RET     Z                   ; if no AliensLeft
1746   0667             L0667:
1747   0667 72                                 LD      (HL),D              ;
1748   0668 2C                                 INC     L                   ;
1749   0669 73                                 LD      (HL),E              ;
1750   066A 2C                                 INC     L                   ;
1751   066B 05                                 DEC     B                   ;
1752   066C C2 67 06                           JP      NZ,L0667            ; loop for all AliensLeft
1753   066F C9                                 RET                         ;
1754   0670             
1755   067A                                    .ORG $067A
1756   067A             ;*****************************************************************************
1757   067A             ;* Scroll down the background screen one pixel.
1758   067A             ;*****************************************************************************
1759   067A             StarsScrollDown:
1760   067A 21 B9 43                           LD      HL,CounterB9        ;
1761   067D 7E                                 LD      A,(HL)              ;
1762   067E 35                                 DEC     (HL)                ; decrement the backwards counter
1763   067F 32 00 58                           LD      (scrollRegister),A  ; 58xx scroll register
1764   0682 E6 07                              AND     $07                 ; mask out 0000_0111
1765   0684 C0                                 RET     NZ                  ; continue after 8 pixels...
1766   0685             ; Fill the background with stars or mothership.
1767   0685 01 47 20                           LD      BC,$2047            ;
1768   0688 11 21 4B                           LD      DE,$4B21            ; get character from the background screen (1st row, 2nd line)
1769   068B 7E                                 LD      A,(HL)              ; get $43B9 free running 8 bit backwards counter value
1770   068C 0F                                 RRCA                        ;
1771   068D 0F                                 RRCA                        ;
1772   068E 0F                                 RRCA                        ;
1773   068F E6 1F                              AND     $1F                 ; mask out 0001_1111
1774   0691 83                                 ADD     A,E                 ;
1775   0692 5F                                 LD      E,A                 ;
1776   0693 2E B2                              LD      L,$B2               ;
1777   0695 7E                                 LD      A,(HL)              ; get $43B2 (MSB of T1C00 or T1D00 or T1F00)
1778   0696 2C                                 INC     L                   ;
1779   0697 6E                                 LD      L,(HL)              ; get $43B3 (LSB of T1C00 or T1D00 or T1F00)
1780   0698 67                                 LD      H,A                 ;
1781   0699             L0699:
1782   0699 7E                                 LD      A,(HL)              ;
1783   069A 12                                 LD      (DE),A              ; to background screen
1784   069B 2C                                 INC     L                   ;
1785   069C 7B                                 LD      A,E                 ;
1786   069D 90                                 SUB     B                   ;
1787   069E 5F                                 LD      E,A                 ;
1788   069F D2 99 06                           JP      NC,L0699            ;
1789   06A2 15                                 DEC     D                   ;
1790   06A3 7A                                 LD      A,D                 ;
1791   06A4 B9                                 CP      C                   ;
1792   06A5 C2 99 06                           JP      NZ,L0699            ;
1793   06A8 7D                                 LD      A,L                 ;
1794   06A9 32 B3 43                           LD      (M43B3),A           ;
1795   06AC C9                                 RET                         ;
1796   06AD             
1797   06B0                                    .ORG $06B0
1798   06B0             ;*****************************************************************************
1799   06B0             ;* Fill the background with (2x2) planets.
1800   06B0             ;* Reads the MSB from `T1E20`, then reaches `T1E40` simply by adding `$20`
1801   06B0             ;* to the same pointer (`$1E20 + $20 = $1E40`) — which is the clearest proof that `T1E40` is the LSB companion of `T1E20`.
1802   06B0             ;* So `DE = (T1E20[i] << 8) | T1E40[i]`, then the LSB gets a scroll dependent offset added (derived from `CounterB9 >> 3`)
1803   06B0             ;* so the planet drifts down as the star background scrolls. `DE` ends up somewhere in `$4800`–`$4BFF` (the background screen).
1804   06B0             ;* The graphic itself is then chosen via `T1E60 -> T1E00` and drawn by `L07DC`.
1805   06B0             ;* The routine only fires when `CounterB9` matches the planet counter (`$43AB`),
1806   06B0             ;* so as the background scrolls a new planet is dropped in at successive slots,
1807   06B0             ;* the slot index (masked to `$1F`) cycles through all 32 `T1E20`/`T1E40` positions.
1808   06B0             ;*****************************************************************************
1809   06B0             AddPlanetsToBackground:
1810   06B0 21 AB 43                           LD      HL,M43AB            ; counter value for (2x2) planets
1811   06B3 3A B9 43                           LD      A,(CounterB9)       ;
1812   06B6 4F                                 LD      C,A                 ;
1813   06B7 BE                                 CP      (HL)                ;
1814   06B8 C0                                 RET     NZ                  ;
1815   06B9 7E                                 LD      A,(HL)              ;
1816   06BA 2C                                 INC     L                   ;
1817   06BB 86                                 ADD     A,(HL)              ;
1818   06BC 2D                                 DEC     L                   ;
1819   06BD 77                                 LD      (HL),A              ;
1820   06BE 2C                                 INC     L                   ;
1821   06BF 2C                                 INC     L                   ;
1822   06C0 34                                 INC     (HL)                ;
1823   06C1 46                                 LD      B,(HL)              ;
1824   06C2 2C                                 INC     L                   ;
1825   06C3 34                                 INC     (HL)                ;
1826   06C4 7E                                 LD      A,(HL)              ;
1827   06C5 21 20 1E                           LD      HL,T1E20            ; MSB's of screen ram for planets
1828   06C8 E6 1F                              AND     $1F                 ;
1829   06CA 85                                 ADD     A,L                 ;
1830   06CB 6F                                 LD      L,A                 ;
1831   06CC 56                                 LD      D,(HL)              ;
1832   06CD C6 20                              ADD     $20                 ;
1833   06CF 6F                                 LD      L,A                 ;
1834   06D0 5E                                 LD      E,(HL)              ;
1835   06D1 79                                 LD      A,C                 ;
1836   06D2 0F                                 RRCA                        ;
1837   06D3 0F                                 RRCA                        ;
1838   06D4 0F                                 RRCA                        ;
1839   06D5 E6 1E                              AND     $1E                 ;
1840   06D7 83                                 ADD     A,E                 ;
1841   06D8 C6 02                              ADD     $02                 ;
1842   06DA 5F                                 LD      E,A                 ;
1843   06DB 21 60 1E                           LD      HL,T1E60            ; LSB's of screen ram for planets
1844   06DE 78                                 LD      A,B                 ;
1845   06DF E6 1F                              AND     $1F                 ;
1846   06E1 85                                 ADD     A,L                 ;
1847   06E2 6F                                 LD      L,A                 ;
1848   06E3 6E                                 LD      L,(HL)              ;
1849   06E4 CD DC 07                           CALL    L07DC               ; draw the characters at background
1850   06E7 C9                                 RET                         ;
1851   06E8             
1852   06E8             ;*****************************************************************************
1853   06E8             ;* Print score column
1854   06E8             ;*****************************************************************************
1855   06E8             L06E8:
1856   06E8 21 00 18                           LD      HL,T1800            ; base addr. table for 'screen ram adresses and static texts'
1857   06EB 0E 01                              LD      C,$01               ; 1 column (rotated to 1 row)
1858   06ED C3 D0 01                           JP      PrintTextLines      ;
1859   06F0             
1860   06F0             ;*****************************************************************************
1861   06F0             ;* Update scroll register and fill background
1862   06F0             ;*****************************************************************************
1863   06F0             L06F0:
1864   06F0 CD 7A 06                           CALL    StarsScrollDown     ;
1865   06F3 CD 40 20                           CALL    AddGalaxiesToBackground
1866   06F6 C3 B0 06                           JP      AddPlanetsToBackground
1867   06F9             
1868   0700                                    .ORG $0700
1869   0700             ;*****************************************************************************
1870   0700             ;* Controller for player data structure.
1871   0700             ;* Handles: PlayerState, OldPlayerShipMSB, PlayerBulletState, PlayerBulletMSB, AbovePlayerBulletState, $43E8
1872   0700             ;*****************************************************************************
1873   0700             PlayerDataController:
1874   0700 01 C0 43                           LD      BC,PlayerState      ; Player data structure (grid)
1875   0703 11 E0 43                           LD      DE,OldPlayerShipMSB ; Player data structure (screen ram)
1876   0706             L0706:
1877   0706 CD 18 07                           CALL    UpdateScreenObjects ;
1878   0709 79                                 LD      A,C                 ;
1879   070A C6 04                              ADD     $04                 ;
1880   070C 4F                                 LD      C,A                 ;
1881   070D C6 20                              ADD     $20                 ;
1882   070F 5F                                 LD      E,A                 ;
1883   0710 50                                 LD      D,B                 ;
1884   0711 FE EC                              CP      $EC                 ;
1885   0713 C2 06 07                           JP      NZ,L0706            ; loop until $43EC
1886   0716 C9                                 RET                         ;
1887   0717             
1888   0718                                    .ORG $0718
1889   0718             ;*****************************************************************************
1890   0718             ;* Draw or delete screen objects dep. on control state of player, alien and bullet.
1891   0718             ;*****************************************************************************
1892   0718             UpdateScreenObjects:
1893   0718 CD 20 07                           CALL    Bit4Controller      ; for deleting screen objects
1894   071B C3 40 07                           JP      Bit3Controller      ; for drawing screen objects
1895   071E             
1896   0720                                    .ORG $0720
1897   0720             ;*****************************************************************************
1898   0720             ;* Handles the bit4 actions for deleting screen objects.
1899   0720             ;*****************************************************************************
1900   0720             Bit4Controller:
1901   0720 0A                                 LD      A,(BC)              ; get value from data structure (grid)
1902   0721 67                                 LD      H,A                 ; save the bits
1903   0722 E6 10                              AND     $10                 ; mask out 0001_0000 (bit4 of control state A)
1904   0724 C8                                 RET     Z                   ; ret if bit not set.
1905   0725 7C                                 LD      A,H                 ; restore the bits
1906   0726 E6 EF                              AND     $EF                 ; mask out 1110_1111
1907   0728 02                                 LD      (BC),A              ; save to control state A
1908   0729 07                                 RLCA                        ; Multiply by 8 ..
1909   072A 07                                 RLCA                        ; ..
1910   072B 07                                 RLCA                        ; ..
1911   072C E6 07                              AND     $07                 ; mask out 0000_0111
1912   072E C6 38                              ADD     $38                 ; add to base for jump table
1913   0730 6F                                 LD      L,A                 ;
1914   0731 26 07                              LD      H,T0735 >> 8        ; MSB for jump table
1915   0733 6E                                 LD      L,(HL)              ;
1916   0734 E9                                 JP      (HL)                ; jump to control function
1917   0735             
1918   0735             ; LSB jump table:
1919   0735             ;.....not used
1920   0735             ;........not used
1921   0735             ;...........not used
1922   0735             ;..............0763..................control state A: 0001_xxxx...Delete 1x1 screen objects.
1923   0735             ;.................0779...............control state A: 0011_xxxx...Delete 2x1 screen objects.
1924   0735             ;....................not used
1925   0735             ;.......................079E.........control state A: 0111_xxxx...Delete 1x2 screen objects.
1926   0735             ;..........................07BE......control state A: 1001_xxxx...Delete 2x2 screen objects.
1927   0735             T0735:
1928   0735 00 00 00 63                        .DB $00, $00, $00, L0763 & $FF, L0779 & $FF, $00, L079E & $FF, L07BE & $FF
1928   0739 79 00 9E BE 
1929   073D             
1930   0740                                    .ORG $0740
1931   0740             ;*****************************************************************************
1932   0740             ;* Handles the bit3 actions for drawing screen objects.
1933   0740             ;*****************************************************************************
1934   0740             Bit3Controller:
1935   0740 0A                                 LD      A,(BC)              ; get value from data structure (grid)
1936   0741 67                                 LD      H,A                 ; save it
1937   0742 E6 08                              AND     $08                 ; mask out 0000_1000 (bit3 of control state A)
1938   0744 C8                                 RET     Z                   ; ret if bit not set.
1939   0745 7C                                 LD      A,H                 ; restore the bits
1940   0746 E6 07                              AND     $07                 ; mask out 0000_0111
1941   0748 67                                 LD      H,A                 ; save it
1942   0749 0F                                 RRCA                        ; Divide by 8 ..
1943   074A 0F                                 RRCA                        ; ..
1944   074B 0F                                 RRCA                        ; ..
1945   074C B4                                 OR      H                   ; add original bits
1946   074D F6 18                              OR      $18                 ; set 0001_1000 flag
1947   074F 02                                 LD      (BC),A              ; set the bits at control state A
1948   0750 03                                 INC     BC                  ; go to control state B
1949   0751 7C                                 LD      A,H                 ;
1950   0752 C6 5B                              ADD     $5B                 ; add to base for jump table
1951   0754 6F                                 LD      L,A                 ;
1952   0755 26 07                              LD      H,T0759 >> 8        ; MSB for jump table
1953   0757 6E                                 LD      L,(HL)              ;
1954   0758 E9                                 JP      (HL)                ; jump to control function
1955   0759             
1956   0759             ; LSB jump table:
1957   0759             ;.....not used
1958   0759             ;........not used
1959   0759             ;...........076D.....................control state A: xxxx_1000...Draw 1x1 screen objects.
1960   0759             ;..............0788..................control state A: xxxx_1001...Draw 2x1 screen objects.
1961   0759             ;.................not used
1962   0759             ;....................07AA............control state A: xxxx_1011...Draw 1x2 screen objects.
1963   0759             ;.......................07D2.........control state A: xxxx_1100...Draw 2x2 screen objects.
1964   0759             ;..........................not used
1965   0759             T0759:
1966   0759 00 00 6D 88                        .DB $00, $00, L076D & $FF, L0788 & $FF, $00, L07AA & $FF, L07D2 & $FF
1966   075D 00 AA D2 
1967   0760             
1968   0763                                    .ORG $0763
1969   0763             ;*****************************************************************************
1970   0763             ;* Bit4 control function 63:
1971   0763             ;* If control state A: 0001_xxxx
1972   0763             ;* Delete 1x1 screen objects (bullet, alien).
1973   0763             ;*****************************************************************************
1974   0763             L0763:
1975   0763 EB                                 EX      DE,HL               ;
1976   0764 56                                 LD      D,(HL)              ; get screen ram adress MSB
1977   0765 23                                 INC     HL                  ;
1978   0766 5E                                 LD      E,(HL)              ; get screen ram adress LSB
1979   0767 2B                                 DEC     HL                  ; restore pointer
1980   0768 AF                                 XOR     A                   ; A=0
1981   0769 12                                 LD      (DE),A              ; delete at screen
1982   076A EB                                 EX      DE,HL               ;
1983   076B C9                                 RET                         ;
1984   076C             
1985   076D                                    .ORG $076D
1986   076D             ;*****************************************************************************
1987   076D             ;* Bit3 control function 6D:
1988   076D             ;* If control state A: xxxx_1000
1989   076D             ;* Set alien control state B value to screen ram.
1990   076D             ;* Draw 1x1 screen objects (used at 'fade in' animation).
1991   076D             ;*****************************************************************************
1992   076D             L076D:
1993   076D EB                                 EX      DE,HL               ;
1994   076E 23                                 INC     HL                  ;
1995   076F 23                                 INC     HL                  ;
1996   0770 56                                 LD      D,(HL)              ; get MSB screen ram adress of alien
1997   0771 23                                 INC     HL                  ;
1998   0772 5E                                 LD      E,(HL)              ; get LSB screen ram adress of alien
1999   0773 0A                                 LD      A,(BC)              ; get alien control state B
2000   0774 12                                 LD      (DE),A              ; set at screen ram
2001   0775 0B                                 DEC     BC                  ; move to alien control state A
2002   0776 C9                                 RET                         ;
2003   0777             
2004   0779                                    .ORG $0779
2005   0779             ;*****************************************************************************
2006   0779             ;* Bit4 control function 79:
2007   0779             ;* If control state A: 0011_xxxx
2008   0779             ;* Delete 2x1 screen objects (alien).
2009   0779             ;*****************************************************************************
2010   0779             L0779:
2011   0779 EB                                 EX      DE,HL               ;
2012   077A 56                                 LD      D,(HL)              ;
2013   077B 23                                 INC     HL                  ;
2014   077C 5E                                 LD      E,(HL)              ;
2015   077D 2B                                 DEC     HL                  ; restore pointer
2016   077E AF                                 XOR     A                   ; A=0
2017   077F 12                                 LD      (DE),A              ; delete at screen, left part
2018   0780 CD 17 02                           CALL    RightOneColumn      ; 
2019   0783 AF                                 XOR     A                   ; A=0
2020   0784 12                                 LD      (DE),A              ; delete at screen, right part
2021   0785 EB                                 EX      DE,HL               ;
2022   0786 C9                                 RET                         ;
2023   0787             
2024   0788                                    .ORG $0788
2025   0788             ;*****************************************************************************
2026   0788             ;* Bit3 control function 88:
2027   0788             ;* If control state A: xxxx_1001
2028   0788             ;* Map alien control state B to shape and draw it.
2029   0788             ;* Draw 2x1 screen objects (alien).
2030   0788             ;*****************************************************************************
2031   0788             L0788:
2032   0788 EB                                 EX      DE,HL               ;
2033   0789 23                                 INC     HL                  ;
2034   078A 23                                 INC     HL                  ;
2035   078B 56                                 LD      D,(HL)              ;
2036   078C 23                                 INC     HL                  ;
2037   078D 5E                                 LD      E,(HL)              ;
2038   078E 0A                                 LD      A,(BC)              ; get alien control state B
2039   078F 6F                                 LD      L,A                 ; as offset for...
2040   0790 26 14                              LD      H,T1420 >> 8        ; get alien character block shapes table
2041   0792 7E                                 LD      A,(HL)              ;
2042   0793 12                                 LD      (DE),A              ; draw alien character left part
2043   0794 23                                 INC     HL                  ; next character
2044   0795 CD 17 02                           CALL    RightOneColumn      ;
2045   0798 7E                                 LD      A,(HL)              ;
2046   0799 12                                 LD      (DE),A              ; draw alien character right part
2047   079A 0B                                 DEC     BC                  ;
2048   079B C9                                 RET                         ;
2049   079C             
2050   079E                                    .ORG $079E
2051   079E             ;*****************************************************************************
2052   079E             ;* Bit4 control function 9E:
2053   079E             ;* If control state A: 0111_xxxx
2054   079E             ;* Delete 1x2 screen objects (alien).
2055   079E             ;*****************************************************************************
2056   079E             L079E:
2057   079E EB                                 EX      DE,HL               ;
2058   079F 56                                 LD      D,(HL)              ; get MSB of screen ram
2059   07A0 23                                 INC     HL                  ;
2060   07A1 5E                                 LD      E,(HL)              ; get LSB of screen ram
2061   07A2 2B                                 DEC     HL                  ; restore pointer
2062   07A3 AF                                 XOR     A                   ; A=0
2063   07A4 12                                 LD      (DE),A              ; delete at screen, upper part
2064   07A5 13                                 INC     DE                  ;
2065   07A6 12                                 LD      (DE),A              ; delete at screen, lower part
2066   07A7 EB                                 EX      DE,HL               ;
2067   07A8 C9                                 RET                         ;
2068   07A9             
2069   07AA                                    .ORG $07AA
2070   07AA             ;*****************************************************************************
2071   07AA             ;* Bit3 control function AA:
2072   07AA             ;* If control state A: xxxx_1011
2073   07AA             ;* Draw 1x2 screen objects (alien).
2074   07AA             ;*****************************************************************************
2075   07AA             L07AA:
2076   07AA EB                                 EX      DE,HL               ;
2077   07AB 23                                 INC     HL                  ;
2078   07AC 23                                 INC     HL                  ;
2079   07AD 56                                 LD      D,(HL)              ;
2080   07AE 23                                 INC     HL                  ;
2081   07AF 5E                                 LD      E,(HL)              ;
2082   07B0 0A                                 LD      A,(BC)              ;
2083   07B1 6F                                 LD      L,A                 ;
2084   07B2 26 14                              LD      H,T1420 >> 8        ; get alien character block shapes table
2085   07B4 7E                                 LD      A,(HL)              ;
2086   07B5 12                                 LD      (DE),A              ; draw upper part on screen
2087   07B6 23                                 INC     HL                  ;
2088   07B7 13                                 INC     DE                  ;
2089   07B8 7E                                 LD      A,(HL)              ;
2090   07B9 12                                 LD      (DE),A              ; draw lower part on screen
2091   07BA 0B                                 DEC     BC                  ;
2092   07BB C9                                 RET                         ;
2093   07BC             
2094   07BE                                    .ORG $07BE
2095   07BE             ;*****************************************************************************
2096   07BE             ;* Bit4 control function BE:
2097   07BE             ;* If control state A: 1001_xxxx
2098   07BE             ;* Delete 2x2 screen objects (player ship, alien).
2099   07BE             ;*****************************************************************************
2100   07BE             L07BE:
2101   07BE EB                                 EX      DE,HL               ;
2102   07BF 56                                 LD      D,(HL)              ;
2103   07C0 23                                 INC     HL                  ;
2104   07C1 5E                                 LD      E,(HL)              ;
2105   07C2 2B                                 DEC     HL                  ;
2106   07C3 AF                                 XOR     A                   ; A=0
2107   07C4 12                                 LD      (DE),A              ; delete upper left part
2108   07C5 13                                 INC     DE                  ;
2109   07C6 12                                 LD      (DE),A              ; delete upper right part
2110   07C7 CD 17 02                           CALL    RightOneColumn      ;
2111   07CA AF                                 XOR     A                   ; A=0
2112   07CB 12                                 LD      (DE),A              ; delete lower left part
2113   07CC 1B                                 DEC     DE                  ;
2114   07CD 12                                 LD      (DE),A              ; delete lower right part
2115   07CE EB                                 EX      DE,HL               ;
2116   07CF C9                                 RET                         ;
2117   07D0             
2118   07D2                                    .ORG $07D2
2119   07D2             ;*****************************************************************************
2120   07D2             ;* Bit3 control function D2:
2121   07D2             ;* If control state A: xxxx_1100
2122   07D2             ;* Draw 2x2 screen objects (player ship, alien, planets).
2123   07D2             ;*****************************************************************************
2124   07D2             L07D2:
2125   07D2 EB                                 EX      DE,HL               ;
2126   07D3 23                                 INC     HL                  ;
2127   07D4 23                                 INC     HL                  ;
2128   07D5 56                                 LD      D,(HL)              ; get MSB from player data structure (screen ram)
2129   07D6 23                                 INC     HL                  ;
2130   07D7 5E                                 LD      E,(HL)              ; get LSB from player data structure (screen ram)
2131   07D8 0A                                 LD      A,(BC)              ; get value from player data structure (grid)
2132   07D9 6F                                 LD      L,A                 ;
2133   07DA 26 14                              LD      H,T1400 >> 8        ; get player ship character block shapes table
2134   07DC             L07DC:
2135   07DC 7E                                 LD      A,(HL)              ; Entry point for general draw
2136   07DD 12                                 LD      (DE),A              ; draw upper left part
2137   07DE 23                                 INC     HL                  ;
2138   07DF 13                                 INC     DE                  ;
2139   07E0 7E                                 LD      A,(HL)              ;
2140   07E1 12                                 LD      (DE),A              ; draw upper right part
2141   07E2 23                                 INC     HL                  ;
2142   07E3 1B                                 DEC     DE                  ;
2143   07E4 CD 17 02                           CALL    RightOneColumn      ;
2144   07E7 7E                                 LD      A,(HL)              ;
2145   07E8 12                                 LD      (DE),A              ; draw lower left part
2146   07E9 23                                 INC     HL                  ;
2147   07EA 13                                 INC     DE                  ;
2148   07EB 7E                                 LD      A,(HL)              ;
2149   07EC 12                                 LD      (DE),A              ; draw lower right part
2150   07ED 0B                                 DEC     BC                  ;
2151   07EE C9                                 RET                         ;
2152   07EF             
2153   07F0                                    .ORG $07F0
2154   07F0             ;*****************************************************************************
2155   07F0             ;* Reset scroll register for background at score flash
2156   07F0             ;*****************************************************************************
2157   07F0             L07F0:
2158   07F0 3A B9 43                           LD      A,(CounterB9)       ;
2159   07F3 32 00 58                           LD      (scrollRegister),A  ; 58xx scroll register
2160   07F6 CD 80 03                           CALL    ClearForeground     ;
2161   07F9 C3 1E 04                           JP      SetBitsVideoRegister
2162   07FC             
2163   07FC             ;*****************************************************************************
2164   07FC             ; ic46
2165   07FC             ;*****************************************************************************
2166   0800                                    .ORG $0800
2167   0800             ;*****************************************************************************
2168   0800             ;* Game state 3.
2169   0800             ;* Normal game play.
2170   0800             ;*****************************************************************************
2171   0800             L0800:
2172   0800 21 14 08                           LD      HL,T0814            ;
2173   0803 3A B8 43                           LD      A,(LevelAndRound)   ; bit0 - 3: game level, bit4 - 7: game round
2174   0806 07                                 RLCA                        ; Multiply by 2 to get a 2 byte offset
2175   0807 E6 1E                              AND     $1E                 ; mask out 0001_1110 game level
2176   0809 85                                 ADD     A,L                 ; add offset ...
2177   080A 6F                                 LD      L,A                 ; ... to base of table
2178   080B 7E                                 LD      A,(HL)              ; MSB of destination
2179   080C 2C                                 INC     L                   ; Get the
2180   080D 6E                                 LD      L,(HL)              ; ... LSB of destination
2181   080E 67                                 LD      H,A                 ; Now point to function
2182   080F E9                                 JP      (HL)                ; jump to corresponding function according to LevelAndRound.
2183   0810             
2184   0814                                    .ORG $0814
2185   0814             T0814:
2186   0814                                    .MSFIRST
2187   0814 08 34                              .DW L0834       ;Game level 0: called for each frame during stars scrolling down and 'aliens fade in'
2188   0816 20 00                              .DW L2000       ;Game level 1: called for each frame during 'player alife' with aliens, after 'fade in'
2189   0818 08 34                              .DW L0834       ;Game level 2: called for each frame during stars scrolling down and 'aliens fade in'
2190   081A 20 00                              .DW L2000       ;Game level 3: called for each frame during 'player alife' with aliens, after 'fade in'
2191   081C 22 30                              .DW L2230       ;Game level 4: called for each frame during 'spiral fill'
2192   081E 34 00                              .DW L3400       ;Game level 5: called for each frame during birds level including 'fade in'
2193   0820 22 30                              .DW L2230       ;Game level 6: called for each frame during 'spiral fill'
2194   0822 34 00                              .DW L3400       ;Game level 7: called for each frame during birds level including 'fade in'
2195   0824 22 30                              .DW L2230       ;Game level 8: called for each frame during 'spiral fill'
2196   0826 22 B4                              .DW L22B4       ;Game level 9: called for each frame during mothership 'fade in'
2197   0828 22 CA                              .DW L22CA       ;Game level A: called for each frame during mothership and aliens 'fade in'
2198   082A 20 00                              .DW L2000       ;Game level B: called for each frame during 'player alife' with aliens and mothership, after 'fade in'
2199   082C             
2200   0834                                    .ORG $0834
2201   0834             ;*****************************************************************************
2202   0834             ;* Game level 0 and 2:
2203   0834             ;* Stars scrolling down and 'aliens fade in'
2204   0834             ;*****************************************************************************
2205   0834             L0834:
2206   0834 CD F0 06                           CALL    L06F0               ; update scroll register and fill background
2207   0837 21 B4 43                           LD      HL,CounterB4        ; 
2208   083A 35                                 DEC     (HL)                ; decrement the counter
2209   083B 7E                                 LD      A,(HL)              ;
2210   083C FE 15                              CP      $15                 ;
2211   083E D0                                 RET     NC                  ;
2212   083F CD 5A 08                           CALL    GetAnimationChrs    ; for 'aliens fade in'
2213   0842 CD FA 05                           CALL    L05FA               ; init all alien control states
2214   0845 CD 50 0A                           CALL    AlienDataController ;
2215   0848             L0848:
2216   0848 21 B4 43                           LD      HL,CounterB4        ;
2217   084B 7E                                 LD      A,(HL)              ;
2218   084C A7                                 AND     A                   ; updates the zero flag
2219   084D C0                                 RET     NZ                  ; if CounterB4 is 0.
2220   084E 2E B8                              LD      L,$B8               ;
2221   0850 34                                 INC     (HL)                ; increment game level $43B8
2222   0851 2E A4                              LD      L,$A4               ; Next interval game state ...
2223   0853 36 02                              LD      (HL),$02            ; .. is 2
2224   0855 C9                                 RET                         ;
2225   0856             
2226   085A                                    .ORG $085A
2227   085A             ;*****************************************************************************
2228   085A             ;* The 'aliens fade in' animation sequence is:
2229   085A             ;* 6C, 6D, 6E, 6F, 68, from foreground tiles.
2230   085A             ;*****************************************************************************
2231   085A             GetAnimationChrs:
2232   085A 11 6C 08                           LD      DE,$086C            ;
2233   085D FE 11                              CP      $11                 ;
2234   085F D0                                 RET     NC                  ;
2235   0860 1E 6D                              LD      E,$6D               ;
2236   0862 FE 0D                              CP      $0D                 ;
2237   0864 D0                                 RET     NC                  ;
2238   0865 1E 6E                              LD      E,$6E               ;
2239   0867 FE 09                              CP      $09                 ;
2240   0869 D0                                 RET     NC                  ;
2241   086A 1E 6F                              LD      E,$6F               ;
2242   086C FE 05                              CP      $05                 ;
2243   086E D0                                 RET     NC                  ;
2244   086F 1E 68                              LD      E,$68               ;
2245   0871 C9                                 RET                         ;
