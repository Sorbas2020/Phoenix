6488   27A8             UpdateSoundControlHW:
6489   27A8 21 8C 43                           LD      HL,SoundControlA    ; ..
6490   27AB 7E                                 LD      A,(HL)              ; .. to
6491   27AC 32 00 60                           LD      (SOUNDCTLA),A       ; 60xx sound A
6492   27AF 2C                                 INC     L                   ; SoundControlB ..
6493   27B0 7E                                 LD      A,(HL)              ; .. to
6494   27B1 32 00 68                           LD      (SOUNDCTLB),A       ; 68xx sound B
6495   27B4 F6 0F                              OR      $0F                 ; 0000_1111
6496   27B6 77                                 LD      (HL),A              ;
6497   27B7 2D                                 DEC     L                   ;
6498   27B8 36 0F                              LD      (HL),$0F            ; 0000_1111
6499   27BA C9                                 RET                         ;
