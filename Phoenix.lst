1438   04A0                                    .ORG $04A0
1439   04A0             ;*****************************************************************************
1440   04A0             ;* Changing the player at attract mode.
1441   04A0             ;*****************************************************************************
1442   04A0             L04A0:
1443   04A0 2E A3                              LD      L,$A3               ; set GameAndDemoOrSplash
1444   04A2 36 01                              LD      (HL),$01            ; to 'Game for player 2'
1445   04A4 01 01 00                           LD      BC,$0001            ; from bank 0 to bank 1
1446   04A7 CD 60 04                           CALL    CopyMemoryBank      ; to toggle the player
1447   04AA C9                                 RET                         ;
1448   04AB             
1449   04AC                                    .ORG $04AC
1450   04AC             ;*****************************************************************************
1451   04AC             ;* Game state 1.
1452   04AC             ;* Flashing of score1 or 2.
1453   04AC             ;*****************************************************************************
1454   04AC             L04AC:
1455   04AC 21 A5 43                           LD      HL,CounterA5        ;
1456   04AF 35                                 DEC     (HL)                ; decrement counter
1457   04B0 7E                                 LD      A,(HL)              ; save value
1458   04B1 2D                                 DEC     L                   ; HL=A3A4 next game state ..
1459   04B2 36 02                              LD      (HL),$02            ; .. is 2
1460   04B4 A7                                 AND     A                   ; ret if ..
1461   04B5 C8                                 RET     Z                   ; counter 0
1462   04B6 36 01                              LD      (HL),$01            ; set game state to 1
1463   04B8 FE 7F                              CP      $7F                 ; 0111_1111
1464   04BA CA F0 07                           JP      Z,L07F0             ;
1465   04BD 2E 9A                              LD      L,$9A               ;
1466   04BF 36 00                              LD      (HL),$00            ; reset Counter9A MSB
1467   04C1 2C                                 INC     L                   ; and ..
1468   04C2 36 00                              LD      (HL),$00            ; LSB
1469   04C4 E6 08                              AND     $08                 ; 0000_1000
1470   04C6 C2 E6 04                           JP      NZ,L04E6            ;
1471   04C9 CD E8 06                           CALL    L06E8               ;
1472   04CC 00                                 NOP                         ;
1473   04CD 21 A3 43                           LD      HL,GameAndDemoOrSplash
1474   04D0 7E                                 LD      A,(HL)              ;
1475   04D1 A7                                 AND     A                   ; updates the zero flag
1476   04D2 2E 83                              LD      L,$83               ; LSB of Score1low adress
1477   04D4 11 61 42                           LD      DE,$4261            ; screen ram addr. of lowest score digit player 1
1478   04D7 CA DF 04                           JP      Z,L04DF             ; 
1479   04DA 2E 87                              LD      L,$87               ; LSB of Score2low adress
1480   04DC 11 21 40                           LD      DE,$4021            ; screen ram addr. of lowest score digit player 2
1481   04DF             L04DF:
1482   04DF 06 06                              LD      B,$06               ; number of digits to print
1483   04E1 CD C4 00                           CALL    PrintNumber         ;
1484   04E4 C9                                 RET                         ;
1485   04E5             
1486   04E6                                    .ORG $04E6
1487   04E6             L04E6:
1488   04E6 21 A3 43                           LD      HL,GameAndDemoOrSplash
1489   04E9 7E                                 LD      A,(HL)              ;
1490   04EA A7                                 AND     A                   ; updates the zero flag
1491   04EB 11 61 42                           LD      DE,$4261            ; screen ram addr. of lowest score digit player 1
1492   04EE CA F4 04                           JP      Z,L04F4             ;
1493   04F1 11 21 40                           LD      DE,$4021            ; screen ram addr. of lowest score digit player 2
1494   04F4             L04F4:
1495   04F4 06 06                              LD      B,$06               ; number of digits to delete
1496   04F6 CD FB 04                           CALL    L04FB               ;
1497   04F9 C9                                 RET                         ;
1498   04FA             
1499   04FB                                    .ORG $04FB
1500   04FB             L04FB:
1501   04FB 3E 00                              LD      A,$00               ; delete ..
1502   04FD 12                                 LD      (DE),A              ; ..one digit
1503   04FE CD 10 02                           CALL    LeftOneColumn       ;
1504   0501 05                                 DEC     B                   ; decrement number of digits
1505   0502 C2 FB 04                           JP      NZ,L04FB            ; ..until
1506   0505 C9                                 RET                         ; ..done
1507   0506             
1508   0506             ;*****************************************************************************
