3007   0CC4             ;*****************************************************************************
3008   0CC4             ;* The player ship was hit.
3009   0CC4             ;* MAME cheat code "Invincibility": Set $0CC4 to $C9 (RET).
3010   0CC4             ;*****************************************************************************
3011   0CC4             L0CC4:
3012   0CC4 3E 04                              LD      A,$04               ; Next interval game state is 4 (player ship partikel explosion)
3013   0CC6 32 A4 43                           LD      (GameState),A       ; 
3014   0CC9 3E 60                              LD      A,$60               ; set a new counter value for ...
3015   0CCB 32 A5 43                           LD      (CounterA5),A       ; 
3016   0CCE 3E 10                              LD      A,$10               ; set flag and counter for ..
3017   0CD0 32 63 43                           LD      (ParticleExplosion),A
3018   0CD3 C9                                 RET                         ;
3019   0CD4             
