8801   3B3A E6 08                              AND     $08                 
8802   3B3C F6 07                              OR      $07                 
8803   3B3E 2E 8D                              LD      L,$8D               
8804   3B40 77                                 LD      (HL),A              
8805   3B41 C9                                 RET                         
