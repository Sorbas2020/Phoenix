1624   05D8             ;*****************************************************************************
1625   05D8             ;* Clears B memories starting at HL.
1626   05D8             ;*****************************************************************************
1627   05D8             ClearBbytesAtHL:
1628   05D8 AF                                 XOR     A                   ; A=0
1629   05D9             L05D9:
1630   05D9 77                                 LD      (HL),A              ; store
1631   05DA 23                                 INC     HL                  ; next
1632   05DB 05                                 DEC     B                   ; decrease counter.
1633   05DC C2 D9 05                           JP      NZ,L05D9            ;
1634   05DF C9                                 RET                         ;
1635   05E0             
1636   05E0             ;*****************************************************************************
1637   05E0             ;* Copy number of bytes (B register) from DE to HL.
1638   05E0             ;*****************************************************************************
1639   05E0             CopyBbytesHLtoDE:
1640   05E0 7E                                 LD      A,(HL)              ; Copy to HL ...
1641   05E1 12                                 LD      (DE),A              ; ... from DE
1642   05E2 23                                 INC     HL                  ; Next destination
1643   05E3 13                                 INC     DE                  ; Next source
1644   05E4 05                                 DEC     B                   ; All done?
1645   05E5 C2 E0 05                           JP      NZ,CopyBbytesHLtoDE ; no ... keep going
1646   05E8 C9                                 RET                         ; Out
1647   05E9             
1648   05EC                                    .ORG $05EC
1649   05EC             ;*****************************************************************************
1650   05EC             ;* Init all alien control states for a given level and round.
1651   05EC             ;*****************************************************************************
1652   05EC             InitAlienControlStates:
1653   05EC 21 00 15                           LD      HL,T1500            ;
1654   05EF 3A B8 43                           LD      A,(LevelAndRound)   ;
1655   05F2 E6 0F                              AND     $0F                 ;
1656   05F4 07                                 RLCA                        ; Multiply by 2
1657   05F5 85                                 ADD     A,L                 ;
1658   05F6 6F                                 LD      L,A                 ;
1659   05F7 56                                 LD      D,(HL)              ;
1660   05F8 23                                 INC     HL                  ;
1661   05F9 5E                                 LD      E,(HL)              ;
1662   05FA             ;
1663   05FA             L05FA:
1664   05FA 21 70 4B                           LD      HL,M4B70            ;
1665   05FD 3A BA 43                           LD      A,(AliensLeft)      ;
1666   0600 47                                 LD      B,A                 ;
1667   0601 A7                                 AND     A                   ; updates the zero flag
1668   0602 C8                                 RET     Z                   ; if no AliensLeft
1669   0603             ;
1670   0603             L0603:
1671   0603 72                                 LD      (HL),D              ; set control state A
1672   0604 2C                                 INC     L                   ;
1673   0605 73                                 LD      (HL),E              ; set control state B
1674   0606 2C                                 INC     L                   ;
1675   0607 2C                                 INC     L                   ;
1676   0608 2C                                 INC     L                   ;
1677   0609 05                                 DEC     B                   ; number of aliens left
1678   060A C2 03 06                           JP      NZ,L0603            ;
1679   060D C9                                 RET                         ;
1680   060E             
1681   0610                                    .ORG $0610
1682   0610             ;*****************************************************************************
1683   0610             ;* Load alien screen coordinates for a given level and round to $4B70 - $4BAF.
