2058   079E             ;* Delete 1x2 screen objects (alien).
2059   079E             ;*****************************************************************************
2060   079E             L079E:
2061   079E EB                                 EX      DE,HL               ;
2062   079F 56                                 LD      D,(HL)              ; get MSB of screen ram
2063   07A0 23                                 INC     HL                  ;
2064   07A1 5E                                 LD      E,(HL)              ; get LSB of screen ram
2065   07A2 2B                                 DEC     HL                  ; restore pointer
2066   07A3 AF                                 XOR     A                   ; A=0
2067   07A4 12                                 LD      (DE),A              ; delete at screen, upper part
2068   07A5 13                                 INC     DE                  ;
2069   07A6 12                                 LD      (DE),A              ; delete at screen, lower part
2070   07A7 EB                                 EX      DE,HL               ;
2071   07A8 C9                                 RET                         ;
