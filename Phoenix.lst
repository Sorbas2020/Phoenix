3353   0E8B C2 7E 0E                           JP      NZ,L0E7E            ; 
3354   0E8E C9                                 RET                         
3355   0E8F             
3356   0E90                                    .ORG $0E90
3357   0E90             ;
3358   0E90             L0E90:
3359   0E90 7E                                 LD      A,(HL)              
3360   0E91 C6 02                              ADD     $02                 
3361   0E93 BA                                 CP      D                   
3362   0E94 D8                                 RET     C                   
3363   0E95 D6 05                              SUB     $05                 
3364   0E97 BA                                 CP      D                   
3365   0E98 D0                                 RET     NC                  
3366   0E99 23                                 INC     HL                  
3367   0E9A 7E                                 LD      A,(HL)              
3368   0E9B 2B                                 DEC     HL                  
3369   0E9C E6 F8                              AND     $F8                 
3370   0E9E BB                                 CP      E                   
3371   0E9F C0                                 RET     NZ                  
