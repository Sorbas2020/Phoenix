3021   0CD8             ;*****************************************************************************
3022   0CD8             ;* Handle enemy bullet control states for 5 bullet slots,
3023   0CD8             ;* and draw or delete the screen object.
3024   0CD8             ;*****************************************************************************
3025   0CD8             L0CD8:
3026   0CD8 01 CC 43                           LD      BC,AlienBullet0State; data structure (grid)
3027   0CDB 11 EC 43                           LD      DE,OldAlienBullet0MSB; screen ram
3028   0CDE             L0CDE:
3029   0CDE C5                                 PUSH    BC                  ; 
3030   0CDF CD 18 07                           CALL    UpdateScreenObjects ; 
3031   0CE2 C1                                 POP     BC                  ; 
3032   0CE3 79                                 LD      A,C                 ; 
3033   0CE4 C6 04                              ADD     $04                 ; 
3034   0CE6 4F                                 LD      C,A                 ; 
3035   0CE7 C6 20                              ADD     $20                 ; 
3036   0CE9 5F                                 LD      E,A                 ; 
3037   0CEA 50                                 LD      D,B                 ; 
3038   0CEB A7                                 AND     A                   ; updates the zero flag
3039   0CEC C2 DE 0C                           JP      NZ,L0CDE            ; loop for all bullet slots
3040   0CEF C9                                 RET                         ; 
3041   0CF0             
3042   0CF4                                    .ORG $0CF4
3043   0CF4             ;*****************************************************************************
3044   0CF4             ;* Alien collision on left or right side of player ship.
