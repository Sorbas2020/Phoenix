8530   3A00             ;*****************************************************************************
8531   3A00             ;* Frame gate + danger-window width:
8532   3A00             ;* Returns D = half-width of the player "danger" window
8533   3A00             ;* (wider when fewer birds remain -> more aggressive bombing).
8534   3A00             ;* On alternate frames, pops L3930's return address so the
8535   3A00             ;* whole bomb scan is skipped this frame (throttles bombing).
8536   3A00             ;* The `POP HL` / `RET` trick at `$3A0E` is the key detail:
8537   3A00             ;* when the gate "fails", it removes `L3930`'s own continuation (`$3942`)
8538   3A00             ;* from the stack and returns one level higher, so on those frames `L3930`
8539   3A00             ;* performs no bomb-drop scan at all.
8540   3A00             ;*****************************************************************************
8541   3A00             L3A00:
8542   3A00 3A BB 43                           LD      A,(BirdsLeft)       ; 
8543   3A03 D6 0C                              SUB     $0C                 
8544   3A05 2F                                 CPL                         
8545   3A06 3C                                 INC     A                   
8546   3A07 57                                 LD      D,A                 
8547   3A08 3A 9B 43                           LD      A,(Counter9A+$1)    ; 
8548   3A0B 0F                                 RRCA                        
8549   3A0C 0F                                 RRCA                        
8550   3A0D D8                                 RET     C                   
8551   3A0E E1                                 POP     HL                  
8552   3A0F C9                                 RET                         
8553   3A10             
