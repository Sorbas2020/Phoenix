1880   0706             L0706:
1881   0706 CD 18 07                           CALL    UpdateScreenObjects ;
1882   0709 79                                 LD      A,C                 ;
1883   070A C6 04                              ADD     $04                 ;
1884   070C 4F                                 LD      C,A                 ;
1885   070D C6 20                              ADD     $20                 ;
1886   070F 5F                                 LD      E,A                 ;
1887   0710 50                                 LD      D,B                 ;
1888   0711 FE EC                              CP      $EC                 ;
1889   0713 C2 06 07                           JP      NZ,L0706            ; loop until $43EC
1890   0716 C9                                 RET                         ;
