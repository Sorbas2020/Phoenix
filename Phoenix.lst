4835   1EE0             ;*****************************************************************************
4836   1EE0             ;* Copyright-notice integrity check:
4837   1EE0             ;* It runs only in attract mode, as the tail of the intro bird animation.
4838   1EE0             ;* It sums the 26 characters of the on-screen line “` AMSTAR ELECTRONICS CORP. `”,
4839   1EE0             ;* adds a tuned constant, and adds the result into `HiScorehigh`.
4840   1EE0             ;* With unmodified ROM the total wraps to exactly `$00`, so the hi-score is left untouched.
4841   1EE0             ;* Change the copyright text and the hi-score gets corrupted.
4842   1EE0             ;* If a bootleg patches the copyright string — or the line is otherwise not intact when this runs,
4843   1EE0             ;* the sum no longer cancels and the delta is added to `HiScorehigh` on every frame of the bird intro.
4844   1EE0             ;* Since scores are BCD, that immediately produces garbage in the `HI-SCORE` display.
4845   1EE0             ;* A quiet, non-obvious tamper trap rather than an outright refusal to boot.
4846   1EE0             ;* The arithmetic
4847   1EE0             ;* | Term                                                           | Value               |
4848   1EE0             ;* |----------------------------------------------------------------|---------------------|
4849   1EE0             ;* | Sum of the 26 text codes (`$121`, truncated to 8 bits)         | `$21`               |
4850   1EE0             ;* | ROM byte at `$3FFD` (last byte of the `T3FC0` bird-init block) | `$B8`               |
4851   1EE0             ;* | Constant added at `$1EF2`                                      | `$27`               |
4852   1EE0             ;* | Total                                                          | `$100` -> **`$00`** |
4853   1EE0             ;*****************************************************************************
4854   1EE0             L1EE0:
4855   1EE0 11 3D 43                           LD      DE,ForegroundScreen+$33D ; screen: start of the AMSTAR line
4856   1EE3 01 1A 00                           LD      BC,$001A            ; B = 0 (accumulator), C = 26
4857   1EE6             L1EE6:
4858   1EE6 1A                                 LD      A,(DE)              ; read one character from screen
4859   1EE7 80                                 ADD     A,B                 ; accumulate
4860   1EE8 47                                 LD      B,A                 ; 
4861   1EE9 CD 17 02                           CALL    RightOneColumn      ; DE -= 32
4862   1EEC 0D                                 DEC     C                   ; 
4863   1EED C2 E6 1E                           JP      NZ,L1EE6            ; 
4864   1EF0 1A                                 LD      A,(DE)              ; 27th read -> $3FFD (ROM!)
4865   1EF1 80                                 ADD     A,B                 ; 
4866   1EF2 C6 27                              ADD     $27                 ; magic constant
4867   1EF4 21 89 43                           LD      HL,HiScorehigh      ; 
4868   1EF7 86                                 ADD     A,(HL)              ; 
4869   1EF8 77                                 LD      (HL),A              ; 
4870   1EF9 00                                 NOP                         ; 
4871   1EFA C9                                 RET                         ; 
4872   1EFB             
