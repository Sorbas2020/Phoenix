0001   0000             ;*****************************************************************************
0002   0000             ;*                                                                           *
0003   0000             ;* PHOENIX (AMSTAR, SET 1).  Amstar Electronics Corp. 1980                   *
0004   0000             ;*                                                                           *
0005   0000             ;*****************************************************************************
0006   0000             ;* This code refers to the "maincpu" section of the ROM region from ROM set. *
0007   0000             ;*                                                                           *
0008   0000             ;* ROM region offsets:                                                       *
0009   0000             ;*  ic45        $0000-$07FF                                                  *
0010   0000             ;*  ic46        $0800-$0FFF                                                  *
0011   0000             ;*  ic47        $1000-$17FF                                                  *
0012   0000             ;*  ic48        $1800-$1FFF                                                  *
0013   0000             ;*  h5-ic49.5a  $2000-$27FF                                                  *
0014   0000             ;*  h6-ic50.6a  $2800-$2FFF                                                  *
0015   0000             ;*  h7-ic51.7a  $3000-$37FF                                                  *
0016   0000             ;*  h8-ic52.8a  $3800-$3FFF                                                  *
0017   0000             ;*****************************************************************************
0018   0000             ;* 20250330                                                                  *
0019   0000             ;* Skipped all unused code and data.                                         *
0020   0000             ;* All code and data at original offsets.                                    *
0021   0000             ;* Assembled with 'Micro Z80 assembler - uz80as' (v2.02).                    *
0022   0000             ;* https://github.com/jorgicor/uz80as                                        *
0023   0000             ;* Usage:                                                                    *
0024   0000             ;* uz80as.exe -x Phoenix.asm                                                 *
0025   0000             ;*****************************************************************************
0026   0000             
0027   0000             ; ForegroundScreen.
0028   0000             ForegroundScreen       .EQU $4000       ;32*26 bytes for the foreground screen
0029   0000             
0030   0000             ; General storage.
0031   0000             ; Alien-formation attack controller data:
0032   0000             ; Drives when and how aliens break out of the base formation to fly their "closed loop" swooping attack patterns.
0033   0000             ; The whole structure (`$4350`–`$437F`) is zeroed at level init by the routine at `$32B0`,
0034   0000             ; and it's serviced every frame by a 7 way state machine dispatched through the jump table `T3018` (indexed by `Counter93`),
0035   0000             ; with each handler reading/updating the behavior state in `$4350`.
0036   0000             M4350                  .EQU $4350       ;Alien behavior state (the state-machine variable, values 0–6)
0037   0000             M4351                  .EQU $4351       ;MSB of next closed loop pattern (into the `T2Exx` / `T3330` pattern tables)
0038   0000             M4352                  .EQU $4352       ;LSB of next closed loop pattern (into the `T2Exx` / `T3330` pattern tables)
0039   0000             M4353                  .EQU $4353       ;Number of aliens doing the closed loop pattern (how many attackers)
0040   0000             M4354                  .EQU $4354       ;LSB pointer to the currently selected lead attacking alien (`$4B50`/`$4B72` grid slot)
0041   0000             M4355                  .EQU $4355       ;Delay counter before the next attack is armed (→ behavior state 1)
0042   0000             M4356                  .EQU $4356       ;Rotating 0–15 "movement start" index (from `$4395`) used to sync aliens
0043   0000             M4357                  .EQU $4357       ;Attack-cycle/escalation counter (0–3); scales attacker count and difficulty
0044   0000             M4358                  .EQU $4358       ;Inter-step timer for the angry downward-push movement pattern
0045   0000             M4359                  .EQU $4359       ;Staggered group countdown timer 1 for phased alien launches
0046   0000             M435A                  .EQU $435A       ;Staggered group countdown timer 2 for phased alien launches
0047   0000             M435B                  .EQU $435B       ;Staggered group countdown timer 3 for phased alien launches
0048   0000             
0049   0000             ; Flags and counter:
0050   0000             M435E                  .EQU $435E       ;Flag for: 'AliensLeft < 5' ($FF)
0051   0000             M435F                  .EQU $435F       ;8 bit counter for alien movement
0052   0000             PlayerMoved            .EQU $4360       ;Flag for: 'Player moved' ($FF)
0053   0000             BulletTriggered        .EQU $4361       ;Flag for: 'Bullet triggered' ($30) and counter
0054   0000             M4362                  .EQU $4362       ;Flag for: 'Player shield active' and animation counter
0055   0000             ParticleExplosion      .EQU $4363       ;Flag for: 'Particle explosion start' and animation counter
0056   0000             M4364                  .EQU $4364       ;Flag for: 'Enemy hit detected' ($FF) and counter
0057   0000             
0058   0000             M4366                  .EQU $4366       ;Flag for: 'Mothership or bird wing hit detected' ($FF)
0059   0000             M4367                  .EQU $4367       ;Flag for: 'Mothership partially faded in' ($FF)
0060   0000             M4368                  .EQU $4368       ;Maturity of the birds. From 'egg' over 'no wings' to 'adult' ($01 to $0F)
0061   0000             M4369                  .EQU $4369       ;Flag for: 'Bonus explosion' ($FF)
0062   0000             M436A                  .EQU $436A       ;Flag for: 'Bonus live added' ($FF) and counter
0063   0000             M436B                  .EQU $436B       ;Flag for: 'Mother ship score display' ($FF) and counter
0064   0000             
0065   0000             ; Shape of the next bird attack:
0066   0000             ; All three are recomputed by `L3560` each time a new bird group is dispatched.
0067   0000             M436D                  .EQU $436D       ;Horizontal start position of the bird group
0068   0000             M436E                  .EQU $436E       ;Bird count / formation-size for the wave
0069   0000             M436F                  .EQU $436F       ;Per-wave random variation seed (keeps successive waves from being identical)
0070   0000             
0071   0000             ;Explosion slots for animation:
0072   0000             M4370                  .EQU $4370       ;Explosion slot0 animation index
0073   0000             M4371                  .EQU $4371       ;Explosion slot0 BCD score value (last digit is ever 0)
0074   0000             M4372                  .EQU $4372       ;Explosion slot0 MSB screen ram
0075   0000             M4373                  .EQU $4373       ;Explosion slot0 LSB screen ram
0076   0000             M4374                  .EQU $4374       ;Explosion slot1 animation index
0077   0000             M4375                  .EQU $4375       ;Explosion slot1 BCD score value (last digit is ever 0)
0078   0000             M4376                  .EQU $4376       ;Explosion slot1 MSB screen ram
0079   0000             M4377                  .EQU $4377       ;Explosion slot1 LSB screen ram
0080   0000             M4378                  .EQU $4378       ;Bonus explosion slot0 animation index
0081   0000             M4379                  .EQU $4379       ;Bonus explosion slot0 BCD score value (last digit is ever 0)
0082   0000             M437A                  .EQU $437A       ;Bonus explosion slot0 MSB screen ram
0083   0000             M437B                  .EQU $437B       ;Bonus explosion slot0 LSB screen ram
0084   0000             M437C                  .EQU $437C       ;Bonus explosion slot1 animation index
0085   0000             M437D                  .EQU $437D       ;Bonus explosion slot1 BCD score value (last digit is ever 0)
0086   0000             M437E                  .EQU $437E       ;Bonus explosion slot1 MSB screen ram
0087   0000             M437F                  .EQU $437F       ;Bonus explosion slot1 LSB screen ram
0088   0000             
0089   0000             ;For the score:
0090   0000             M4380                  .EQU $4380       ;Ever set to 0 (prevents overflow)
0091   0000             Score1high             .EQU $4381       ;Player 1 score BCD (high)
0092   0000             Score1mid              .EQU $4382       ;Player 1 score BCD (mid)
0093   0000             Score1low              .EQU $4383       ;Player 1 score BCD (low)
0094   0000             M4384                  .EQU $4384       ;Ever set to 0 (prevents overflow)
0095   0000             Score2high             .EQU $4385       ;Player 2 score BCD (high)
0096   0000             Score2mid              .EQU $4386       ;Player 2 score BCD (mid)
0097   0000             Score2low              .EQU $4387       ;Player 2 score BCD (low)
0098   0000             M4388                  .EQU $4388       ;Ever set to 0 (prevents overflow)
0099   0000             HiScorehigh            .EQU $4389       ;Hi score BCD (high)
0100   0000             HiScoremid             .EQU $438A       ;Hi score BCD (mid)
0101   0000             HiScorelow             .EQU $438B       ;Hi score BCD (low)
0102   0000             
0103   0000             ;For general purposes:
0104   0000             SoundControlA          .EQU $438C       ;RAM copy of sound device control register A (0x6000)
0105   0000             SoundControlB          .EQU $438D       ;RAM copy of sound device control register B (0x6800)
0106   0000             M438E                  .EQU $438E       ;Bird-wave background-sound phase (advances the melody, low bit drives SoundControlB)
0107   0000             CoinCount              .EQU $438F       ;Number of coins inserted (max is 9)
0108   0000             Player1Lives           .EQU $4390       ;Player 1 number of lives
0109   0000             Player2Lives           .EQU $4391       ;Player 2 number of lives
0110   0000             M4392                  .EQU $4392       ;Ever set to 0 ?
0111   0000             Counter93              .EQU $4393       ;Free running counter during playtime at game level 3
0112   0000             M4394                  .EQU $4394       ;Start value list pointer for alien movement MSB
0113   0000             M4395                  .EQU $4395       ;Start value list pointer for alien movement LSB
0114   0000             M4396                  .EQU $4396       ;Bird-wave background-sound step timer (counts frames per tone vs `T3DE0` duration)
0115   0000             M4397                  .EQU $4397       ;Score "dirty" flag — `0` means score changed this frame -> redraw the digits
0116   0000             M4398                  .EQU $4398       ;16 bit counter (MSB) actual index for slow print at intro splash
0117   0000             M4399                  .EQU $4399       ;16 bit counter (LSB) actual index for slow print at intro splash
0118   0000             Counter9A              .EQU $439A       ;16 bit counter (MSB) for animation
0119   0000             M439B                  .EQU $439B       ;16 bit counter (LSB) for animation and next index for slow print at intro splash
0120   0000             M439C                  .EQU $439C       ;Spiral-fill animation step counter (level 4/6/8 inter-wave fade-in)
0121   0000             M439D                  .EQU $439D       ;Fist two digits of BCD score value for mothership explosion
0122   0000             M439E                  .EQU $439E       ;Mapped player ship position, left part: ($09 to $C0)
0123   0000             M439F                  .EQU $439F       ;Mapped player ship position, right part: ($17 to $C8)
0124   0000             IN0Current             .EQU $43A0       ;Current value of IN0: bit0='coin', bit1='1 player', bit2='2 players', bit4='fire', bit5='right', bit6='left', bit7='shield'
0125   0000             IN0Previous            .EQU $43A1       ;Previous value of IN0
0126   0000             GameOrAttract          .EQU $43A2       ;Attract mode=0, One player game mode=1, Two players game mode=2
0127   0000             GameAndDemoOrSplash    .EQU $43A3       ;Game and demo for player 1=0, Game for player 2=1, Intro splash=2
0128   0000             GameState              .EQU $43A4       ;Game state=0 - 7
0129   0000             CounterA5              .EQU $43A5       ;8 bit counter (e.g.: score flash time)
0130   0000             ShieldCount            .EQU $43A6       ;Counts shield time and controls shield picture. Shields end at C0.
0131   0000             AnimationCounter       .EQU $43A7       ;For mothership's antenna and the alien pilot animation
0132   0000             M43A8                  .EQU $43A8       ;Temporary storage (MSB of pointer to table $1860)
0133   0000             M43A9                  .EQU $43A9       ;Temporary storage (LSB of pointer to table $1860)
0134   0000             M43AA                  .EQU $43AA       ;Mothership-wave frame counter (times antenna/pilot animation and star scroll)
0135   0000             
0136   0000             ; For Background graphic's (stars, planets, galaxies) and scroll control
0137   0000             M43AB                  .EQU $43AB       ;Counter for planet trigger
0138   0000             M43AC                  .EQU $43AC       ;Planet vertical spacing increment (added to trigger `$43AB`)
0139   0000             M43AD                  .EQU $43AD       ;Planet X index -> `T1E60` (screen-RAM LSB), incremented per planet
0140   0000             M43AE                  .EQU $43AE       ;Planet X index -> `T1E20` (screen-RAM MSB), incremented per planet
0141   0000             M43AF                  .EQU $43AF       ;`CounterB9` trigger for the next galaxy
0142   0000             M43B0                  .EQU $43B0       ;Galaxy spacing decrement (subtracted from `$43AF`)
0143   0000             M43B1                  .EQU $43B1       ;Galaxy X index -> `T1E80`, incremented per galaxy
0144   0000             M43B2                  .EQU $43B2       ;MSB pointer into the background pattern tables `T1C00`/`T1D00`/`T1F00`
0145   0000             M43B3                  .EQU $43B3       ;LSB pointer into the background pattern tables `T1C00`/`T1D00`/`T1F00`
0146   0000             CounterB4              .EQU $43B4       ;8 bit counter (stars scrolling down, aliens fade in time)
0147   0000             M43B5                  .EQU $43B5       ;Reserved/unused byte always `$FF`
0148   0000             M43B6                  .EQU $43B6       ;End-of-wave countdown timer that advances the game to the next level/round
0149   0000             
0150   0000             ;For general purposes
0151   0000             LevelAndRound          .EQU $43B8       ;Bit0 - 3: game level, bit4 - 7: game round
0152   0000             CounterB9              .EQU $43B9       ;8 bit backwards counter
0153   0000             AliensLeft             .EQU $43BA       ;Number of aliens left in wave (16 at new)
0154   0000             BirdsLeft              .EQU $43BB       ;Number of birds left in wave (8 at new)
0155   0000             M43BC                  .EQU $43BC       ;Reserved/unused byte
0156   0000             M43BD                  .EQU $43BD       ;Low byte of the bonus extra-life score threshold; rewritten (nibble-swapped `BonusLivesAt`) after a bonus is granted
0157   0000             BonusLivesAt           .EQU $43BE       ;Middle byte of the threshold, set from DIP switches to `$30/$40/$50/$60` = 3000/4000/5000/6000 points
0158   0000             M43BF                  .EQU $43BF       ;High byte of the bonus extra-life score threshold
0159   0000             
0160   0000             ; Player and player bullets, data structure (grid).
0161   0000             PlayerState            .EQU $43C0       ;Player ship control state register
0162   0000             PlayerShape            .EQU $43C1       ;LSB for T1400 player ship character block shapes table
0163   0000             PlayerShipX            .EQU $43C2       ;Player ship, coordinate X ($0C=min.left, $64=default, $C0=max.right)
0164   0000             PlayerShipY            .EQU $43C3       ;Player ship, coordinate Y ($D8)
0165   0000             PlayerBulletState      .EQU $43C4       ;Player bullet, control state register
0166   0000             PlayerBulletShape      .EQU $43C5       ;Player bullet, character code ($50 to $57)
0167   0000             PlayerBulletX          .EQU $43C6       ;Player bullet, coordinate X
0168   0000             PlayerBulletY          .EQU $43C7       ;Player bullet, coordinate Y ($D0=min.bottom, $18=max.top)
0169   0000             AbovePlayerBulletState .EQU $43C8       ;One position above player bullet, control state register
0170   0000             AbovePlayerBulletShape .EQU $43C9       ;One position above player bullet, character code ($50 to $57)
0171   0000             AbovePlayerBulletX     .EQU $43CA       ;One position above player bullet, coordinate X
0172   0000             AbovePlayerBulletY     .EQU $43CB       ;One position above player bullet, coordinate Y
0173   0000             
0174   0000             ; Alien and bird bullets, data structure (grid).
0175   0000             AlienBullet0State      .EQU $43CC       ;Enemy bullet 0, control state register
0176   0000             AlienBullet0Shape      .EQU $43CD       ;Enemy bullet 0, character code ($58 to $5F)
0177   0000             AlienBullet0X          .EQU $43CE       ;Enemy bullet 0, coordinate X
0178   0000             AlienBullet0Y          .EQU $43CF       ;Enemy bullet 0, coordinate Y
0179   0000             AlienBullet1State      .EQU $43D0       ;Enemy bullet 1, control state register
0180   0000             AlienBullet1Shape      .EQU $43D1       ;Enemy bullet 1, character code ($58 to $5F)
0181   0000             AlienBullet1X          .EQU $43D2       ;Enemy bullet 1, coordinate X
0182   0000             AlienBullet1Y          .EQU $43D3       ;Enemy bullet 1, coordinate Y
0183   0000             AlienBullet2State      .EQU $43D4       ;Enemy bullet 2, control state register
0184   0000             AlienBullet2Shape      .EQU $43D5       ;Enemy bullet 2, character code ($58 to $5F)
0185   0000             AlienBullet2X          .EQU $43D6       ;Enemy bullet 2, coordinate X
0186   0000             AlienBullet2Y          .EQU $43D7       ;Enemy bullet 2, coordinate Y
0187   0000             AlienBullet3State      .EQU $43D8       ;Enemy bullet 3, control state register
0188   0000             AlienBullet3Shape      .EQU $43D9       ;Enemy bullet 3, character code ($58 to $5F)
0189   0000             AlienBullet3X          .EQU $43DA       ;Enemy bullet 3, coordinate X
0190   0000             AlienBullet3Y          .EQU $43DB       ;Enemy bullet 3, coordinate Y
0191   0000             AlienBullet4State      .EQU $43DC       ;Enemy bullet 4, control state register
0192   0000             AlienBullet4Shape      .EQU $43DD       ;Enemy bullet 4, character code ($58 to $5F)
0193   0000             AlienBullet4X          .EQU $43DE       ;Enemy bullet 4, coordinate X
0194   0000             AlienBullet4Y          .EQU $43DF       ;Enemy bullet 4, coordinate Y
0195   0000             
0196   0000             ; Player and player bullets, data structure (screen ram).
0197   0000             OldPlayerShipMSB       .EQU $43E0       ;Old MSB screen ram: Upper left character of player ship
0198   0000             OldPlayerShipLSB       .EQU $43E1       ;Old LSB screen ram: Upper left character of player ship
0199   0000             PlayerShipMSB          .EQU $43E2       ;MSB screen ram: Upper left character of player ship
0200   0000             PlayerShipLSB          .EQU $43E3       ;LSB screen ram: Upper left character of player ship
0201   0000             PlayerBulletMSB        .EQU $43E4       ;MSB screen ram: Player bullet
0202   0000             PlayerBulletLSB        .EQU $43E5       ;LSB screen ram: Player bullet
0203   0000             AbovePlayerBulletMSB   .EQU $43E6       ;MSB screen ram: One character above player bullet
0204   0000             AbovePlayerBulletLSB   .EQU $43E7       ;LSB screen ram: One character above player bullet
0205   0000             M43E8                  .EQU $43E8       ;MSB of its previous position (erase pointer, refreshed by `L0886`)
0206   0000             M43E9                  .EQU $43E9       ;LSB of its previous position (erase pointer, refreshed by `L0886`)
0207   0000             M43EA                  .EQU $43EA       ;MSB of its current position (draw + collision pointer, recomputed each frame by `L09A0` from `$43CA:$43CB`)
0208   0000             M43EB                  .EQU $43EB       ;LSB of its current position (draw + collision pointer, recomputed each frame by `L09A0` from `$43CA:$43CB`)
0209   0000             
0210   0000             ; Alien and bird bullets, data structure (screen ram).
0211   0000             OldAlienBullet0MSB     .EQU $43EC       ;Old MSB screen ram: Enemy bullet 0
0212   0000             OldAlienBullet0LSB     .EQU $43ED       ;Old LSB screen ram: Enemy bullet 0
0213   0000             AlienBullet0MSB        .EQU $43EE       ;MSB screen ram: Enemy bullet 0
0214   0000             AlienBullet0LSB        .EQU $43EF       ;LSB screen ram: Enemy bullet 0
0215   0000             OldAlienBullet1MSB     .EQU $43F0       ;Old MSB screen ram: Enemy bullet 1
0216   0000             OldAlienBullet1LSB     .EQU $43F1       ;Old LSB screen ram: Enemy bullet 1
0217   0000             AlienBullet1MSB        .EQU $43F2       ;MSB screen ram: Enemy bullet 1
0218   0000             AlienBullet1LSB        .EQU $43F3       ;LSB screen ram: Enemy bullet 1
0219   0000             OldAlienBullet2MSB     .EQU $43F4       ;Old MSB screen ram: Enemy bullet 2
0220   0000             OldAlienBullet2LSB     .EQU $43F5       ;Old LSB screen ram: Enemy bullet 2
0221   0000             AlienBullet2MSB        .EQU $43F6       ;MSB screen ram: Enemy bullet 2
0222   0000             AlienBullet2LSB        .EQU $43F7       ;LSB screen ram: Enemy bullet 2
0223   0000             OldAlienBullet3MSB     .EQU $43F8       ;Old MSB screen ram: Enemy bullet 3
0224   0000             OldAlienBullet3LSB     .EQU $43F9       ;Old LSB screen ram: Enemy bullet 3
0225   0000             AlienBullet3MSB        .EQU $43FA       ;MSB screen ram: Enemy bullet 3
0226   0000             AlienBullet3LSB        .EQU $43FB       ;LSB screen ram: Enemy bullet 3
0227   0000             OldAlienBullet4MSB     .EQU $43FC       ;Old MSB screen ram: Enemy bullet 4
0228   0000             OldAlienBullet4LSB     .EQU $43FD       ;Old LSB screen ram: Enemy bullet 4
0229   0000             AlienBullet4MSB        .EQU $43FE       ;MSB screen ram: Enemy bullet 4
0230   0000             AlienBullet4LSB        .EQU $43FF       ;LSB screen ram: Enemy bullet 4
0231   0000             
0232   0000             ; Background screen.
0233   0000             BackgroundScreen       .EQU $4800       ;32*26 bytes for the background screen
0234   0000             
0235   0000             ; Pointer to alien movement pattern.
0236   0000             M4B50                  .EQU $4B50       ;Alien0 movement pattern table MSB
0237   0000             M4B51                  .EQU $4B51       ;Alien0 movement pattern table LSB
0238   0000             M4B52                  .EQU $4B52       ;Alien1 movement pattern table MSB
0239   0000             M4B53                  .EQU $4B53       ;Alien1 movement pattern table LSB
0240   0000             M4B54                  .EQU $4B54       ;Alien2 movement pattern table MSB
0241   0000             M4B55                  .EQU $4B55       ;Alien2 movement pattern table LSB
0242   0000             M4B56                  .EQU $4B56       ;Alien3 movement pattern table MSB
0243   0000             M4B57                  .EQU $4B57       ;Alien3 movement pattern table LSB
0244   0000             M4B58                  .EQU $4B58       ;Alien4 movement pattern table MSB
0245   0000             M4B59                  .EQU $4B59       ;Alien4 movement pattern table LSB
0246   0000             M4B5A                  .EQU $4B5A       ;Alien5 movement pattern table MSB
0247   0000             M4B5B                  .EQU $4B5B       ;Alien5 movement pattern table LSB
0248   0000             M4B5C                  .EQU $4B5C       ;Alien6 movement pattern table MSB
0249   0000             M4B5D                  .EQU $4B5D       ;Alien6 movement pattern table LSB
0250   0000             M4B5E                  .EQU $4B5E       ;Alien7 movement pattern table MSB
0251   0000             M4B5F                  .EQU $4B5F       ;Alien7 movement pattern table LSB
0252   0000             M4B60                  .EQU $4B60       ;Alien8 movement pattern table MSB
0253   0000             M4B61                  .EQU $4B61       ;Alien8 movement pattern table LSB
0254   0000             M4B62                  .EQU $4B62       ;Alien9 movement pattern table MSB
0255   0000             M4B63                  .EQU $4B63       ;Alien9 movement pattern table LSB
0256   0000             M4B64                  .EQU $4B64       ;AlienA movement pattern table MSB
0257   0000             M4B65                  .EQU $4B65       ;AlienA movement pattern table LSB
0258   0000             M4B66                  .EQU $4B66       ;AlienB movement pattern table MSB
0259   0000             M4B67                  .EQU $4B67       ;AlienB movement pattern table LSB
0260   0000             M4B68                  .EQU $4B68       ;AlienC movement pattern table MSB
0261   0000             M4B69                  .EQU $4B69       ;AlienC movement pattern table LSB
0262   0000             M4B6A                  .EQU $4B6A       ;AlienD movement pattern table MSB
0263   0000             M4B6B                  .EQU $4B6B       ;AlienD movement pattern table LSB
0264   0000             M4B6C                  .EQU $4B6C       ;AlienE movement pattern table MSB
0265   0000             M4B6D                  .EQU $4B6D       ;AlienE movement pattern table LSB
0266   0000             M4B6E                  .EQU $4B6E       ;AlienF movement pattern table MSB
0267   0000             M4B6F                  .EQU $4B6F       ;AlienF movement pattern table LSB
0268   0000             
0269   0000             ; Alien data structure (grid).
0270   0000             ; Used for all levels with the 16 aliens.
0271   0000             ; Level: 1, 2, 5 (with mothership), 6, 7, 10(with mothership).
0272   0000             ; During 'fade in' phase, the alien control state B is holding the character code!
0273   0000             M4B70                  .EQU $4B70       ;Alien0 control state A
0274   0000             M4B71                  .EQU $4B71       ;Alien0 control state B (LSB for T14xx)
0275   0000             M4B72                  .EQU $4B72       ;Alien0 screen coordinate X
0276   0000             M4B73                  .EQU $4B73       ;Alien0 screen coordinate Y
0277   0000             M4B74                  .EQU $4B74       ;Alien1 control state A
0278   0000             M4B75                  .EQU $4B75       ;Alien1 control state B (LSB for T14xx)
0279   0000             M4B76                  .EQU $4B76       ;Alien1 screen coordinate X
0280   0000             M4B77                  .EQU $4B77       ;Alien1 screen coordinate Y
0281   0000             M4B78                  .EQU $4B78       ;Alien2 control state A
0282   0000             M4B79                  .EQU $4B79       ;Alien2 control state B (LSB for T14xx)
0283   0000             M4B7A                  .EQU $4B7A       ;Alien2 screen coordinate X
0284   0000             M4B7B                  .EQU $4B7B       ;Alien2 screen coordinate Y
0285   0000             M4B7C                  .EQU $4B7C       ;Alien3 control state A
0286   0000             M4B7D                  .EQU $4B7D       ;Alien3 control state B (LSB for T14xx)
0287   0000             M4B7E                  .EQU $4B7E       ;Alien3 screen coordinate X
0288   0000             M4B7F                  .EQU $4B7F       ;Alien3 screen coordinate Y
