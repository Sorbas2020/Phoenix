1526   0518 21 A4 43                           LD      HL,GameState        ; Next interval game state ...
1527   051B 36 03                              LD      (HL),$03            ; ... is 3 (normal game play)
1528   051D CD 80 05                           CALL    InitBackgroundData ;
1529   0520 CD 47 05                           CALL    InitPlayerDataStructure
1530   0523 CD A0 09                           CALL    L09A0               ; get screen ram adress for player ship position
1531   0526             L0526:
