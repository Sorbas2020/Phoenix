8509   39DE 11 C4 43                           LD      DE,PlayerBulletState
8510   39E1 06 04                              LD      B,$04               
8511   39E3 CD E0 05                           CALL    CopyBbytesHLtoDE    ; 
8512   39E6 1E E6                              LD      E,$E6               
8513   39E8 06 02                              LD      B,$02               
8514   39EA C3 E0 05                           JP      CopyBbytesHLtoDE    ; 
