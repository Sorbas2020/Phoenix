5478   22E0                                    .ORG $22E0
5479   22E0             ;
5480   22E0             L22E0:
5481   22E0 3E 71                              LD      A,$71               ; init the ...
5482   22E2             ;
5483   22E2             L22E2:
5484   22E2 32 B9 43                           LD      (CounterB9),A       ; free running 8 bit backwards counter
5485   22E5 32 00 58                           LD      (scrollRegister),A  ; 58xx scroll register
5486   22E8 C9                                 RET                         ;
