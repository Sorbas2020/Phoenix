1685   0610             InitAlienPositions:
1686   0610 21 3A 06                           LD      HL,T063A            ;
1687   0613 3A B8 43                           LD      A,(LevelAndRound)   ;
1688   0616 0F                                 RRCA                        ;
1689   0617 E6 0F                              AND     $0F                 ; mask out 0000_1111
1690   0619 85                                 ADD     A,L                 ;
1691   061A 6F                                 LD      L,A                 ;
1692   061B 00                                 NOP                         ; Old command removed or space for a future replace patch
1693   061C 00                                 NOP                         ; ..
1694   061D 00                                 NOP                         ; ..
1695   061E 6E                                 LD      L,(HL)              ;
1696   061F 26 15                              LD      H,T1540 >> 8        ; MSB for T1540-T15E0
1697   0621 11 72 4B                           LD      DE,M4B72            ;
1698   0624 3A BA 43                           LD      A,(AliensLeft)      ;
1699   0627 47                                 LD      B,A                 ;
1700   0628 A7                                 AND     A                   ; updates the zero flag
1701   0629 C8                                 RET     Z                   ; if no AliensLeft
1702   062A             ;
1703   062A             L062A:
1704   062A 7E                                 LD      A,(HL)              ; get value from table
1705   062B 12                                 LD      (DE),A              ; save to alien screen coordinate
1706   062C 23                                 INC     HL                  ;
1707   062D 13                                 INC     DE                  ;
1708   062E 7E                                 LD      A,(HL)              ;
1709   062F 12                                 LD      (DE),A              ;
1710   0630 23                                 INC     HL                  ;
1711   0631 13                                 INC     DE                  ;
1712   0632 13                                 INC     DE                  ;
1713   0633 13                                 INC     DE                  ;
1714   0634 05                                 DEC     B                   ;
1715   0635 C2 2A 06                           JP      NZ,L062A            ; loop for all AliensLeft
1716   0638 C9                                 RET                         ;
1717   0639             
1718   063A                                    .ORG $063A
1719   063A             ; Init data for 1st game round.
1720   063A             ; LSB's for T1560, T1540, T15E0.
1721   063A             T063A:
1722   063A 60 40 E0 E0                        .DB T1560 & $FF, T1540 & $FF, T15E0 & $FF, T15E0 & $FF, T15E0 & $FF, T15E0 & $FF, $FF, $FF
1722   063E E0 E0 FF FF 
1723   0642             ; Init data for 2nd game round.
1724   0642             ; LSB's for T15C0, T15A0, T1580.
1725   0642 C0 A0 80 80                        .DB T15C0 & $FF, T15A0 & $FF, T1580 & $FF, T1580 & $FF, T1580 & $FF, T1580 & $FF, $FF, $FF
1725   0646 80 80 FF FF 
