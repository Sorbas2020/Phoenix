1515   050B CD D8 05                           CALL    ClearBbytesAtHL     ;
1516   050E 3A 50 4B                           LD      A,(M4B50)           ;
1517   0511 32 94 43                           LD      (M4394),A           ;
1518   0514 C9                                 RET                         ;
