1615   05A8             T05A8:
1616   05A8 80 7F 00 00                        .DB $80, $7F, $00, $00, $40, $3F, $00, T1C00 >> 8, T1C00 & $FF, $FF, $FF, $FF    ; alien waves
1616   05AC 40 3F 00 1C 
1616   05B0 00 FF FF FF 
1617   05B4             T05B4:
1618   05B4 60 5F 01 02                        .DB $60, $5F, $01, $02, $30, $2F, $00, T1C00 >> 8, T1C00 & $FF, $C0, $FF, $FF    ; mothership
1618   05B8 30 2F 00 1C 
1618   05BC 00 C0 FF FF 
1619   05C0             T05C0:
1620   05C0 80 7F 03 04                        .DB $80, $7F, $03, $04, $40, $3F, $00, T1F00 >> 8, T1F00 & $FF, $A0, $FF, $FF    ; alien wave 2
1620   05C4 40 3F 00 1F 
1620   05C8 00 A0 FF FF 
1621   05CC             T05CC:
1622   05CC 60 60 05 06                        .DB $60, $60, $05, $06, $50, $30, $00, T1D00 >> 8, T1D00 & $FF, $48, $FF, $FF    ; mothership
1622   05D0 50 30 00 1D 
1622   05D4 00 48 FF FF 
