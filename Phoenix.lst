6749   2FE0 03 19 06 06                        .DB $03, $19, $06, $06, $1A, $11, $12, $13, $02, $02, $02, $05, $05, $02, $02, $02
6749   2FE4 1A 11 12 13 
6749   2FE8 02 02 02 05 
6749   2FEC 05 02 02 02 
6750   2FF0 05 05 02 02                        .DB $05, $05, $02, $02, $02, $05, $1C, $08, $08, $07, $07, $08, $08, $08, $00, $FF
6750   2FF4 02 05 1C 08 
6750   2FF8 08 07 07 08 
6750   2FFC 08 08 00 FF 
6751   3000             
6752   3000             ;*****************************************************************************
6753   3000             ; h7-ic51.7a
6754   3000             ;*****************************************************************************
6755   3000             
6756   3000             ;*****************************************************************************
6757   3000             ;* AlienBehaviorUpdate.
6758   3000             ;* The 'core of the matter': drives every alien attack pattern and the
6759   3000             ;* randomized selection. One sub-task runs per frame, chosen round-robin by
6760   3000             ;* Counter93 (0-7) via jump table T3018. The sub-tasks cooperate through the
6761   3000             ;* behavior state machine at $4350 and the control block $4350-$435B.
6762   3000             ;* The selected patterns do always fit on the screen,
6763   3000             ;* even if the alien formation is further down. (phase 1, 2, 3)
6764   3000             ;*****************************************************************************
6765   3000             L3000:
6766   3000 21 93 43                           LD      HL,Counter93        ; 
6767   3003 7E                                 LD      A,(HL)              ; load and save ram value
6768   3004 34                                 INC     (HL)                ; increment Counter93
6769   3005 E6 07                              AND     $07                 ; masc out 0000_0111 the saved value in order to count from 0 to 7
6770   3007 21 18 30                           LD      HL,T3018            ; base of jump table
6771   300A 07                                 RLCA                        ; Multiply by 2 to get a 2 byte offset
6772   300B 85                                 ADD     A,L                 ;
6773   300C 6F                                 LD      L,A                 ;
6774   300D 7E                                 LD      A,(HL)              ; get MSB from jump table
6775   300E 23                                 INC     HL                  ;
6776   300F 6E                                 LD      L,(HL)              ; get LSB from jump table
6777   3010 67                                 LD      H,A                 ;
6778   3011 E9                                 JP      (HL)                ; dispatch to sub-task
6779   3012             
6780   3012             ;*****************************************************************************
6781   3012             ;* Sub-task 7: Do nothing.
6782   3012             ;*****************************************************************************
6783   3012             L3012:
6784   3012 C9                                 RET                         ;
6785   3013             
6786   3018                                    .ORG $3018
6787   3018             ; Jump table for AlienBehaviorUpdate sub-tasks (by Counter93)
6788   3018             T3018:
6789   3018                                    .MSFIRST
6790   3018 32 64                              .DW L3264 ; 0 -> L3264  install chosen pattern / rotate start pointer
6791   301A 30 28                              .DW L3028 ; 1 -> L3028  'Angry movement A/B' (push formation down)
6792   301C 30 BA                              .DW L30BA ; 2 -> L30BA  tick attack-delay + group timers
6793   301E 31 24                              .DW L3124 ; 3 -> L3124  decide how many aliens attack
6794   3020 31 5A                              .DW L315A ; 4 -> L315A  pick a random alien to attack
6795   3022 31 B4                              .DW L31B4 ; 5 -> L31B4  choose the closed-loop swoop pattern
6796   3024 32 2C                              .DW L322C ; 6 -> L322C  confirm pattern start across the grid
6797   3026 30 12                              .DW L3012 ; 7 -> L3012  (nop)
6798   3028             
6799   3028             ;*****************************************************************************
6800   3028             ;* Sub-task 1: 'Angry movement pattern A/B' (pattern 26/28).
6801   3028             ;* Every $4358 frames, escalate $4357 and re-arm the downward-push pattern
6802   3028             ;* (T2E00/T2E40), so the formation creeps further down the screen.
6803   3028             ;*****************************************************************************
6804   3028             L3028:
6805   3028 21 57 43                           LD      HL,M4357            ; 
6806   302B 7E                                 LD      A,(HL)              ; escalation counter
6807   302C FE 03                              CP      $03                 ; 
6808   302E D0                                 RET     NC                  ; stop after 3 angry cycles
6809   302F 2E 50                              LD      L,$50               ; 
6810   3031 7E                                 LD      A,(HL)              ; get $4350 Alien behavior state
6811   3032 FE 04                              CP      $04                 ; 
6812   3034 D0                                 RET     NC                  ; only act in state < 4
6813   3035 2E 58                              LD      L,$58               ; 
6814   3037 7E                                 LD      A,(HL)              ; get $4358 angry-interval timer
6815   3038 A7                                 AND     A                   ; updates the zero flag
6816   3039 CA 5C 30                           JP      Z,L305C             ; expired -> compute next interval
6817   303C 35                                 DEC     (HL)                ; tick $4358 timer
6818   303D C0                                 RET     NZ                  ; 
6819   303E 2D                                 DEC     L                   ; 
6820   303F 34                                 INC     (HL)                ; $4357++  (advance a cycle)
6821   3040 2E 50                              LD      L,$50               ; 
6822   3042 36 04                              LD      (HL),$04            ; set $4350 next alien behavior state to 4
6823   3044 2E 53                              LD      L,$53               ; 
6824   3046 36 10                              LD      (HL),$10            ; set $4353 Number of aliens doing the closed loop pattern
6825   3048 2C                                 INC     L                   ; 
6826   3049 36 50                              LD      (HL),$50            ; $4354 = $50
6827   304B 2E 51                              LD      L,$51               ; 
6828   304D 36 2E                              LD      (HL),$2E            ; $4351 = pattern page T2Exx
6829   304F 2C                                 INC     L                   ; 
6830   3050 36 00                              LD      (HL),$00            ; set $4352 for T2E00
6831   3052 3A C2 43                           LD      A,(PlayerShipX)     ; 
6832   3055 0F                                 RRCA                        ; 
6833   3056 D8                                 RET     C                   ; player X odd -> keep T2E00
6834   3057 36 40                              LD      (HL),$40            ; set $4352 for T2E40
6835   3059 C9                                 RET                         ; 
6836   305A             
6837   305C                                    .ORG $305C
6838   305C             ;*****************************************************************************
6839   305C             ;* End of movement pattern reached. Get the next start pointer.
6840   305C             ;*****************************************************************************
6841   305C             L305C:
6842   305C CD 74 30                           CALL    L3074               ; C = scaled random magnitude
6843   305F 21 57 43                           LD      HL,M4357            ; 
6844   3062 7E                                 LD      A,(HL)              ; get $4357
6845   3063 07                                 RLCA                        ; Multiply by 4 ..
6846   3064 07                                 RLCA                        ; ..
6847   3065 00                                 NOP                         ;
6848   3066 00                                 NOP                         ;
6849   3067 81                                 ADD     A,C                 ;
6850   3068 C6 07                              ADD     $07                 ;
6851   306A 2E 58                              LD      L,$58               ;
6852   306C 77                                 LD      (HL),A              ; $4358 = new interval
6853   306D C9                                 RET                         ;
6854   306E             
6855   3074                                    .ORG $3074
6856   3074             ;*****************************************************************************
6857   3074             ;* Build a scaled random magnitude in C from round, level, aliens-left and
6858   3074             ;* a random number. Used to size timer spans and attacker counts.
6859   3074             ;*****************************************************************************
6860   3074             L3074:
6861   3074 21 B8 43                           LD      HL,LevelAndRound    ; 
6862   3077 7E                                 LD      A,(HL)              ; 
6863   3078 0F                                 RRCA                        ; 
6864   3079 00                                 NOP                         ; 
6865   307A E6 07                              AND     $07                 ; 0000_0111 game round 0..7
6866   307C 47                                 LD      B,A                 ; 
6867   307D 3E 07                              LD      A,$07               ; 
6868   307F 90                                 SUB     B                   ; C = 7 - round
6869   3080 4F                                 LD      C,A                 ; 
6870   3081 7E                                 LD      A,(HL)              ; get LevelAndRound
6871   3082 FE 80                              CP      $80                 ; 
6872   3084 DA 89 30                           JP      C,L3089             ; 
6873   3087 3E 70                              LD      A,$70               ; clamp high levels
6874   3089             L3089:
6875   3089 0F                                 RRCA                        ; 
6876   308A 0F                                 RRCA                        ; 
6877   308B 0F                                 RRCA                        ; 
6878   308C 0F                                 RRCA                        ; 
6879   308D E6 07                              AND     $07                 ; 0000_0111 game level 0..7
6880   308F 47                                 LD      B,A                 ; 
6881   3090 3E 07                              LD      A,$07               ; 
6882   3092 90                                 SUB     B                   ; 7 - level
6883   3093 81                                 ADD     A,C                 ; 
6884   3094 4F                                 LD      C,A                 ; 
6885   3095 3A BA 43                           LD      A,(AliensLeft)      ; 
6886   3098 D6 05                              SUB     $05                 ; 
6887   309A D2 9F 30                           JP      NC,L309F            ; if AliensLeft >= 5
6888   309D 3E 10                              LD      A,$10               ; else add a bonus
6889   309F             L309F:
6890   309F 81                                 ADD     A,C                 ; 
6891   30A0 4F                                 LD      C,A                 ; 
6892   30A1 CD AA 30                           CALL    GetRandomNumber     ; 
6893   30A4 E6 07                              AND     $07                 ; 0000_0111  for 0 to 7
6894   30A6 81                                 ADD     A,C                 ; 
6895   30A7 4F                                 LD      C,A                 ; C = final magnitude
6896   30A8 C9                                 RET                         ; 
6897   30A9             
6898   30AA                                    .ORG $30AA
6899   30AA             ;*****************************************************************************
6900   30AA             ;* Free running counter ($439B) and the X position of the player ship ($43C2)
6901   30AA             ;* is the base for a pseudo random number.
6902   30AA             ;* Returns A-register: $00 to $0F.
6903   30AA             ;*****************************************************************************
6904   30AA             GetRandomNumber:
6905   30AA 21 9B 43                           LD      HL,Counter9A+$1     ; 
6906   30AD 7E                                 LD      A,(HL)              ;
6907   30AE 07                                 RLCA                        ; Multiply by 8 ..
6908   30AF 07                                 RLCA                        ; ..
6909   30B0 07                                 RLCA                        ; ..
6910   30B1 E6 07                              AND     $07                 ; mask out 0000_0111 in order to count from 0 to 7
6911   30B3 2E C2                              LD      L,$C2               ; get $43C2 PlayerShipX
6912   30B5 86                                 ADD     A,(HL)              ; add to counter value
6913   30B6 E6 0F                              AND     $0F                 ; mask out 0000_1111
6914   30B8 C9                                 RET                         ;
6915   30B9             
6916   30BA                                    .ORG $30BA
6917   30BA             ;*****************************************************************************
6918   30BA             ;* Sub-task 2: tick the three staggered group timers and the attack delay.
6919   30BA             ;* When the delay $4355 expires (in state 0) begin a new attack (state 1).
6920   30BA             ;*****************************************************************************
6921   30BA             L30BA:
6922   30BA 21 58 43                           LD      HL,M4358            ; 
6923   30BD CD DA 30                           CALL    L30DA               ; tick $4359
6924   30C0 CD DA 30                           CALL    L30DA               ; tick $435A
6925   30C3 CD DA 30                           CALL    L30DA               ; tick $435B
6926   30C6 2E 50                              LD      L,$50               ; 
6927   30C8 7E                                 LD      A,(HL)              ; get $4350 Alien behavior state
6928   30C9 A7                                 AND     A                   ; updates the zero flag
6929   30CA C0                                 RET     NZ                  ; only when state == 0
6930   30CB 2E 55                              LD      L,$55               ; 
6931   30CD 7E                                 LD      A,(HL)              ; $4355 attack delay
6932   30CE A7                                 AND     A                   ; updates the zero flag
6933   30CF CA E4 30                           JP      Z,L30E4             ;  expired -> recompute delay
6934   30D2 35                                 DEC     (HL)                ; else count down
6935   30D3 C0                                 RET     NZ                  ; 
6936   30D4 2E 50                              LD      L,$50               ; 
6937   30D6 36 01                              LD      (HL),$01            ; $4350 next alien behavior state to 1  (begin a new attack)
6938   30D8 C9                                 RET                         ; 
6939   30D9             
6940   30DA                                    .ORG $30DA
6941   30DA             ;*****************************************************************************
6942   30DA             ;* Tick one timer (does not go below 0).
6943   30DA             ;*****************************************************************************
6944   30DA             L30DA:
6945   30DA 2C                                 INC     L                   ; 
6946   30DB 7E                                 LD      A,(HL)              ; 
6947   30DC A7                                 AND     A                   ; updates the zero flag
6948   30DD C8                                 RET     Z                   ; already 0 -> nothing
6949   30DE 35                                 DEC     (HL)                ; else count down
6950   30DF C9                                 RET                         ; 
6951   30E0             
6952   30E4                                    .ORG $30E4
6953   30E4             ;*****************************************************************************
6954   30E4             ;* Recompute the attack delay $4355 and reload the 3 group timers.
6955   30E4             ;*****************************************************************************
6956   30E4             L30E4:
6957   30E4 CD 74 30                           CALL    L3074               ; C = magnitude
6958   30E7 21 9A 43                           LD      HL,Counter9A        ; 
6959   30EA 7E                                 LD      A,(HL)              ; 
6960   30EB FE 10                              CP      $10                 ; 
6961   30ED DA F2 30                           JP      C,L30F2             ; 
6962   30F0 3E 0F                              LD      A,$0F               ; 
6963   30F2             L30F2:
6964   30F2 47                                 LD      B,A                 ; 
6965   30F3 3E 0F                              LD      A,$0F               ; 
6966   30F5 90                                 SUB     B                   ; 
6967   30F6 81                                 ADD     A,C                 ; 
6968   30F7 4F                                 LD      C,A                 ; 
6969   30F8 06 01                              LD      B,$01               ; 
6970   30FA 2E 58                              LD      L,$58               ; $4358
6971   30FC CD 12 31                           CALL    L3112               ; reload $4359
6972   30FF CD 12 31                           CALL    L3112               ; reload $435A
6973   3102 CD 12 31                           CALL    L3112               ; reload $435B
6974   3105 79                                 LD      A,C                 ; 
6975   3106 0F                                 RRCA                        ; 
6976   3107 0F                                 RRCA                        ; 
6977   3108 E6 3F                              AND     $3F                 ; 0011_1111
6978   310A C6 01                              ADD     $01                 ; 
6979   310C 2E 55                              LD      L,$55               ; 
6980   310E 77                                 LD      (HL),A              ; $4355 = new attack delay
6981   310F C9                                 RET                         ; 
6982   3110             
6983   3112                                    .ORG $3112
6984   3112             ;*****************************************************************************
6985   3112             ;* Reload one group timer (only if it is currently 0).
6986   3112             ;*****************************************************************************
6987   3112             L3112:
6988   3112 2C                                 INC     L                   ; 
6989   3113 7E                                 LD      A,(HL)              ; 
6990   3114 A7                                 AND     A                   ; updates the zero flag
6991   3115 C0                                 RET     NZ                  ; if <> 0
6992   3116 79                                 LD      A,C                 ; 
6993   3117 0F                                 RRCA                        ; 
6994   3118 E6 7F                              AND     $7F                 ; 0111_1111
6995   311A 4F                                 LD      C,A                 ; 
6996   311B 78                                 LD      A,B                 ; 
6997   311C A7                                 AND     A                   ; updates the zero flag
6998   311D C8                                 RET     Z                   ; 
6999   311E 05                                 DEC     B                   ; 
7000   311F 36 0C                              LD      (HL),$0C            ; 
7001   3121 C9                                 RET                         ; 
7002   3122             
7003   3124                                    .ORG $3124
7004   3124             ;*****************************************************************************
7005   3124             ;* Sub-task 3: in state 1, advance to state 2 and compute the number of
7006   3124             ;* aliens that will fly the swoop ($4353), from round + random, reduced as
7007   3124             ;* the escalation counter $4357 grows.
7008   3124             ;*****************************************************************************
7009   3124             L3124:
7010   3124 21 50 43                           LD      HL,M4350            ; 
7011   3127 7E                                 LD      A,(HL)              ; get alien behavior state
7012   3128 FE 01                              CP      $01                 ; 
7013   312A C0                                 RET     NZ                  ; only in state 1
7014   312B 36 02                              LD      (HL),$02            ; set $4350 next alien behavior state to 2
7015   312D 2E B8                              LD      L,$B8               ; 
7016   312F 7E                                 LD      A,(HL)              ; get LevelAndRound
7017   3130 0F                                 RRCA                        ; 
7018   3131 0F                                 RRCA                        ; 
7019   3132 E6 0F                              AND     $0F                 ; 0000_1111 (bit 0,1 game round / bit 2,3 game level)
7020   3134 C6 05                              ADD     $05                 ; 
7021   3136 FE 11                              CP      $11                 ; 
7022   3138 DA 3D 31                           JP      C,L313D             ; cap when round >= 4
7023   313B 3E 05                              LD      A,$05               ; 
7024   313D             L313D:
7025   313D 2E 57                              LD      L,$57               ; $4357
7026   313F 96                                 SUB     (HL)                ; minus $4357 (escalation)
7027   3140 47                                 LD      B,A                 ; 
7028   3141 CD AA 30                           CALL    GetRandomNumber     ; 
7029   3144 3C                                 INC     A                   ; 1..16
7030   3145 B8                                 CP      B                   ; 
7031   3146 DA 4B 31                           JP      C,L314B             ; 
7032   3149 3E 01                              LD      A,$01               ; at least one alien
7033   314B             L314B:
7034   314B 2E 53                              LD      L,$53               ; $4353
7035   314D 77                                 LD      (HL),A              ; set $4353 = attacker count
7036   314E C9                                 RET                         ; 
7037   314F             
7038   315A                                    .ORG $315A
7039   315A             ;*****************************************************************************
7040   315A             ;* Sub-task 4: in state 2, scan the 16-alien grid from a random offset for
7041   315A             ;* an active alien whose control bytes match the current start pointer.
7042   315A             ;* The first match is recorded in $4354 and state advances to 3.
7043   315A             ;*****************************************************************************
7044   315A             L315A:
7045   315A 21 50 43                           LD      HL,M4350            ; 
7046   315D 7E                                 LD      A,(HL)              ; get alien behavior state
7047   315E FE 02                              CP      $02                 ; 
7048   3160 C0                                 RET     NZ                  ; only in state 2
7049   3161 CD AA 30                           CALL    GetRandomNumber     ; random start index
7050   3164 00                                 NOP                         ; 
7051   3165 47                                 LD      B,A                 ; 
7052   3166 07                                 RLCA                        ; Multiply by 2
7053   3167 C6 50                              ADD     $50                 ; 
7054   3169 6F                                 LD      L,A                 ; 
7055   316A 26 4B                              LD      H,$4B               ; HL = $4B50 + rand*2 (pattern ptr)
7056   316C 78                                 LD      A,B                 ; 
7057   316D 07                                 RLCA                        ; Multiply by 4 ..
7058   316E 07                                 RLCA                        ; 
7059   316F C6 70                              ADD     $70                 ; 
7060   3171 5F                                 LD      E,A                 ; 
7061   3172 16 4B                              LD      D,$4B               ; DE = $4B70 + rand*4 (grid)
7062   3174 0E 10                              LD      C,$10               ; scan all 16 aliens
7063   3176 79                                 LD      A,C                 ; 
7064   3177 90                                 SUB     B                   ; 
7065   3178 47                                 LD      B,A                 ; 
7066   3179             L3179:
7067   3179 CD 92 31                           CALL    L3192               ; test this alien
7068   317C 13                                 INC     DE                  ; 
7069   317D 13                                 INC     DE                  ; 
7070   317E 13                                 INC     DE                  ; 
7071   317F 13                                 INC     DE                  ; next grid entry (+4)
7072   3180 23                                 INC     HL                  ; 
7073   3181 23                                 INC     HL                  ; next pattern ptr (+2)
7074   3182 05                                 DEC     B                   ; 
7075   3183 C2 8A 31                           JP      NZ,L318A            ; 
7076   3186 1E 70                              LD      E,$70               ; wrap grid pointer
7077   3188 2E 50                              LD      L,$50               ; wrap pattern pointer
7078   318A             L318A:
7079   318A 0D                                 DEC     C                   ; 
7080   318B C2 79 31                           JP      NZ,L3179            ; loop for all 16 aliens
7081   318E C9                                 RET                         ; 
7082   318F             
7083   3192                                    .ORG $3192
7084   3192             ;*****************************************************************************
7085   3192             ;* Match test: active alien whose control bytes equal the start pointer.
7086   3192             ;*****************************************************************************
7087   3192             L3192:
7088   3192 1A                                 LD      A,(DE)              ; 
7089   3193 E6 08                              AND     $08                 ; 0000_1000 alien active?
7090   3195 C8                                 RET     Z                   ; 
7091   3196 3A 94 43                           LD      A,(M4394)           ; start ptr MSB
7092   3199 BE                                 CP      (HL)                ; 
7093   319A C0                                 RET     NZ                  ; control-A must match
7094   319B 3A 56 43                           LD      A,(M4356)           ; start ptr LSB
7095   319E 2C                                 INC     L                   ; 
7096   319F 46                                 LD      B,(HL)              ; 
7097   31A0 2D                                 DEC     L                   ; 
7098   31A1 B8                                 CP      B                   ; 
7099   31A2 C0                                 RET     NZ                  ; control-B must match
7100   31A3 7D                                 LD      A,L                 ; 
7101   31A4 32 54 43                           LD      (M4354),A           ; remember this alien's slot
7102   31A7 3E 03                              LD      A,$03               ; 
7103   31A9 32 50 43                           LD      (M4350),A           ; set next alien behavior state to 3
7104   31AC E1                                 POP     HL                  ; abort the scan loop
7105   31AD C9                                 RET                         ; 
7106   31AE             
7107   31B4                                    .ORG $31B4
7108   31B4             ;*****************************************************************************
7109   31B4             ;* Sub-task 5: in state 3, choose the closed-loop swoop pattern for the
7110   31B4             ;* selected alien based on its position relative to the player (T3300),
7111   31B4             ;* its row/phase (L3210 + T3310) and a random pick (T3330). Pattern pointer
7112   31B4             ;* is stored at $4351/$4352 and state advances to 5.
7113   31B4             ;*****************************************************************************
7114   31B4             L31B4:
7115   31B4 3A 50 43                           LD      A,(M4350)           ; get alien behavior state
7116   31B7 FE 03                              CP      $03                 ; 
7117   31B9 C0                                 RET     NZ                  ; only in state 3
7118   31BA 3A 54 43                           LD      A,(M4354)           ; chosen alien slot
7119   31BD D6 50                              SUB     $50                 ; 
7120   31BF 07                                 RLCA                        ; Multiply by 2 to get 2 byte offset
7121   31C0 C6 72                              ADD     $72                 ; -> $4B72 + idx*2 (grid coords)
7122   31C2 6F                                 LD      L,A                 ; 
7123   31C3 26 4B                              LD      H,$4B               ; 
7124   31C5 46                                 LD      B,(HL)              ; get alien screen coordinate X
7125   31C6 2C                                 INC     L                   ; 
7126   31C7 56                                 LD      D,(HL)              ; get alien screen coordinate Y
7127   31C8 3A C2 43                           LD      A,(PlayerShipX)     ; 
7128   31CB 0E 04                              LD      C,$04               ; 
7129   31CD B8                                 CP      B                   ; 
7130   31CE D2 D6 31                           JP      NC,L31D6            ; if PlayerShipX > alien screen coordinate X
7131   31D1 4F                                 LD      C,A                 ; 
7132   31D2 78                                 LD      A,B                 ; 
7133   31D3 41                                 LD      B,C                 ; 
7134   31D4 0E 00                              LD      C,$00               ; 
7135   31D6             L31D6:
7136   31D6 90                                 SUB     B                   ; distance to player
7137   31D7 07                                 RLCA                        ; Multiply by 8 ..
7138   31D8 07                                 RLCA                        ; ..
7139   31D9 07                                 RLCA                        ; ..
7140   31DA E6 07                              AND     $07                 ; 0000_0111
7141   31DC C6 00                              ADD     $00                 ; LSB for table T3300
7142   31DE 6F                                 LD      L,A                 ; 
7143   31DF 26 33                              LD      H,$33               ; get MSB for table T3300
7144   31E1 7E                                 LD      A,(HL)              ; T3300 group
7145   31E2 81                                 ADD     A,C                 ; 
7146   31E3 07                                 RLCA                        ; Multiply by 4 ..
7147   31E4 07                                 RLCA                        ; ..
7148   31E5 4F                                 LD      C,A                 ; 
7149   31E6 00                                 NOP                         ; 
7150   31E7 00                                 NOP                         ; 
7151   31E8 00                                 NOP                         ; 
7152   31E9 3A 57 43                           LD      A,(M4357)           ; 
7153   31EC 47                                 LD      B,A                 ; 
7154   31ED CD 10 32                           CALL    L3210               ; attack phase from alien Y
7155   31F0 79                                 LD      A,C                 ; 
7156   31F1 80                                 ADD     A,B                 ; 
7157   31F2 C6 10                              ADD     $10                 ; LSB for table T3310
7158   31F4 6F                                 LD      L,A                 ; 
7159   31F5 26 33                              LD      H,$33               ; get MSB for table T3310
7160   31F7 4E                                 LD      C,(HL)              ; get data from T3310
7161   31F8 CD AA 30                           CALL    GetRandomNumber     ; 
7162   31FB E6 06                              AND     $06                 ; 0000_0110 (0, 2, 4 or 6)
7163   31FD 81                                 ADD     A,C                 ; 
7164   31FE 6F                                 LD      L,A                 ; 
7165   31FF 26 33                              LD      H,$33               ; get MSB for table T3330 (base adresses of closed loop pattern tables for aliens)
7166   3201 7E                                 LD      A,(HL)              ; pattern MSB
7167   3202 2C                                 INC     L                   ; 
7168   3203 46                                 LD      B,(HL)              ; pattern LSB
7169   3204 21 50 43                           LD      HL,M4350            ; 
7170   3207 36 05                              LD      (HL),$05            ; set $4350 next alien behavior state to 5
7171   3209 2C                                 INC     L                   ; 
7172   320A 77                                 LD      (HL),A              ; set MSB of next closed loop pattern at $4351
7173   320B 2C                                 INC     L                   ; 
7174   320C 70                                 LD      (HL),B              ; set LSB of next closed loop pattern at $4352
7175   320D C9                                 RET                         ; 
