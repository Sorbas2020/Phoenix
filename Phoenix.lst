5428   22CA             ;*****************************************************************************
5429   22CA             ;* Game level A:
5430   22CA             ;* Mothership and aliens 'fade in'
5431   22CA             ;*****************************************************************************
5432   22CA             L22CA:
5433   22CA 21 B4 43                           LD      HL,CounterB4        ; 
5434   22CD 7E                                 LD      A,(HL)              ;
5435   22CE FE C0                              CP      $C0                 ;
5436   22D0 C2 34 08                           JP      NZ,L0834            ; Stars scrolling down and 'aliens fade in'
5437   22D3 36 30                              LD      (HL),$30            ;
5438   22D5 2E 67                              LD      L,$67               ;
5439   22D7 36 FF                              LD      (HL),$FF            ;
5440   22D9 2E BC                              LD      L,$BC               ;
5441   22DB 36 3F                              LD      (HL),$3F            ;
5442   22DD C9                                 RET                         ;
5443   22DE             
5444   22E0                                    .ORG $22E0
5445   22E0             ;
5446   22E0             L22E0:
5447   22E0 3E 71                              LD      A,$71               ; init the ...
5448   22E2             ;
5449   22E2             L22E2:
5450   22E2 32 B9 43                           LD      (CounterB9),A       ; free running 8 bit backwards counter
5451   22E5 32 00 58                           LD      (scrollRegister),A  ; 58xx scroll register
5452   22E8 C9                                 RET                         ;
5453   22E9             
5454   22F0                                    .ORG $22F0
5455   22F0             ;
5456   22F0             L22F0:
5457   22F0 CD A0 03                           CALL    ClearBackground     ; 
5458   22F3 AF                                 XOR     A                   ; A=0
5459   22F4 C3 E2 22                           JP      L22E2               ; 
5460   22F7             
5461   22FA                                    .ORG $22FA
5462   22FA             ;*****************************************************************************
5463   22FA             ;* Rotate the conveyor belt:
5464   22FA             ;* How the "rotation" actually works:
5465   22FA             ;* Each belt tile is a code in `$60`–`$6F`, i.e. `$60 + p` where `p` is a 4-bit phase (0–15)
5466   22FA             ;* that selects which frame of the belt-link graphic is shown. The routine treats that 4-bit phase as two 2-bit halves.
5467   22FA             ;* - high half = bits 2–3
5468   22FA             ;* - low half = bits 0–1
5469   22FA             ;* Walking up the belt column (`L -= $20` each step), every tile is rebuilt as:
5470   22FA             ;* new_phase = (previous_tile.low2 << 2) | (current_tile.high2)
5471   22FA             ;* new_tile  = $60 | new_phase
5472   22FA             ;* In other words:
5473   22FA             ;* - a tile's new high 2 bits come from the lower neighbour's old low 2 bits, and
5474   22FA             ;* - its new low 2 bits come from its own old high 2 bits.
5475   22FA             ;* That is a 2-bit-per-tile shift register running up the column:
5476   22FA             ;* Every animation step, the belt-link pattern marches exactly one 2-bit field up the chain.
5477   22FA             ;* The seed value read from `$488A` feeds a fresh pattern into the bottom of the chain each step,
5478   22FA             ;* so the motion is continuous and never runs out of pattern.
5479   22FA             ;* Because the cumulative effect is "every belt segment's pattern shifts one position along the belt each tick",
5480   22FA             ;* the row of `$60`–`$6F` tiles cycles through their link graphics in lock-step — which the eye reads as the belt rotating/conveying.
5481   22FA             ;*****************************************************************************
5482   22FA             L22FA:
5483   22FA 21 AA 4A                           LD      HL,BackgroundScreen+$2AA
5484   22FD 06 12                              LD      B,$12               
5485   22FF 3A 8A 48                           LD      A,(BackgroundScreen+$8A)
5486   2302 4F                                 LD      C,A                 
5487   2303             L2303:
5488   2303 79                                 LD      A,C                 
5489   2304 E6 03                              AND     $03                 
5490   2306 07                                 RLCA                        ; Multiply by 4 ..
5491   2307 07                                 RLCA                        ; ..
5492   2308 57                                 LD      D,A                 
5493   2309 4E                                 LD      C,(HL)              
5494   230A 79                                 LD      A,C                 
5495   230B E6 0C                              AND     $0C                 
5496   230D 0F                                 RRCA                        
5497   230E 0F                                 RRCA                        
5498   230F B2                                 OR      D                   
5499   2310 F6 60                              OR      $60                 
5500   2312 77                                 LD      (HL),A              
5501   2313 7D                                 LD      A,L                 
5502   2314 D6 20                              SUB     $20                 
5503   2316 6F                                 LD      L,A                 
5504   2317 D2 1B 23                           JP      NC,L231B            ; 
5505   231A 25                                 DEC     H                   
5506   231B             L231B:
5507   231B 05                                 DEC     B                   
5508   231C C2 03 23                           JP      NZ,L2303            ; 
5509   231F C9                                 RET                         
5510   2320             
5511   2322                                    .ORG $2322
5512   2322             ;*****************************************************************************
5513   2322             ;* Animation of the mothership's antenna and the alien pilot.
5514   2322             ;*****************************************************************************
5515   2322             L2322:
5516   2322 21 A7 43                           LD      HL,AnimationCounter ; 
5517   2325 34                                 INC     (HL)                ; increment the animation counter
5518   2326 7E                                 LD      A,(HL)              ;
5519   2327 E6 07                              AND     $07                 ; mask out 0000_0111, in order to count from 0 to 7 for 8 frames
5520   2329 07                                 RLCA                        ; Multiply by 8 ..
5521   232A 07                                 RLCA                        ; ..to get..
5522   232B 07                                 RLCA                        ; ..the frame data adress (8 characters per frame)
5523   232C C6 C0                              ADD     T1BC0 & $FF         ; LSB of T1BC0
5524   232E 6F                                 LD      L,A                 ;
5525   232F 26 1B                              LD      H,T1BC0 >> 8        ; MSB of T1BC0
5526   2331 11 A6 49                           LD      DE,BackgroundScreen+$1A6; at the middle of the mothership
5527   2334 01 02 04                           LD      BC,$0402            ; images are 2x4
5528   2337 C3 D6 0A                           JP      DrawImageCbyB       ; 
5529   233A             ; Intro-splash bird animation script table:
5530   233A             ; A list of bird shape indices that, played in order, make the attract-mode bird grow
5531   233A             ; from a twinkling star into a full flapping Phoenix and then shrink back.
5532   233A             ; Used at `DrawIntroBirdAnimationFrame` (`$21DC`).
5533   233A             ; The mapping is a two-level lookup:
5534   233A             ; M4399  --(>>3)-->  T233A[i] = shape index
5535   233A             ;                      |
5536   233A             ;                      +--(*8)--+--(+ M4399&7 phase)--> T3E08 entry --> bird tile-block address
5537   233A             ; So `T233A` is essentially a tiny animation timeline.
5538   233A             ; The index `M4399 >> 3` walks through it, each step lasting 8 ticks (during which `M4399 & 7` animates the wings),
5539   233A             ; turning the abstract growth/flap/shrink choreography into concrete shape indices that `DrawBirdObject` renders.
5540   233A             ; The trailing `FF` signals the end of the script (it's the sentinel the surrounding intro logic uses to know the sequence is finished).
5541   233A             T233A:
5542   233A 01 02 03 04                        .DB $01, $02, $03, $04, $05, $06, $07, $0A, $07, $0A, $07, $0A, $07, $0A, $07, $0A
5542   233E 05 06 07 0A 
5542   2342 07 0A 07 0A 
5542   2346 07 0A 07 0A 
5543   234A 09 08 04 03                        .DB $09, $08, $04, $03, $02, $01, $FF
5543   234E 02 01 FF 
5544   2351             
5545   2351             ;*****************************************************************************
5546   2351             ;* Mother-ship collision routine:
5547   2351             ;* During the mother-ship levels (game level ≥ 8), `L2000` -> `L24A0` calls `L2351`.
5548   2351             ;* It looks up the tile at the (scroll-adjusted) bullet position 
5549   2351             ;* and explicitly tests for the `$4C`–`$4F` group.
5550   2351             ;*****************************************************************************
5551   2351             L2351:
5552   2351 1A                                 LD      A,(DE)              
5553   2352 E6 08                              AND     $08                 
5554   2354 C8                                 RET     Z                   
5555   2355 7E                                 LD      A,(HL)              
5556   2356 2C                                 INC     L                   
5557   2357 6E                                 LD      L,(HL)              
5558   2358 C6 08                              ADD     $08                 
5559   235A 67                                 LD      H,A                 
5560   235B 3A B9 43                           LD      A,(CounterB9)       ; 
5561   235E 0F                                 RRCA                        
5562   235F 0F                                 RRCA                        
5563   2360 0F                                 RRCA                        
5564   2361 85                                 ADD     A,L                 
5565   2362 E6 1F                              AND     $1F                 
5566   2364 47                                 LD      B,A                 
5567   2365 7D                                 LD      A,L                 
5568   2366 E6 E0                              AND     $E0                 
5569   2368 B0                                 OR      B                   
5570   2369 6F                                 LD      L,A                 
5571   236A 7E                                 LD      A,(HL)              
5572   236B 47                                 LD      B,A                 
5573   236C E6 FC                              AND     $FC                 
5574   236E FE 4C                              CP      $4C                 
5575   2370 CA 7B 23                           JP      Z,L237B             ; 
5576   2373 E6 F0                              AND     $F0                 
5577   2375 FE 60                              CP      $60                 
5578   2377 CA 98 23                           JP      Z,L2398             ; 
5579   237A C9                                 RET                         
5580   237B             ;*****************************************************************************
5581   237B             ;* The mothership's protective shield was hit by a player bullet.
5582   237B             ;* Shield erosion.
5583   237B             ;* So a hit on a `$4C`–`$4F` tile does the following, with no score awarded:
5584   237B             ;* 1. The bullet is consumed (`AND $F7` clears the active bit) — the shot stops there; it does not punch through.
5585   237B             ;* 2. A "mother-ship hit" is registered (`$4366 = $FF`), which drives the hit sound effect.
5586   237B             ;* 3. The tile is decremented one step: `$4F -> $4E -> $4D -> $4C -> $4B`.
5587   237B             ;*    Because the four tiles are an increasing-density gradient, each shot visually "chips" the curved armour one notch thinner.
5588   237B             ;* 4. When a tile erodes to `$4B` it's cleared to `$00` (that chunk of shield is gone).
5589   237B             ;*    If the tile behind it is the solid hull `$5E`, that hull tile is turned into a fresh `$4F`,
5590   237B             ;*    i.e. the next layer of hull becomes the new erodible shield edge.
5591   237B             ;*****************************************************************************
5592   237B             L237B:
5593   237B 1A                                 LD      A,(DE)              
5594   237C E6 F7                              AND     $F7                 
5595   237E 12                                 LD      (DE),A              
5596   237F 3E FF                              LD      A,$FF               
5597   2381 32 66 43                           LD      (M4366),A           ; 
5598   2384 78                                 LD      A,B                 
5599   2385 3D                                 DEC     A                   
5600   2386 77                                 LD      (HL),A              
5601   2387 FE 4B                              CP      $4B                 
5602   2389 C0                                 RET     NZ                  
5603   238A 36 00                              LD      (HL),$00            
5604   238C 2D                                 DEC     L                   
5605   238D 7E                                 LD      A,(HL)              
5606   238E FE 5E                              CP      $5E                 
5607   2390 C0                                 RET     NZ                  
5608   2391 36 4F                              LD      (HL),$4F            
5609   2393 C9                                 RET                         
5610   2394             
5611   2398                                    .ORG $2398
5612   2398             ;*****************************************************************************
5613   2398             ;* Belt-hit handler:
5614   2398             ;*****************************************************************************
5615   2398             L2398:
5616   2398 1A                                 LD      A,(DE)              
5617   2399 E6 F7                              AND     $F7                 
5618   239B 12                                 LD      (DE),A              
5619   239C 1C                                 INC     E                   
5620   239D 1C                                 INC     E                   
5621   239E 1A                                 LD      A,(DE)              
5622   239F E6 04                              AND     $04                 
5623   23A1 78                                 LD      A,B                 
5624   23A2 C2 30 20                           JP      NZ,L2030            ; 
5625   23A5 E6 0C                              AND     $0C                 
5626   23A7 FE 04                              CP      $04                 
5627   23A9 11 40 1B                           LD      DE,$1B40            
5628   23AC             L23AC:
5629   23AC CA C0 23                           JP      Z,L23C0             ; 
5630   23AF 78                                 LD      A,B                 
5631   23B0 E6 0F                              AND     $0F                 
5632   23B2 83                                 ADD     A,E                 
5633   23B3 5F                                 LD      E,A                 
5634   23B4 1A                                 LD      A,(DE)              
5635   23B5 77                                 LD      (HL),A              
5636   23B6 3E FF                              LD      A,$FF               
5637   23B8 32 66 43                           LD      (M4366),A           ; 
5638   23BB C9                                 RET                         
5639   23BC             
5640   23C0                                    .ORG $23C0
5641   23C0             ;*****************************************************************************
5642   23C0             ;* The mothership will be destroyed if an alien pilot is hit.
5643   23C0             ;* If the hit lands on the belt segment directly in front of the alien pilot,
5644   23C0             ;* `L23AC` takes the `JP Z,L23C0` branch instead, which checks whether the tile behind
5645   23C0             ;* is a pilot tile (`$70`-range) and, if so, destroys the mother ship.
5646   23C0             ;*****************************************************************************
5647   23C0             L23C0:
5648   23C0 2D                                 DEC     L                   
5649   23C1 7E                                 LD      A,(HL)              
5650   23C2 E6 F0                              AND     $F0                 
5651   23C4 FE 70                              CP      $70                 
5652   23C6 C0                                 RET     NZ                  
5653   23C7 21 A4 43                           LD      HL,GameState        ; Next interval game state ...
5654   23CA 36 06                              LD      (HL),$06            ; ... is 6 (mother ship partikel explosion)
5655   23CC 2C                                 INC     L                   
5656   23CD 36 60                              LD      (HL),$60            
5657   23CF 2E 63                              LD      L,$63               
5658   23D1 36 FF                              LD      (HL),$FF            
5659   23D3 C9                                 RET                         
5660   23D4             
5661   23D6                                    .ORG $23D6
5662   23D6             ;*****************************************************************************
5663   23D6             ;* Background sound update.
5664   23D6             ;*****************************************************************************
5665   23D6             L23D6:
5666   23D6 21 B8 43                           LD      HL,LevelAndRound    ; 
5667   23D9 7E                                 LD      A,(HL)              ;
5668   23DA E6 0F                              AND     $0F                 ; mask out 0000_1111
5669   23DC FE 01                              CP      $01                 ;
5670   23DE CA 98 3A                           JP      Z,L3A98             ; if game level is 1 (1st alien wave)
5671   23E1 FE 03                              CP      $03                 ;
5672   23E3 CA 98 3A                           JP      Z,L3A98             ; if game level is 3 (2nd alien wave)
5673   23E6 FE 05                              CP      $05                 ;
5674   23E8 CA D0 3A                           JP      Z,L3AD0             ; if game level is 5 (1st bird wave)
5675   23EB FE 07                              CP      $07                 ;
5676   23ED CA D0 3A                           JP      Z,L3AD0             ; if game level is 7 (2nd bird wave)
5677   23F0 FE 09                              CP      $09                 ;
5678   23F2 D8                                 RET     C                   ; if game level is 9 (mothership 'fade in')
5679   23F3 FE 0B                              CP      $0B                 ;
5680   23F5 DA 02 3B                           JP      C,L3B02             ; if game level is B (mothership)
5681   23F8 CD 02 3B                           CALL    L3B02               ; Background sound for level B (mothership)
5682   23FB C3 98 3A                           JP      L3A98               ; Background sound for the alien waves
5683   23FE             
5684   2400                                    .ORG $2400
5685   2400             ;*****************************************************************************
5686   2400             ;* Game state 6.
5687   2400             ;* Mother ship partikel explosion.
5688   2400             ;*****************************************************************************
5689   2400             L2400:
5690   2400 CD 2C 24                           CALL    L242C               ; Shared per-frame prologue for game state 6
5691   2403 CA 52 25                           JP      Z,L2552             ; timer expired -> state 7, score display
5692   2406 FE 20                              CP      $20                 ; 
5693   2408 DA 6A 24                           JP      C,EraseMothership   ; last $20 frames: wipe the hull
5694   240B CA 20 25                           JP      Z,L2520             ; exactly $20: Calculation and display of the bonus score for mothership explosion
5695   240E 47                                 LD      B,A                 ; 
5696   240F 0F                                 RRCA                        ; 
5697   2410 00                                 NOP                         ; 
5698   2411 78                                 LD      A,B                 ; 
5699   2412 D2 E8 20                           JP      NC,L20E8            ; 
5700   2415 7B                                 LD      A,E                 ; 
5701   2416 D6 05                              SUB     $05                 ; 
5702   2418 C6 C0                              ADD     $C0                 ; 
5703   241A 4F                                 LD      C,A                 ; 
5704   241B 7A                                 LD      A,D                 ; 
5705   241C CE 00                              ADC     $00                 ; 
5706   241E 47                                 LD      B,A                 ; 
5707   241F 7E                                 LD      A,(HL)              ; 
5708   2420 11 00 2A                           LD      DE,T2A00            ; get the foreground tiles of the mothership particles explosion
5709   2423 21 00 2B                           LD      HL,T2B00            ; get the control data
5710   2426 C3 85 20                           JP      L2085               ; 
5711   2429             
5712   242C                                    .ORG $242C
5713   242C             ;*****************************************************************************
5714   242C             ;* Shared per-frame prologue for game state 6:
5715   242C             ;* It does three things: freezes the background scroll on a character boundary
5716   242C             ;* and re-programs the `58xx` scroll register, computes the scroll-compensated
5717   242C             ;* foreground screen origin for the explosion into `DE`,
5718   242C             ;* and ticks the state timer `CounterA5` down, returning it in `A` with the `Z` flag set on expiry.
5719   242C             ;* `L242C` therefore holds the scroll still: `AND $F8` rounds `CounterB9` down to a whole character row,
5720   242C             ;* stores it back, and re-programs the register with that value every frame.
5721   242C             ;* The background stops drifting, and — importantly for the next step,
5722   242C             ;* the scroll offset is guaranteed to be an exact multiple of 8 pixels.
5723   242C             ;*****************************************************************************
5724   242C             L242C:
5725   242C 21 B9 43                           LD      HL,CounterB9        ; 
5726   242F 7E                                 LD      A,(HL)              ; 
5727   2430 E6 F8                              AND     $F8                 ; 1111_1000 drop the 3 sub-character bits
5728   2432 77                                 LD      (HL),A              ; write the aligned value back
5729   2433 32 00 58                           LD      (scrollRegister),A  ; 58xx scroll register58xx scroll register
5730   2436 11 C6 41                           LD      DE,$41C6            ; mother-ship origin, foreground plane
5731   2439 0F                                 RRCA                        ; A = CounterB9 / 8
5732   243A 0F                                 RRCA                        ;   (clean shift: low 3 bits are 0)
5733   243B 0F                                 RRCA                        ; 
5734   243C 47                                 LD      B,A                 ; B = scroll offset in character rows
5735   243D 7B                                 LD      A,E                 ; $C6
5736   243E 90                                 SUB     B                   ; 
5737   243F E6 1F                              AND     $1F                 ; 0001_1111 wrap within the 5-bit row field
5738   2441 47                                 LD      B,A                 ; 
5739   2442 7B                                 LD      A,E                 ; $C6
5740   2443 E6 E0                              AND     $E0                 ; 1110_0000 keep the horizontal field ($C0)
5741   2445 B0                                 OR      B                   ; 
5742   2446 5F                                 LD      E,A                 ; E = $C0 | (($C6 - scroll) & $1F)
5743   2447 2E A5                              LD      L,$A5               ; CounterA5
5744   2449 35                                 DEC     (HL)                ; <- the flags the caller tests
5745   244A 7E                                 LD      A,(HL)              ; 
5746   244B C9                                 RET                         ; 
5747   244C             
5748   244C             ;*****************************************************************************
5749   244C             ;* Game state 7.
5750   244C             ;* Mother ship score display.
5751   244C             ;*****************************************************************************
5752   244C             L244C:
5753   244C 21 A5 43                           LD      HL,CounterA5        ; 
5754   244F 35                                 DEC     (HL)                ;
5755   2450 7E                                 LD      A,(HL)              ;
5756   2451 0F                                 RRCA                        ;
5757   2452 DA F0 06                           JP      C,L06F0             ; update scroll register and fill background
5758   2455 A7                                 AND     A                   ; updates the zero flag
5759   2456 C0                                 RET     NZ                  ;
5760   2457 2D                                 DEC     L                   ;
5761   2458 36 02                              LD      (HL),$02            ;
5762   245A 2E B8                              LD      L,$B8               ;
5763   245C 7E                                 LD      A,(HL)              ;
5764   245D E6 F0                              AND     $F0                 ;
5765   245F C6 10                              ADD     $10                 ; go to next round and ..
5766   2461 77                                 LD      (HL),A              ; .. store at LevelAndRound $43B8
5767   2462 2E BA                              LD      L,$BA               ;
5768   2464 36 10                              LD      (HL),$10            ; set AliensLeft to 16
5769   2466 C3 80 03                           JP      ClearForeground     ; 
5770   2469             
5771   246A                                    .ORG $246A
5772   246A             ;*****************************************************************************
5773   246A             ;* EraseMothership:
5774   246A             ;*****************************************************************************
5775   246A             EraseMothership:
5776   246A 01 14 09                           LD      BC,$0914            ; 20x9 image
5777   246D 11 C6 4A                           LD      DE,$4AC6            ; Screen coordinate of mother ship
5778   2470 21 00 1C                           LD      HL,$1C00            ; Background stars to erase the mother ship
5779   2473 C3 D6 0A                           JP      DrawImageCbyB       ; Erase the mother ship
5780   2476             
5781   2476             ;*****************************************************************************
5782   2476             ;* Re-arms the bird attack cycle:
5783   2476             ;* It runs once each time the bird dwell timer `B4BD3` expires and computes two fresh values:
5784   2476             ;* A new dwell time for `B4BD3` (how long until the next re-arm) and a new descent threshold `B4BD1`
5785   2476             ;* (how far the formation is allowed to scroll down before the direction flips).
5786   2476             ;* Both are derived from the surviving birds' vertical spread, the kill count,
5787   2476             ;* the frame counter, and the wave randomiser `M436F`.
5788   2476             ;* Notes
5789   2476             ;* - `RLCA` at `$2484`, `$2488` and `$26BD` is a rotate, not a shift.
5790   2476             ;*   For the small values involved it acts as ×2, but a value ≥ `$80` would wrap its top bit into bit 0.
5791   2476             ;* - Only `L` is reloaded throughout; `H` stays `$4B` for the `B4BDx` writes and `$43` after `$247E`.
5792   2476             ;*****************************************************************************
5793   2476             L2476:
5794   2476 78                                 LD      A,B                 ; 
5795   2477 81                                 ADD     A,C                 ; A = B + C
5796   2478 CD 95 24                           CALL    L2495               ; unrolled multiply
5797   247B 2E D3                              LD      L,$D3               ; $4BD3 countdown timer between bird attacks ("bird extended storage")
5798   247D 77                                 LD      (HL),A              ; B4BD3 = new dwell time
5799   247E 21 BB 43                           LD      HL,BirdsLeft        ; 
5800   2481 3E 08                              LD      A,$08               ; number of birds
5801   2483 96                                 SUB     (HL)                ; birds already killed
5802   2484 07                                 RLCA                        ; Multiply by 2
5803   2485 2E 9A                              LD      L,$9A               ; Counter9A
5804   2487 86                                 ADD     A,(HL)              ; 
5805   2488 07                                 RLCA                        ; Multiply by 2
5806   2489 47                                 LD      B,A                 ; 
5807   248A             ; Attack timing / launch slot                      
5808   248A 2E 6F                              LD      L,$6F               ; $436F (random)
5809   248C 7E                                 LD      A,(HL)              ; 
5810   248D E6 1E                              AND     $1E                 ; 0001_1110 random even value 0..$1E
5811   248F 80                                 ADD     A,B                 ; B from (8-BirdsLeft) & Counter9A
5812   2490 32 D1 4B                           LD      (B4BD1),A           ; new descent turnaround threshold (max depth)
5813   2493 C9                                 RET                         ; 
5814   2494             
5815   2495                                    .ORG $2495
5816   2495             ;*****************************************************************************
5817   2495             ;* Unrolled multiply:
5818   2495             ;* `L2495` is a hand-unrolled "add `B` up to three times, then maybe double" helper.
5819   2495             ;*****************************************************************************
5820   2495             L2495:
5821   2495 80                                 ADD     A,B                 ; 
5822   2496 0D                                 DEC     C                   ; 
5823   2497 C8                                 RET     Z                   ; 
5824   2498 80                                 ADD     A,B                 ; 
5825   2499 0D                                 DEC     C                   ; 
5826   249A C8                                 RET     Z                   ; 
5827   249B 80                                 ADD     A,B                 ; 
5828   249C 0D                                 DEC     C                   ; 
5829   249D C8                                 RET     Z                   ; 
5830   249E 87                                 ADD     A,A                 ; 
5831   249F C9                                 RET                         ; 
5832   24A0             ;
5833   24A0             L24A0:
5834   24A0 3A B8 43                           LD      A,(LevelAndRound)   ; 
5835   24A3 E6 0F                              AND     $0F                 ; mask out 0000_1111
5836   24A5 FE 08                              CP      $08                 ;
5837   24A7 D8                                 RET     C                   ; return if game level < 8
5838   24A8 11 C4 43                           LD      DE,PlayerBulletState
5839   24AB 21 E6 43                           LD      HL,AbovePlayerBulletMSB
5840   24AE CD 51 23                           CALL    L2351               ; 
5841   24B1 3A 9B 43                           LD      A,(Counter9A+$1)    ; 
5842   24B4 E6 03                              AND     $03                 ; mask out 0000_0011
5843   24B6 FE 03                              CP      $03                 ;
5844   24B8 C0                                 RET     NZ                  ; return if <> 3
5845   24B9 C3 F2 24                           JP      L24F2               ; 
5846   24BC             
5847   24C4                                    .ORG $24C4
5848   24C4             ;*****************************************************************************
5849   24C4             ;* The mother-ship level handlers (`L2130`/`L2146`/`L21BA`/`L21C5`) all call `L24C4` every frame.
5850   24C4             ;* `L24C4` bumps a frame counter (`$43AA`) and time-slices two animations:
5851   24C4             ;* The antenna/pilot animation `L2322` runs on 3 of every 4 frames,
5852   24C4             ;* and the belt rotation `L22FA` runs on the 4th.
5853   24C4             ;*****************************************************************************
5854   24C4             L24C4:
5855   24C4 3A B8 43                           LD      A,(LevelAndRound)   ; 
5856   24C7 E6 0F                              AND     $0F                 ; mask out 0000_1111
5857   24C9 FE 08                              CP      $08                 ;
5858   24CB DA F0 06                           JP      C,L06F0             ; update scroll register and fill background if game level < 8
5859   24CE CD E0 24                           CALL    L24E0               ; 
5860   24D1 21 AA 43                           LD      HL,M43AA            ; 
5861   24D4 34                                 INC     (HL)                ;
5862   24D5 7E                                 LD      A,(HL)              ;
5863   24D6 E6 03                              AND     $03                 ; mask out 0000_0011
5864   24D8 CA FA 22                           JP      Z,L22FA             ; if $43AA <> 3
5865   24DB C3 22 23                           JP      L2322               ; Animation of the mothership's antenna and the alien pilot
5866   24DE             
5867   24E0                                    .ORG $24E0
5868   24E0             ;
5869   24E0             L24E0:
5870   24E0 3A AA 43                           LD      A,(M43AA)           ; 
5871   24E3 E6 0F                              AND     $0F                 
5872   24E5 C0                                 RET     NZ                  
5873   24E6 3A B9 43                           LD      A,(CounterB9)       ; 
5874   24E9 FE A0                              CP      $A0                 
5875   24EB D8                                 RET     C                   
5876   24EC C3 7A 06                           JP      StarsScrollDown     ; 
5877   24EF             
5878   24F2                                    .ORG $24F2
5879   24F2             ;*****************************************************************************
5880   24F2             ;* Mother ship bomb attack (reached from L24A0 on level >= 8, when
5881   24F2             ;* Counter9A+1 & 3 == 3). Randomly targets the player's column, then fires.
5882   24F2             ;* Purpose:
5883   24F2             ;* On mother ship levels this fires a bomb only when a random number happens
5884   24F2             ;* to line up horizontally with the player ship (a "semi aimed" attack,
5885   24F2             ;* further rate limited by the `Counter9A` gate). It builds the bomb's `B`=X / `C`=Y
5886   24F2             ;* (Y derived from the scroll counter) and jumps into the shared spawner `L25B7`.
5887   24F2             ;* The two `PUSH HL` match the two `POP HL` that `L25B7`/`L25E0` do on exit.
5888   24F2             ;*****************************************************************************
5889   24F2             L24F2:
5890   24F2 CD AA 30                           CALL    GetRandomNumber     ; 
5891   24F5 C6 60                              ADD     $60                 
5892   24F7 00                                 NOP                         
5893   24F8 47                                 LD      B,A                 
5894   24F9 21 9B 43                           LD      HL,Counter9A+$1    ; 
5895   24FC E6 0E                              AND     $0E                 
5896   24FE A6                                 AND     (HL)                
5897   24FF C0                                 RET     NZ                  
5898   2500 3A 9E 43                           LD      A,(M439E)           ; 
5899   2503 B8                                 CP      B                   
5900   2504 D0                                 RET     NC                  
5901   2505 3A 9F 43                           LD      A,(M439F)           ; 
5902   2508 B8                                 CP      B                   
5903   2509 D8                                 RET     C                   
5904   250A 78                                 LD      A,B                 
5905   250B D6 04                              SUB     $04                 
5906   250D 47                                 LD      B,A                 
5907   250E 3A B9 43                           LD      A,(CounterB9)       ; 
5908   2511 2F                                 CPL                         
5909   2512 3C                                 INC     A                   
5910   2513 E6 F8                              AND     $F8                 
5911   2515 C6 48                              ADD     $48                 
5912   2517 4F                                 LD      C,A                 
5913   2518 E5                                 PUSH    HL                  
5914   2519 E5                                 PUSH    HL                  
5915   251A C3 B7 25                           JP      L25B7               ; 
5916   251D             
5917   2520                                    .ORG $2520
5918   2520             ;*****************************************************************************
5919   2520             ;* The 'alien pilot' at mothership was hit.
5920   2520             ;* Calculation and display of the bonus score for mothership explosion.
5921   2520             ;*****************************************************************************
5922   2520             L2520:
5923   2520 D5                                 PUSH    DE                  ;
5924   2521 CD 80 03                           CALL    ClearForeground     ; remove all but the rest of the mothership
5925   2524 D1                                 POP     DE                  ;
5926   2525 3A B9 43                           LD      A,(CounterB9)       ; get value from 8 bit backwards counter
5927   2528 C6 60                              ADD     $60                 ; use it for a ...
5928   252A 0F                                 RRCA                        ; ... score value
5929   252B 47                                 LD      B,A                 ; save it
5930   252C 3A B8 43                           LD      A,(LevelAndRound)   ; 
5931   252F E6 F0                              AND     $F0                 ; mask out 1111_0000 (bit4 - 7: game round)
5932   2531 80                                 ADD     A,B                 ; add score value
5933   2532 06 90                              LD      B,$90               ;
5934   2534 DA 3D 25                           JP      C,L253D             ; 
5935   2537 FE 90                              CP      $90                 ;
5936   2539 D2 3D 25                           JP      NC,L253D            ; 
5937   253C 47                                 LD      B,A                 ;
5938   253D             L253D:
5939   253D AF                                 XOR     A                   ; A=0
5940   253E 78                                 LD      A,B                 ;
5941   253F 27                                 DAA                         ; adjust for BCD
5942   2540 21 9D 43                           LD      HL,M439D            ; 
5943   2543 77                                 LD      (HL),A              ; set value for fist two digits of BCD score
5944   2544 2C                                 INC     L                   ;
5945   2545 36 00                              LD      (HL),$00            ; last two digits of BCD score set to '00'
5946   2547 7B                                 LD      A,E                 ; get LSB of screen ram...
5947   2548 D6 5E                              SUB     $5E                 ; ...
5948   254A 5F                                 LD      E,A                 ; ...
5949   254B 06 04                              LD      B,$04               ; number of digits to print
5950   254D C3 C4 00                           JP      PrintNumber         ; score for mothership explosion
5951   2550             
5952   2552                                    .ORG $2552
5953   2552             ;
5954   2552             L2552:
5955   2552 2E A4                              LD      L,$A4               ;
5956   2554 36 07                              LD      (HL),$07            
5957   2556 2C                                 INC     L                   
5958   2557 36 40                              LD      (HL),$40            
5959   2559 2E 6B                              LD      L,$6B               
5960   255B 36 FF                              LD      (HL),$FF            
5961   255D C9                                 RET                         
5962   255E             
5963   2560                                    .ORG $2560
5964   2560             ;*****************************************************************************
5965   2560             ;* Alien bomb-drop: pick a group of 8 aliens, find one lined up with the
5966   2560             ;* player at attack depth, and fire an enemy bullet at it.
5967   2560             ;* Purpose:
5968   2560             ;* `L2560` is the alien bomb drop selector. 
5969   2560             ;* It picks one of two 8 alien groups (alternating on `Counter93`),
5970   2560             ;* computes the player's horizontal window (`B`,`C`) and the required attack depth `D`
5971   2560             ;* (scaled by the attack escalation counter `$4357`), then scans the group with `L2596`.
5972   2560             ;*****************************************************************************
5973   2560             L2560:
5974   2560 21 93 43                           LD      HL,Counter93            ; 
5975   2563 7E                                 LD      A,(HL)              
5976   2564 E6 01                              AND     $01                 
5977   2566 07                                 RLCA                        ; Multiply by 32 ..
5978   2567 07                                 RLCA                        ; ..
5979   2568 07                                 RLCA                        ; ..
5980   2569 07                                 RLCA                        ; ..
5981   256A 07                                 RLCA                        ; ..
5982   256B C6 70                              ADD     $70                 
5983   256D 6F                                 LD      L,A                 
5984   256E 26 4B                              LD      H,$4B               
5985   2570 1E 08                              LD      E,$08               
5986   2572 3A 57 43                           LD      A,(M4357)           ; 
5987   2575 07                                 RLCA                        ; Multiply by 8 ..
5988   2576 07                                 RLCA                        ; ..
5989   2577 07                                 RLCA                        ; ..
5990   2578 00                                 NOP                         
5991   2579 C6 AD                              ADD     $AD                 
5992   257B 57                                 LD      D,A                 
5993   257C 3A 9F 43                           LD      A,(M439F)           ; 
5994   257F C6 03                              ADD     $03                 
5995   2581 4F                                 LD      C,A                 
5996   2582 3A 9E 43                           LD      A,(M439E)           ; 
5997   2585 D6 0A                              SUB     $0A                 
5998   2587 47                                 LD      B,A                 
5999   2588             L2588:
6000   2588 E5                                 PUSH    HL                  
6001   2589 CD 96 25                           CALL    L2596               ; 
6002   258C E1                                 POP     HL                  
6003   258D 7D                                 LD      A,L                 
6004   258E C6 04                              ADD     $04                 
6005   2590 6F                                 LD      L,A                 
6006   2591 1D                                 DEC     E                   
6007   2592 C2 88 25                           JP      NZ,L2588            ; 
6008   2595 C9                                 RET                         
6009   2596             ;*****************************************************************************
6010   2596             ;* Per-alien attack candidacy test. HL -> alien entry.
6011   2596             ;* Must be active, valid shape, horizontally over the player, and deep enough.
6012   2596             ;* `L2596` accepts an alien that is active, a valid shape, horizontally over the player,
6013   2596             ;* and deep enough on screen. When one qualifies it loads its position into `B`/`C` and drops into `L25B7`.
6014   2596             ;*****************************************************************************
6015   2596             L2596:
6016   2596 7E                                 LD      A,(HL)              
6017   2597 E6 08                              AND     $08                 
6018   2599 C8                                 RET     Z                   
6019   259A 2C                                 INC     L                   
6020   259B 7E                                 LD      A,(HL)              
6021   259C FE 08                              CP      $08                 
6022   259E C8                                 RET     Z                   
6023   259F FE 88                              CP      $88                 
6024   25A1 D0                                 RET     NC                  
6025   25A2 2C                                 INC     L                   
6026   25A3 7E                                 LD      A,(HL)              
6027   25A4 B8                                 CP      B                   
6028   25A5 D8                                 RET     C                   
6029   25A6 B9                                 CP      C                   
6030   25A7 D0                                 RET     NC                  
6031   25A8 2C                                 INC     L                   
6032   25A9 7E                                 LD      A,(HL)              
6033   25AA BA                                 CP      D                   
6034   25AB D0                                 RET     NC                  
6035   25AC FE 80                              CP      $80                 
6036   25AE D8                                 RET     C                   
6037   25AF 00                                 NOP                         
6038   25B0 00                                 NOP                         
6039   25B1 00                                 NOP                         
6040   25B2 00                                 NOP                         
6041   25B3 00                                 NOP                         
6042   25B4 4F                                 LD      C,A                 
6043   25B5 2D                                 DEC     L                   
6044   25B6 46                                 LD      B,(HL)              
6045   25B7             ;*****************************************************************************
6046   25B7             ;* Fire the enemy bullet (shared by alien and mother-ship attacks):
6047   25B7             ;* Finds a free enemy-bullet slot (max 3/4/5 depending on round) and,
6048   25B7             ;* if one exists, activates it at `(B,C)`; if all slots are busy
6049   25B7             ;* it returns up two stack levels (cancelling the scan for this frame).
6050   25B7             ;*****************************************************************************
6051   25B7             L25B7:
6052   25B7 3A B8 43                           LD      A,(LevelAndRound)   ; 
6053   25BA 16 03                              LD      D,$03               ;
6054   25BC FE 10                              CP      $10                 ; 0001_0000
6055   25BE DA CA 25                           JP      C,L25CA             ; if game round < 1
6056   25C1 16 04                              LD      D,$04               ;
6057   25C3 FE 20                              CP      $20                 ; 0010_0000
6058   25C5 DA CA 25                           JP      C,L25CA             ; if game round < 2
6059   25C8 16 05                              LD      D,$05               ;
6060   25CA             L25CA:
6061   25CA 21 CC 43                           LD      HL,AlienBullet0State
6062   25CD             L25CD:
6063   25CD 7E                                 LD      A,(HL)              ;
6064   25CE E6 08                              AND     $08                 ; mask out 0000_1000
6065   25D0 CA E0 25                           JP      Z,L25E0             ; 
6066   25D3 7D                                 LD      A,L                 
6067   25D4 C6 04                              ADD     $04                 
6068   25D6 6F                                 LD      L,A                 
6069   25D7 15                                 DEC     D                   
6070   25D8 C2 CD 25                           JP      NZ,L25CD            ; 
6071   25DB E1                                 POP     HL                  
6072   25DC E1                                 POP     HL                  
6073   25DD C9                                 RET                         
6074   25DE             
6075   25E0                                    .ORG $25E0
6076   25E0             ;*****************************************************************************
6077   25E0             ;* Bullet spawner:
6078   25E0             ;* It fills that slot — marking it active, computing a bullet character/type from the position,
6079   25E0             ;* and storing the X/Y. The paired `POP HL` at the ends unwind the two dummy
6080   25E0             ;* stack frames the callers pushed, so control returns cleanly
6081   25E0             ;* regardless of whether a bullet was actually fired.
6082   25E0             ;*****************************************************************************
6083   25E0             L25E0:
6084   25E0 78                                 LD      A,B                 
