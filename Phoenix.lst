8746   3B02             ;*****************************************************************************
8747   3B02             ;* Background sound for level B (mothership).
8748   3B02             ;* Sound data is derived from Counter9A+1.
8749   3B02             ;*****************************************************************************
8750   3B02             L3B02:
8751   3B02 21 9A 43                           LD      HL,Counter9A        ; 
8752   3B05 7E                                 LD      A,(HL)              
8753   3B06 FE 02                              CP      $02                 
8754   3B08 D0                                 RET     NC                  
8755   3B09 2C                                 INC     L                   
8756   3B0A 7E                                 LD      A,(HL)              
8757   3B0B 47                                 LD      B,A                 
8758   3B0C E6 60                              AND     $60                 
8759   3B0E 2E 8D                              LD      L,$8D               
8760   3B10 36 0A                              LD      (HL),$0A            
8761   3B12 C0                                 RET     NZ                  
8762   3B13 78                                 LD      A,B                 
8763   3B14 E6 02                              AND     $02                 
8764   3B16 C6 1C                              ADD     $1C                 
8765   3B18 77                                 LD      (HL),A              
8766   3B19 C9                                 RET                         
8767   3B1A             
8768   3B1B                                    .ORG $3B1B
8769   3B1B             ;*****************************************************************************
8770   3B1B             ;* Ringtone sound for the player shield.
8771   3B1B             ;* Sound data is derived from player shield animation counter.
8772   3B1B             ;*****************************************************************************
8773   3B1B             L3B1B:
8774   3B1B 21 62 43                           LD      HL,M4362            ; 
8775   3B1E 7E                                 LD      A,(HL)              
8776   3B1F A7                                 AND     A                   ; updates the zero flag
8777   3B20 C8                                 RET     Z                   ; if $4362 is 0.
8778   3B21 FE 40                              CP      $40                 
8779   3B23 DA 28 3B                           JP      C,L3B28             ; 
8780   3B26 36 40                              LD      (HL),$40            
8781   3B28             L3B28:
8782   3B28 35                                 DEC     (HL)                
8783   3B29 7E                                 LD      A,(HL)              
8784   3B2A E6 06                              AND     $06                 
8785   3B2C 07                                 RLCA                        ; Multiply by 2
8786   3B2D 00                                 NOP                         
8787   3B2E 2E 8D                              LD      L,$8D               
8788   3B30 77                                 LD      (HL),A              
8789   3B31 C9                                 RET                         
