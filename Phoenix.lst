7488   350E C5                                 PUSH    BC                  ;
7489   350F 01 DF FF                           LD      BC,$FFDF            ; Screen offset constant -33 right one column (-1), up one row (-32)
7490   3512 EB                                 EX      DE,HL               ;
7491   3513 36 00                              LD      (HL),$00            ; delete character on screen
7492   3515 23                                 INC     HL                  ;
7493   3516 36 00                              LD      (HL),$00            ; delete character on screen
7494   3518 09                                 ADD     HL,BC               ;
7495   3519 C9                                 RET                         ; jumps to draw shape entry.
