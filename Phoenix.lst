3236   0E10                                    .ORG $0E10
3237   0E10             ;
3238   0E10             L0E10:
3239   0E10 0A                                 LD      A,(BC)              ; get player bullet state
3240   0E11 E6 08                              AND     $08                 ; mask out 0000_1000
3241   0E13 C8                                 RET     Z                   ; if bit3 not set
3242   0E14 56                                 LD      D,(HL)              ; get MSB screen ram adress
3243   0E15 2C                                 INC     L                   ;
3244   0E16 5E                                 LD      E,(HL)              ; get LSB screen ram adress
3245   0E17 1A                                 LD      A,(DE)              ; get character
3246   0E18 FE C0                              CP      $C0                 ; bullets and alien ($50 - $BF)
3247   0E1A D0                                 RET     NC                  ;
3248   0E1B FE 60                              CP      $60                 ; alien ($60 - $BF)
3249   0E1D D8                                 RET     C                   ; if no character
3250   0E1E FE 68                              CP      $68                 ; alien
3251   0E20 D2 39 0E                           JP      NC,L0E39            ; 
3252   0E23 E6 07                              AND     $07                 ; mask out 0000_0111
3253   0E25 07                                 RLCA                        ; Multiply by 4 ..
3254   0E26 07                                 RLCA                        ; ..
3255   0E27 C6 40                              ADD     $40                 ;
3256   0E29 6F                                 LD      L,A                 ;
3257   0E2A 26 17                              LD      H,T1740 >> 8        ; T1740
3258   0E2C 03                                 INC     BC                  ;
3259   0E2D 03                                 INC     BC                  ;
3260   0E2E 0A                                 LD      A,(BC)              ;
3261   0E2F E6 07                              AND     $07                 ;
3262   0E31 BE                                 CP      (HL)                ;
3263   0E32 D0                                 RET     NC                  ;
3264   0E33 23                                 INC     HL                  ;
3265   0E34 BE                                 CP      (HL)                ;
3266   0E35 D8                                 RET     C                   ;
3267   0E36 C3 70 0E                           JP      L0E70               ; 
