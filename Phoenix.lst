5495   22FA                                    .ORG $22FA
5496   22FA             ;*****************************************************************************
5497   22FA             ;* Rotate the conveyor belt:
5498   22FA             ;* How the "rotation" actually works:
5499   22FA             ;* Each belt tile is a code in `$60`–`$6F`, i.e. `$60 + p` where `p` is a 4-bit phase (0–15)
5500   22FA             ;* that selects which frame of the belt-link graphic is shown. The routine treats that 4-bit phase as two 2-bit halves.
5501   22FA             ;* - high half = bits 2–3
5502   22FA             ;* - low half = bits 0–1
5503   22FA             ;* Walking up the belt column (`L -= $20` each step), every tile is rebuilt as:
5504   22FA             ;* new_phase = (previous_tile.low2 << 2) | (current_tile.high2)
5505   22FA             ;* new_tile  = $60 | new_phase
5506   22FA             ;* In other words:
5507   22FA             ;* - a tile's new high 2 bits come from the lower neighbour's old low 2 bits, and
5508   22FA             ;* - its new low 2 bits come from its own old high 2 bits.
5509   22FA             ;* That is a 2-bit-per-tile shift register running up the column:
5510   22FA             ;* Every animation step, the belt-link pattern marches exactly one 2-bit field up the chain.
5511   22FA             ;* The seed value read from `$488A` feeds a fresh pattern into the bottom of the chain each step,
5512   22FA             ;* so the motion is continuous and never runs out of pattern.
5513   22FA             ;* Because the cumulative effect is "every belt segment's pattern shifts one position along the belt each tick",
5514   22FA             ;* the row of `$60`–`$6F` tiles cycles through their link graphics in lock-step — which the eye reads as the belt rotating/conveying.
5515   22FA             ;*****************************************************************************
5516   22FA             L22FA:
5517   22FA 21 AA 4A                           LD      HL,BackgroundScreen+$2AA     ; $4AAA = far end of the belt column
5518   22FD 06 12                              LD      B,$12               ; 18 belt tiles in the column
5519   22FF 3A 8A 48                           LD      A,(BackgroundScreen+$8A)     ; $488A = seed tile feeding the belt
5520   2302 4F                                 LD      C,A                 ; C = "incoming" pattern
5521   2303             L2303:
5522   2303 79                                 LD      A,C                 ; A = incoming/previous tile
5523   2304 E6 03                              AND     $03                 ; its low 2 bits (lower belt-link half)
5524   2306 07                                 RLCA                        ; << 2
5525   2307 07                                 RLCA                        ; 
5526   2308 57                                 LD      D,A                 ; D = (prev & 3) << 2  -> new HIGH half
5527   2309 4E                                 LD      C,(HL)              ; C = current tile (kept as 'previous' for next loop)
5528   230A 79                                 LD      A,C                 ; 
5529   230B E6 0C                              AND     $0C                 ; current tile's high 2 bits (upper half)
5530   230D 0F                                 RRCA                        ; >> 2
5531   230E 0F                                 RRCA                        ; -> new LOW half
5532   230F B2                                 OR      D                   ; combine: (prev_low<<2) | (cur_high>>2)
5533   2310 F6 60                              OR      $60                 ; force into belt tile range $60-$6F
5534   2312 77                                 LD      (HL),A              ; write the rotated belt tile back
5535   2313 7D                                 LD      A,L                 ; 
5536   2314 D6 20                              SUB     $20                 ; step one tile up the column
5537   2316 6F                                 LD      L,A                 ; 
5538   2317 D2 1B 23                           JP      NC,L231B            ; 
5539   231A 25                                 DEC     H                   ; 
5540   231B             L231B:
5541   231B 05                                 DEC     B                   ; 
5542   231C C2 03 23                           JP      NZ,L2303            ; repeat for all 18 tiles
5543   231F C9                                 RET                         ; 
5544   2320             
5545   2322                                    .ORG $2322
5546   2322             ;*****************************************************************************
5547   2322             ;* Animation of the mothership's antenna and the alien pilot.
5548   2322             ;*****************************************************************************
5549   2322             L2322:
5550   2322 21 A7 43                           LD      HL,AnimationCounter ; 
5551   2325 34                                 INC     (HL)                ; increment the animation counter
5552   2326 7E                                 LD      A,(HL)              ;
5553   2327 E6 07                              AND     $07                 ; mask out 0000_0111, in order to count from 0 to 7 for 8 frames
5554   2329 07                                 RLCA                        ; Multiply by 8 ..
5555   232A 07                                 RLCA                        ; ..to get..
5556   232B 07                                 RLCA                        ; ..the frame data adress (8 characters per frame)
5557   232C C6 C0                              ADD     T1BC0 & $FF         ; LSB of T1BC0
5558   232E 6F                                 LD      L,A                 ;
5559   232F 26 1B                              LD      H,T1BC0 >> 8        ; MSB of T1BC0
5560   2331 11 A6 49                           LD      DE,BackgroundScreen+$1A6; at the middle of the mothership
5561   2334 01 02 04                           LD      BC,$0402            ; images are 2x4
5562   2337 C3 D6 0A                           JP      DrawImageCbyB       ; 
5563   233A             
5564   233A             ; Intro-splash bird animation script table:
5565   233A             ; A list of bird shape indices that, played in order, make the attract-mode bird grow
5566   233A             ; from a twinkling star into a full flapping Phoenix and then shrink back.
5567   233A             ; Used at `DrawIntroBirdAnimationFrame` (`$21DC`).
5568   233A             ; The mapping is a two-level lookup:
5569   233A             ; M4399  --(>>3)-->  T233A[i] = shape index
5570   233A             ;                      |
5571   233A             ;                      +--(*8)--+--(+ M4399&7 phase)--> T3E08 entry --> bird tile-block address
5572   233A             ; So `T233A` is essentially a tiny animation timeline.
5573   233A             ; The index `M4399 >> 3` walks through it, each step lasting 8 ticks (during which `M4399 & 7` animates the wings),
5574   233A             ; turning the abstract growth/flap/shrink choreography into concrete shape indices that `DrawBirdObject` renders.
5575   233A             ; The trailing `FF` signals the end of the script (it's the sentinel the surrounding intro logic uses to know the sequence is finished).
5576   233A             T233A:
5577   233A 01 02 03 04                        .DB $01, $02, $03, $04                              ; star, small, medium, big, cluster (a twinkle appears and swells)
5578   233E 05 06 07                           .DB $05, $06, $07,                                  ; growing-up body stages (it sprouts into a bird)
5579   2341 0A 07 0A 07                        .DB $0A, $07, $0A, $07, $0A, $07, $0A, $07, $0A     ; wings down, wings up, ... (the bird flaps in place)
5579   2345 0A 07 0A 07 
5579   2349 0A 
5580   234A 09 08 04 03                        .DB $09, $08, $04, $03, $02, $01                    ; shrinking stages (the bird collapses back to a star)
5580   234E 02 01 
5581   2350 FF                                 .DB $FF                                             ; end-of-sequence marker
5582   2351             
5583   2351             ;*****************************************************************************
5584   2351             ;* Mother-ship collision routine:
5585   2351             ;* During the mother-ship levels (game level ≥ 8), `L2000` -> `L24A0` calls `L2351`.
5586   2351             ;* It looks up the tile at the (scroll-adjusted) bullet position 
5587   2351             ;* and explicitly tests for the `$4C`–`$4F` group.
5588   2351             ;* `L2351` is called with `DE` = the bullet's control-state record and
5589   2351             ;* `HL` = its live screen-address pair. Both are the player bullet (object 1 of the player grid).
5590   2351             ;* `$43E6`/`$43E7` is the current position written each frame
5591   2351             ;* by `GetScreenRamAddress` (the listing labels it `AbovePlayerBulletMSB`).
5592   2351             ;* Two details make this work:
5593   2351             ;* - `ADD $08` on the MSB converts the bullet's foreground address (`$40`–`$43`)
5594   2351             ;*   into the matching background address (`$48`–`$4B`), because the mother ship is drawn in the background plane.
5595   2351             ;* - Scroll compensation adjusts only the low 5 bits (the vertical row on the rotated screen)
5596   2351             ;*   by `CounterB9 >> 3`, preserving the horizontal field — the same technique as `L242C`,
5597   2351             ;*   but adding the offset here rather than subtracting.
5598   2351             ;* From there the tile decides the outcome: `$4C`–`$4F` erodes the dome
5599   2351             ;* (`L237B`, decrementing the tile and cascading into `$4F` at the edge),
5600   2351             ;* `$60`–`$6F` hits the purple conveyor belt (`L2398`),
5601   2351             ;* which in turn can reach the alien pilot and trigger `L23C0` -> game state 6.
5602   2351             ;*****************************************************************************
5603   2351             L2351:
5604   2351 1A                                 LD      A,(DE)              ; 
5605   2352 E6 08                              AND     $08                 ; 0000_1000
5606   2354 C8                                 RET     Z                   ; no bullet in flight
5607   2355 7E                                 LD      A,(HL)              ; screen MSB
5608   2356 2C                                 INC     L                   ; 
5609   2357 6E                                 LD      L,(HL)              ; screen LSB
5610   2358 C6 08                              ADD     $08                 ; $4x -> $4x+8 : foreground to background plane
5611   235A 67                                 LD      H,A                 ; 
5612   235B 3A B9 43                           LD      A,(CounterB9)       ; 
5613   235E 0F                                 RRCA                        ; 
5614   235F 0F                                 RRCA                        ; 
5615   2360 0F                                 RRCA                        ; scroll offset in character rows
5616   2361 85                                 ADD     A,L                 ; 
5617   2362 E6 1F                              AND     $1F                 ; 0001_1111 wrap within the row field
5618   2364 47                                 LD      B,A                 ; 
5619   2365 7D                                 LD      A,L                 ; 
5620   2366 E6 E0                              AND     $E0                 ; 1110_0000 keep the horizontal field
5621   2368 B0                                 OR      B                   ; 
5622   2369 6F                                 LD      L,A                 ; 
5623   236A 7E                                 LD      A,(HL)              ; background tile under the bullet
5624   236B 47                                 LD      B,A                 ; 
5625   236C E6 FC                              AND     $FC                 ; mask low 2 bits -> $4C/$4D/$4E/$4F all -> $4C
5626   236E FE 4C                              CP      $4C                 ; 
5627   2370 CA 7B 23                           JP      Z,L237B             ; hit the mother-ship SHIELD
5628   2373 E6 F0                              AND     $F0                 ; 1111_0000
5629   2375 FE 60                              CP      $60                 ; tile in $60..$6F ?
5630   2377 CA 98 23                           JP      Z,L2398             ; -> conveyor-belt hit handler
5631   237A C9                                 RET                         ; anything else -> no hit
5632   237B             
5633   237B             ;*****************************************************************************
5634   237B             ;* The mothership's protective shield was hit by a player bullet.
5635   237B             ;* Shield erosion.
5636   237B             ;* So a hit on a `$4C`–`$4F` tile does the following, with no score awarded:
5637   237B             ;* 1. The bullet is consumed (`AND $F7` clears the active bit) — the shot stops there; it does not punch through.
5638   237B             ;* 2. A "mother-ship hit" is registered (`$4366 = $FF`), which drives the hit sound effect.
5639   237B             ;* 3. The tile is decremented one step: `$4F -> $4E -> $4D -> $4C -> $4B`.
5640   237B             ;*    Because the four tiles are an increasing-density gradient, each shot visually "chips" the curved armour one notch thinner.
5641   237B             ;* 4. When a tile erodes to `$4B` it's cleared to `$00` (that chunk of shield is gone).
5642   237B             ;*    If the tile behind it is the solid hull `$5E`, that hull tile is turned into a fresh `$4F`,
5643   237B             ;*    i.e. the next layer of hull becomes the new erodible shield edge.
5644   237B             ;*****************************************************************************
5645   237B             L237B:
5646   237B 1A                                 LD      A,(DE)              ; 
5647   237C E6 F7                              AND     $F7                 ; clear bit3 -> consume/deactivate the bullet
5648   237E 12                                 LD      (DE),A              ; 
5649   237F 3E FF                              LD      A,$FF               ; set flag for
5650   2381 32 66 43                           LD      (M4366),A           ; set 'Mothership hit detected' flag (hit sound)
5651   2384 78                                 LD      A,B                 ; the tile that was hit
5652   2385 3D                                 DEC     A                   ; $4F->$4E->$4D->$4C->$4B  (one gradient step)
5653   2386 77                                 LD      (HL),A              ; write the eroded tile back to the screen
5654   2387 FE 4B                              CP      $4B                 ; 
5655   2389 C0                                 RET     NZ                  ; not fully eroded yet -> done
5656   238A 36 00                              LD      (HL),$00            ; reached $4B -> remove this shield piece
5657   238C 2D                                 DEC     L                   ; 
5658   238D 7E                                 LD      A,(HL)              ; the tile behind it
5659   238E FE 5E                              CP      $5E                 ; solid mother-ship body?
5660   2390 C0                                 RET     NZ                  ; 
5661   2391 36 4F                              LD      (HL),$4F            ; convert body $5E -> $4F (expose next shield layer)
5662   2393 C9                                 RET                         ; 
5663   2394             
5664   2398                                    .ORG $2398
5665   2398             ;*****************************************************************************
5666   2398             ;* Belt-hit handler:
5667   2398             ;*****************************************************************************
5668   2398             L2398:
5669   2398 1A                                 LD      A,(DE)              ; 
5670   2399 E6 F7                              AND     $F7                 ; consume/deactivate the bullet
5671   239B 12                                 LD      (DE),A              ; 
5672   239C 1C                                 INC     E                   ; 
5673   239D 1C                                 INC     E                   ; DE -> PlayerBulletX
5674   239E 1A                                 LD      A,(DE)              ; 
5675   239F E6 04                              AND     $04                 ; which half of the belt (by bullet X)
5676   23A1 78                                 LD      A,B                 ; B = the belt tile that was hit
5677   23A2 C2 30 20                           JP      NZ,L2030            ; right half -> use table $1B50
5678   23A5 E6 0C                              AND     $0C                 ; 0000_1100
5679   23A7 FE 04                              CP      $04                 ; 
5680   23A9 11 40 1B                           LD      DE,$1B40            ; left half -> use table $1B40 belt-damage remap table
5681   23AC             L23AC:
5682   23AC CA C0 23                           JP      Z,L23C0             ; segment in front of the pilot -> destroy ship
5683   23AF 78                                 LD      A,B                 ; the purple conveyor belt was hit
5684   23B0 E6 0F                              AND     $0F                 ; low nibble 0..F
5685   23B2 83                                 ADD     A,E                 ; DE = $1B40 + (tile & $0F)
5686   23B3 5F                                 LD      E,A                 ; index into belt-parts table (T1B40/T1B48/T1B50)
5687   23B4 1A                                 LD      A,(DE)              ; 
5688   23B5 77                                 LD      (HL),A              ; replace tile with a 'damaged' belt tile
5689   23B6 3E FF                              LD      A,$FF               ; set flag for
5690   23B8 32 66 43                           LD      (M4366),A           ; 'Mothership hit detected' (hit sound)
5691   23BB C9                                 RET                         ; 
5692   23BC             
5693   23C0                                    .ORG $23C0
5694   23C0             ;*****************************************************************************
5695   23C0             ;* The mothership will be destroyed if an alien pilot is hit.
5696   23C0             ;* If the hit lands on the belt segment directly in front of the alien pilot,
5697   23C0             ;* `L23AC` takes the `JP Z,L23C0` branch instead, which checks whether the tile behind
5698   23C0             ;* is a pilot tile (`$70`-range) and, if so, destroys the mother ship.
5699   23C0             ;*****************************************************************************
5700   23C0             L23C0:
5701   23C0 2D                                 DEC     L                   ; 
5702   23C1 7E                                 LD      A,(HL)              ; 
5703   23C2 E6 F0                              AND     $F0                 ; 1111_0000
5704   23C4 FE 70                              CP      $70                 ; background tiles code of alien pilot
5705   23C6 C0                                 RET     NZ                  ; not the pilot -> nothing
5706   23C7 21 A4 43                           LD      HL,GameState        ; Next interval game state ...
5707   23CA 36 06                              LD      (HL),$06            ; ... is 6 (mother ship partikel explosion)
5708   23CC 2C                                 INC     L                   ; CounterA5
5709   23CD 36 60                              LD      (HL),$60            ; set counter value for
5710   23CF 2E 63                              LD      L,$63               ; ParticleExplosion
5711   23D1 36 FF                              LD      (HL),$FF            ; Set flag for: 'particle explosion start'
5712   23D3 C9                                 RET                         ; 
5713   23D4             
5714   23D6                                    .ORG $23D6
5715   23D6             ;*****************************************************************************
5716   23D6             ;* Background sound update.
5717   23D6             ;*****************************************************************************
5718   23D6             L23D6:
5719   23D6 21 B8 43                           LD      HL,LevelAndRound    ; 
5720   23D9 7E                                 LD      A,(HL)              ;
5721   23DA E6 0F                              AND     $0F                 ; mask out 0000_1111
5722   23DC FE 01                              CP      $01                 ;
5723   23DE CA 98 3A                           JP      Z,L3A98             ; if game level is 1 (1st alien wave)
5724   23E1 FE 03                              CP      $03                 ;
5725   23E3 CA 98 3A                           JP      Z,L3A98             ; if game level is 3 (2nd alien wave)
5726   23E6 FE 05                              CP      $05                 ;
5727   23E8 CA D0 3A                           JP      Z,L3AD0             ; if game level is 5 (1st bird wave)
5728   23EB FE 07                              CP      $07                 ;
5729   23ED CA D0 3A                           JP      Z,L3AD0             ; if game level is 7 (2nd bird wave)
5730   23F0 FE 09                              CP      $09                 ;
5731   23F2 D8                                 RET     C                   ; if game level is 9 (mothership 'fade in')
5732   23F3 FE 0B                              CP      $0B                 ;
5733   23F5 DA 02 3B                           JP      C,L3B02             ; if game level is B (mothership)
5734   23F8 CD 02 3B                           CALL    L3B02               ; Background sound for level B (mothership)
5735   23FB C3 98 3A                           JP      L3A98               ; Background sound for the alien waves
5736   23FE             
5737   2400                                    .ORG $2400
5738   2400             ;*****************************************************************************
5739   2400             ;* Game state 6.
5740   2400             ;* Mother ship partikel explosion.
5741   2400             ;*****************************************************************************
5742   2400             L2400:
5743   2400 CD 2C 24                           CALL    L242C               ; Shared per-frame prologue for game state 6
5744   2403 CA 52 25                           JP      Z,L2552             ; timer expired -> state 7, score display
5745   2406 FE 20                              CP      $20                 ; 
5746   2408 DA 6A 24                           JP      C,EraseMothership   ; last $20 frames: wipe the hull
5747   240B CA 20 25                           JP      Z,L2520             ; exactly $20: Calculation and display of the bonus score for mothership explosion
5748   240E 47                                 LD      B,A                 ; 
5749   240F 0F                                 RRCA                        ; 
5750   2410 00                                 NOP                         ; 
5751   2411 78                                 LD      A,B                 ; 
5752   2412 D2 E8 20                           JP      NC,L20E8            ; 
5753   2415 7B                                 LD      A,E                 ; 
5754   2416 D6 05                              SUB     $05                 ; 
5755   2418 C6 C0                              ADD     $C0                 ; 
5756   241A 4F                                 LD      C,A                 ; 
5757   241B 7A                                 LD      A,D                 ; 
5758   241C CE 00                              ADC     $00                 ; 
5759   241E 47                                 LD      B,A                 ; 
5760   241F 7E                                 LD      A,(HL)              ; 
5761   2420 11 00 2A                           LD      DE,T2A00            ; get the foreground tiles of the mothership particles explosion
5762   2423 21 00 2B                           LD      HL,T2B00            ; get the control data
5763   2426 C3 85 20                           JP      L2085               ; 
5764   2429             
5765   242C                                    .ORG $242C
5766   242C             ;*****************************************************************************
5767   242C             ;* Shared per-frame prologue for game state 6:
5768   242C             ;* It does three things: freezes the background scroll on a character boundary
5769   242C             ;* and re-programs the `58xx` scroll register, computes the scroll-compensated
5770   242C             ;* foreground screen origin for the explosion into `DE`,
5771   242C             ;* and ticks the state timer `CounterA5` down, returning it in `A` with the `Z` flag set on expiry.
5772   242C             ;* `L242C` therefore holds the scroll still: `AND $F8` rounds `CounterB9` down to a whole character row,
5773   242C             ;* stores it back, and re-programs the register with that value every frame.
5774   242C             ;* The background stops drifting, and — importantly for the next step,
5775   242C             ;* the scroll offset is guaranteed to be an exact multiple of 8 pixels.
5776   242C             ;*****************************************************************************
5777   242C             L242C:
5778   242C 21 B9 43                           LD      HL,CounterB9        ; 
5779   242F 7E                                 LD      A,(HL)              ; 
5780   2430 E6 F8                              AND     $F8                 ; 1111_1000 drop the 3 sub-character bits
5781   2432 77                                 LD      (HL),A              ; write the aligned value back
5782   2433 32 00 58                           LD      (scrollRegister),A  ; 58xx scroll register58xx scroll register
5783   2436 11 C6 41                           LD      DE,$41C6            ; mother-ship origin, foreground plane
5784   2439 0F                                 RRCA                        ; A = CounterB9 / 8
5785   243A 0F                                 RRCA                        ;   (clean shift: low 3 bits are 0)
5786   243B 0F                                 RRCA                        ; 
5787   243C 47                                 LD      B,A                 ; B = scroll offset in character rows
5788   243D 7B                                 LD      A,E                 ; $C6
5789   243E 90                                 SUB     B                   ; 
5790   243F E6 1F                              AND     $1F                 ; 0001_1111 wrap within the 5-bit row field
5791   2441 47                                 LD      B,A                 ; 
5792   2442 7B                                 LD      A,E                 ; $C6
5793   2443 E6 E0                              AND     $E0                 ; 1110_0000 keep the horizontal field ($C0)
5794   2445 B0                                 OR      B                   ; 
5795   2446 5F                                 LD      E,A                 ; E = $C0 | (($C6 - scroll) & $1F)
5796   2447 2E A5                              LD      L,$A5               ; CounterA5
5797   2449 35                                 DEC     (HL)                ; <- the flags the caller tests
5798   244A 7E                                 LD      A,(HL)              ; 
5799   244B C9                                 RET                         ; 
5800   244C             
5801   244C             ;*****************************************************************************
5802   244C             ;* Game state 7.
5803   244C             ;* Mother ship score display.
5804   244C             ;*****************************************************************************
5805   244C             L244C:
5806   244C 21 A5 43                           LD      HL,CounterA5        ; 
5807   244F 35                                 DEC     (HL)                ;
5808   2450 7E                                 LD      A,(HL)              ;
5809   2451 0F                                 RRCA                        ;
5810   2452 DA F0 06                           JP      C,L06F0             ; update scroll register and fill background
5811   2455 A7                                 AND     A                   ; updates the zero flag
5812   2456 C0                                 RET     NZ                  ;
5813   2457 2D                                 DEC     L                   ;
5814   2458 36 02                              LD      (HL),$02            ;
5815   245A 2E B8                              LD      L,$B8               ; LevelAndRound
5816   245C 7E                                 LD      A,(HL)              ;
5817   245D E6 F0                              AND     $F0                 ; 1111_0000
5818   245F C6 10                              ADD     $10                 ; go to next round and ..
5819   2461 77                                 LD      (HL),A              ; .. store at LevelAndRound $43B8
5820   2462 2E BA                              LD      L,$BA               ;
5821   2464 36 10                              LD      (HL),$10            ; set AliensLeft to 16
5822   2466 C3 80 03                           JP      ClearForeground     ; 
5823   2469             
5824   246A                                    .ORG $246A
5825   246A             ;*****************************************************************************
5826   246A             ;* EraseMothership:
5827   246A             ;*****************************************************************************
5828   246A             EraseMothership:
5829   246A 01 14 09                           LD      BC,$0914            ; 20x9 image
5830   246D 11 C6 4A                           LD      DE,$4AC6            ; Screen coordinate of mother ship
5831   2470 21 00 1C                           LD      HL,$1C00            ; Background stars to erase the mother ship
5832   2473 C3 D6 0A                           JP      DrawImageCbyB       ; Erase the mother ship
5833   2476             
5834   2476             ;*****************************************************************************
5835   2476             ;* Re-arms the bird attack cycle:
5836   2476             ;* It runs once each time the bird dwell timer `B4BD3` expires and computes two fresh values:
5837   2476             ;* A new dwell time for `B4BD3` (how long until the next re-arm) and a new descent threshold `B4BD1`
5838   2476             ;* (how far the formation is allowed to scroll down before the direction flips).
5839   2476             ;* Both are derived from the surviving birds' vertical spread, the kill count,
5840   2476             ;* the frame counter, and the wave randomiser `M436F`.
5841   2476             ;* Notes
5842   2476             ;* - `RLCA` at `$2484`, `$2488` and `$26BD` is a rotate, not a shift.
5843   2476             ;*   For the small values involved it acts as ×2, but a value ≥ `$80` would wrap its top bit into bit 0.
5844   2476             ;* - Only `L` is reloaded throughout; `H` stays `$4B` for the `B4BDx` writes and `$43` after `$247E`.
5845   2476             ;*****************************************************************************
5846   2476             L2476:
5847   2476 78                                 LD      A,B                 ; 
5848   2477 81                                 ADD     A,C                 ; A = B + C
5849   2478 CD 95 24                           CALL    L2495               ; unrolled multiply
5850   247B 2E D3                              LD      L,$D3               ; $4BD3 countdown timer between bird attacks ("bird extended storage")
5851   247D 77                                 LD      (HL),A              ; B4BD3 = new dwell time
5852   247E 21 BB 43                           LD      HL,BirdsLeft        ; 
5853   2481 3E 08                              LD      A,$08               ; number of birds
5854   2483 96                                 SUB     (HL)                ; birds already killed
5855   2484 07                                 RLCA                        ; Multiply by 2
5856   2485 2E 9A                              LD      L,$9A               ; Counter9A
5857   2487 86                                 ADD     A,(HL)              ; 
5858   2488 07                                 RLCA                        ; Multiply by 2
5859   2489 47                                 LD      B,A                 ; 
5860   248A             ; Attack timing / launch slot                      
5861   248A 2E 6F                              LD      L,$6F               ; $436F (random)
5862   248C 7E                                 LD      A,(HL)              ; 
5863   248D E6 1E                              AND     $1E                 ; 0001_1110 random even value 0..$1E
5864   248F 80                                 ADD     A,B                 ; B from (8-BirdsLeft) & Counter9A
5865   2490 32 D1 4B                           LD      (B4BD1),A           ; new descent turnaround threshold (max depth)
5866   2493 C9                                 RET                         ; 
5867   2494             
5868   2495                                    .ORG $2495
5869   2495             ;*****************************************************************************
5870   2495             ;* Unrolled multiply:
5871   2495             ;* `L2495` is a hand-unrolled "add `B` up to three times, then maybe double" helper.
5872   2495             ;*****************************************************************************
5873   2495             L2495:
5874   2495 80                                 ADD     A,B                 ; 
5875   2496 0D                                 DEC     C                   ; 
5876   2497 C8                                 RET     Z                   ; 
5877   2498 80                                 ADD     A,B                 ; 
5878   2499 0D                                 DEC     C                   ; 
5879   249A C8                                 RET     Z                   ; 
5880   249B 80                                 ADD     A,B                 ; 
5881   249C 0D                                 DEC     C                   ; 
5882   249D C8                                 RET     Z                   ; 
5883   249E 87                                 ADD     A,A                 ; 
5884   249F C9                                 RET                         ; 
5885   24A0             
5886   24A0             ;*****************************************************************************
5887   24A0             ;* Mother-ship hook in the main gameplay loop:
5888   24A0             ;* On the mother-ship level it does two things per frame:
5889   24A0             ;* Tests the player's bullet against the mother-ship structure (hull dome or conveyor belt) and,
5890   24A0             ;* every fourth frame, gives the mother ship a chance to drop a bomb aimed at the player.
5891   24A0             ;* On every other level it returns immediately.
5892   24A0             ;*****************************************************************************
5893   24A0             L24A0:
5894   24A0 3A B8 43                           LD      A,(LevelAndRound)   ; 
5895   24A3 E6 0F                              AND     $0F                 ; mask out 0000_1111
5896   24A5 FE 08                              CP      $08                 ;
5897   24A7 D8                                 RET     C                   ; return if game level < 8
5898   24A8 11 C4 43                           LD      DE,PlayerBulletState
5899   24AB 21 E6 43                           LD      HL,AbovePlayerBulletMSB
5900   24AE CD 51 23                           CALL    L2351               ; bullet vs. mother ship
5901   24B1 3A 9B 43                           LD      A,(Counter9A+$1)    ; 
5902   24B4 E6 03                              AND     $03                 ; mask out 0000_0011
5903   24B6 FE 03                              CP      $03                 ;
5904   24B8 C0                                 RET     NZ                  ; only on 1 frame in 4
5905   24B9 C3 F2 24                           JP      L24F2               ; mother ship returns fire
5906   24BC             
5907   24C4                                    .ORG $24C4
5908   24C4             ;*****************************************************************************
5909   24C4             ;* The mother-ship level handlers (`L2130`/`L2146`/`L21BA`/`L21C5`) all call `L24C4` every frame.
5910   24C4             ;* `L24C4` bumps a frame counter (`$43AA`) and time-slices two animations:
5911   24C4             ;* The antenna/pilot animation `L2322` runs on 3 of every 4 frames,
5912   24C4             ;* and the belt rotation `L22FA` runs on the 4th.
5913   24C4             ;*****************************************************************************
5914   24C4             L24C4:
5915   24C4 3A B8 43                           LD      A,(LevelAndRound)   ; 
5916   24C7 E6 0F                              AND     $0F                 ; mask out 0000_1111
5917   24C9 FE 08                              CP      $08                 ;
5918   24CB DA F0 06                           JP      C,L06F0             ; level < 8: just scroll stars
5919   24CE CD E0 24                           CALL    L24E0               ; 
5920   24D1 21 AA 43                           LD      HL,M43AA            ; Mothership-wave frame counter
5921   24D4 34                                 INC     (HL)                ; mother-ship frame counter
5922   24D5 7E                                 LD      A,(HL)              ;
5923   24D6 E6 03                              AND     $03                 ; mask out 0000_0011
5924   24D8 CA FA 22                           JP      Z,L22FA             ; every 4th frame: rotate the conveyor belt
5925   24DB C3 22 23                           JP      L2322               ; Animation of the mothership's antenna and the alien pilot
5926   24DE             
5927   24E0                                    .ORG $24E0
5928   24E0             ;
5929   24E0             L24E0:
5930   24E0 3A AA 43                           LD      A,(M43AA)           ; Mothership-wave frame counter
5931   24E3 E6 0F                              AND     $0F                 ; 0000_1111
5932   24E5 C0                                 RET     NZ                  ; 
5933   24E6 3A B9 43                           LD      A,(CounterB9)       ; 
5934   24E9 FE A0                              CP      $A0                 ; 
5935   24EB D8                                 RET     C                   ; gate stars-scroll
5936   24EC C3 7A 06                           JP      StarsScrollDown     ; 
5937   24EF             
5938   24F2                                    .ORG $24F2
5939   24F2             ;*****************************************************************************
5940   24F2             ;* Mother ship bomb attack (reached from L24A0 on level >= 8, when
5941   24F2             ;* Counter9A+1 & 3 == 3). Randomly targets the player's column, then fires.
5942   24F2             ;* Purpose:
5943   24F2             ;* On mother ship levels this fires a bomb only when a random number happens
5944   24F2             ;* to line up horizontally with the player ship (a "semi aimed" attack,
5945   24F2             ;* further rate limited by the `Counter9A` gate). It builds the bomb's `B`=X / `C`=Y
5946   24F2             ;* (Y derived from the scroll counter) and jumps into the shared spawner `L25B7`.
5947   24F2             ;* The two `PUSH HL` match the two `POP HL` that `L25B7`/`L25E0` do on exit.
5948   24F2             ;*****************************************************************************
5949   24F2             L24F2:
5950   24F2 CD AA 30                           CALL    GetRandomNumber     ; 
5951   24F5 C6 60                              ADD     $60                 ; candidate X in the playfield
5952   24F7 00                                 NOP                         ; 
5953   24F8 47                                 LD      B,A                 ; B = random target X ($60 + rnd)
5954   24F9 21 9B 43                           LD      HL,Counter9A+$1    ;; 
5955   24FC E6 0E                              AND     $0E                 ; 0000_1110
5956   24FE A6                                 AND     (HL)                ; 
5957   24FF C0                                 RET     NZ                  ; probabilistic gate: usually skip
5958   2500 3A 9E 43                           LD      A,(M439E)           ; player ship left bound
5959   2503 B8                                 CP      B                   ; 
5960   2504 D0                                 RET     NC                  ; target left of player -> skip
5961   2505 3A 9F 43                           LD      A,(M439F)           ; player ship right bound
5962   2508 B8                                 CP      B                   ; 
5963   2509 D8                                 RET     C                   ; target right of player -> skip
5964   250A 78                                 LD      A,B                 ; target aligns with the player
5965   250B D6 04                              SUB     $04                 ; bomb X
5966   250D 47                                 LD      B,A                 ; B = bomb X
5967   250E 3A B9 43                           LD      A,(CounterB9)       ; 
5968   2511 2F                                 CPL                         ; 
5969   2512 3C                                 INC     A                   ; = -CounterB9
5970   2513 E6 F8                              AND     $F8                 ; 1111_1000 -CounterB9, character aligned
5971   2515 C6 48                              ADD     $48                 ; bomb Y, follows the scroll
5972   2517 4F                                 LD      C,A                 ; C = bomb Y (from scroll position)
5973   2518 E5                                 PUSH    HL                  ; 
5974   2519 E5                                 PUSH    HL                  ; two dummy stack frames for L25B7's POPs
5975   251A C3 B7 25                           JP      L25B7               ; fire the enemy bullet
5976   251D             
5977   2520                                    .ORG $2520
5978   2520             ;*****************************************************************************
5979   2520             ;* The 'alien pilot' at mothership was hit.
5980   2520             ;* Calculation and display of the bonus score for mothership explosion.
5981   2520             ;*****************************************************************************
5982   2520             L2520:
5983   2520 D5                                 PUSH    DE                  ;
5984   2521 CD 80 03                           CALL    ClearForeground     ; remove all but the rest of the mothership
5985   2524 D1                                 POP     DE                  ;
5986   2525 3A B9 43                           LD      A,(CounterB9)       ; get value from 8 bit backwards counter
5987   2528 C6 60                              ADD     $60                 ; use it for a ...
5988   252A 0F                                 RRCA                        ; ... score value
5989   252B 47                                 LD      B,A                 ; save it
5990   252C 3A B8 43                           LD      A,(LevelAndRound)   ; 
5991   252F E6 F0                              AND     $F0                 ; mask out 1111_0000 (bit4 - 7: game round)
5992   2531 80                                 ADD     A,B                 ; add score value
5993   2532 06 90                              LD      B,$90               ;
5994   2534 DA 3D 25                           JP      C,L253D             ; 
5995   2537 FE 90                              CP      $90                 ;
5996   2539 D2 3D 25                           JP      NC,L253D            ; if >= $90
5997   253C 47                                 LD      B,A                 ;
5998   253D             L253D:
5999   253D AF                                 XOR     A                   ; A=0
6000   253E 78                                 LD      A,B                 ;
6001   253F 27                                 DAA                         ; adjust for BCD
6002   2540 21 9D 43                           LD      HL,M439D            ; 
6003   2543 77                                 LD      (HL),A              ; set value for fist two digits of BCD score
6004   2544 2C                                 INC     L                   ;
6005   2545 36 00                              LD      (HL),$00            ; last two digits of BCD score set to '00'
6006   2547 7B                                 LD      A,E                 ; get LSB of screen ram...
6007   2548 D6 5E                              SUB     $5E                 ; ...
6008   254A 5F                                 LD      E,A                 ; ...
6009   254B 06 04                              LD      B,$04               ; number of digits to print
6010   254D C3 C4 00                           JP      PrintNumber         ; score for mothership explosion
6011   2550             
6012   2552                                    .ORG $2552
6013   2552             ;
6014   2552             L2552:
6015   2552 2E A4                              LD      L,$A4               ; GameState
6016   2554 36 07                              LD      (HL),$07            ; set to 'mother ship score display'
6017   2556 2C                                 INC     L                   ; CounterA5
6018   2557 36 40                              LD      (HL),$40            ; set it
6019   2559 2E 6B                              LD      L,$6B               ; $436B
6020   255B 36 FF                              LD      (HL),$FF            ; set flag for 'mother ship score display'
6021   255D C9                                 RET                         ; 
6022   255E             
6023   2560                                    .ORG $2560
6024   2560             ;*****************************************************************************
6025   2560             ;* Alien bomb-drop: pick a group of 8 aliens, find one lined up with the
6026   2560             ;* player at attack depth, and fire an enemy bullet at it.
6027   2560             ;* Purpose:
6028   2560             ;* `L2560` is the alien bomb drop selector. 
6029   2560             ;* It picks one of two 8 alien groups (alternating on `Counter93`),
6030   2560             ;* computes the player's horizontal window (`B`,`C`) and the required attack depth `D`
6031   2560             ;* (scaled by the attack escalation counter `$4357`), then scans the group with `L2596`.
6032   2560             ;*****************************************************************************
6033   2560             L2560:
6034   2560 21 93 43                           LD      HL,Counter93        ; 
6035   2563 7E                                 LD      A,(HL)              ; 
6036   2564 E6 01                              AND     $01                 ; 0000_0001 alternate between the two halves...
6037   2566 07                                 RLCA                        ; Multiply by 32 ..
6038   2567 07                                 RLCA                        ; ..
6039   2568 07                                 RLCA                        ; ..
6040   2569 07                                 RLCA                        ; ..
6041   256A 07                                 RLCA                        ; ...(0 or $20)
6042   256B C6 70                              ADD     $70                 ; 
6043   256D 6F                                 LD      L,A                 ; 
6044   256E 26 4B                              LD      H,$4B               ; HL = $4B70 or $4B90 (8-alien group)
6045   2570 1E 08                              LD      E,$08               ; 8 aliens to scan
6046   2572 3A 57 43                           LD      A,(M4357)           ; attack escalation counter
6047   2575 07                                 RLCA                        ; Multiply by 8 ..
6048   2576 07                                 RLCA                        ; ..
6049   2577 07                                 RLCA                        ; ..
6050   2578 00                                 NOP                         ; 
6051   2579 C6 AD                              ADD     $AD                 ; 
6052   257B 57                                 LD      D,A                 ; D = Y depth threshold
6053   257C 3A 9F 43                           LD      A,(M439F)           ; 
6054   257F C6 03                              ADD     $03                 ; 
6055   2581 4F                                 LD      C,A                 ; C = player right bound + 3
6056   2582 3A 9E 43                           LD      A,(M439E)           ; 
6057   2585 D6 0A                              SUB     $0A                 ; 
6058   2587 47                                 LD      B,A                 ; B = player left bound - $0A
6059   2588             L2588:
6060   2588 E5                                 PUSH    HL                  ; 
6061   2589 CD 96 25                           CALL    L2596               ; test this alien
6062   258C E1                                 POP     HL                  ; 
6063   258D 7D                                 LD      A,L                 ; 
6064   258E C6 04                              ADD     $04                 ; 
6065   2590 6F                                 LD      L,A                 ; next alien entry
6066   2591 1D                                 DEC     E                   ; 
6067   2592 C2 88 25                           JP      NZ,L2588            ; loop 8 aliens
6068   2595 C9                                 RET                         ; 
6069   2596             ;*****************************************************************************
6070   2596             ;* Per-alien attack candidacy test. HL -> alien entry.
6071   2596             ;* Must be active, valid shape, horizontally over the player, and deep enough.
6072   2596             ;* `L2596` accepts an alien that is active, a valid shape, horizontally over the player,
6073   2596             ;* and deep enough on screen. When one qualifies it loads its position into `B`/`C` and drops into `L25B7`.
6074   2596             ;*****************************************************************************
6075   2596             L2596:
6076   2596 7E                                 LD      A,(HL)              ; control state (+0)
6077   2597 E6 08                              AND     $08                 ; 0000_1000
6078   2599 C8                                 RET     Z                   ; not active -> skip
6079   259A 2C                                 INC     L                   ; +1 shape/char
6080   259B 7E                                 LD      A,(HL)              ; 
6081   259C FE 08                              CP      $08                 ; 
6082   259E C8                                 RET     Z                   ; skip specific value
6083   259F FE 88                              CP      $88                 ; 
6084   25A1 D0                                 RET     NC                  ; shape out of range -> skip
6085   25A2 2C                                 INC     L                   ; +2 screen X
6086   25A3 7E                                 LD      A,(HL)              ; 
6087   25A4 B8                                 CP      B                   ; 
6088   25A5 D8                                 RET     C                   ; left of player -> skip
6089   25A6 B9                                 CP      C                   ; 
6090   25A7 D0                                 RET     NC                  ; right of player -> skip
6091   25A8 2C                                 INC     L                   ; +3 screen Y
6092   25A9 7E                                 LD      A,(HL)              ; 
6093   25AA BA                                 CP      D                   ; 
6094   25AB D0                                 RET     NC                  ; not deep enough -> skip
6095   25AC FE 80                              CP      $80                 ; 
6096   25AE D8                                 RET     C                   ; too high -> skip
6097   25AF 00                                 NOP                         ; (patched-out code)
6098   25B0 00                                 NOP                         ; 
6099   25B1 00                                 NOP                         ; 
6100   25B2 00                                 NOP                         ; 
6101   25B3 00                                 NOP                         ; 
6102   25B4 4F                                 LD      C,A                 ; C = alien Y
6103   25B5 2D                                 DEC     L                   ; back to +2
6104   25B6 46                                 LD      B,(HL)              ; B = alien X  (fall into spawner)
6105   25B7             ;*****************************************************************************
6106   25B7             ;* Fire the enemy bullet (shared by alien and mother-ship attacks):
6107   25B7             ;* Finds a free enemy-bullet slot (max 3/4/5 depending on round) and,
6108   25B7             ;* if one exists, activates it at `(B,C)`; if all slots are busy
6109   25B7             ;* it returns up two stack levels (cancelling the scan for this frame).
6110   25B7             ;*****************************************************************************
6111   25B7             L25B7:
6112   25B7 3A B8 43                           LD      A,(LevelAndRound)   ; 
6113   25BA 16 03                              LD      D,$03               ; base: 3 bullets
6114   25BC FE 10                              CP      $10                 ; 0001_0000
6115   25BE DA CA 25                           JP      C,L25CA             ; round 0
6116   25C1 16 04                              LD      D,$04               ; round 1: 4 bullets
6117   25C3 FE 20                              CP      $20                 ; 0010_0000
6118   25C5 DA CA 25                           JP      C,L25CA             ; if game round < 2
6119   25C8 16 05                              LD      D,$05               ; round >=2: 5 bullets
6120   25CA             L25CA:
6121   25CA 21 CC 43                           LD      HL,AlienBullet0State
6122   25CD             L25CD:
6123   25CD 7E                                 LD      A,(HL)              ; 
6124   25CE E6 08                              AND     $08                 ; 0000_1000 slot in use?
6125   25D0 CA E0 25                           JP      Z,L25E0             ; found a free slot -> spawn
6126   25D3 7D                                 LD      A,L                 ; 
6127   25D4 C6 04                              ADD     $04                 ; 
6128   25D6 6F                                 LD      L,A                 ; next slot
6129   25D7 15                                 DEC     D                   ; 
6130   25D8 C2 CD 25                           JP      NZ,L25CD            ; try D slots
6131   25DB E1                                 POP     HL                  ; 
6132   25DC E1                                 POP     HL                  ; discard the two pushed frames
6133   25DD C9                                 RET                         ; no free slot -> abort
6134   25DE             
6135   25E0                                    .ORG $25E0
6136   25E0             ;*****************************************************************************
6137   25E0             ;* Bullet spawner:
6138   25E0             ;* It fills that slot — marking it active, computing a bullet character/type from the position,
6139   25E0             ;* and storing the X/Y. The paired `POP HL` at the ends unwind the two dummy
6140   25E0             ;* stack frames the callers pushed, so control returns cleanly
6141   25E0             ;* regardless of whether a bullet was actually fired.
6142   25E0             ;*****************************************************************************
6143   25E0             L25E0:
6144   25E0 78                                 LD      A,B                 ; 
6145   25E1 C6 04                              ADD     $04                 ; 
6146   25E3 47                                 LD      B,A                 ; adjust bullet X
6147   25E4 79                                 LD      A,C                 ; 
6148   25E5 C6 0C                              ADD     $0C                 ; 
6149   25E7 4F                                 LD      C,A                 ; adjust bullet Y
6150   25E8 36 08                              LD      (HL),$08            ; state = active (bit3)
6151   25EA 2C                                 INC     L                   ; 
6152   25EB 78                                 LD      A,B                 ; 
6153   25EC 0F                                 RRCA                        ; 
6154   25ED E6 03                              AND     $03                 ; 0000_0011
6155   25EF 57                                 LD      D,A                 ; 
6156   25F0 79                                 LD      A,C                 ; 
6157   25F1 E6 04                              AND     $04                 ; 0000_0100
6158   25F3 82                                 ADD     A,D                 ; 
6159   25F4 C6 58                              ADD     $58                 ; 
6160   25F6 77                                 LD      (HL),A              ; bullet character/type ($58 + variant)
6161   25F7 2C                                 INC     L                   ; 
6162   25F8 70                                 LD      (HL),B              ; bullet X
6163   25F9 2C                                 INC     L                   ; 
6164   25FA 71                                 LD      (HL),C              ; bullet Y
6165   25FB E1                                 POP     HL                  ; 
6166   25FC E1                                 POP     HL                  ; discard the two pushed frames
6167   25FD C9                                 RET                         ; 
6168   25FE             
6169   2600                                    .ORG $2600
6170   2600             ;*****************************************************************************
6171   2600             ;* Birds vertical movement update (with 58xx scroll register).
6172   2600             ;* The descent threshold:
6173   2600             ;* B4BD1 = (M436F & $1E) + 2·( 2·(8 − BirdsLeft) + Counter9A )
6174   2600             ;* The kill count `8 − BirdsLeft` enters with weight 4 and `Counter9A` with weight 2,
6175   2600             ;* plus a random even offset up to `$1E`. As birds are shot down, the threshold climbs,
6176   2600             ;* so the formation is allowed to descend further before turning — the wave gets more aggressive.
6177   2600             ;* `B4BD1` is consumed on the very next frame by `L2600`.
6178   2600             ;* `B4BD1 ≥ B4BD3` takes the descend path (`CounterB9 − step`, table `$3ED0` indexed by `B4BD5`).
6179   2600             ;* Call chain:
6180   2600             ;* L2600  (bird vertical movement, every frame)
6181   2600             ;*   └─ $263F  Counter9A+1 bit0
6182   2600             ;*        ├─ 0 -> L26D0     recompute B4BD6 / B4BD7 from live bird slots
6183   2600             ;*        └─ 1 -> L2668     recompute B4BD5 (descent speed, clamped via $3EE0)
6184   2600             ;*                 └─ L26AA  tick B4BD3
6185   2600             ;*                      └─ on expiry -> L2476   re-arm B4BD3 and B4BD1
6186   2600             ;* The two halves alternate on odd/even frames,
6187   2600             ;* so the spread values `L2476` consumes are always from the previous frame.
6188   2600             ;*****************************************************************************
6189   2600             L2600:
6190   2600 00                                 NOP                         ; Old command removed or space for a future replace patch
6191   2601 00                                 NOP                         ; ..
6192   2602 00                                 NOP                         ; ..
6193   2603 00                                 NOP                         ; ..
6194   2604 00                                 NOP                         ; ..
6195   2605 3A B9 43                           LD      A,(CounterB9)       ; 
6196   2608 2F                                 CPL                         ; 
6197   2609 0F                                 RRCA                        ; 
6198   260A 0F                                 RRCA                        ; 
6199   260B 0F                                 RRCA                        ; >> 3
6200   260C E6 1F                              AND     $1F                 ; 0001_1111 0..31
6201   260E 21 D2 4B                           LD      HL,B4BD2            ; vertical scroll phase of the bird formation (the master index)
6202   2611 77                                 LD      (HL),A              ; B4BD2 = (~CounterB9 >> 3) & $1F
6203   2612 2C                                 INC     L                   ; -> B4BD3
6204   2613 3A D1 4B                           LD      A,(B4BD1)           ; descent turnaround threshold (max depth)
6205   2616 BE                                 CP      (HL)                ; vs $4BD2 (scroll phase)
6206   2617 DA 50 26                           JP      C,L2650             ; phase passed threshold -> reverse
6207   261A 3A D5 4B                           LD      A,(B4BD5)           ; D = descent-step value
6208   261D 57                                 LD      D,A                 ; 
6209   261E E6 03                              AND     $03                 ; E = B4BD5 & 3   -> sub-phase (column 0..3)
6210   2620 5F                                 LD      E,A                 ; 
6211   2621 3A 9B 43                           LD      A,(Counter9A+$1)    ; 
6212   2624 07                                 RLCA                        ; Multiply by 4 ..
6213   2625 07                                 RLCA                        ; ..
6214   2626 E6 0C                              AND     $0C                 ; 0000_1100 animation-frame row -> 0,4,8,12
6215   2628 83                                 ADD     A,E                 ; + sub-phase
6216   2629 C6 D0                              ADD     $D0                 ; 
6217   262B 6F                                 LD      L,A                 ; 
6218   262C 26 3E                              LD      H,$3E               ; HL = $3ED0 + row + column
6219   262E 7A                                 LD      A,D                 ; 
6220   262F 0F                                 RRCA                        ; 
6221   2630 0F                                 RRCA                        ; B4BD5 >> 2 -> coarse speed
6222   2631 E6 07                              AND     $07                 ; 0000_0111 coarse speed 0..7
6223   2633 86                                 ADD     A,(HL)              ; + 0/1 dither bit from table
6224   2634 57                                 LD      D,A                 ; total vertical step this frame
6225   2635 3A B9 43                           LD      A,(CounterB9)       ; 
6226   2638 92                                 SUB     D                   ; 
6227   2639             L2639:
6228   2639 32 B9 43                           LD      (CounterB9),A       ; 
6229   263C 32 00 58                           LD      (scrollRegister),A  ; $5800 vertical scroll register
6230   263F 3A 9B 43                           LD      A,(Counter9A+$1)    ; 
6231   2642 0F                                 RRCA                        ; 
6232   2643 D2 D0 26                           JP      NC,L26D0            ; 
6233   2646 CD 68 26                           CALL    L2668               ; 
6234   2649 C3 AA 26                           JP      L26AA               ; 
6235   264C             
6236   2650                                    .ORG $2650
6237   2650             ;*****************************************************************************
6238   2650             ;* `L2650` takes the ascend path (`CounterB9 + step`, indexed via `B4BD4`).
6239   2650             ;* Since `L2476` writes both sides of that comparison,
6240   2650             ;* it is what decides how long the formation dives before pulling back up.
6241   2650             ;*****************************************************************************
6242   2650             L2650:
6243   2650 2C                                 INC     L                   ; 
6244   2651 3A 9B 43                           LD      A,(Counter9A+$1)    ; 
6245   2654 07                                 RLCA                        ; Multiply by 4 ..
6246   2655 07                                 RLCA                        ; ..
6247   2656 E6 0C                              AND     $0C                 ; 0000_1100
6248   2658 86                                 ADD     A,(HL)              ; 
6249   2659 C6 D0                              ADD     $D0                 ; 
6250   265B 6F                                 LD      L,A                 ; 
6251   265C 26 3E                              LD      H,$3E               ; 
6252   265E 3A B9 43                           LD      A,(CounterB9)       ; 
6253   2661 86                                 ADD     A,(HL)              ; 
6254   2662 C3 39 26                           JP      L2639               ; 
6255   2665 D2 AE 26                           JP      NC,L26AE            ; 
6256   2668             
6257   2668             ;
6258   2668             L2668:
6259   2668 3A 6E 43                           LD      A,(M436E)           ; base for descent-step calc (-> B4BD5)
6260   266B 00                                 NOP                         ; 
6261   266C 47                                 LD      B,A                 ; 
6262   266D 3A 9A 43                           LD      A,(Counter9A)       ; 
6263   2670 FE 18                              CP      $18                 ; 
6264   2672 DA 76 26                           JP      C,L2676             ; 
6265   2675 04                                 INC     B                   ; 
6266   2676             L2676:
6267   2676 FE 10                              CP      $10                 ; 
6268   2678 DA 7C 26                           JP      C,L267C             ; 
6269   267B 04                                 INC     B                   ; 
6270   267C             L267C:
6271   267C 3A BA 43                           LD      A,(AliensLeft)      ; 
6272   267F FE 03                              CP      $03                 ; 
6273   2681 D2 85 26                           JP      NC,L2685            ; if >= $03
6274   2684 04                                 INC     B                   ; 
6275   2685             L2685:
6276   2685 3A D6 4B                           LD      A,(B4BD6)           ; 
6277   2688 C6 E0                              ADD     $E0                 ; 
6278   268A 6F                                 LD      L,A                 ; 
6279   268B 26 3E                              LD      H,$3E               ; HL = $3EE0 + B4BD6
6280   268D 78                                 LD      A,B                 ; B = candidate step (from M436E, wave timer, AliensLeft)
6281   268E BE                                 CP      (HL)                ; 
6282   268F DA 93 26                           JP      C,L2693             ; keep B if B < limit
6283   2692 7E                                 LD      A,(HL)              ; else clamp to table limit
6284   2693             L2693:
6285   2693 57                                 LD      D,A                 ; 
6286   2694 3A BB 43                           LD      A,(BirdsLeft)       ; 
6287   2697 FE 04                              CP      $04                 ; 
6288   2699 D2 9D 26                           JP      NC,L269D            ; if >= $04
6289   269C 14                                 INC     D                   ; 
6290   269D             L269D:
6291   269D FE 02                              CP      $02                 ; 
6292   269F D2 A3 26                           JP      NC,L26A3            ; if >= $02
6293   26A2 14                                 INC     D                   ; 
6294   26A3             L26A3:
6295   26A3 7A                                 LD      A,D                 ; D further nudged by BirdsLeft, then:
6296   26A4 32 D5 4B                           LD      (B4BD5),A           ; descent step / speed value
6297   26A7 C9                                 RET                         ; 
6298   26A8             
6299   26AA                                    .ORG $26AA
6300   26AA             L26AA:
6301   26AA 21 D3 4B                           LD      HL,B4BD3            ; countdown timer between bird attacks ("bird extended storage")
6302   26AD 7E                                 LD      A,(HL)              ; 
6303   26AE             L26AE:
6304   26AE 35                                 DEC     (HL)                ; tick
6305   26AF A7                                 AND     A                   ; updates the zero flag
6306   26B0 C0                                 RET     NZ                  ; not yet
6307   26B1 34                                 INC     (HL)                ; 
6308   26B2 2E D6                              LD      L,$D6               ; $4BD6
6309   26B4 7E                                 LD      A,(HL)              ; 
6310   26B5 FE 16                              CP      $16                 ; 
6311   26B7 D0                                 RET     NC                  ; 
6312   26B8 FE 08                              CP      $08                 ; 
6313   26BA D8                                 RET     C                   ; 
6314   26BB 2C                                 INC     L                   ; 
6315   26BC 96                                 SUB     (HL)                ; 
6316   26BD 07                                 RLCA                        ; Multiply by 2
6317   26BE 47                                 LD      B,A                 ; 
6318   26BF             ; Attack sub-pattern selector
6319   26BF 3A 6F 43                           LD      A,(M436F)           ; Per-wave random variation seed (keeps successive waves from being identical)
6320   26C2 E6 03                              AND     $03                 ; 0000_0011
6321   26C4 2E D4                              LD      L,$D4               ; B4BD4 attack sub-pattern selector (0–3)
6322   26C6 77                                 LD      (HL),A              ; set one of four bird attack variants
6323   26C7 2F                                 CPL                         ; 
6324   26C8 E6 03                              AND     $03                 ; 0000_0011
6325   26CA 3C                                 INC     A                   ; 
6326   26CB 4F                                 LD      C,A                 ; 
6327   26CC C3 76 24                           JP      L2476               ; 
6328   26CF             
6329   26D0                                    .ORG $26D0
6330   26D0             ;
6331   26D0             L26D0:
6332   26D0 21 A8 4B                           LD      HL,M4BA8            ; 
6333   26D3 01 00 08                           LD      BC,$0800            ; 
6334   26D6 11 00 80                           LD      DE,$8000            ; 
6335   26D9             L26D9:
6336   26D9 7E                                 LD      A,(HL)              ; 
6337   26DA A7                                 AND     A                   ; updates the zero flag
6338   26DB CA E5 26                           JP      Z,L26E5             ; 
6339   26DE 7A                                 LD      A,D                 ; 
6340   26DF 07                                 RLCA                        ; Multiply by 2
6341   26E0 D2 E4 26                           JP      NC,L26E4            ; 
6342   26E3 51                                 LD      D,C                 ; 
6343   26E4             L26E4:
6344   26E4 59                                 LD      E,C                 ; 
6345   26E5             L26E5:
6346   26E5 0C                                 INC     C                   ; 
6347   26E6 7D                                 LD      A,L                 ; 
6348   26E7 90                                 SUB     B                   ; 
6349   26E8 6F                                 LD      L,A                 ; 
6350   26E9 FE 68                              CP      $68                 ; 
6351   26EB C2 D9 26                           JP      NZ,L26D9            ; 
6352   26EE 3A D2 4B                           LD      A,(B4BD2)           ; vertical scroll phase of the bird formation (the master index)
6353   26F1 82                                 ADD     A,D                 ; + first active row
6354   26F2 83                                 ADD     A,E                 ; + last active row
6355   26F3 E6 1F                              AND     $1F                 ; 0001_1111
6356   26F5 32 D6 4B                           LD      (B4BD6),A           ; combined scroll-phase + active-bird center index (0–31)
6357   26F8 7B                                 LD      A,E                 ; 
6358   26F9 92                                 SUB     D                   ; 
6359   26FA 32 D7 4B                           LD      (B4BD7),A           ; vertical spread of the active birds (computed, effectively unused)
6360   26FD C9                                 RET                         ; 
6361   26FE             
6362   2700                                    .ORG $2700
6363   2700             ;*****************************************************************************
6364   2700             ;* Handles the scoring, and the update of sound control HW.
6365   2700             ;*****************************************************************************
6366   2700             UpdateScoresAndSound:
6367   2700 21 A2 43                           LD      HL,GameOrAttract    ; 
6368   2703 7E                                 LD      A,(HL)              ; get it
6369   2704 A7                                 AND     A                   ; updates the zero flag
6370   2705 C8                                 RET     Z                   ; if GameOrAttract is 'Attract mode'.
6371   2706 2C                                 INC     L                   ;
6372   2707 7E                                 LD      A,(HL)              ; get GameAndDemoOrSplash
6373   2708 E6 01                              AND     $01                 ; mask out 0000_0001 'Game for player 2'
6374   270A 07                                 RLCA                        ; Multiply by 4 ..
6375   270B 07                                 RLCA                        ; ..
6376   270C C6 83                              ADD     $83                 ;
6377   270E 6F                                 LD      L,A                 ;
6378   270F 3E FF                              LD      A,$FF               ;
6379   2711 32 97 43                           LD      (M4397),A           ; assume "no change"
6380   2714 11 70 43                           LD      DE,M4370            ; 
6381   2717             L2717:
6382   2717 CD 48 27                           CALL    L2748               ; add score values for all enemies hit.
6383   271A 1C                                 INC     E                   ;
6384   271B 1C                                 INC     E                   ;
6385   271C 1C                                 INC     E                   ;
6386   271D 7B                                 LD      A,E                 ;
6387   271E FE 80                              CP      $80                 ; from $4370 to $4380
6388   2720 C2 17 27                           JP      NZ,L2717            ; 
6389   2723 1E 9D                              LD      E,$9D               ;
6390   2725 3A A4 43                           LD      A,(GameState)       ; 
6391   2728 FE 06                              CP      $06                 ;
6392   272A C2 39 27                           JP      NZ,L2739            ; 
6393   272D 1A                                 LD      A,(DE)              ;
6394   272E 47                                 LD      B,A                 ;
6395   272F 0E 00                              LD      C,$00               ;
6396   2731 CD 20 02                           CALL    AddToScore          ; 
6397   2734 AF                                 XOR     A                   ; A=0
6398   2735 12                                 LD      (DE),A              ;
6399   2736 32 97 43                           LD      (M4397),A           ; 
6400   2739             L2739:
6401   2739 3A 97 43                           LD      A,(M4397)           ; 
6402   273C A7                                 AND     A                   ; updates the zero flag
6403   273D CC 68 27                           CALL    Z,L2768             ; redraw score if it changed
6404   2740 CD A8 27                           CALL    UpdateSoundControlHW
6405   2743 C3 10 3A                           JP      UpdateSounds        ; 
6406   2746             
6407   2748                                    .ORG $2748
6408   2748             ;*****************************************************************************
6409   2748             ;* Add score values for enemies hit.
6410   2748             ;*****************************************************************************
6411   2748             L2748:
6412   2748 1A                                 LD      A,(DE)              ; get $4370
6413   2749 1C                                 INC     E                   ;
6414   274A FE 01                              CP      $01                 ;
6415   274C C0                                 RET     NZ                  ; if not 1
6416   274D 1A                                 LD      A,(DE)              ;
6417   274E A7                                 AND     A                   ; updates the zero flag
6418   274F C8                                 RET     Z                   ;
6419   2750 0F                                 RRCA                        ; enemy has been hit
6420   2751 0F                                 RRCA                        ;
6421   2752 0F                                 RRCA                        ;
6422   2753 0F                                 RRCA                        ;
6423   2754 47                                 LD      B,A                 ;
6424   2755 E6 F0                              AND     $F0                 ; 1111_0000
6425   2757 4F                                 LD      C,A                 ;
6426   2758 78                                 LD      A,B                 ;
6427   2759 E6 0F                              AND     $0F                 ; 0000_1111
6428   275B 47                                 LD      B,A                 ;
6429   275C CD 20 02                           CALL    AddToScore          ; 
6430   275F AF                                 XOR     A                   ; Clear A Reg.
6431   2760 12                                 LD      (DE),A              ; clear the temp. score storage and ...
6432   2761 32 97 43                           LD      (M4397),A           ; mark score as changed (0)
6433   2764 C9                                 RET                         ;
6434   2765             
6435   2768                                    .ORG $2768
6436   2768             ;*****************************************************************************
6437   2768             ;* Score-display
6438   2768             ;* Together with `$43BE` (`BonusLivesAt`), these make a contiguous 3 byte BCD value
6439   2768             ;* (`$43BD` = low, `$43BE` = middle, `$43BF` = high).
6440   2768             ;* `$43BE` is loaded from the DIP switches to `$30/$40/$50/$60`,
6441   2768             ;* the "extra ship at 3000/4000/5000/6000 points" setting,
6442   2768             ;* and `$43BD`/`$43BF` are its companion digit bytes (zeroed at init).
6443   2768             ;* This 3-byte threshold is checked against the player's score,
6444   2768             ;* using the 3 byte BCD compare `L0314`.
6445   2768             ;*****************************************************************************
6446   2768             L2768:
6447   2768 E5                                 PUSH    HL                  ; 
6448   2769 11 61 42                           LD      DE,$4261            ; end of the screen area of player 1 score
6449   276C 06 06                              LD      B,$06               ; number of digits to print
6450   276E 3A A3 43                           LD      A,(GameAndDemoOrSplash)
6451   2771 A7                                 AND     A                   ; updates the zero flag
6452   2772 CA 78 27                           JP      Z,$2778             ; if GameAndDemoOrSplash is 'Game and demo for player 1'
6453   2775 11 21 40                           LD      DE,$4021            ; end of the screen area of player 2 score
6454   2778 CD C4 00                           CALL    PrintNumber         ; update the score on screen
6455   277B E1                                 POP     HL                  ; 
6456   277C 11 BD 43                           LD      DE,M43BD            ; Low byte of the bonus extra-life score threshold
6457   277F EB                                 EX      DE,HL               ; HL = $43BD
6458   2780 7E                                 LD      A,(HL)              ; $43BD
6459   2781 2C                                 INC     L                   ; 
6460   2782 B6                                 OR      (HL)                ; | $43BE Middle byte of the threshold
6461   2783 C8                                 RET     Z                   ; no bonus pending if both 0
6462   2784 2C                                 INC     L                   ; -> $43BF High byte of the bonus extra-life score threshold
6463   2785 EB                                 EX      DE,HL               ; DE = $43BF (threshold high)
6464   2786 CD 14 03                           CALL    L0314               ; 3-byte BCD compare: threshold vs score
6465   2789 D0                                 RET     NC                  ; not reached yet -> return
6466   278A 3A A3 43                           LD      A,(GameAndDemoOrSplash)
6467   278D C6 90                              ADD     $90                 ; 
6468   278F 6F                                 LD      L,A                 ; 
6469   2790 34                                 INC     (HL)                ; +1 life
6470   2791 CD 67 03                           CALL    UpdateLivesScreen   ; 
6471   2794 3E FF                              LD      A,$FF               ; set flag for
6472   2796 32 6A 43                           LD      (M436A),A           ; 'Bonus live added' (triggers the sound)
6473   2799 2E BE                              LD      L,$BE               ; BonusLivesAt
6474   279B 7E                                 LD      A,(HL)              ; 
6475   279C 36 00                              LD      (HL),$00            ; clear it
6476   279E 0F                                 RRCA                        ; nibble swap
6477   279F 0F                                 RRCA                        ; ..
6478   27A0 0F                                 RRCA                        ; ..
6479   27A1 0F                                 RRCA                        ; ..
6480   27A2 2D                                 DEC     L                   ; $43BD Low byte of the bonus extra-life score threshold
6481   27A3 77                                 LD      (HL),A              ; update threshold so it won't re-award
6482   27A4 C9                                 RET                         ; 
