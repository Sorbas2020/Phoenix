6290   2705 C8                                 RET     Z                   ; if GameOrAttract is 'Attract mode'.
6291   2706 2C                                 INC     L                   ;
6292   2707 7E                                 LD      A,(HL)              ; get GameAndDemoOrSplash
6293   2708 E6 01                              AND     $01                 ; mask out 0000_0001 'Game for player 2'
6294   270A 07                                 RLCA                        ; Multiply by 4 ..
6295   270B 07                                 RLCA                        ; ..
6296   270C C6 83                              ADD     $83                 ;
6297   270E 6F                                 LD      L,A                 ;
6298   270F 3E FF                              LD      A,$FF               ;
6299   2711 32 97 43                           LD      (M4397),A           ; 
6300   2714 11 70 43                           LD      DE,M4370            ; 
6301   2717             L2717:
6302   2717 CD 48 27                           CALL    L2748               ; add score values for all enemies hit.
6303   271A 1C                                 INC     E                   ;
6304   271B 1C                                 INC     E                   ;
6305   271C 1C                                 INC     E                   ;
6306   271D 7B                                 LD      A,E                 ;
6307   271E FE 80                              CP      $80                 ; from $4370 to $4380
6308   2720 C2 17 27                           JP      NZ,L2717            ; 
6309   2723 1E 9D                              LD      E,$9D               ;
6310   2725 3A A4 43                           LD      A,(GameState)       ; 
