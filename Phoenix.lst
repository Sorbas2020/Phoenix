7177   3210                                    .ORG $3210
7178   3210             ;*****************************************************************************
7179   3210             ;* Get the attack phase at Reg. B (0..3) from the alien Y (only when one attacker).
7180   3210             ;*****************************************************************************
7181   3210             L3210:
7182   3210 3A 53 43                           LD      A,(M4353)           ; Number of aliens doing the closed loop pattern
7183   3213 FE 01                              CP      $01                 ; 
7184   3215 C0                                 RET     NZ                  ; only meaningful for 1
7185   3216 7A                                 LD      A,D                 ; alien screen coordinate Y
7186   3217 06 00                              LD      B,$00               ; return B = phase 0
7187   3219 FE 58                              CP      $58                 ; 
7188   321B D8                                 RET     C                   ; if alien screen coordinate Y < $58
7189   321C 06 01                              LD      B,$01               ; return B = phase 1
7190   321E FE 78                              CP      $78                 ; 
7191   3220 D8                                 RET     C                   ; if alien screen coordinate Y < $78
7192   3221 06 02                              LD      B,$02               ; return B = phase 2
7193   3223 FE 98                              CP      $98                 ; 
7194   3225 D8                                 RET     C                   ; if alien screen coordinate Y < $98
7195   3226 06 03                              LD      B,$03               ; return B = phase 3
7196   3228 C9                                 RET                         ; 
7197   3229             
7198   322C                                    .ORG $322C
7199   322C             ;*****************************************************************************
7200   322C             ;* Sub-task 6: in state 4 (angry path), verify all active aliens carry the
7201   322C             ;* start pointer, then advance to state 6.
7202   322C             ;*****************************************************************************
7203   322C             L322C:
7204   322C 3A 50 43                           LD      A,(M4350)           ; get alien behavior state
7205   322F FE 04                              CP      $04                 ; 
7206   3231 C0                                 RET     NZ                  ; only in state 4
7207   3232 21 50 4B                           LD      HL,M4B50            ; Pointer to alien movement pattern
7208   3235 11 70 4B                           LD      DE,M4B70            ; Alien data structure (grid)
7209   3238 3A 56 43                           LD      A,(M4356)           ; 
7210   323B 4F                                 LD      C,A                 ; start ptr LSB
7211   323C 3A 94 43                           LD      A,(M4394)           ; get start value list pointer for alien movement MSB
7212   323F 47                                 LD      B,A                 ; start ptr MSB
7213   3240             L3240:
7214   3240 1A                                 LD      A,(DE)              ; 
7215   3241 E6 08                              AND     $08                 ; 0000_1000 alien active?
7216   3243 CA 4E 32                           JP      Z,L324E             ; 
7217   3246 7E                                 LD      A,(HL)              ; 
7218   3247 B8                                 CP      B                   ; 
7219   3248 C0                                 RET     NZ                  ; control-A must match
7220   3249 2C                                 INC     L                   ; 
7221   324A 7E                                 LD      A,(HL)              ; 
7222   324B 2D                                 DEC     L                   ; 
7223   324C B9                                 CP      C                   ; 
7224   324D C0                                 RET     NZ                  ; control-B must match
7225   324E             L324E:
7226   324E 2C                                 INC     L                   ; 
7227   324F 2C                                 INC     L                   ; 
7228   3250 7B                                 LD      A,E                 ; 
7229   3251 C6 04                              ADD     $04                 ; next grid entry
7230   3253 5F                                 LD      E,A                 ; 
7231   3254 FE B0                              CP      $B0                 ; 
7232   3256 C2 40 32                           JP      NZ,L3240            ; loop over alien data structure
7233   3259 3E 06                              LD      A,$06               ; 
7234   325B 32 50 43                           LD      (M4350),A           ; set next alien behavior state to 6
7235   325E C9                                 RET                         ; 
7236   325F             
7237   3264                                    .ORG $3264
7238   3264             ;*****************************************************************************
7239   3264             ;* Sub-task 0: rotate the 'start value list' pointer $4356 (0-15). If a
7240   3264             ;* pattern is fully prepared (state >= 5), reset to state 0 and write the
7241   3264             ;* chosen closed-loop pattern pointer into the movement slots ($4B50) of the
7242   3264             ;* matching aliens - launching the actual swoop.
7243   3264             ;*****************************************************************************
7244   3264             L3264:
7245   3264 21 95 43                           LD      HL,M4395            ; start-value list pointer LSB
7246   3267 7E                                 LD      A,(HL)              ; get start value list pointer for alien movement LSB
7247   3268 32 56 43                           LD      (M4356),A           ; 
7248   326B 3C                                 INC     A                   ; 
7249   326C E6 0F                              AND     $0F                 ; 0000_1111 wrap 0..15
7250   326E 77                                 LD      (HL),A              ; 
7251   326F 2E 50                              LD      L,$50               ; 
7252   3271 7E                                 LD      A,(HL)              ; get $4350 Alien behavior state
7253   3272 FE 05                              CP      $05                 ; 
7254   3274 D8                                 RET     C                   ; nothing prepared yet
7255   3275 36 00                              LD      (HL),$00            ; set $4350 next alien behavior state to 0
7256   3277 2E 53                              LD      L,$53               ; 
7257   3279 4E                                 LD      C,(HL)              ; get $4353 Number of aliens doing the closed loop pattern
7258   327A 2C                                 INC     L                   ; 
7259   327B 6E                                 LD      L,(HL)              ; get $4354 lead alien slot
7260   327C 26 4B                              LD      H,$4B               ; 
7261   327E 3A 56 43                           LD      A,(M4356)           ; 
7262   3281 57                                 LD      D,A                 ; D = start ptr LSB
7263   3282 3A 94 43                           LD      A,(M4394)           ; get start value list pointer for alien movement MSB
7264   3285 5F                                 LD      E,A                 ; E = start ptr MSB
7265   3286 7D                                 LD      A,L                 ; 
7266   3287 D6 50                              SUB     $50                 ; 
7267   3289 0F                                 RRCA                        ; 
7268   328A 47                                 LD      B,A                 ; 
7269   328B 3E 10                              LD      A,$10               ; 
7270   328D 90                                 SUB     B                   ; 
7271   328E 47                                 LD      B,A                 ; entries left to scan
7272   328F             L328F:
7273   328F 7E                                 LD      A,(HL)              ; 
7274   3290 2C                                 INC     L                   ; 
7275   3291 BB                                 CP      E                   ; 
7276   3292 C2 A4 32                           JP      NZ,L32A4            ; control-A match?
7277   3295 7E                                 LD      A,(HL)              ; 
7278   3296 BA                                 CP      D                   ; 
7279   3297 C2 A4 32                           JP      NZ,L32A4            ; control-B match?
7280   329A 2D                                 DEC     L                   ; 
7281   329B 3A 51 43                           LD      A,(M4351)           ; get MSB of next closed loop pattern
7282   329E 77                                 LD      (HL),A              ; 
7283   329F 2C                                 INC     L                   ; 
7284   32A0 3A 52 43                           LD      A,(M4352)           ; get LSB of next closed loop pattern
7285   32A3 77                                 LD      (HL),A              ; alien now flies the swoop
7286   32A4             L32A4:
7287   32A4 2C                                 INC     L                   ; 
7288   32A5 05                                 DEC     B                   ; 
7289   32A6 C2 AB 32                           JP      NZ,L32AB            ; 
7290   32A9 2E 50                              LD      L,$50               ; wrap to $4B50
7291   32AB             L32AB:
7292   32AB 0D                                 DEC     C                   ; 
7293   32AC C2 8F 32                           JP      NZ,L328F            ; loop for Number of aliens doing the closed loop pattern
7294   32AF C9                                 RET                         ; 
7295   32B0             
7296   32B0             ;*****************************************************************************
7297   32B0             ;* Bird-level init:
7298   32B0             ;* First clears `$4B70`–`$4BAF`, then copies `BirdsLeft × 8` bytes from table T3F80
7299   32B0             ;* into the object array, choosing the source block by level.
7300   32B0             ;* So when a full wave starts (`BirdsLeft = 8`, `C = $40`),
7301   32B0             ;* the source LSB resolves to `$80` -> it copies the whole table starting at `$3F80` into `$4B70`,
7302   32B0             ;* meaning `$3F80`–`$3F87` becomes the live control block of bird #0 at `$4B70`.
7303   32B0             ;* (If fewer birds are present, both source and destination are offset toward the end of their respective arrays,
7304   32B0             ;* so the remaining birds are taken from the tail of the table.)
7305   32B0             ;* The `LevelAndRound` bit test redirects the source to `$3FC0` for levels 4/9.
7306   32B0             ;* After the copy, these objects are driven by the bird routines — e.g. `DrawFirst4BirdObjects`/`DrawSecond4BirdObjects`
7307   32B0             ;* and `L35B0`, all of which iterate the array in 8 byte steps (`ADD $08`) over `$4B70`–`$4BAF`, confirming the 8 byte-per-bird structure.
7308   32B0             ;*****************************************************************************
7309   32B0             L32B0:
7310   32B0 21 50 43                           LD      HL,M4350            ; 
7311   32B3 06 30                              LD      B,$30               ; 4350 to 437F
7312   32B5 CD D8 05                           CALL    ClearBbytesAtHL     ; 
7313   32B8 2E 9A                              LD      L,$9A               ; Counter9A
7314   32BA 06 04                              LD      B,$04               ; 439A to 439D
7315   32BC CD D8 05                           CALL    ClearBbytesAtHL     ; 
7316   32BF 3A BB 43                           LD      A,(BirdsLeft)       ; 
7317   32C2 A7                                 AND     A                   ; updates the zero flag
7318   32C3 C8                                 RET     Z                   ; not a bird level -> done
7319   32C4 07                                 RLCA                        ; BirdsLeft * 8 (record size)
7320   32C5 07                                 RLCA                        ; ..
7321   32C6 07                                 RLCA                        ; ..
7322   32C7 4F                                 LD      C,A                 ; 
7323   32C8 21 70 4B                           LD      HL,M4B70            ; 
7324   32CB 06 40                              LD      B,$40               ; 
7325   32CD CD D8 05                           CALL    ClearBbytesAtHL     ;  clear $4B70-$4BAF
7326   32D0 16 4B                              LD      D,$4B               ; 
7327   32D2 26 3F                              LD      H,$3F               ; source page (T3F80/T3FC0)
7328   32D4 3E 40                              LD      A,$40               ; 
7329   32D6 91                                 SUB     C                   ; 
7330   32D7 C6 70                              ADD     $70                 ; 
7331   32D9 5F                                 LD      E,A                 ; dest LSB  = $4B70 + ($40 - BirdsLeft*8)
7332   32DA C6 10                              ADD     $10                 ; 
7333   32DC 6F                                 LD      L,A                 ; src  LSB  = $80  + ($40 - BirdsLeft*8)
7334   32DD 41                                 LD      B,C                 ; bytes = BirdsLeft*8
7335   32DE 3A B8 43                           LD      A,(LevelAndRound)   ; 
7336   32E1 0F                                 RRCA                        ; 
7337   32E2 0F                                 RRCA                        ; 
7338   32E3 D2 E0 05                           JP      NC,CopyBbytesHLtoDE ; levels 3/8 -> copy from $3F80 block
7339   32E6 7D                                 LD      A,L                 ; 
7340   32E7 C6 40                              ADD     $40                 ; levels 4/9 -> source += $40 ($3FC0 block)
7341   32E9 6F                                 LD      L,A                 ; 
7342   32EA C3 E0 05                           JP      CopyBbytesHLtoDE    ; 
7343   32ED             
