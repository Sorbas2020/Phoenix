7700   35EB 77                                 LD      (HL),A              
7701   35EC 2D                                 DEC     L                   
7702   35ED 2D                                 DEC     L                   
7703   35EE 78                                 LD      A,B                 
7704   35EF 86                                 ADD     A,(HL)              
7705   35F0 77                                 LD      (HL),A              
7706   35F1 FE 08                              CP      $08                 
7707   35F3 DA 6A 36                           JP      C,L366A             ; 
7708   35F6 E6 07                              AND     $07                 
7709   35F8 77                                 LD      (HL),A              
7710   35F9 2D                                 DEC     L                   
7711   35FA 7E                                 LD      A,(HL)              
7712   35FB D6 20                              SUB     $20                 
7713   35FD 77                                 LD      (HL),A              
7714   35FE D2 04 36                           JP      NC,L3604            ; 
7715   3601 2D                                 DEC     L                   
7716   3602 35                                 DEC     (HL)                
7717   3603 2C                                 INC     L                   
7718   3604             L3604:
7719   3604 2C                                 INC     L                   
7720   3605 2C                                 INC     L                   
7721   3606 2C                                 INC     L                   
7722   3607 4E                                 LD      C,(HL)              
7723   3608 2C                                 INC     L                   
7724   3609 2C                                 INC     L                   
7725   360A 7E                                 LD      A,(HL)              
7726   360B 2D                                 DEC     L                   
7727   360C 36 10                              LD      (HL),$10            
7728   360E 91                                 SUB     C                   
7729   360F CA 72 36                           JP      Z,L3672             ; 
7730   3612 3D                                 DEC     A                   
7731   3613 0F                                 RRCA                        
7732   3614 0F                                 RRCA                        
7733   3615 0F                                 RRCA                        
7734   3616 E6 1F                              AND     $1F                 
7735   3618 B8                                 CP      B                   
7736   3619 3C                                 INC     A                   
7737   361A 77                                 LD      (HL),A              
7738   361B D8                                 RET     C                   
7739   361C 3A 6E 43                           LD      A,(M436E)           ; 
7740   361F 77                                 LD      (HL),A              
7741   3620 B8                                 CP      B                   
7742   3621 C8                                 RET     Z                   
7743   3622 04                                 INC     B                   
7744   3623 70                                 LD      (HL),B              
7745   3624 C9                                 RET                         
7746   3625             
7747   3628                                    .ORG $3628
7748   3628             L3628:
7749   3628 E6 0F                              AND     $0F                 
7750   362A CA 44 37                           JP      Z,L3744             ; 
7751   362D 47                                 LD      B,A                 
7752   362E 2D                                 DEC     L                   
7753   362F 7E                                 LD      A,(HL)              
7754   3630 90                                 SUB     B                   
7755   3631 77                                 LD      (HL),A              
7756   3632 2D                                 DEC     L                   
7757   3633 2D                                 DEC     L                   
