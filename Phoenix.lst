8699   3AD0             ;*****************************************************************************
8700   3AD0             ;* Background sound for the bird waves:
8701   3AD0             ;* Counts frames for the current tone;
8702   3AD0             ;* it's compared against a per-phase duration taken from `T3DE0`
8703   3AD0             ;* (indexed by the formation scroll phase `B4BD6`),
8704   3AD0             ;* and when the duration is reached it resets to 0, which advances `$438E` to the next note.
8705   3AD0             ;*****************************************************************************
8706   3AD0             L3AD0:
8707   3AD0 21 8E 43                           LD      HL,M438E            ; Bird-wave background-sound phase
8708   3AD3 7E                                 LD      A,(HL)              ; 
8709   3AD4 E6 01                              AND     $01                 ; 0000_0001 phase bit
8710   3AD6 07                                 RLCA                        ; Multiply by 4 ..
8711   3AD7 07                                 RLCA                        ; ..
8712   3AD8 F6 20                              OR      $20                 ; 0010_0000
8713   3ADA 47                                 LD      B,A                 ; 
8714   3ADB 2D                                 DEC     L                   ; 
8715   3ADC 7E                                 LD      A,(HL)              ; $438D SoundControlB
8716   3ADD E6 C0                              AND     $C0                 ; 1100_0000
8717   3ADF B0                                 OR      B                   ; set bits
8718   3AE0 77                                 LD      (HL),A              ; at SoundControlB
8719   3AE1 2E 96                              LD      L,$96               ; $4396 bird-wave background-sound step timer
8720   3AE3 7E                                 LD      A,(HL)              ; 
8721   3AE4 34                                 INC     (HL)                ; 
8722   3AE5 A7                                 AND     A                   ; updates the zero flag
8723   3AE6 CA F8 3A                           JP      Z,L3AF8             ; 
8724   3AE9 3A D6 4B                           LD      A,(M4BD6)           ; 
8725   3AEC C6 E0                              ADD     $E0                 ; LSB of table T3DE0 Background sound data for the bird waves.
8726   3AEE 5F                                 LD      E,A                 ; 
8727   3AEF 16 3D                              LD      D,$3D               ; MSB of table T3DE0 Background sound data for the bird waves.
8728   3AF1 1A                                 LD      A,(DE)              ; 
8729   3AF2 BE                                 CP      (HL)                ; 
8730   3AF3 D0                                 RET     NC                  ; 
8731   3AF4 36 00                              LD      (HL),$00            ; 
