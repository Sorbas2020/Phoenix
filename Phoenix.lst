3473   0F14 C8                                 RET     Z                   ; if no collision
3474   0F15 00                                 NOP                         
3475   0F16 00                                 NOP                         
3476   0F17 21 9E 43                           LD      HL,M439E            ; Mapped player ship position, left part: ($09 to $C0)
3477   0F1A 7E                                 LD      A,(HL)              
3478   0F1B D6 06                              SUB     $06                 
3479   0F1D 47                                 LD      B,A                 
3480   0F1E 2C                                 INC     L                   
3481   0F1F 4E                                 LD      C,(HL)              
3482   0F20 21 70 4B                           LD      HL,M4B70            ; 
3483   0F23             L0F23:
3484   0F23 7E                                 LD      A,(HL)              
3485   0F24 2C                                 INC     L                   
3486   0F25 2C                                 INC     L                   
3487   0F26 E6 08                              AND     $08                 
3488   0F28 C4 38 0F                           CALL    NZ,L0F38            ; 
3489   0F2B 2C                                 INC     L                   
3490   0F2C 2C                                 INC     L                   
3491   0F2D 3E B0                              LD      A,$B0               
3492   0F2F BD                                 CP      L                   
3493   0F30 C2 23 0F                           JP      NZ,L0F23            ; 
3494   0F33 C9                                 RET                         
