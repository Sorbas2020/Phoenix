7503   34C0             ;*****************************************************************************
7504   34C0             ;* Draw a given bird object.
7505   34C0             ;* Input HL is the data structur of one bird object.
7506   34C0             ;* (For the 8 birds: $4B70, $4B78, $4B80, $4B88, $4B90, $4B98, $4BA0, $4BA8)
7507   34C0             ;*****************************************************************************
7508   34C0             DrawBirdObject:
7509   34C0 7E                                 LD      A,(HL)              ; HL=$4B70 (or $4B78,...)
7510   34C1 A7                                 AND     A                   ; updates the zero flag
7511   34C2 C8                                 RET     Z                   ; if 0
7512   34C3 47                                 LD      B,A                 ; save it
7513   34C4 C6 C0                              ADD     $C0                 ; add to base for table T3EC0
7514   34C6 5F                                 LD      E,A                 ; save it
7515   34C7 16 3E                              LD      D,$3E               ; MSB for T3EC0
7516   34C9 1A                                 LD      A,(DE)              ; get data starting from $3EC1
7517   34CA 4F                                 LD      C,A                 ; 
7518   34CB 2C                                 INC     L                   ; 
7519   34CC 56                                 LD      D,(HL)              ; get $4B71 MSB of screen ram
7520   34CD 2C                                 INC     L                   ; 
7521   34CE 5E                                 LD      E,(HL)              ; get $4B72 LSB of screen ram
7522   34CF 2C                                 INC     L                   ; 
7523   34D0 78                                 LD      A,B                 ; restore shape index
7524   34D1 07                                 RLCA                        ; *8  (each shape owns 8 bytes = 4 phase entries)
7525   34D2 07                                 RLCA                        ; 
7526   34D3 07                                 RLCA                        ; 
7527   34D4 86                                 ADD     A,(HL)              ; and add to $4B73 alien0 screen coordinate Y
7528   34D5 E6 7E                              AND     $7E                 ; mask out 0111_1110
7529   34D7 6F                                 LD      L,A                 ; 
7530   34D8 26 3E                              LD      H,$3E               ; HL = $3E00 + shape*8 + phase  (within T3E08)
7531   34DA 7E                                 LD      A,(HL)              ; MSB of the bird character-block address
7532   34DB 2C                                 INC     L                   ; 
7533   34DC 6E                                 LD      L,(HL)              ; get LSB
7534   34DD 67                                 LD      H,A                 ; 
7535   34DE             L34DE:
7536   34DE 7A                                 LD      A,D                 ; 
7537   34DF FE 4B                              CP      $4B                 ; MSB of screen ram
7538   34E1 C2 0C 35                           JP      NZ,L350C            ; if value is not equal $4B
7539   34E4 7B                                 LD      A,E                 ; 
7540   34E5 FE 50                              CP      $50                 ; 
7541   34E7 DA 0C 35                           JP      C,L350C             ; 
7542   34EA 06 08                              LD      B,$08               ; 
7543   34EC 2C                                 INC     L                   ; 
7544   34ED 2C                                 INC     L                   ; 
7545   34EE D6 20                              SUB     $20                 ; 
7546   34F0 5F                                 LD      E,A                 ; 
7547   34F1 FE 50                              CP      $50                 ; 
7548   34F3 DA 09 35                           JP      C,L3509             ; 
7549   34F6 06 10                              LD      B,$10               ; 
7550   34F8 2C                                 INC     L                   ; 
7551   34F9 2C                                 INC     L                   ; 
7552   34FA D6 20                              SUB     $20                 ; 
7553   34FC 5F                                 LD      E,A                 ; 
7554   34FD FE 50                              CP      $50                 ; 
7555   34FF DA 09 35                           JP      C,L3509             ; 
7556   3502 06 18                              LD      B,$18               ; 
7557   3504 2C                                 INC     L                   ; 
7558   3505 2C                                 INC     L                   ; 
7559   3506 D6 20                              SUB     $20                 ; 
7560   3508 5F                                 LD      E,A                 ; 
7561   3509             ;
7562   3509             L3509:
7563   3509 79                                 LD      A,C                 ; 
7564   350A 80                                 ADD     A,B                 ; 
7565   350B 4F                                 LD      C,A                 ; 
7566   350C             ;
7567   350C             L350C:
7568   350C 06 35                              LD      B,$35               ; MSB of return address for the draw shape entry.
7569   350E C5                                 PUSH    BC                  ;
7570   350F 01 DF FF                           LD      BC,$FFDF            ; Screen offset constant -33 right one column (-1), up one row (-32)
7571   3512 EB                                 EX      DE,HL               ;
7572   3513 36 00                              LD      (HL),$00            ; delete character on screen
7573   3515 23                                 INC     HL                  ;
7574   3516 36 00                              LD      (HL),$00            ; delete character on screen
7575   3518 09                                 ADD     HL,BC               ;
7576   3519 C9                                 RET                         ; jumps to draw shape entry.
7577   351A             
7578   3520                                    .ORG $3520
7579   3520             ;*****************************************************************************
7580   3520             ;* Draw a shape.
7581   3520             ;* Entry dep. on size of shape: 2x2,3x2,4x2,5x2,6x2,7x2.
7582   3520             ;*****************************************************************************
7583   3520             Draw7x2:
7584   3520 1A                                 LD      A,(DE)              ;
7585   3521 77                                 LD      (HL),A              ;
7586   3522 13                                 INC     DE                  ;
7587   3523 23                                 INC     HL                  ;
7588   3524 1A                                 LD      A,(DE)              ;
7589   3525 77                                 LD      (HL),A              ;
7590   3526 13                                 INC     DE                  ;
7591   3527 09                                 ADD     HL,BC               ;
7592   3528             Draw6x2:
7593   3528 1A                                 LD      A,(DE)              ;
