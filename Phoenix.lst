7098   3210             ;*****************************************************************************
7099   3210             ;* Get the attack phase at Reg. B (0..3) from the alien Y (only when one attacker).
7100   3210             ;*****************************************************************************
7101   3210             L3210:
7102   3210 3A 53 43                           LD      A,(M4353)           ; Number of aliens doing the closed loop pattern
7103   3213 FE 01                              CP      $01                 ; 
7104   3215 C0                                 RET     NZ                  ; only meaningful for 1
7105   3216 7A                                 LD      A,D                 ; alien screen coordinate Y
7106   3217 06 00                              LD      B,$00               ; return B = phase 0
7107   3219 FE 58                              CP      $58                 ; 
7108   321B D8                                 RET     C                   ; if alien screen coordinate Y < $58
7109   321C 06 01                              LD      B,$01               ; return B = phase 1
7110   321E FE 78                              CP      $78                 ; 
7111   3220 D8                                 RET     C                   ; if alien screen coordinate Y < $78
7112   3221 06 02                              LD      B,$02               ; return B = phase 2
7113   3223 FE 98                              CP      $98                 ; 
7114   3225 D8                                 RET     C                   ; if alien screen coordinate Y < $98
7115   3226 06 03                              LD      B,$03               ; return B = phase 3
7116   3228 C9                                 RET                         ; 
