7775   364A 2C                                 INC     L                   
7776   364B 7E                                 LD      A,(HL)              
7777   364C 2C                                 INC     L                   
7778   364D 2C                                 INC     L                   
7779   364E 96                                 SUB     (HL)                
7780   364F 0F                                 RRCA                        
7781   3650 0F                                 RRCA                        
7782   3651 0F                                 RRCA                        
7783   3652 E6 1F                              AND     $1F                 
7784   3654 B8                                 CP      B                   
7785   3655 3C                                 INC     A                   
7786   3656 2D                                 DEC     L                   
7787   3657 DA 63 36                           JP      C,L3663             ; 
