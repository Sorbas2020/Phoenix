1973   0763             ;*****************************************************************************
1974   0763             ;* Bit4 control function 63:
1975   0763             ;* If control state A: 0001_xxxx
1976   0763             ;* Delete 1x1 screen objects (bullet, alien).
1977   0763             ;*****************************************************************************
1978   0763             L0763:
1979   0763 EB                                 EX      DE,HL               ;
1980   0764 56                                 LD      D,(HL)              ; get screen ram adress MSB
1981   0765 23                                 INC     HL                  ;
1982   0766 5E                                 LD      E,(HL)              ; get screen ram adress LSB
1983   0767 2B                                 DEC     HL                  ; restore pointer
1984   0768 AF                                 XOR     A                   ; A=0
1985   0769 12                                 LD      (DE),A              ; delete at screen
1986   076A EB                                 EX      DE,HL               ;
1987   076B C9                                 RET                         ;
