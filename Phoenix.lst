4867   1EE0             
4868   1EE0             ;*****************************************************************************
4869   1EE0             ;* Copyright-notice integrity check:
4870   1EE0             ;* It runs only in attract mode, as the tail of the intro bird animation.
4871   1EE0             ;* It sums the 26 characters of the on-screen line "` AMSTAR ELECTRONICS CORP. `",
4872   1EE0             ;* adds a tuned constant, and adds the result into `HiScorehigh`.
4873   1EE0             ;* With unmodified ROM the total wraps to exactly `$00`, so the hi-score is left untouched.
4874   1EE0             ;* Change the copyright text and the hi-score gets corrupted.
4875   1EE0             ;* If a bootleg patches the copyright string — or the line is otherwise not intact when this runs,
4876   1EE0             ;* the sum no longer cancels and the delta is added to `HiScorehigh` on every frame of the bird intro.
4877   1EE0             ;* Since scores are BCD, that immediately produces garbage in the `HI-SCORE` display.
4878   1EE0             ;* A quiet, non-obvious tamper trap rather than an outright refusal to boot.
4879   1EE0             ;* The arithmetic
4880   1EE0             ;* | Term                                                           | Value               |
4881   1EE0             ;* |----------------------------------------------------------------|---------------------|
4882   1EE0             ;* | Sum of the 26 text codes (`$121`, truncated to 8 bits)         | `$21`               |
4883   1EE0             ;* | ROM byte at `$3FFD` (last byte of the `T3FC0` bird-init block) | `$B8`               |
4884   1EE0             ;* | Constant added at `$1EF2`                                      | `$27`               |
4885   1EE0             ;* | Total                                                          | `$100` -> **`$00`** |
4886   1EE0             ;*****************************************************************************
4887   1EE0             L1EE0:
4888   1EE0 11 3D 43                           LD      DE,ForegroundScreen+$33D ; screen: start of the AMSTAR line
4889   1EE3 01 1A 00                           LD      BC,$001A            ; B = 0 (accumulator), C = 26
4890   1EE6             L1EE6:
4891   1EE6 1A                                 LD      A,(DE)              ; read one character from screen
4892   1EE7 80                                 ADD     A,B                 ; accumulate
4893   1EE8 47                                 LD      B,A                 ; 
4894   1EE9 CD 17 02                           CALL    RightOneColumn      ; DE -= 32
4895   1EEC 0D                                 DEC     C                   ; 
4896   1EED C2 E6 1E                           JP      NZ,L1EE6            ; 
4897   1EF0 1A                                 LD      A,(DE)              ; 27th read -> $3FFD (ROM!)
4898   1EF1 80                                 ADD     A,B                 ; 
4899   1EF2 C6 27                              ADD     $27                 ; magic constant
4900   1EF4 21 89 43                           LD      HL,HiScorehigh      ; 
4901   1EF7 86                                 ADD     A,(HL)              ; 
4902   1EF8 77                                 LD      (HL),A              ; 
4903   1EF9 00                                 NOP                         ; 
4904   1EFA C9                                 RET                         ; 
4905   1EFB             
4906   1F00                                    .ORG $1F00
