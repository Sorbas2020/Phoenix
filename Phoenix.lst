7569   355B 36 00                              LD      (HL),$00            ;
7570   355D C9                                 RET                         ;
7571   355E             
7572   3560                                    .ORG $3560
7573   3560             ;*****************************************************************************
7574   3560             ;* Bird-launch setup:
7575   3560             ;* Decides the parameters of the next incoming bird group.
7576   3560             ;* Builds a random horizontal jitter, then composes an index from the current game state.
7577   3560             ;* The index is `bit5(timing) | round(bits 3 4) | (BirdsLeft 1)(bits 1 2)`,
7578   3560             ;* which spans `$00`–`$3E` in steps of 2 -> addresses `$3E80`–`$3EBE`.
7579   3560             ;* So the table is 32 two byte entries, selected by:
7580   3560             ;* - Game round (`LevelAndRound`, clamped at round 4) -> one of 4 difficulty groups
7581   3560             ;* - Birds remaining (`BirdsLeft 1`, clamped to 0–3) -> entry within the group
7582   3560             ;* - A timing bit from `Counter9A` -> alternates between the two halves of the table
7583   3560             ;* They're then consumed by the bird movement/attack code.
7584   3560             ;*****************************************************************************
7585   3560             L3560:
7586   3560 CD AA 30                           CALL    GetRandomNumber     ; 
7587   3563 47                                 LD      B,A                 ;
7588   3564 07                                 RLCA                        ; Multiply by 4 ..
7589   3565 07                                 RLCA                        ; ..
7590   3566 4F                                 LD      C,A                 ;
7591   3567 07                                 RLCA                        ; Multiply by 4 ..
7592   3568 07                                 RLCA                        ; ..
7593   3569 B0                                 OR      B                   
7594   356A 32 6F 43                           LD      (M436F),A           ; 
7595   356D 3A B8 43                           LD      A,(LevelAndRound)   ; 
7596   3570 FE 40                              CP      $40                 ;
7597   3572 DA 77 35                           JP      C,L3577             ; if game round < 4
7598   3575 3E 30                              LD      A,$30               
7599   3577             L3577:
7600   3577 E6 30                              AND     $30                 
7601   3579 0F                                 RRCA                        
7602   357A 47                                 LD      B,A                 
7603   357B 3A BB 43                           LD      A,(BirdsLeft)       ; 
7604   357E 3D                                 DEC     A                   
7605   357F FE 04                              CP      $04                 
7606   3581 DA 86 35                           JP      C,L3586             ; 
7607   3584 3E 03                              LD      A,$03               
7608   3586             L3586:
7609   3586 07                                 RLCA                        ; Multiply by 2
7610   3587 B0                                 OR      B                   
7611   3588 47                                 LD      B,A                 
7612   3589 3A 9A 43                           LD      A,(Counter9A)       ; 
7613   358C 07                                 RLCA                        ; Multiply by 4 ..
7614   358D 07                                 RLCA                        ; ..
7615   358E E6 20                              AND     $20                 ; mask out 0010_0000
7616   3590 B0                                 OR      B                   
7617   3591 C6 80                              ADD     $80                 
7618   3593 6F                                 LD      L,A                 
7619   3594 26 3E                              LD      H,$3E               
7620   3596 7E                                 LD      A,(HL)              ; data from table T3E80
7621   3597 32 6E 43                           LD      (M436E),A           ; 
7622   359A 2C                                 INC     L                   
7623   359B 7E                                 LD      A,(HL)              ; data from table T3E80
7624   359C 81                                 ADD     A,C                 
7625   359D E6 F8                              AND     $F8                 
7626   359F 32 6D 43                           LD      (M436D),A           ; 
7627   35A2 C9                                 RET                         
7628   35A3             
7629   35B0                                    .ORG $35B0
7630   35B0             ;*****************************************************************************
7631   35B0             ;* The dispatch trick:
7632   35B0             ;* `L35B0` is called with `HL` -> the bird's record.
7633   35B0             ;* It reads the state index at record offset +0, then (crucially) advances `HL`
7634   35B0             ;* to offset +4 and passes that pointer along.
7635   35B0             ;* It then looks up `T3F00 + index*8` and pushes four 16 bit values, then does `RET`.
7636   35B0             ;*****************************************************************************
7637   35B0             L35B0:
7638   35B0 7E                                 LD      A,(HL)              ; get index character block shape
7639   35B1 A7                                 AND     A                   ; updates the zero flag
7640   35B2 C8                                 RET     Z                   ; if index is 0
7641   35B3 47                                 LD      B,A                 ; save index to B
7642   35B4 2C                                 INC     L                   ;
7643   35B5 2C                                 INC     L                   ;
7644   35B6 2C                                 INC     L                   ;
7645   35B7 2C                                 INC     L                   ;
7646   35B8 7E                                 LD      A,(HL)              ;
7647   35B9 A7                                 AND     A                   ; updates the zero flag
7648   35BA CA BE 35                           JP      Z,L35BE             ; 
7649   35BD 35                                 DEC     (HL)                ;
7650   35BE             L35BE:
7651   35BE EB                                 EX      DE,HL               ;
7652   35BF D5                                 PUSH    DE                  ;
7653   35C0 78                                 LD      A,B                 ; load index
7654   35C1 07                                 RLCA                        ; Multiply by 8 ..
7655   35C2 07                                 RLCA                        ; ..
7656   35C3 07                                 RLCA                        ; ..
7657   35C4 6F                                 LD      L,A                 ;
7658   35C5 26 3F                              LD      H,$3F               ; MSB of table T3F00 for stack manipulation
7659   35C7 46                                 LD      B,(HL)              ; get 1st byte
7660   35C8 23                                 INC     HL                  ;
7661   35C9 4E                                 LD      C,(HL)              ; get 2nd byte
7662   35CA C5                                 PUSH    BC                  ; to stack
7663   35CB 23                                 INC     HL                  ;
7664   35CC 46                                 LD      B,(HL)              ; get 3rd byte
7665   35CD 23                                 INC     HL                  ;
7666   35CE 4E                                 LD      C,(HL)              ; get 4rd byte
7667   35CF C5                                 PUSH    BC                  ; to stack
7668   35D0 23                                 INC     HL                  ;
7669   35D1 46                                 LD      B,(HL)              ; get MSB of 1st address
7670   35D2 23                                 INC     HL                  ;
7671   35D3 4E                                 LD      C,(HL)              ; get LSB of 1st address
7672   35D4 C5                                 PUSH    BC                  ; to stack
7673   35D5 23                                 INC     HL                  ;
7674   35D6 46                                 LD      B,(HL)              ; get MSB of 2nd address
7675   35D7 23                                 INC     HL                  ;
7676   35D8 4E                                 LD      C,(HL)              ; get LSB of 2nd address
7677   35D9 C5                                 PUSH    BC                  ; to stack
7678   35DA EB                                 EX      DE,HL               ;
7679   35DB C9                                 RET                         ; calls the 2nd address
7680   35DC             ;*****************************************************************************
7681   35DC             ;* Because the 2nd address was pushed last, `RET` jumps there first. So the sequence is:
7682   35DC             ;* 1. `RET` -> 2nd address (`$35E0` or `$36C0`) runs first, with `HL` = bird record +4.
7683   35DC             ;*    These are the movement / animation routines. They do their work and finish with their own `RET`.
7684   35DC             ;* 2. That `RET` pops the next stack item — the 1st address (`$36CC`, `$36D2`, `$36EA`, or `$370A`)
7685   35DC             ;*     — and jumps there. These are the state transition routines.
7686   35DC             ;*     They begin by popping the two constants and the bird pointer back off the stack.
7687   35DC             ;*****************************************************************************
7688   35DC             
7689   35E0                                    .ORG $35E0
