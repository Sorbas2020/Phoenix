7173   3272 FE 05                              CP      $05                 
7174   3274 D8                                 RET     C                   ; if < 5
7175   3275 36 00                              LD      (HL),$00            ; clear $4350
7176   3277 2E 53                              LD      L,$53               
7177   3279 4E                                 LD      C,(HL)              ; get $4353
7178   327A 2C                                 INC     L                   
7179   327B 6E                                 LD      L,(HL)              ; get $4354
7180   327C 26 4B                              LD      H,$4B               
7181   327E 3A 56 43                           LD      A,(M4356)           ; 
7182   3281 57                                 LD      D,A                 
7183   3282 3A 94 43                           LD      A,(M4394)           ; 
7184   3285 5F                                 LD      E,A                 
7185   3286 7D                                 LD      A,L                 
7186   3287 D6 50                              SUB     $50                 
7187   3289 0F                                 RRCA                        
7188   328A 47                                 LD      B,A                 
7189   328B 3E 10                              LD      A,$10               
7190   328D 90                                 SUB     B                   
