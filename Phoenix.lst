8561   3A15 C2 43 3B                           JP      NZ,L3B43            ; if LevelAndRound is not 0.
8562   3A18 2E 8D                              LD      L,$8D               ; set SoundControlB for...
8563   3A1A 36 CF                              LD      (HL),$CF            ; ... 1100_1111 triggers Tune3 -- ESTUDIO (Phoenix theme song)
8564   3A1C C9                                 RET                         ;
